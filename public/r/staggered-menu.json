{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "staggered-menu",
  "type": "registry:ui",
  "title": "Staggered Menu",
  "description": "Side menu whose color layers slide in one after another, then links rise in with a staggered tilt as the toggle rolls from Menu to Close.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/staggered-menu/StaggeredMenu.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, nextTick, onBeforeUnmount, ref, useId, watch } from 'vue';\n  import { animate } from 'motion-v';\n  import {\n    defaultDocument,\n    useEventListener,\n    usePreferredReducedMotion,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import {\n    EASE,\n    ITEM_HIDDEN,\n    ITEM_SHOWN,\n    SOCIAL_HIDDEN,\n    SOCIAL_SHOWN,\n    labelSequence,\n    layerColors,\n    offscreenTransform,\n  } from './staggered-menu-motion';\n  import type { StaggeredMenuProps } from './types';\n\n  type Controls = ReturnType<typeof animate>;\n\n  const props = withDefaults(defineProps<StaggeredMenuProps>(), {\n    position: 'right',\n    colors: () => ['#B497CF', '#5227FF'],\n    items: () => [],\n    socialItems: () => [],\n    displaySocials: true,\n    displayItemNumbering: true,\n    logoUrl: undefined,\n    menuButtonColor: '#fff',\n    openMenuButtonColor: '#fff',\n    accentColor: '#5227FF',\n    changeMenuColorOnOpen: true,\n    isFixed: false,\n    closeOnClickAway: true,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    'menu-open': [];\n    'menu-close': [];\n  }>();\n\n  const reducedMotion = usePreferredReducedMotion();\n\n  const open = ref(false);\n  const textLines = ref(['Menu', 'Close']);\n  const panelRef = ref<HTMLElement | null>(null);\n  const layersRef = ref<HTMLElement | null>(null);\n  const toggleRef = ref<HTMLButtonElement | null>(null);\n  const iconRef = ref<HTMLElement | null>(null);\n  const textInnerRef = ref<HTMLElement | null>(null);\n\n  const layers = computed(() => layerColors(props.colors));\n  const offscreen = computed(() => offscreenTransform(props.position));\n  const panelId = `staggered-menu-panel-${useId()}`;\n\n  let busy = false;\n  let openAnims: Controls[] = [];\n  let closeAnims: Controls[] = [];\n  let iconAnim: Controls | null = null;\n  let colorAnim: Controls | null = null;\n  let textAnim: Controls | null = null;\n\n  /** Durations collapse to 0 under reduced motion. */\n  function time(seconds: number) {\n    return reducedMotion.value === 'reduce' ? 0 : seconds;\n  }\n\n  function stopAll(list: Controls[]) {\n    list.forEach((controls) => controls.stop());\n  }\n\n  function parts() {\n    const panel = panelRef.value;\n    return {\n      panel,\n      layers: Array.from(\n        layersRef.value?.querySelectorAll<HTMLElement>('.sm-prelayer') ?? [],\n      ),\n      labels: Array.from(\n        panel?.querySelectorAll<HTMLElement>('.sm-panel-itemLabel') ?? [],\n      ),\n      numbers: Array.from(\n        panel?.querySelectorAll<HTMLElement>('.sm-panel-itemNum') ?? [],\n      ),\n      socialTitle: panel?.querySelector<HTMLElement>('.sm-socials-title'),\n      socialLinks: Array.from(\n        panel?.querySelectorAll<HTMLElement>('.sm-socials-link') ?? [],\n      ),\n    };\n  }\n\n  function resetContent() {\n    const { labels, numbers, socialTitle, socialLinks } = parts();\n    labels.forEach((el) => (el.style.transform = ITEM_HIDDEN));\n    numbers.forEach((el) => (el.style.opacity = '0'));\n    if (socialTitle) socialTitle.style.opacity = '0';\n    socialLinks.forEach((el) => {\n      el.style.transform = SOCIAL_HIDDEN;\n      el.style.opacity = '0';\n    });\n  }\n\n  function playOpen() {\n    if (busy) return;\n    const {\n      panel,\n      layers: layerEls,\n      labels,\n      numbers,\n      socialTitle,\n      socialLinks,\n    } = parts();\n    if (!panel) return;\n    busy = true;\n    stopAll(openAnims);\n    stopAll(closeAnims);\n    closeAnims = [];\n    resetContent();\n\n    const anims: Controls[] = [];\n    layerEls.forEach((el, i) => {\n      anims.push(\n        animate(\n          el,\n          { transform: [offscreen.value, 'translateX(0%)'] },\n          { duration: time(0.5), ease: EASE.power4Out, delay: time(i * 0.07) },\n        ),\n      );\n    });\n    const lastTime = layerEls.length ? (layerEls.length - 1) * 0.07 : 0;\n    const panelAt = lastTime + (layerEls.length ? 0.08 : 0);\n    const panelDuration = 0.65;\n    anims.push(\n      animate(\n        panel,\n        { transform: [offscreen.value, 'translateX(0%)'] },\n        {\n          duration: time(panelDuration),\n          ease: EASE.power4Out,\n          delay: time(panelAt),\n        },\n      ),\n    );\n\n    const itemsAt = panelAt + panelDuration * 0.15;\n    labels.forEach((el, i) => {\n      anims.push(\n        animate(\n          el,\n          { transform: [ITEM_HIDDEN, ITEM_SHOWN] },\n          {\n            duration: time(1),\n            ease: EASE.power4Out,\n            delay: time(itemsAt + i * 0.1),\n          },\n        ),\n      );\n    });\n    numbers.forEach((el, i) => {\n      anims.push(\n        animate(\n          el,\n          { opacity: [0, 1] },\n          {\n            duration: time(0.6),\n            ease: EASE.power2Out,\n            delay: time(itemsAt + 0.1 + i * 0.08),\n          },\n        ),\n      );\n    });\n\n    const socialsAt = panelAt + panelDuration * 0.4;\n    if (socialTitle) {\n      anims.push(\n        animate(\n          socialTitle,\n          { opacity: [0, 1] },\n          { duration: time(0.5), ease: EASE.power2Out, delay: time(socialsAt) },\n        ),\n      );\n    }\n    socialLinks.forEach((el, i) => {\n      anims.push(\n        animate(\n          el,\n          { transform: [SOCIAL_HIDDEN, SOCIAL_SHOWN], opacity: [0, 1] },\n          {\n            duration: time(0.55),\n            ease: EASE.power3Out,\n            delay: time(socialsAt + 0.04 + i * 0.08),\n          },\n        ),\n      );\n    });\n\n    openAnims = anims;\n    Promise.all(anims.map((controls) => controls.finished)).then(\n      () => {\n        if (openAnims === anims) busy = false;\n      },\n      () => undefined,\n    );\n  }\n\n  function playClose() {\n    stopAll(openAnims);\n    openAnims = [];\n    const { panel, layers: layerEls } = parts();\n    if (!panel) return;\n    stopAll(closeAnims);\n    const anims = [...layerEls, panel].map((el) =>\n      animate(\n        el,\n        { transform: offscreen.value },\n        { duration: time(0.32), ease: EASE.power3In },\n      ),\n    );\n    closeAnims = anims;\n    Promise.all(anims.map((controls) => controls.finished)).then(\n      () => {\n        if (closeAnims !== anims) return;\n        resetContent();\n        busy = false;\n      },\n      () => undefined,\n    );\n  }\n\n  function animateIcon(opening: boolean) {\n    const icon = iconRef.value;\n    if (!icon) return;\n    iconAnim?.stop();\n    iconAnim = opening\n      ? animate(\n          icon,\n          { rotate: 225 },\n          { duration: time(0.8), ease: EASE.power4Out },\n        )\n      : animate(\n          icon,\n          { rotate: 0 },\n          { duration: time(0.35), ease: EASE.power3InOut },\n        );\n  }\n\n  function animateColor(opening: boolean) {\n    const button = toggleRef.value;\n    if (!button) return;\n    colorAnim?.stop();\n    if (!props.changeMenuColorOnOpen) {\n      button.style.color = props.menuButtonColor;\n      return;\n    }\n    colorAnim = animate(\n      button,\n      { color: opening ? props.openMenuButtonColor : props.menuButtonColor },\n      { delay: time(0.18), duration: time(0.3), ease: EASE.power2Out },\n    );\n  }\n\n  async function animateText(opening: boolean) {\n    const sequence = labelSequence(opening);\n    textLines.value = sequence;\n    await nextTick();\n    const inner = textInnerRef.value;\n    if (!inner) return;\n    textAnim?.stop();\n    const shift = ((sequence.length - 1) / sequence.length) * 100;\n    textAnim = animate(\n      inner,\n      { transform: ['translateY(0%)', `translateY(-${shift}%)`] },\n      { duration: time(0.5 + sequence.length * 0.07), ease: EASE.power4Out },\n    );\n  }\n\n  function setOpen(target: boolean) {\n    open.value = target;\n    if (target) {\n      emit('menu-open');\n      playOpen();\n    } else {\n      emit('menu-close');\n      playClose();\n    }\n    animateIcon(target);\n    animateColor(target);\n    animateText(target);\n  }\n\n  function toggleMenu() {\n    setOpen(!open.value);\n  }\n\n  function closeMenu() {\n    if (open.value) setOpen(false);\n  }\n\n  watch(\n    [\n      () => props.changeMenuColorOnOpen,\n      () => props.menuButtonColor,\n      () => props.openMenuButtonColor,\n    ],\n    () => {\n      const button = toggleRef.value;\n      if (!button) return;\n      colorAnim?.stop();\n      button.style.color =\n        props.changeMenuColorOnOpen && open.value\n          ? props.openMenuButtonColor\n          : props.menuButtonColor;\n    },\n  );\n\n  useEventListener(defaultDocument, 'mousedown', (event: MouseEvent) => {\n    if (!props.closeOnClickAway || !open.value) return;\n    const target = event.target;\n    if (!(target instanceof Node)) return;\n    if (\n      panelRef.value &&\n      !panelRef.value.contains(target) &&\n      toggleRef.value &&\n      !toggleRef.value.contains(target)\n    )\n      closeMenu();\n  });\n\n  useEventListener('keydown', (event: KeyboardEvent) => {\n    if (event.key !== 'Escape' || !open.value) return;\n    closeMenu();\n    toggleRef.value?.focus();\n  });\n\n  onBeforeUnmount(() => {\n    stopAll(openAnims);\n    stopAll(closeAnims);\n    iconAnim?.stop();\n    colorAnim?.stop();\n    textAnim?.stop();\n  });\n</script>\n\n<template>\n  <div\n    :class=\"\n      cn('staggered-menu-wrapper', isFixed && 'fixed-wrapper', props.class)\n    \"\n    :style=\"accentColor ? { '--sm-accent': accentColor } : undefined\"\n    :data-position=\"position\"\n    :data-open=\"open || undefined\"\n  >\n    <div ref=\"layersRef\" class=\"sm-prelayers\" aria-hidden=\"true\">\n      <div\n        v-for=\"(color, i) in layers\"\n        :key=\"i\"\n        class=\"sm-prelayer\"\n        :style=\"{ background: color, transform: offscreen }\"\n      />\n    </div>\n\n    <header class=\"staggered-menu-header\" aria-label=\"Main navigation header\">\n      <div class=\"sm-logo\" aria-label=\"Logo\">\n        <slot name=\"logo\" :open=\"open\">\n          <img\n            v-if=\"logoUrl\"\n            :src=\"logoUrl\"\n            alt=\"Logo\"\n            class=\"sm-logo-img\"\n            draggable=\"false\"\n            width=\"110\"\n            height=\"24\"\n          />\n        </slot>\n      </div>\n      <button\n        ref=\"toggleRef\"\n        class=\"sm-toggle\"\n        :aria-label=\"open ? 'Close menu' : 'Open menu'\"\n        :aria-expanded=\"open\"\n        :aria-controls=\"panelId\"\n        type=\"button\"\n        :style=\"{ color: menuButtonColor }\"\n        @click=\"toggleMenu\"\n      >\n        <span class=\"sm-toggle-textWrap\" aria-hidden=\"true\">\n          <span ref=\"textInnerRef\" class=\"sm-toggle-textInner\">\n            <span\n              v-for=\"(line, i) in textLines\"\n              :key=\"i\"\n              class=\"sm-toggle-line\"\n            >\n              {{ line }}\n            </span>\n          </span>\n        </span>\n        <span ref=\"iconRef\" class=\"sm-icon\" aria-hidden=\"true\">\n          <span class=\"sm-icon-line\" />\n          <span class=\"sm-icon-line sm-icon-line-v\" />\n        </span>\n      </button>\n    </header>\n\n    <aside\n      :id=\"panelId\"\n      ref=\"panelRef\"\n      class=\"staggered-menu-panel\"\n      :aria-hidden=\"!open\"\n      :inert=\"!open\"\n      :style=\"{ transform: offscreen }\"\n    >\n      <div class=\"sm-panel-inner\">\n        <ul class=\"sm-panel-list\" role=\"list\">\n          <template v-if=\"items.length\">\n            <li\n              v-for=\"(item, idx) in items\"\n              :key=\"item.label + idx\"\n              class=\"sm-panel-itemWrap\"\n            >\n              <a\n                class=\"sm-panel-item\"\n                :href=\"item.link\"\n                :aria-label=\"item.ariaLabel\"\n                :data-index=\"idx + 1\"\n                @click=\"closeMenu\"\n              >\n                <span class=\"sm-panel-itemLabel\">{{ item.label }}</span>\n                <span\n                  v-if=\"displayItemNumbering\"\n                  class=\"sm-panel-itemNum\"\n                  aria-hidden=\"true\"\n                >\n                  {{ String(idx + 1).padStart(2, '0') }}\n                </span>\n              </a>\n            </li>\n          </template>\n          <li v-else class=\"sm-panel-itemWrap\" aria-hidden=\"true\">\n            <span class=\"sm-panel-item\">\n              <span class=\"sm-panel-itemLabel\">No items</span>\n            </span>\n          </li>\n        </ul>\n\n        <div\n          v-if=\"displaySocials && socialItems.length > 0\"\n          class=\"sm-socials\"\n          aria-label=\"Social links\"\n        >\n          <h3 class=\"sm-socials-title\">Socials</h3>\n          <ul class=\"sm-socials-list\" role=\"list\">\n            <li\n              v-for=\"(social, i) in socialItems\"\n              :key=\"social.label + i\"\n              class=\"sm-socials-item\"\n            >\n              <a\n                :href=\"social.link\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                class=\"sm-socials-link\"\n              >\n                {{ social.label }}\n              </a>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </aside>\n  </div>\n</template>\n\n<style scoped>\n  .staggered-menu-wrapper {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    z-index: 40;\n    pointer-events: none;\n  }\n\n  .staggered-menu-wrapper.fixed-wrapper {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    z-index: 40;\n    overflow: hidden;\n  }\n\n  .staggered-menu-header {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 2em;\n    background: transparent;\n    pointer-events: none;\n    z-index: 20;\n  }\n\n  .staggered-menu-header > * {\n    pointer-events: auto;\n  }\n\n  .sm-logo {\n    display: flex;\n    align-items: center;\n    user-select: none;\n  }\n\n  .sm-logo-img {\n    display: block;\n    height: 32px;\n    width: auto;\n    object-fit: contain;\n  }\n\n  .sm-toggle {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    gap: 0.3rem;\n    background: transparent;\n    border: none;\n    cursor: pointer;\n    color: #e9e9ef;\n    font-weight: 500;\n    line-height: 1;\n    overflow: visible;\n  }\n\n  .sm-toggle:focus-visible {\n    outline: 2px solid currentColor;\n    outline-offset: 4px;\n    border-radius: 4px;\n  }\n\n  .sm-toggle-textWrap {\n    position: relative;\n    display: inline-block;\n    height: 1em;\n    overflow: hidden;\n    white-space: nowrap;\n    width: var(--sm-toggle-width, auto);\n    min-width: var(--sm-toggle-width, auto);\n  }\n\n  .sm-toggle-textInner {\n    display: flex;\n    flex-direction: column;\n    line-height: 1;\n  }\n\n  .sm-toggle-line {\n    display: block;\n    height: 1em;\n    line-height: 1;\n  }\n\n  .sm-icon {\n    position: relative;\n    width: 14px;\n    height: 14px;\n    flex: 0 0 14px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    will-change: transform;\n  }\n\n  .sm-icon-line {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 100%;\n    height: 2px;\n    background: currentColor;\n    border-radius: 2px;\n    transform: translate(-50%, -50%);\n    will-change: transform;\n  }\n\n  .sm-icon-line-v {\n    transform: translate(-50%, -50%) rotate(90deg);\n  }\n\n  .staggered-menu-panel {\n    position: absolute;\n    top: 0;\n    right: 0;\n    width: clamp(260px, 38vw, 420px);\n    height: 100%;\n    background: white;\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    display: flex;\n    flex-direction: column;\n    padding: 6em 2em 2em 2em;\n    overflow-y: auto;\n    z-index: 10;\n    pointer-events: auto;\n  }\n\n  [data-position='left'] .staggered-menu-panel {\n    right: auto;\n    left: 0;\n  }\n\n  .sm-prelayers {\n    position: absolute;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    width: clamp(260px, 38vw, 420px);\n    pointer-events: none;\n    z-index: 5;\n  }\n\n  [data-position='left'] .sm-prelayers {\n    right: auto;\n    left: 0;\n  }\n\n  .sm-prelayer {\n    position: absolute;\n    top: 0;\n    right: 0;\n    height: 100%;\n    width: 100%;\n  }\n\n  .sm-panel-inner {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 1.25rem;\n  }\n\n  .sm-socials {\n    margin-top: auto;\n    padding-top: 2rem;\n    display: flex;\n    flex-direction: column;\n    gap: 0.75rem;\n  }\n\n  .sm-socials-title {\n    margin: 0;\n    font-size: 1rem;\n    font-weight: 500;\n    color: var(--sm-accent, #ff0000);\n    opacity: 0;\n  }\n\n  .sm-socials-list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    gap: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .sm-socials-link {\n    font-size: 1.2rem;\n    font-weight: 500;\n    color: #111;\n    text-decoration: none;\n    position: relative;\n    padding: 2px 0;\n    display: inline-block;\n    opacity: 0;\n    transform: translateY(25px);\n    transition:\n      color 0.3s ease,\n      filter 0.3s ease;\n  }\n\n  .sm-socials-link:hover {\n    color: var(--sm-accent, #ff0000);\n  }\n\n  .sm-socials-link:focus-visible {\n    outline: 2px solid var(--sm-accent, #ff0000);\n    outline-offset: 3px;\n  }\n\n  /* Dim siblings via filter so the entrance opacity tween stays untouched. */\n  .sm-socials-list:hover .sm-socials-link:not(:hover),\n  .sm-socials-list:focus-within .sm-socials-link:not(:focus-visible) {\n    filter: opacity(0.35);\n  }\n\n  .sm-panel-list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n  }\n\n  .sm-panel-itemWrap {\n    position: relative;\n    overflow: hidden;\n    line-height: 1;\n  }\n\n  .sm-panel-item {\n    position: relative;\n    color: #000;\n    font-weight: 600;\n    font-size: 3.5rem;\n    cursor: pointer;\n    line-height: 1;\n    letter-spacing: -2px;\n    text-transform: uppercase;\n    transition:\n      background 0.25s,\n      color 0.25s;\n    display: inline-block;\n    text-decoration: none;\n    padding-right: 1.4em;\n  }\n\n  .sm-panel-item:hover,\n  .sm-panel-item:focus-visible {\n    color: var(--sm-accent, #5227ff);\n  }\n\n  .sm-panel-item:focus-visible {\n    outline: 2px solid var(--sm-accent, #5227ff);\n    outline-offset: 2px;\n  }\n\n  .sm-panel-itemLabel {\n    display: inline-block;\n    will-change: transform;\n    transform-origin: 50% 100%;\n    transform: translateY(140%) rotate(10deg);\n  }\n\n  .sm-panel-itemNum {\n    position: absolute;\n    top: 0.1em;\n    right: 2.8em;\n    font-size: 18px;\n    font-weight: 400;\n    color: var(--sm-accent, #5227ff);\n    letter-spacing: 0;\n    pointer-events: none;\n    user-select: none;\n    opacity: 0;\n  }\n\n  @media (max-width: 1024px) {\n    .staggered-menu-panel {\n      width: 100%;\n      left: 0;\n      right: 0;\n    }\n\n    .sm-prelayers {\n      width: 100%;\n    }\n\n    .staggered-menu-wrapper[data-open] .sm-logo-img {\n      filter: invert(100%);\n    }\n  }\n</style>\n",
