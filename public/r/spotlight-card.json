    {
      "path": "registry/new-york/spotlight-card/BeamSpotlightCard.vue",
      "content": "<script setup lang=\"ts\">\n  import { useMouseInElement, useElementHover } from '@vueuse/core';\n  import type { BeamSpotlightCardProps } from './types';\n  import { cn } from '~/lib/utils';\n\n  const props = withDefaults(defineProps<BeamSpotlightCardProps>(), {\n    beamColor: 'rgba(120, 119, 198, 0.5)',\n    beamWidth: 200,\n    borderRadius: 16,\n    class: '',\n  });\n\n  const containerRef = ref<HTMLElement>();\n  const { elementX, elementY } = useMouseInElement(containerRef);\n  const isHovered = useElementHover(containerRef);\n\n  const verticalBeamStyle = computed(() => ({\n    left: `${elementX.value - props.beamWidth / 2}px`,\n    top: '0',\n    width: `${props.beamWidth}px`,\n    height: '100%',\n    background: `linear-gradient(90deg, transparent, ${props.beamColor}, transparent)`,\n    opacity: isHovered.value ? 0.6 : 0,\n    filter: 'blur(20px)',\n  }));\n\n  const horizontalBeamStyle = computed(() => ({\n    left: '0',\n    top: `${elementY.value - props.beamWidth / 2}px`,\n    width: '100%',\n    height: `${props.beamWidth}px`,\n    background: `linear-gradient(180deg, transparent, ${props.beamColor}, transparent)`,\n    opacity: isHovered.value ? 0.4 : 0,\n    filter: 'blur(20px)',\n  }));\n\n  const intersectionStyle = computed(() => ({\n    left: `${elementX.value}px`,\n    top: `${elementY.value}px`,\n    width: '100px',\n    height: '100px',\n    transform: 'translate(-50%, -50%)',\n    background: `radial-gradient(circle, ${props.beamColor} 0%, transparent 70%)`,\n    opacity: isHovered.value ? 1 : 0,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"containerRef\"\n    :class=\"\n      cn(\n        'relative overflow-hidden',\n        'bg-white dark:bg-neutral-950',\n        'border border-neutral-200 dark:border-neutral-800',\n        'transition-all duration-500',\n        props.class,\n      )\n    \"\n    :style=\"{ borderRadius: `${borderRadius}px` }\"\n  >\n    <div\n      class=\"absolute pointer-events-none transition-all duration-150\"\n      :style=\"verticalBeamStyle\"\n    ></div>\n    <div\n      class=\"absolute pointer-events-none transition-all duration-150\"\n      :style=\"horizontalBeamStyle\"\n    ></div>\n    <div\n      class=\"absolute pointer-events-none transition-all duration-150\"\n      :style=\"intersectionStyle\"\n    ></div>\n    <div class=\"relative z-10\">\n      <slot></slot>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/spotlight-card/BeamSpotlightCard.vue"
    },
    {
      "path": "registry/new-york/spotlight-card/GradientFollowCard.vue",
      "content": "<script setup lang=\"ts\">\n  import { useMouseInElement, useElementHover } from '@vueuse/core';\n  import type { GradientFollowCardProps } from './types';\n  import { cn } from '~/lib/utils';\n\n  const props = withDefaults(defineProps<GradientFollowCardProps>(), {\n    gradientColors: () =>\n      ['#7877c6', '#5eead4', '#f472b6'] as [string, string, string],\n    borderRadius: 16,\n    class: '',\n  });\n\n  const containerRef = ref<HTMLElement>();\n  const { elementX, elementY, isOutside } = useMouseInElement(containerRef);\n  const isHovered = useElementHover(containerRef);\n\n  const posX = computed(() => {\n    if (isOutside.value || !containerRef.value) return 50;\n    return (\n      (elementX.value / containerRef.value.getBoundingClientRect().width) * 100\n    );\n  });\n\n  const posY = computed(() => {\n    if (isOutside.value || !containerRef.value) return 50;\n    return (\n      (elementY.value / containerRef.value.getBoundingClientRect().height) * 100\n    );\n  });\n\n  const gradientStyle = computed(() => ({\n    background: `\n    radial-gradient(600px circle at ${posX.value}% ${posY.value}%, ${props.gradientColors[0]}40, transparent 40%),\n    radial-gradient(400px circle at ${posX.value + 10}% ${posY.value - 10}%, ${props.gradientColors[1]}30, transparent 40%),\n    radial-gradient(300px circle at ${posX.value - 10}% ${posY.value + 10}%, ${props.gradientColors[2]}20, transparent 40%)\n  `,\n    opacity: isHovered.value ? 1 : 0.3,\n  }));\n\n  const borderStyle = computed(() => ({\n    borderRadius: `${props.borderRadius}px`,\n    border: '1px solid',\n    borderColor: isHovered.value\n      ? 'rgba(255, 255, 255, 0.2)'\n      : 'rgba(255, 255, 255, 0.1)',\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"containerRef\"\n    :class=\"\n      cn('relative overflow-hidden transition-all duration-500', props.class)\n    \"\n    :style=\"{ borderRadius: `${borderRadius}px` }\"\n  >\n    <div\n      class=\"absolute inset-0 transition-opacity duration-500\"\n      :style=\"gradientStyle\"\n    ></div>\n    <div\n      class=\"absolute inset-0 bg-white/90 dark:bg-neutral-950/90\"\n      :style=\"{ borderRadius: `${borderRadius}px` }\"\n    ></div>\n    <div\n      class=\"absolute inset-0 pointer-events-none transition-opacity duration-500\"\n      :style=\"borderStyle\"\n    ></div>\n    <div class=\"relative z-10\">\n      <slot></slot>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/spotlight-card/GradientFollowCard.vue"
    },
    {
      "path": "registry/new-york/spotlight-card/MultiSpotlightCard.vue",
      "content": "<script setup lang=\"ts\">\n  import { useMouseInElement, useElementHover } from '@vueuse/core';\n  import type { MultiSpotlightCardProps } from './types';\n  import { cn } from '~/lib/utils';\n\n  const props = withDefaults(defineProps<MultiSpotlightCardProps>(), {\n    colors: () => [\n      'rgba(120, 119, 198, 0.4)',\n      'rgba(255, 77, 77, 0.3)',\n      'rgba(77, 255, 174, 0.3)',\n    ],\n    borderRadius: 16,\n    class: '',\n  });\n\n  const containerRef = ref<HTMLElement>();\n  const { elementX, elementY } = useMouseInElement(containerRef);\n  const isHovered = useElementHover(containerRef);\n\n  function getSpotlightStyle(color: string, index: number) {\n    return {\n      left: `${elementX.value + (index - 1) * 50}px`,\n      top: `${elementY.value + (index - 1) * 50}px`,\n      width: '300px',\n      height: '300px',\n      transform: 'translate(-50%, -50%)',\n      background: `radial-gradient(circle, ${color} 0%, transparent 70%)`,\n      opacity: isHovered.value ? 1 : 0,\n      filter: 'blur(40px)',\n    };\n  }\n</script>\n\n<template>\n  <div\n    ref=\"containerRef\"\n    :class=\"\n      cn(\n        'relative overflow-hidden',\n        'bg-white dark:bg-neutral-950',\n        'border border-neutral-200 dark:border-neutral-800',\n        'transition-all duration-500',\n        props.class,\n      )\n    \"\n    :style=\"{ borderRadius: `${borderRadius}px` }\"\n  >\n    <div\n      v-for=\"(color, index) in colors\"\n      :key=\"index\"\n      class=\"absolute pointer-events-none transition-opacity duration-500\"\n      :style=\"getSpotlightStyle(color, index)\"\n    ></div>\n    <div class=\"relative z-10\">\n      <slot></slot>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/spotlight-card/MultiSpotlightCard.vue"
    },
    {
      "path": "registry/new-york/spotlight-card/SpotlightCard.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n  import {\n    useEventListener,\n    useIntersectionObserver,\n    usePreferredReducedMotion,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import {\n    SPOTLIGHT_CARD_NOISE,\n    SPOTLIGHT_CARD_THEMES,\n    clamp,\n    falloff,\n    spotlightGradient,\n  } from './spotlight-card-utils';\n  import type { SpotlightCardProps, SpotlightCardSettings } from './types';\n\n  const props = withDefaults(defineProps<SpotlightCardProps>(), {\n    spotlightColor: undefined,\n    intensity: 0.15,\n    spotlightSize: 240,\n    softness: 0.7,\n    shape: 'circle',\n    borderGlow: 0.6,\n    proximity: 80,\n    smoothing: 0.3,\n    ambient: false,\n    flare: true,\n    grain: 0,\n    theme: 'dark',\n    class: '',\n  });\n\n  const rootRef = ref<HTMLDivElement | null>(null);\n  const lightRef = ref<HTMLSpanElement | null>(null);\n  const grainRef = ref<HTMLSpanElement | null>(null);\n  const edgeRef = ref<HTMLSpanElement | null>(null);\n\n  const reducedMotion = usePreferredReducedMotion();\n\n  const palette = computed(\n    () => SPOTLIGHT_CARD_THEMES[props.theme] ?? SPOTLIGHT_CARD_THEMES.dark,\n  );\n\n  const settings = computed<SpotlightCardSettings>(() => {\n    const color = props.spotlightColor ?? palette.value.light;\n    return {\n      shape: props.shape === 'beam' ? 'beam' : 'circle',\n      fill: falloff(color, props.softness),\n      edge: falloff(color, 1),\n      size: Math.max(20, props.spotlightSize),\n      intensity: clamp(props.intensity, 0, 1) * palette.value.fill,\n      borderGlow: clamp(props.borderGlow, 0, 1) * palette.value.edge,\n      proximity: Math.max(0, props.proximity),\n      smoothing: clamp(props.smoothing, 0, 1),\n      ambient: props.ambient,\n      flare: props.flare,\n      grain: clamp(props.grain, 0, 1),\n    };\n  });\n\n  const rootStyle = computed(() => ({\n    '--spotlight-card-surface': palette.value.surface,\n    '--spotlight-card-border': palette.value.border,\n    '--spotlight-card-shadow': palette.value.shadow,\n  }));\n\n  const state = {\n    x: 0,\n    y: 0,\n    presence: 0,\n    flare: 0,\n    time: 0,\n    pressed: false,\n    visible: true,\n  };\n  const pointer = { x: 0, y: 0, active: false };\n  const drawn = { light: '', edge: '', noise: '' };\n  let focusTarget: Element | null = null;\n  let raf = 0;\n  let last = 0;\n  let alive = false;\n\n  function paint(s: SpotlightCardSettings) {\n    const light = lightRef.value;\n    const edge = edgeRef.value;\n    const noise = grainRef.value;\n    if (!light || !edge || !noise) return;\n    const size = s.size * (1 + 0.2 * state.flare);\n    const boost = 1 + 0.7 * state.flare;\n    const fill = spotlightGradient(s, size, state.x, state.y, s.fill);\n    const rim = spotlightGradient(\n      s,\n      size * 0.6,\n      state.x,\n      s.shape === 'beam' ? 0 : state.y,\n      s.edge,\n    );\n    if (fill !== drawn.light) {\n      drawn.light = fill;\n      light.style.background = fill;\n    }\n    if (rim !== drawn.edge) {\n      drawn.edge = rim;\n      edge.style.background = rim;\n    }\n    light.style.opacity = String(\n      Math.min(1, state.presence * s.intensity * boost),\n    );\n    edge.style.opacity = String(\n      Math.min(1, state.presence * s.borderGlow * boost),\n    );\n    const grainy =\n      s.grain > 0\n        ? spotlightGradient(\n            s,\n            size,\n            state.x,\n            state.y,\n            '#000 0%, transparent 100%',\n          )\n        : 'none';\n    if (grainy !== drawn.noise) {\n      drawn.noise = grainy;\n      noise.style.setProperty('-webkit-mask-image', grainy);\n      noise.style.maskImage = grainy;\n    }\n    noise.style.opacity = String(state.presence * s.grain);\n  }\n\n  function tick(now: number) {\n    raf = 0;\n    const root = rootRef.value;\n    if (!alive || !root) return;\n    const s = settings.value;\n    const reduce = reducedMotion.value === 'reduce';\n    const dt = Math.min(0.05, Math.max(0.001, (now - last) / 1000));\n    last = now;\n    const rect = root.getBoundingClientRect();\n    let tx = state.x;\n    let ty = state.y;\n    let target = 0;\n    if (focusTarget && root.contains(focusTarget)) {\n      const box = focusTarget.getBoundingClientRect();\n      tx = box.left + box.width / 2 - rect.left;\n      ty = box.top + box.height / 2 - rect.top;\n      target = 1;\n    } else if (pointer.active) {\n      tx = pointer.x - rect.left;\n      ty = pointer.y - rect.top;\n      const gap = Math.hypot(\n        Math.max(0, -tx, tx - rect.width),\n        Math.max(0, -ty, ty - rect.height),\n      );\n      if (gap === 0) target = 1;\n      else if (s.proximity > 0)\n        target = Math.max(0, 1 - gap / s.proximity) ** 2;\n    }\n    if (target < 0.6 && s.ambient && state.visible) {\n      if (!reduce) state.time += dt;\n      const drift = 0.6 - target;\n      tx +=\n        (rect.width * (0.5 + 0.34 * Math.sin(state.time * 0.43)) - tx) *\n        (drift / 0.6);\n      ty +=\n        (rect.height * (0.5 + 0.3 * Math.sin(state.time * 0.61 + 1.3)) - ty) *\n        (drift / 0.6);\n      target = 0.6;\n    }\n    if (state.presence < 0.02 && target > 0 && !s.ambient) {\n      state.x = tx;\n      state.y = ty;\n    }\n    const follow =\n      reduce || s.smoothing === 0\n        ? 1\n        : 1 - Math.exp(-dt / (0.015 + s.smoothing * 0.22));\n    state.x += (tx - state.x) * follow;\n    state.y += (ty - state.y) * follow;\n    const fade = reduce\n      ? 1\n      : 1 - Math.exp(-dt / (target > state.presence ? 0.1 : 0.32));\n    state.presence += (target - state.presence) * fade;\n    if (Math.abs(target - state.presence) < 0.002) state.presence = target;\n    const press = state.pressed && s.flare && !reduce ? 1 : 0;\n    state.flare +=\n      (press - state.flare) * (1 - Math.exp(-dt / (press ? 0.05 : 0.28)));\n    if (Math.abs(press - state.flare) < 0.002) state.flare = press;\n    paint(s);\n    const moving = Math.abs(tx - state.x) > 0.1 || Math.abs(ty - state.y) > 0.1;\n    const settled =\n      !moving && state.presence === target && state.flare === press;\n    if (!settled || (s.ambient && state.visible && !reduce))\n      raf = requestAnimationFrame(tick);\n  }\n\n  function wake() {\n    if (raf || !alive) return;\n    last = performance.now();\n    raf = requestAnimationFrame(tick);\n  }\n\n  function onMove(event: PointerEvent) {\n    pointer.x = event.clientX;\n    pointer.y = event.clientY;\n    pointer.active = true;\n    const root = rootRef.value;\n    if (\n      state.presence > 0 ||\n      settings.value.proximity > 0 ||\n      (root && event.target instanceof Node && root.contains(event.target))\n    )\n      wake();\n  }\n\n  function onOut(event: PointerEvent) {\n    if (event.relatedTarget) return;\n    pointer.active = false;\n    wake();\n  }\n\n  function onDown(event: PointerEvent) {\n    pointer.x = event.clientX;\n    pointer.y = event.clientY;\n    pointer.active = true;\n    state.pressed = true;\n    wake();\n  }\n\n  function onUp(event: PointerEvent) {\n    if (event.pointerType !== 'mouse') pointer.active = false;\n    if (!state.pressed && event.pointerType === 'mouse') return;\n    state.pressed = false;\n    wake();\n  }\n\n  function onFocusIn(event: FocusEvent) {\n    if (\n      !(event.target instanceof Element) ||\n      !event.target.matches(':focus-visible')\n    )\n      return;\n    focusTarget = event.target;\n    wake();\n  }\n\n  function onFocusOut(event: FocusEvent) {\n    const root = rootRef.value;\n    if (\n      root &&\n      event.relatedTarget instanceof Node &&\n      root.contains(event.relatedTarget)\n    )\n      return;\n    focusTarget = null;\n    wake();\n  }\n\n  function onScroll() {\n    if (pointer.active || state.presence > 0) wake();\n  }\n\n  useEventListener('pointermove', onMove, { passive: true });\n  useEventListener('pointerup', onUp);\n  useEventListener('pointercancel', onUp);\n  useEventListener('scroll', onScroll, { capture: true, passive: true });\n  useEventListener(\n    () => (rootRef.value ? rootRef.value.ownerDocument : null),\n    'pointerout',\n    onOut,\n  );\n  useEventListener(rootRef, 'pointerdown', onDown);\n  useEventListener(rootRef, 'focusin', onFocusIn);\n  useEventListener(rootRef, 'focusout', onFocusOut);\n\n  useIntersectionObserver(rootRef, (entries) => {\n    state.visible = entries.some((entry) => entry.isIntersecting);\n    if (state.visible) wake();\n  });\n\n  watch(settings, wake);\n\n  onMounted(() => {\n    state.time = Math.random() * 60;\n    alive = true;\n    wake();\n  });\n\n  onBeforeUnmount(() => {\n    alive = false;\n    cancelAnimationFrame(raf);\n    raf = 0;\n  });\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"\n      cn(\n        'relative isolate overflow-hidden rounded-3xl bg-(--spotlight-card-surface) p-8 shadow-(--spotlight-card-shadow)',\n        props.class,\n      )\n    \"\n    :style=\"rootStyle\"\n  >\n    <span ref=\"lightRef\" class=\"spotlight-card__light\" aria-hidden=\"true\" />\n    <span\n      ref=\"grainRef\"\n      class=\"spotlight-card__grain\"\n      :style=\"{ backgroundImage: SPOTLIGHT_CARD_NOISE }\"\n      aria-hidden=\"true\"\n    />\n    <slot />\n    <span class=\"spotlight-card__border\" aria-hidden=\"true\" />\n    <span ref=\"edgeRef\" class=\"spotlight-card__edge\" aria-hidden=\"true\" />\n  </div>\n</template>\n\n<style scoped>\n  .spotlight-card__light,\n  .spotlight-card__grain,\n  .spotlight-card__border,\n  .spotlight-card__edge {\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    pointer-events: none;\n  }\n\n  .spotlight-card__light,\n  .spotlight-card__grain {\n    z-index: -1;\n    opacity: 0;\n  }\n\n  .spotlight-card__grain {\n    background-size: 160px 160px;\n    mix-blend-mode: overlay;\n  }\n\n  .spotlight-card__border,\n  .spotlight-card__edge {\n    z-index: 1;\n    padding: 1px;\n    -webkit-mask:\n      linear-gradient(#000 0 0) content-box,\n      linear-gradient(#000 0 0);\n    -webkit-mask-composite: xor;\n    mask:\n      linear-gradient(#000 0 0) content-box exclude,\n      linear-gradient(#000 0 0);\n  }\n\n  .spotlight-card__border {\n    background: var(--spotlight-card-border);\n  }\n\n  .spotlight-card__edge {\n    opacity: 0;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/spotlight-card/SpotlightCard.vue"
    },
