      "content": "<script setup lang=\"ts\">\n  import { cn } from '~/lib/utils';\n\n  const props = withDefaults(defineProps<{ class?: string }>(), { class: '' });\n</script>\n\n<template>\n  <h3\n    :class=\"\n      cn(\n        'text-xl font-semibold leading-none tracking-tight text-neutral-900 dark:text-white',\n        props.class,\n      )\n    \"\n  >\n    <slot></slot>\n  </h3>\n</template>\n",
