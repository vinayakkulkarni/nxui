{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "backup-reserve",
  "type": "registry:ui",
  "title": "Backup Reserve",
  "description": "Battery reserve setting with an LCD readout, segmented charge bar, slider, presets, a storm watch switch and a grid charging stepper.",
  "dependencies": ["@vueuse/core"],
  "registryDependencies": ["https://nxui.geoql.in/r/segment-display.json"],
  "files": [
    {
      "path": "registry/new-york/backup-reserve/BackupReserve.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, nextTick, ref } from 'vue';\n  import {\n    usePreferredReducedMotion,\n    useTimeoutFn,\n    useTransition,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import SegmentDisplay from '../segment-display/SegmentDisplay.vue';\n  import BackupReserveDisplay from './BackupReserveDisplay.vue';\n  import BackupReserveSlider from './BackupReserveSlider.vue';\n  import type { BackupReserveProps, BackupReserveSettings } from './types';\n\n  const props = withDefaults(defineProps<BackupReserveProps>(), {\n    title: 'Backup reserve',\n    subtitle: 'Held back for outages',\n    status: 'Grid up',\n    battery: 64,\n    capacity: 13.5,\n    essentialLoad: 0.45,\n    presets: () => [10, 20, 30, 50, 80, 100],\n    cells: 25,\n    charging: true,\n    gridRateMin: 0,\n    gridRateMax: 11.5,\n    gridRateStep: 0.2,\n    stormTitle: 'Storm watch',\n    stormDescription: 'Fills to 100 % before alerts',\n    gridTitle: 'Grid charging',\n    gridDescription: 'Max rate from the grid',\n    cancelLabel: 'Cancel',\n    saveLabel: 'Save',\n    color: '#ff9a2e',\n    usableColor: '#4ade80',\n    class: '',\n  });\n\n  const reserve = defineModel<number>('reserve', { default: 30 });\n  const stormWatch = defineModel<boolean>('stormWatch', { default: true });\n  const gridRate = defineModel<number>('gridRate', { default: 3.8 });\n\n  const emit = defineEmits<{\n    save: [settings: BackupReserveSettings];\n    cancel: [];\n  }>();\n\n  const reduced = usePreferredReducedMotion();\n  const shown = useTransition(reserve, {\n    duration: computed(() => (reduced.value === 'reduce' ? 0 : 260)),\n    transition: [0.22, 1, 0.36, 1],\n  });\n\n  const hours = computed(() => {\n    if (props.essentialLoad <= 0) return 0;\n    return Math.round(\n      ((reserve.value / 100) * props.capacity) / props.essentialLoad,\n    );\n  });\n\n  // Presets: a radio group, with arrow keys moving the selection.\n  const presetButtons = ref<HTMLButtonElement[]>([]);\n  const presetIndex = computed(() => props.presets.indexOf(reserve.value));\n\n  function pickPreset(value: number): void {\n    reserve.value = value;\n  }\n\n  function onPresetKeydown(event: KeyboardEvent): void {\n    const count = props.presets.length;\n    if (count === 0) return;\n    let from = presetIndex.value;\n    if (from < 0) {\n      from = props.presets.findIndex((p) => p >= reserve.value);\n      if (from < 0) from = count - 1;\n    }\n    let next = from;\n    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {\n      next = presetIndex.value < 0 ? from : (from + 1) % count;\n    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {\n      next = presetIndex.value < 0 ? from : (from - 1 + count) % count;\n    } else return;\n    event.preventDefault();\n    const value = props.presets[next];\n    if (value === undefined) return;\n    reserve.value = value;\n    nextTick(() => presetButtons.value[next]?.focus());\n  }\n\n  function presetTabIndex(i: number): number {\n    if (presetIndex.value >= 0) return i === presetIndex.value ? 0 : -1;\n    return i === 0 ? 0 : -1;\n  }\n\n  function toggleStorm(): void {\n    stormWatch.value = !stormWatch.value;\n  }\n\n  function setRate(value: number): void {\n    const stepped = Math.round(value / props.gridRateStep) * props.gridRateStep;\n    gridRate.value = Number(\n      Math.min(props.gridRateMax, Math.max(props.gridRateMin, stepped)).toFixed(\n        2,\n      ),\n    );\n  }\n  function decreaseRate(): void {\n    setRate(gridRate.value - props.gridRateStep);\n  }\n  function increaseRate(): void {\n    setRate(gridRate.value + props.gridRateStep);\n  }\n  function onRateKeydown(event: KeyboardEvent): void {\n    if (event.key === 'ArrowUp' || event.key === 'ArrowRight') increaseRate();\n    else if (event.key === 'ArrowDown' || event.key === 'ArrowLeft')\n      decreaseRate();\n    else if (event.key === 'Home') setRate(props.gridRateMin);\n    else if (event.key === 'End') setRate(props.gridRateMax);\n    else return;\n    event.preventDefault();\n  }\n\n  // Cancel restores the last saved values.\n  const saved = ref<BackupReserveSettings>({\n    reserve: reserve.value,\n    stormWatch: stormWatch.value,\n    gridRate: gridRate.value,\n  });\n  const dirty = computed(\n    () =>\n      saved.value.reserve !== reserve.value ||\n      saved.value.stormWatch !== stormWatch.value ||\n      saved.value.gridRate !== gridRate.value,\n  );\n  const justSaved = ref(false);\n  const savedFlash = useTimeoutFn(\n    () => {\n      justSaved.value = false;\n    },\n    1600,\n    { immediate: false },\n  );\n\n  function cancel(): void {\n    reserve.value = saved.value.reserve;\n    stormWatch.value = saved.value.stormWatch;\n    gridRate.value = saved.value.gridRate;\n    emit('cancel');\n  }\n\n  function save(): void {\n    const settings: BackupReserveSettings = {\n      reserve: reserve.value,\n      stormWatch: stormWatch.value,\n      gridRate: gridRate.value,\n    };\n    saved.value = settings;\n    emit('save', { ...settings });\n    justSaved.value = true;\n    savedFlash.start();\n  }\n\n  const raised =\n    'border border-border bg-linear-to-b from-white to-zinc-100 shadow-[0_1px_2px_rgb(0_0_0/0.08),inset_0_1px_0_rgb(255_255_255/0.9)] dark:border-white/8 dark:from-[#333336] dark:to-[#242426] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.08),0_3px_8px_rgb(0_0_0/0.55)]';\n  const pressed =\n    'border border-black/10 bg-zinc-200/70 text-foreground shadow-[inset_0_2px_4px_rgb(0_0_0/0.12)] dark:border-white/5 dark:bg-[#141415] dark:text-white dark:shadow-[inset_0_2px_6px_rgb(0_0_0/0.8),0_1px_0_rgb(255_255_255/0.05)]';\n  const focusRing =\n    'outline-none focus-visible:ring-2 focus-visible:ring-(--br-accent) focus-visible:ring-offset-2 focus-visible:ring-offset-card';\n</script>\n\n<template>\n  <article\n    :class=\"\n      cn(\n        'flex w-full max-w-88 flex-col gap-4 rounded-[1.75rem] border border-border bg-card p-3 text-card-foreground shadow-[0_24px_48px_-20px_rgb(0_0_0/0.25)] dark:border-white/8 dark:bg-[#1c1c1e] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.06),0_24px_48px_-16px_rgb(0_0_0/0.7)]',\n        props.class,\n      )\n    \"\n    :style=\"{ '--br-accent': props.color }\"\n  >\n    <header class=\"flex items-center gap-3 px-1.5 pt-1.5\">\n      <span\n        class=\"flex size-9 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-foreground shadow-[inset_0_1px_0_rgb(255_255_255/0.6)] dark:border-white/8 dark:bg-linear-to-b dark:from-[#2e2e30] dark:to-[#1f1f21] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.08),0_2px_6px_rgb(0_0_0/0.5)]\"\n      >\n        <Icon name=\"lucide:battery-medium\" class=\"size-4.5\" />\n      </span>\n      <div class=\"min-w-0 flex-1\">\n        <p class=\"truncate text-[15px]/tight font-medium\">{{ props.title }}</p>\n        <p class=\"truncate text-sm/tight text-muted-foreground\">\n          {{ props.subtitle }}\n        </p>\n      </div>\n      <span\n        v-if=\"props.status\"\n        class=\"flex items-center gap-1.5 rounded-full border border-border bg-muted px-2.5 py-1 text-sm/none text-muted-foreground dark:border-white/6 dark:bg-black/30\"\n      >\n        <span\n          class=\"size-1.5 rounded-full bg-(--br-accent) shadow-[0_0_6px_var(--br-accent)]\"\n        />\n        {{ props.status }}\n      </span>\n    </header>\n\n    <BackupReserveDisplay\n      :reserve=\"shown\"\n      :battery=\"props.battery\"\n      :hours=\"hours\"\n      :cells=\"props.cells\"\n      :charging=\"props.charging\"\n      :color=\"props.color\"\n      :usable-color=\"props.usableColor\"\n    />\n\n    <BackupReserveSlider\n      v-model=\"reserve\"\n      :min=\"0\"\n      :max=\"100\"\n      :step=\"1\"\n      :color=\"props.color\"\n      label=\"Backup reserve\"\n      class=\"px-1.5\"\n    />\n\n    <div\n      role=\"radiogroup\"\n      aria-label=\"Reserve presets\"\n      class=\"flex justify-between px-2\"\n    >\n      <div\n        v-for=\"(preset, i) in props.presets\"\n        :key=\"preset\"\n        class=\"flex flex-col items-center gap-2\"\n      >\n        <span\n          class=\"size-1.5 rounded-full transition-[background-color,box-shadow] duration-200\"\n          :class=\"\n            preset === reserve\n              ? 'bg-(--br-accent) shadow-[0_0_6px_var(--br-accent)]'\n              : 'bg-foreground/15'\n          \"\n          aria-hidden=\"true\"\n        />\n        <button\n          ref=\"presetButtons\"\n          type=\"button\"\n          role=\"radio\"\n          :aria-checked=\"preset === reserve\"\n          :aria-label=\"`${preset} %`\"\n          :tabindex=\"presetTabIndex(i)\"\n          :class=\"[\n            'flex size-11 items-center justify-center rounded-full text-sm tabular-nums transition-[background-color,box-shadow,color,scale] duration-200 active:scale-95',\n            focusRing,\n            preset === reserve\n              ? pressed\n              : `${raised} text-muted-foreground hover:text-foreground`,\n          ]\"\n          @click=\"pickPreset(preset)\"\n          @keydown=\"onPresetKeydown\"\n        >\n          {{ preset }}\n        </button>\n      </div>\n    </div>\n\n    <div\n      class=\"flex flex-col rounded-[1.25rem] border border-border bg-muted/50 px-3 dark:border-white/5 dark:bg-[#161617] dark:shadow-[inset_0_1px_3px_rgb(0_0_0/0.5)]\"\n    >\n      <div class=\"flex items-center gap-3 py-3.5\">\n        <div class=\"min-w-0 flex-1\">\n          <p class=\"text-[15px]/tight font-medium\">{{ props.stormTitle }}</p>\n          <p class=\"mt-0.5 text-[13px]/snug text-muted-foreground\">\n            {{ props.stormDescription }}\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          role=\"switch\"\n          :aria-checked=\"stormWatch\"\n          :aria-label=\"props.stormTitle\"\n          :class=\"[\n            'relative h-6 w-10.5 shrink-0 rounded-full transition-[background-color,box-shadow] duration-300',\n            focusRing,\n            stormWatch\n              ? 'bg-(--br-accent) shadow-[0_0_10px_-2px_var(--br-accent),inset_0_1px_2px_rgb(0_0_0/0.2)]'\n              : 'bg-black/15 shadow-[inset_0_1px_2px_rgb(0_0_0/0.2)] dark:bg-black/60 dark:shadow-[inset_0_1px_3px_rgb(0_0_0/0.8)]',\n          ]\"\n          @click=\"toggleStorm\"\n        >\n          <span\n            class=\"absolute top-0.5 left-0.5 size-5 rounded-full bg-linear-to-b from-white to-zinc-200 shadow-[0_1px_3px_rgb(0_0_0/0.4)] transition-transform duration-300 ease-[cubic-bezier(0.34,1.4,0.64,1)] motion-reduce:transition-none\"\n            :class=\"stormWatch ? 'translate-x-4.5' : 'translate-x-0'\"\n          />\n        </button>\n      </div>\n      <div\n        class=\"flex items-center gap-3 border-t border-border py-3.5 dark:border-white/6\"\n      >\n        <div class=\"min-w-0 flex-1\">\n          <p class=\"text-[15px]/tight font-medium\">{{ props.gridTitle }}</p>\n          <p class=\"mt-0.5 text-[13px]/snug text-muted-foreground\">\n            {{ props.gridDescription }}\n          </p>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\">\n          <button\n            type=\"button\"\n            :aria-label=\"`Decrease ${props.gridTitle.toLowerCase()} rate`\"\n            :disabled=\"gridRate <= props.gridRateMin\"\n            :class=\"[\n              'flex size-8 shrink-0 items-center justify-center rounded-full text-foreground transition-[scale,opacity] active:scale-90 disabled:opacity-40',\n              focusRing,\n              raised,\n            ]\"\n            @click=\"decreaseRate\"\n          >\n            <Icon name=\"lucide:minus\" class=\"size-4\" />\n          </button>\n          <div\n            role=\"spinbutton\"\n            tabindex=\"0\"\n            :aria-label=\"props.gridTitle\"\n            :aria-valuenow=\"gridRate\"\n            :aria-valuemin=\"props.gridRateMin\"\n            :aria-valuemax=\"props.gridRateMax\"\n            :aria-valuetext=\"`${gridRate.toFixed(1)} kW`\"\n            :class=\"[\n              'flex h-8 w-17 items-center justify-center gap-1.5 rounded-xl border border-black/40 bg-[#0d0d0d] shadow-[inset_0_1px_4px_rgb(0_0_0/0.8)] dark:border-white/6',\n              focusRing,\n            ]\"\n            @keydown=\"onRateKeydown\"\n          >\n            <SegmentDisplay\n              :value=\"gridRate.toFixed(1)\"\n              :digits=\"2\"\n              :color=\"props.color\"\n              class=\"text-base\"\n            />\n            <span class=\"text-xs text-(--br-accent)/70\">kW</span>\n          </div>\n          <button\n            type=\"button\"\n            :aria-label=\"`Increase ${props.gridTitle.toLowerCase()} rate`\"\n            :disabled=\"gridRate >= props.gridRateMax\"\n            :class=\"[\n              'flex size-8 shrink-0 items-center justify-center rounded-full text-foreground transition-[scale,opacity] active:scale-90 disabled:opacity-40',\n              focusRing,\n              raised,\n            ]\"\n            @click=\"increaseRate\"\n          >\n            <Icon name=\"lucide:plus\" class=\"size-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"flex items-center justify-end gap-2 px-1 pb-1\">\n      <span\n        class=\"mr-auto truncate pl-1 text-sm text-muted-foreground transition-opacity duration-300\"\n        :class=\"dirty ? 'opacity-100' : 'opacity-0'\"\n        aria-live=\"polite\"\n      >\n        {{ dirty ? 'Unsaved changes' : '' }}\n      </span>\n      <button\n        type=\"button\"\n        :class=\"[\n          'h-9.5 rounded-full px-4.5 text-[15px] text-foreground transition-[scale] active:scale-95',\n          focusRing,\n          raised,\n        ]\"\n        @click=\"cancel\"\n      >\n        {{ props.cancelLabel }}\n      </button>\n      <button\n        type=\"button\"\n        :class=\"[\n          'flex h-9.5 min-w-19 items-center justify-center gap-1.5 rounded-full px-4.5 text-[15px] font-medium transition-[scale] active:scale-95',\n          'bg-foreground text-background shadow-[0_2px_6px_rgb(0_0_0/0.25)]',\n          'dark:border dark:border-white/60 dark:bg-linear-to-b dark:from-white dark:to-zinc-300 dark:text-zinc-900 dark:shadow-[inset_0_1px_0_rgb(255_255_255),0_3px_10px_rgb(0_0_0/0.5)]',\n          focusRing,\n        ]\"\n        @click=\"save\"\n      >\n        <Icon v-if=\"justSaved\" name=\"lucide:check\" class=\"size-4\" />\n        {{ justSaved ? 'Saved' : props.saveLabel }}\n      </button>\n    </div>\n  </article>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/backup-reserve/BackupReserve.vue"
    },
    {
      "path": "registry/new-york/backup-reserve/BackupReserveDisplay.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import SegmentDisplay from '../segment-display/SegmentDisplay.vue';\n  import type {\n    BackupReserveCellKind,\n    BackupReserveDisplayProps,\n  } from './types';\n\n  const props = defineProps<BackupReserveDisplayProps>();\n\n  const clamp = (v: number): number => Math.min(100, Math.max(0, v));\n  const reserveCells = computed(() =>\n    Math.round((clamp(props.reserve) / 100) * props.cells),\n  );\n  const batteryCells = computed(() =>\n    Math.round((clamp(props.battery) / 100) * props.cells),\n  );\n  const usable = computed(() =>\n    Math.max(0, Math.round(clamp(props.battery) - clamp(props.reserve))),\n  );\n\n  const cellKinds = computed<BackupReserveCellKind[]>(() =>\n    Array.from({ length: props.cells }, (_, i) => {\n      if (i < reserveCells.value) {\n        return i < batteryCells.value ? 'reserved' : 'reserved-empty';\n      }\n      return i < batteryCells.value ? 'usable' : 'free';\n    }),\n  );\n\n  function cellStyle(kind: BackupReserveCellKind): Record<string, string> {\n    const base: Record<string, string> = {};\n    if (kind === 'reserved') {\n      base.backgroundColor = props.color;\n      base.boxShadow = `0 0 6px color-mix(in oklab, ${props.color} 55%, transparent)`;\n    } else if (kind === 'reserved-empty') {\n      base.boxShadow = `inset 0 0 0 1px color-mix(in oklab, ${props.color} 55%, transparent)`;\n    } else if (kind === 'usable') {\n      base.backgroundColor = props.usableColor;\n      base.boxShadow = `0 0 6px color-mix(in oklab, ${props.usableColor} 45%, transparent)`;\n    }\n    return base;\n  }\n\n  const usableLeft = computed(() => {\n    const start = (reserveCells.value / props.cells) * 100;\n    return Math.min(62, Math.max(30, start));\n  });\n  const showFree = computed(() => props.cells - batteryCells.value >= 4);\n</script>\n\n<template>\n  <section\n    class=\"rounded-[1.25rem] border border-black/40 bg-[#0d0d0d] px-3.5 pt-3.5 pb-3 text-white shadow-[inset_0_2px_10px_rgb(0_0_0/0.8),0_1px_0_rgb(255_255_255/0.05)] dark:border-white/6\"\n    :style=\"{ '--br-accent': props.color, '--br-usable': props.usableColor }\"\n    aria-label=\"Reserve\"\n  >\n    <div\n      class=\"flex items-baseline justify-between text-sm tracking-wider text-(--br-accent)/65\"\n    >\n      <span class=\"uppercase\">Reserve</span>\n      <span class=\"tracking-normal tabular-nums\">\n        ≈ {{ props.hours }} h of essentials\n      </span>\n    </div>\n    <div class=\"mt-2 flex items-end justify-between gap-3\">\n      <div class=\"flex items-end gap-2\">\n        <SegmentDisplay\n          :value=\"String(Math.round(props.reserve))\"\n          :digits=\"2\"\n          :color=\"props.color\"\n          :label=\"`Reserve ${Math.round(props.reserve)} %`\"\n          class=\"text-6xl\"\n        />\n        <span class=\"pb-1 text-base text-(--br-accent)/80\">%</span>\n      </div>\n      <div class=\"flex flex-col items-end gap-2 pb-0.5\">\n        <span class=\"text-sm tracking-wider text-(--br-accent)/65 uppercase\">\n          Battery now\n        </span>\n        <span class=\"flex items-end gap-1.5\">\n          <SegmentDisplay\n            :value=\"String(Math.round(props.battery))\"\n            :digits=\"2\"\n            :color=\"props.usableColor\"\n            :label=\"`Battery ${Math.round(props.battery)} %`\"\n            class=\"text-3xl\"\n          />\n          <span class=\"text-base/none text-(--br-usable)/75\">%</span>\n        </span>\n      </div>\n    </div>\n\n    <div class=\"mt-3 flex gap-1\" aria-hidden=\"true\">\n      <span\n        v-for=\"(kind, i) in cellKinds\"\n        :key=\"i\"\n        class=\"h-3.5 flex-1 rounded-[3px] bg-white/7 transition-[background-color,box-shadow] duration-200\"\n        :class=\"\n          props.charging && i === batteryCells - 1 && kind !== 'free'\n            ? 'animate-[backup-reserve-blink_1.4s_ease-in-out_infinite] motion-reduce:animate-none'\n            : ''\n        \"\n        :style=\"cellStyle(kind)\"\n      />\n    </div>\n    <div\n      class=\"relative mt-2 h-5 text-sm tracking-wider whitespace-nowrap uppercase\"\n      aria-hidden=\"true\"\n    >\n      <span class=\"absolute left-0 text-(--br-accent)/65\">Reserved</span>\n      <span\n        v-if=\"usable > 0\"\n        class=\"absolute text-(--br-usable)/65 transition-[left] duration-200 motion-reduce:transition-none\"\n        :style=\"{ left: `${usableLeft}%` }\"\n      >\n        Usable {{ usable }} %\n      </span>\n      <span v-if=\"showFree\" class=\"absolute right-0 text-(--br-accent)/40\">\n        Free\n      </span>\n    </div>\n  </section>\n</template>\n\n<style>\n  @keyframes backup-reserve-blink {\n    0%,\n    100% {\n      opacity: 1;\n    }\n    50% {\n      opacity: 0.25;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/backup-reserve/BackupReserveDisplay.vue"
    },
    {
      "path": "registry/new-york/backup-reserve/BackupReserveSlider.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref } from 'vue';\n  import type { BackupReserveSliderProps } from './types';\n\n  const props = defineProps<BackupReserveSliderProps>();\n  const model = defineModel<number>({ required: true });\n\n  const track = ref<HTMLElement | null>(null);\n  const thumb = ref<HTMLButtonElement | null>(null);\n  const dragging = ref(false);\n\n  const span = computed(() => Math.max(1, props.max - props.min));\n  const percent = computed(\n    () =>\n      ((Math.min(props.max, Math.max(props.min, model.value)) - props.min) /\n        span.value) *\n      100,\n  );\n\n  const ticks = computed(() =>\n    Array.from({ length: 21 }, (_, i) => {\n      const at = i * 5;\n      return { at, major: at % 25 === 0 };\n    }),\n  );\n  const labels = computed(() =>\n    [0, 25, 50, 75, 100].map((at) => ({\n      at,\n      text: String(Math.round(props.min + (span.value * at) / 100)),\n    })),\n  );\n\n  function snap(v: number): number {\n    const stepped =\n      Math.round((v - props.min) / props.step) * props.step + props.min;\n    return Math.min(props.max, Math.max(props.min, Number(stepped.toFixed(4))));\n  }\n\n  function valueAt(clientX: number): number {\n    const box = track.value?.getBoundingClientRect();\n    if (!box || box.width === 0) return model.value;\n    const ratio = (clientX - box.left) / box.width;\n    return snap(props.min + ratio * span.value);\n  }\n\n  function onPointerDown(event: PointerEvent): void {\n    if (event.button !== 0) return;\n    dragging.value = true;\n    const el = event.currentTarget;\n    if (el instanceof HTMLElement) el.setPointerCapture(event.pointerId);\n    thumb.value?.focus({ preventScroll: true });\n    model.value = valueAt(event.clientX);\n  }\n\n  function onPointerMove(event: PointerEvent): void {\n    if (!dragging.value) return;\n    model.value = valueAt(event.clientX);\n  }\n\n  function onPointerUp(event: PointerEvent): void {\n    dragging.value = false;\n    const el = event.currentTarget;\n    if (el instanceof HTMLElement && el.hasPointerCapture(event.pointerId)) {\n      el.releasePointerCapture(event.pointerId);\n    }\n  }\n\n  function onKeydown(event: KeyboardEvent): void {\n    const big = props.step * 10;\n    const moves: Record<string, number> = {\n      ArrowLeft: -props.step,\n      ArrowDown: -props.step,\n      ArrowRight: props.step,\n      ArrowUp: props.step,\n      PageDown: -big,\n      PageUp: big,\n    };\n    let next: number | null = null;\n    if (event.key in moves) next = model.value + (moves[event.key] ?? 0);\n    else if (event.key === 'Home') next = props.min;\n    else if (event.key === 'End') next = props.max;\n    if (next === null) return;\n    event.preventDefault();\n    model.value = snap(next);\n  }\n</script>\n\n<template>\n  <div class=\"px-1\" :style=\"{ '--br-accent': props.color }\">\n    <div\n      class=\"relative flex h-10 cursor-pointer touch-none items-center select-none\"\n      @pointerdown=\"onPointerDown\"\n      @pointermove=\"onPointerMove\"\n      @pointerup=\"onPointerUp\"\n      @pointercancel=\"onPointerUp\"\n    >\n      <div\n        ref=\"track\"\n        class=\"relative h-1.5 w-full rounded-full bg-black/10 shadow-[inset_0_1px_2px_rgb(0_0_0/0.15)] dark:bg-black dark:shadow-[inset_0_1px_2px_rgb(0_0_0/0.9),0_1px_0_rgb(255_255_255/0.05)]\"\n      >\n        <div\n          class=\"absolute inset-y-0 left-0 rounded-full bg-(--br-accent) shadow-[0_0_8px_var(--br-accent)]\"\n          :class=\"\n            dragging\n              ? ''\n              : 'transition-[width] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none'\n          \"\n          :style=\"{ width: `${percent}%` }\"\n        />\n      </div>\n      <button\n        ref=\"thumb\"\n        type=\"button\"\n        role=\"slider\"\n        :aria-label=\"props.label\"\n        :aria-valuemin=\"props.min\"\n        :aria-valuemax=\"props.max\"\n        :aria-valuenow=\"model\"\n        :aria-valuetext=\"`${model} %`\"\n        class=\"absolute top-1/2 flex h-9 w-7 -translate-1/2 items-center justify-center rounded-[10px] border border-black/15 bg-linear-to-b from-white to-zinc-200 shadow-[0_2px_6px_rgb(0_0_0/0.35),inset_0_1px_0_rgb(255_255_255/0.9)] outline-none focus-visible:ring-2 focus-visible:ring-(--br-accent) focus-visible:ring-offset-2 focus-visible:ring-offset-card active:scale-95 dark:border-black/40\"\n        :class=\"\n          dragging\n            ? 'scale-95'\n            : 'transition-[left,scale] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none'\n        \"\n        :style=\"{ left: `${percent}%` }\"\n        @keydown=\"onKeydown\"\n      >\n        <span\n          class=\"h-4.5 w-0.5 rounded-full bg-zinc-800 shadow-[1px_0_0_rgb(255_255_255/0.9),-1px_0_0_rgb(0_0_0/0.15)]\"\n        />\n      </button>\n    </div>\n\n    <div class=\"relative mt-0.5 h-2.5\" aria-hidden=\"true\">\n      <span\n        v-for=\"t in ticks\"\n        :key=\"t.at\"\n        class=\"absolute top-0 w-px -translate-x-1/2 bg-foreground/25\"\n        :class=\"t.major ? 'h-2.5' : 'h-1.5'\"\n        :style=\"{ left: `${t.at}%` }\"\n      />\n    </div>\n    <div\n      class=\"relative mt-1.5 h-5 text-sm text-muted-foreground tabular-nums\"\n      aria-hidden=\"true\"\n    >\n      <span\n        v-for=\"l in labels\"\n        :key=\"l.at\"\n        class=\"absolute top-0 whitespace-nowrap\"\n        :class=\"\n          l.at === 0 ? 'left-0' : l.at === 100 ? 'right-0' : '-translate-x-1/2'\n        \"\n        :style=\"l.at > 0 && l.at < 100 ? { left: `${l.at}%` } : undefined\"\n      >\n        {{ l.at === 100 ? `${l.text} %` : l.text }}\n      </span>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/backup-reserve/BackupReserveSlider.vue"
    },
    {
      "path": "registry/new-york/backup-reserve/index.ts",
      "content": "export { default as BackupReserve } from './BackupReserve.vue';\nexport { default as BackupReserveDisplay } from './BackupReserveDisplay.vue';\nexport { default as BackupReserveSlider } from './BackupReserveSlider.vue';\nexport type {\n  BackupReserveCellKind,\n  BackupReserveDisplayProps,\n  BackupReserveProps,\n  BackupReserveSettings,\n  BackupReserveSliderProps,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/backup-reserve/index.ts"
    },
    {
      "path": "registry/new-york/backup-reserve/types.ts",
      "content": "/** Values the card saves. */\nexport interface BackupReserveSettings {\n  /** Reserve held back for outages, 0–100 %. */\n  reserve: number;\n  /** Fill the battery to 100 % before a storm alert. */\n  stormWatch: boolean;\n  /** Max charging rate from the grid, in kW. */\n  gridRate: number;\n}\n\n/** How one LCD bar segment is drawn. */\nexport type BackupReserveCellKind =\n  | 'reserved'\n  | 'reserved-empty'\n  | 'usable'\n  | 'free';\n\nexport interface BackupReserveSliderProps {\n  min: number;\n  max: number;\n  step: number;\n  color: string;\n  label: string;\n}\n\nexport interface BackupReserveDisplayProps {\n  reserve: number;\n  battery: number;\n  hours: number;\n  cells: number;\n  charging: boolean;\n  color: string;\n  usableColor: string;\n}\n\nexport interface BackupReserveProps {\n  title?: string;\n  subtitle?: string;\n  /** Text in the status pill. Hidden when empty. */\n  status?: string;\n  /** Current battery charge, 0–100 %. */\n  battery?: number;\n  /** Battery capacity in kWh. Used for the hours estimate. */\n  capacity?: number;\n  /** Load of the essential circuits in kW. Used for the hours estimate. */\n  essentialLoad?: number;\n  /** Quick-pick reserve values. */\n  presets?: number[];\n  /** Segments in the LCD bar. */\n  cells?: number;\n  /** Blink the top battery segment, as if charging. */\n  charging?: boolean;\n  gridRateMin?: number;\n  gridRateMax?: number;\n  gridRateStep?: number;\n  stormTitle?: string;\n  stormDescription?: string;\n  gridTitle?: string;\n  gridDescription?: string;\n  cancelLabel?: string;\n  saveLabel?: string;\n  /** Reserve and LCD accent colour. */\n  color?: string;\n  /** Colour of the usable part of the battery. */\n  usableColor?: string;\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/backup-reserve/types.ts"
    }
  ]
}
