{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "infinite-spiral",
  "type": "registry:ui",
  "title": "Infinite Spiral",
  "description": "An endlessly looping 3D helix of image cards that plays by itself, follows a drag or follows page scroll.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/infinite-spiral/InfiniteSpiral.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, ref } from 'vue';\n  import type { CSSProperties } from 'vue';\n  import {\n    useEventListener,\n    useIntersectionObserver,\n    usePreferredReducedMotion,\n    useRafFn,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import {\n    INFINITE_SPIRAL_NO_ITEMS,\n    clamp,\n    modulo,\n    smoothstep,\n  } from './spiral-math';\n  import type {\n    InfiniteSpiralNormalizedItem,\n    InfiniteSpiralProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<InfiniteSpiralProps>(), {\n    items: () => INFINITE_SPIRAL_NO_ITEMS,\n    speed: 0.55,\n    direction: 'up',\n    animationMode: 'auto',\n    radius: 170,\n    cardWidth: 100,\n    cardHeight: 100,\n    verticalSpacing: 60,\n    perspective: 1000,\n    cardsPerTurn: 7,\n    rotation: 0,\n    cardTilt: 0,\n    cardRadius: 10,\n    centerScale: 1.2,\n    edgeFade: 0.3,\n    edgeBlur: 6,\n    pauseOnHover: true,\n    imageFit: 'cover',\n    grayscale: 0,\n    class: '',\n  });\n\n  const rootRef = ref<HTMLDivElement | null>(null);\n  const cardEls = ref<HTMLElement[]>([]);\n  const dragging = ref(false);\n\n  const motionPref = usePreferredReducedMotion();\n  const reduced = computed(() => motionPref.value === 'reduce');\n\n  let progress = 0;\n  let targetProgress = 0;\n  let autoSpeed = 0;\n  let hovered = false;\n  let visible = true;\n  let lastPointerY = 0;\n  let dragMoved = false;\n  let lastScrollY = 0;\n  const bounds = { width: 1, height: 1 };\n\n  const normalizedItems = computed<InfiniteSpiralNormalizedItem[]>(() =>\n    props.items.map((item, index) => {\n      const alt = `Spiral image ${index + 1}`;\n      if (typeof item === 'string') {\n        return { src: item, alt, key: `${item}-${index}` };\n      }\n      return {\n        ...item,\n        alt: item.alt ?? alt,\n        key: String(item.id ?? `${item.src}-${index}`),\n      };\n    }),\n  );\n\n  const dragEnabled = computed(\n    () => props.animationMode === 'drag' || props.animationMode === 'all',\n  );\n  const scrollEnabled = computed(\n    () => props.animationMode === 'scroll' || props.animationMode === 'all',\n  );\n\n  const rootStyle = computed<CSSProperties>(() => ({\n    perspective: `${props.perspective}px`,\n    '--infinite-spiral-card-width': `${props.cardWidth}px`,\n    '--infinite-spiral-card-height': `${props.cardHeight}px`,\n    '--infinite-spiral-card-radius': `${props.cardRadius}px`,\n    cursor: dragEnabled.value\n      ? dragging.value\n        ? 'grabbing'\n        : 'grab'\n      : 'default',\n    touchAction: dragEnabled.value ? 'pan-x' : 'auto',\n    userSelect: dragEnabled.value ? 'none' : 'auto',\n  }));\n\n  const cardStyle = computed(() => ({\n    width: `${props.cardWidth}px`,\n    height: `${props.cardHeight}px`,\n    borderRadius: `${props.cardRadius}px`,\n  }));\n\n  const imageStyle = computed<CSSProperties>(() => ({\n    width: `${props.cardWidth}px`,\n    height: `${props.cardHeight}px`,\n    maxWidth: 'none',\n    maxHeight: 'none',\n    objectFit: props.imageFit,\n    filter: `grayscale(${clamp(props.grayscale, 0, 1)})`,\n  }));\n\n  function measure() {\n    const rect = rootRef.value?.getBoundingClientRect();\n    if (!rect) return;\n    bounds.width = rect.width;\n    bounds.height = rect.height;\n  }\n\n  useResizeObserver(rootRef, measure);\n\n  useIntersectionObserver(rootRef, (entries) => {\n    visible = entries[0]?.isIntersecting ?? true;\n  });\n\n  onMounted(() => {\n    lastScrollY = window.scrollY;\n    measure();\n  });\n\n  useEventListener(\n    'scroll',\n    () => {\n      const nextScrollY = window.scrollY;\n      const scrollDelta = nextScrollY - lastScrollY;\n      lastScrollY = nextScrollY;\n      if (!scrollEnabled.value || !visible || scrollDelta === 0) return;\n      const multiplier = Math.max(props.speed, 0) / 0.55;\n      targetProgress += clamp(\n        (scrollDelta * multiplier) / Math.max(props.verticalSpacing * 2, 1),\n        -1.5,\n        1.5,\n      );\n    },\n    { passive: true },\n  );\n\n  useRafFn(({ delta: ms }) => {\n    const count = normalizedItems.value.length;\n    if (count === 0) return;\n    const delta = Math.min(Math.max(ms, 0) / 1000, 0.05);\n    const autoEnabled =\n      props.animationMode === 'auto' || props.animationMode === 'all';\n    const motionPaused = dragging.value || (props.pauseOnHover && hovered);\n    const directionMultiplier = props.direction === 'down' ? -1 : 1;\n    const desiredAutoSpeed =\n      autoEnabled && visible && !reduced.value && !motionPaused\n        ? props.speed * directionMultiplier\n        : 0;\n    const speedBlend = 1 - Math.exp(-delta * 7);\n    autoSpeed += (desiredAutoSpeed - autoSpeed) * speedBlend;\n    targetProgress += autoSpeed * delta;\n\n    const followBlend = 1 - Math.exp(-delta * (dragging.value ? 22 : 11));\n    progress += (targetProgress - progress) * followBlend;\n\n    if (!visible) return;\n\n    const half = count / 2;\n    const width = Math.max(bounds.width, 1);\n    const height = Math.max(bounds.height, 1);\n    const fit = Math.min(\n      1,\n      width / (props.cardWidth * 2.8),\n      height / (props.cardHeight * 2.35),\n    );\n    const responsiveRadius =\n      Math.min(props.radius, Math.max(72, width * 0.36)) * fit;\n    const fadeStart = clamp(1 - props.edgeFade, 0, 0.98);\n    const turnSize = Math.max(props.cardsPerTurn, 1);\n\n    for (const card of cardEls.value) {\n      const index = Number(card.dataset.index);\n      const offset = modulo(index - progress + half, count) - half;\n      const edge = Math.min(Math.abs(offset) / Math.max(half, 1), 1);\n      const opacity = 1 - smoothstep(fadeStart, 1, edge);\n      const focus =\n        1 - Math.min(Math.abs(offset) / Math.max(turnSize * 0.65, 1), 1);\n      const scale = (1 + (props.centerScale - 1) * focus) * fit;\n      const angle = offset * (360 / turnSize) + props.rotation;\n      const angleRadians = (angle * Math.PI) / 180;\n      const x = Math.sin(angleRadians) * responsiveRadius;\n      const z = Math.cos(angleRadians) * responsiveRadius;\n      const depthScale = clamp(\n        props.perspective / Math.max(props.perspective - z, 1),\n        0.72,\n        1.45,\n      );\n      const visualScale = scale * depthScale;\n      const depth = (z / Math.max(responsiveRadius, 1) + 1) / 2;\n      const blur = props.edgeBlur * smoothstep(0.35, 1, edge);\n      card.style.transform = `translate(-50%, -50%) translate3d(${x}px, ${offset * props.verticalSpacing * fit}px, 0) rotateZ(${props.cardTilt}deg) scale(${visualScale})`;\n      card.style.opacity = opacity.toFixed(3);\n      card.style.filter = blur > 0.01 ? `blur(${blur.toFixed(2)}px)` : 'none';\n      card.style.zIndex = String(Math.round(depth * 100000) + index);\n      card.style.pointerEvents = opacity > 0.25 ? 'auto' : 'none';\n    }\n  });\n\n  function onMouseEnter() {\n    hovered = true;\n  }\n\n  function onMouseLeave() {\n    hovered = false;\n  }\n\n  function onPointerDown(event: PointerEvent) {\n    if (!dragEnabled.value || event.button !== 0) return;\n    const target = event.currentTarget;\n    if (!(target instanceof HTMLElement)) return;\n    dragging.value = true;\n    dragMoved = false;\n    lastPointerY = event.clientY;\n    targetProgress = progress;\n    target.setPointerCapture(event.pointerId);\n  }\n\n  function onPointerMove(event: PointerEvent) {\n    if (!dragging.value) return;\n    const pointerDelta = event.clientY - lastPointerY;\n    lastPointerY = event.clientY;\n    if (Math.abs(pointerDelta) > 0.5) dragMoved = true;\n    targetProgress -= pointerDelta / Math.max(props.verticalSpacing, 1);\n  }\n\n  function stopDragging(event: PointerEvent) {\n    if (!dragging.value) return;\n    dragging.value = false;\n    const target = event.currentTarget;\n    if (\n      target instanceof HTMLElement &&\n      target.hasPointerCapture(event.pointerId)\n    ) {\n      target.releasePointerCapture(event.pointerId);\n    }\n  }\n\n  function onClickCapture(event: MouseEvent) {\n    if (!dragMoved) return;\n    event.preventDefault();\n    event.stopPropagation();\n    dragMoved = false;\n  }\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"['infinite-spiral', props.class]\"\n    :style=\"rootStyle\"\n    @mouseenter=\"onMouseEnter\"\n    @mouseleave=\"onMouseLeave\"\n    @pointerdown=\"onPointerDown\"\n    @pointermove=\"onPointerMove\"\n    @pointerup=\"stopDragging\"\n    @pointercancel=\"stopDragging\"\n    @click.capture=\"onClickCapture\"\n  >\n    <div\n      class=\"infinite-spiral__stage\"\n      role=\"list\"\n      aria-label=\"Infinite spiral gallery\"\n    >\n      <template v-for=\"(item, index) in normalizedItems\" :key=\"item.key\">\n        <a\n          v-if=\"item.href\"\n          ref=\"cardEls\"\n          class=\"infinite-spiral__item\"\n          :style=\"cardStyle\"\n          :data-index=\"index\"\n          :href=\"item.href\"\n          :target=\"item.target\"\n          :rel=\"item.target === '_blank' ? 'noreferrer' : undefined\"\n          role=\"listitem\"\n          :aria-label=\"item.label ?? item.alt\"\n        >\n          <img\n            class=\"infinite-spiral__image\"\n            :src=\"item.src\"\n            :alt=\"item.alt\"\n            :loading=\"index < 6 ? 'eager' : 'lazy'\"\n            draggable=\"false\"\n            :style=\"imageStyle\"\n          />\n        </a>\n        <div\n          v-else\n          ref=\"cardEls\"\n          class=\"infinite-spiral__item\"\n          :style=\"cardStyle\"\n          :data-index=\"index\"\n          role=\"listitem\"\n          :aria-label=\"item.label ?? item.alt\"\n        >\n          <img\n            class=\"infinite-spiral__image\"\n            :src=\"item.src\"\n            :alt=\"item.alt\"\n            :loading=\"index < 6 ? 'eager' : 'lazy'\"\n            draggable=\"false\"\n            :style=\"imageStyle\"\n          />\n        </div>\n      </template>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .infinite-spiral {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    min-height: 320px;\n    overflow: hidden;\n    isolation: isolate;\n  }\n\n  .infinite-spiral__stage {\n    position: absolute;\n    inset: 0;\n    transform-style: preserve-3d;\n  }\n\n  .infinite-spiral__item {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    display: block;\n    width: var(--infinite-spiral-card-width);\n    height: var(--infinite-spiral-card-height);\n    overflow: hidden;\n    border: 1px solid var(--infinite-spiral-border, rgb(255 255 255 / 0.24));\n    border-radius: var(--infinite-spiral-card-radius);\n    background: var(--infinite-spiral-surface, rgb(255 255 255 / 0.08));\n    box-shadow: 0 14px 38px rgb(8 6 18 / 0.2);\n    transform: translate(-50%, -50%);\n    transform-style: preserve-3d;\n    backface-visibility: hidden;\n    will-change: transform, opacity, filter;\n    text-decoration: none;\n  }\n\n  .infinite-spiral__item:focus-visible {\n    outline: 2px solid var(--ring, currentColor);\n    outline-offset: 2px;\n  }\n\n  .infinite-spiral__image {\n    position: absolute;\n    inset: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-position: center;\n    user-select: none;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .infinite-spiral__item {\n      transition: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/infinite-spiral/InfiniteSpiral.vue"
    },
    {
      "path": "registry/new-york/infinite-spiral/index.ts",
      "content": "export { default as InfiniteSpiral } from './InfiniteSpiral.vue';\nexport type {\n  InfiniteSpiralAnimationMode,\n  InfiniteSpiralDirection,\n  InfiniteSpiralImageFit,\n  InfiniteSpiralItem,\n  InfiniteSpiralNormalizedItem,\n  InfiniteSpiralProps,\n  InfiniteSpiralTarget,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/infinite-spiral/index.ts"
    },
    {
      "path": "registry/new-york/infinite-spiral/spiral-math.ts",
      "content": "export const clamp = (value: number, min: number, max: number) =>\n  Math.min(Math.max(value, min), max);\n\nexport const modulo = (value: number, divisor: number) =>\n  ((value % divisor) + divisor) % divisor;\n\nexport const smoothstep = (min: number, max: number, value: number) => {\n  const x = clamp((value - min) / (max - min || 1), 0, 1);\n  return x * x * (3 - 2 * x);\n};\n\nexport const INFINITE_SPIRAL_NO_ITEMS: string[] = [];\n",
      "type": "registry:ui",
      "target": "components/ui/infinite-spiral/spiral-math.ts"
    },
    {
      "path": "registry/new-york/infinite-spiral/types.ts",
      "content": "import type { HTMLAttributes } from 'vue';\n\nexport type InfiniteSpiralTarget = '_blank' | '_self' | '_parent' | '_top';\n\nexport interface InfiniteSpiralItem {\n  id?: string | number;\n  /** Image URL. */\n  src: string;\n  /** Alt text. Defaults to \"Spiral image N\". */\n  alt?: string;\n  /** When set, the card is a link. */\n  href?: string;\n  /** Link target. */\n  target?: InfiniteSpiralTarget;\n  /** Accessible name of the card. Defaults to the alt text. */\n  label?: string;\n}\n\nexport type InfiniteSpiralDirection = 'up' | 'down';\n\nexport type InfiniteSpiralAnimationMode = 'auto' | 'drag' | 'scroll' | 'all';\n\nexport type InfiniteSpiralImageFit =\n  | 'cover'\n  | 'contain'\n  | 'fill'\n  | 'none'\n  | 'scale-down';\n\nexport interface InfiniteSpiralProps {\n  /** Image URLs or item objects. */\n  items?: Array<string | InfiniteSpiralItem>;\n  /** Auto-play speed in cards per second. */\n  speed?: number;\n  /** Auto-play direction. */\n  direction?: InfiniteSpiralDirection;\n  /** auto plays by itself, drag follows the pointer, scroll follows page scroll, all combines them. */\n  animationMode?: InfiniteSpiralAnimationMode;\n  /** Helix radius in pixels (shrinks on narrow containers). */\n  radius?: number;\n  /** Card width in pixels. */\n  cardWidth?: number;\n  /** Card height in pixels. */\n  cardHeight?: number;\n  /** Vertical distance between neighbouring cards in pixels. */\n  verticalSpacing?: number;\n  /** Perspective distance in pixels. */\n  perspective?: number;\n  /** Cards in one full turn of the helix. */\n  cardsPerTurn?: number;\n  /** Extra rotation of the helix in degrees. */\n  rotation?: number;\n  /** In-plane tilt of every card in degrees. */\n  cardTilt?: number;\n  /** Card corner radius in pixels. */\n  cardRadius?: number;\n  /** Scale of the card at the centre of the helix. */\n  centerScale?: number;\n  /** Fraction of the helix length that fades out at each end (0–1). */\n  edgeFade?: number;\n  /** Largest blur in pixels on cards near the ends. */\n  edgeBlur?: number;\n  /** Pause auto-play while the pointer is over the spiral. */\n  pauseOnHover?: boolean;\n  /** CSS object-fit of the images. */\n  imageFit?: InfiniteSpiralImageFit;\n  /** Grayscale amount of the images (0–1). */\n  grayscale?: number;\n  class?: HTMLAttributes['class'];\n}\n\nexport interface InfiniteSpiralNormalizedItem extends InfiniteSpiralItem {\n  alt: string;\n  key: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/infinite-spiral/types.ts"
    }
  ]
}
