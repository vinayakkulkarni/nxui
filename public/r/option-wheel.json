{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "option-wheel",
  "type": "registry:ui",
  "title": "Option Wheel",
  "description": "Curved option picker that spins with scroll, drag or arrow keys, tilting items away.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/option-wheel/OptionWheel.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    onBeforeUnmount,\n    onMounted,\n    ref,\n    useTemplateRef,\n    watch,\n  } from 'vue';\n  import { useEventListener, usePreferredReducedMotion } from '@vueuse/core';\n  import type { OptionWheelDrag, OptionWheelProps } from './types';\n\n  const props = withDefaults(defineProps<OptionWheelProps>(), {\n    items: () => [\n      'Ambient',\n      'House',\n      'Techno',\n      'Jazz',\n      'Lo-Fi',\n      'Synthwave',\n      'Trance',\n      'Funk',\n      'Disco',\n      'Hip-Hop',\n      'Chillwave',\n      'Drum & Bass',\n    ],\n    defaultSelected: 3,\n    textColor: '#a6a6a6',\n    activeColor: '#ffffff',\n    side: 'left',\n    fontSize: 3,\n    spacing: 1.4,\n    curve: 1,\n    tilt: 6,\n    blur: 2,\n    fade: 0.25,\n    minOpacity: 0.05,\n    smoothing: 200,\n    inset: 80,\n    loop: false,\n    draggable: true,\n    soundUrl: '',\n    soundVolume: 0.5,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    change: [index: number, item: string];\n  }>();\n\n  const rootRef = useTemplateRef<HTMLDivElement>('root');\n  const selectedIndex = ref(props.defaultSelected);\n  const isDragging = ref(false);\n  const ready = ref(false);\n  const remPx = ref(16);\n  const motion = usePreferredReducedMotion();\n\n  const rowH = computed(() =>\n    Math.max(props.fontSize * props.spacing * remPx.value, 1),\n  );\n\n  const rootStyle = computed(() => ({\n    '--ow-text-color': props.textColor,\n    '--ow-active-color': props.activeColor,\n    '--ow-font-size': `${props.fontSize}rem`,\n    '--ow-inset': `${props.inset}px`,\n  }));\n\n  let pos = props.defaultSelected;\n  let target = props.defaultSelected;\n  let selected = props.defaultSelected;\n  let raf = 0;\n  let last = 0;\n  let wheelTimer: ReturnType<typeof setTimeout> | undefined;\n  let drag: OptionWheelDrag | null = null;\n  let dragMoved = false;\n  let audio: HTMLAudioElement | null = null;\n  let audioUrl = '';\n  let lastTick = 0;\n\n  // One rAF loop eases the wheel position toward its target with\n  // frame-rate independent exponential smoothing, then lays every option\n  // out along the curve based on its distance from the current position.\n  function runFrame(now: number) {\n    const dt = Math.min((now - last) / 1000, 0.05);\n    last = now;\n    const tau = Math.max(props.smoothing, 1) / 1000;\n    const k = motion.value === 'reduce' ? 1 : 1 - Math.exp(-dt / tau);\n\n    let next = pos + (target - pos) * k;\n    const settled = Math.abs(target - next) < 0.001;\n    if (settled) next = target;\n    pos = next;\n\n    const root = rootRef.value;\n    const n = props.items.length;\n    const mirror = props.side === 'right' ? -1 : 1;\n    // Options sit on a circle whose radius keeps the arc length between two\n    // neighbours equal to one row height, so tilt controls the curl.\n    const tiltRad = (props.tilt * Math.PI) / 180;\n    const R = tiltRad > 0.0005 ? rowH.value / tiltRad : 0;\n    const els = root ? root.children : null;\n    for (let i = 0; i < n && els; i++) {\n      const el = els[i];\n      if (!(el instanceof HTMLElement)) continue;\n      let d = i - next;\n      if (props.loop && n > 1) {\n        d = ((d % n) + n) % n;\n        if (d > n / 2) d -= n;\n      }\n      const dist = Math.abs(d);\n      let x = 0;\n      let y = d * rowH.value;\n      let rot = 0;\n      if (R > 0) {\n        const ang = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, d * tiltRad));\n        y = R * Math.sin(ang);\n        x = -mirror * R * (1 - Math.cos(ang)) * props.curve;\n        rot = (mirror * ang * 180) / Math.PI;\n      }\n      el.style.transform = `translate(${x.toFixed(2)}px, calc(${y.toFixed(2)}px - 50%)) rotate(${rot.toFixed(3)}deg)`;\n      el.style.opacity = String(\n        Math.max(props.minOpacity, 1 - dist * props.fade),\n      );\n      el.style.filter =\n        props.blur > 0 ? `blur(${(dist * props.blur).toFixed(2)}px)` : 'none';\n      el.style.setProperty(\n        '--ow-p',\n        Math.max(0, 1 - Math.min(dist, 1)).toFixed(4),\n      );\n    }\n\n    raf = settled ? 0 : requestAnimationFrame(runFrame);\n  }\n\n  function startLoop() {\n    if (raf) cancelAnimationFrame(raf);\n    last = performance.now();\n    raf = requestAnimationFrame(runFrame);\n  }\n\n  // Optional tick on selection change, throttled so fast scrolling can't\n  // spam it, with playback failures (autoplay policies) ignored.\n  function playTick() {\n    if (!props.soundUrl) return;\n    const now = performance.now();\n    if (now - lastTick < 70) return;\n    lastTick = now;\n    if (!audio || audioUrl !== props.soundUrl) {\n      audio = new Audio(props.soundUrl);\n      audio.preload = 'auto';\n      audioUrl = props.soundUrl;\n    }\n    audio.volume = Math.min(Math.max(props.soundVolume, 0), 1);\n    audio.currentTime = 0;\n    audio.play().catch(() => {});\n  }\n\n  function applyTarget(value: number, snap: boolean) {\n    const count = props.items.length;\n    if (!count) return;\n    let v = value;\n    if (!props.loop) v = Math.min(Math.max(v, 0), Math.max(count - 1, 0));\n    if (snap) v = Math.round(v);\n    target = v;\n    const idx = ((Math.round(v) % count) + count) % count;\n    if (idx !== selected) {\n      selected = idx;\n      selectedIndex.value = idx;\n      emit('change', idx, props.items[idx] ?? '');\n      playTick();\n    }\n    startLoop();\n  }\n\n  function onWheel(event: WheelEvent) {\n    event.preventDefault();\n    const delta = event.deltaMode === 1 ? event.deltaY * 24 : event.deltaY;\n    // One step per event at most, so notchy mouse wheels move exactly one\n    // option per click while touchpads still scroll continuously.\n    const step = Math.max(-1, Math.min(1, delta / rowH.value));\n    applyTarget(target + step, false);\n    clearTimeout(wheelTimer);\n    wheelTimer = setTimeout(() => applyTarget(target, true), 140);\n  }\n  useEventListener(rootRef, 'wheel', onWheel, { passive: false });\n\n  function handlePointerDown(event: PointerEvent) {\n    if (!props.draggable) return;\n    drag = { y: event.clientY, start: target, id: event.pointerId };\n    dragMoved = false;\n    isDragging.value = true;\n  }\n\n  function handlePointerMove(event: PointerEvent) {\n    if (!drag) return;\n    const dy = event.clientY - drag.y;\n    if (!dragMoved && Math.abs(dy) > 4) {\n      dragMoved = true;\n      // Capture only once a real drag starts, so plain clicks still reach\n      // the items.\n      rootRef.value?.setPointerCapture(drag.id);\n    }\n    if (dragMoved) applyTarget(drag.start - dy / rowH.value, false);\n  }\n\n  function handlePointerEnd() {\n    if (!drag) return;\n    drag = null;\n    isDragging.value = false;\n    if (dragMoved) applyTarget(target, true);\n  }\n\n  function handleItemClick(index: number) {\n    if (dragMoved) return;\n    const count = props.items.length;\n    let d = index - (((target % count) + count) % count);\n    if (props.loop && count > 1) {\n      if (d > count / 2) d -= count;\n      else if (d < -count / 2) d += count;\n    }\n    applyTarget(target + d, true);\n  }\n\n  function handleKeyDown(event: KeyboardEvent) {\n    let delta: number | null = null;\n    if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') delta = -1;\n    else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') delta = 1;\n    if (delta === null) return;\n    event.preventDefault();\n    applyTarget(Math.round(target) + delta, true);\n  }\n\n  watch(\n    [\n      () => props.items,\n      () => props.fontSize,\n      () => props.spacing,\n      () => props.curve,\n      () => props.tilt,\n      () => props.blur,\n      () => props.fade,\n      () => props.minOpacity,\n      () => props.side,\n      () => props.loop,\n      () => props.smoothing,\n    ],\n    () => applyTarget(target, false),\n    { flush: 'post' },\n  );\n\n  onMounted(() => {\n    remPx.value =\n      Number.parseFloat(getComputedStyle(document.documentElement).fontSize) ||\n      16;\n    applyTarget(target, false);\n    ready.value = true;\n  });\n\n  onBeforeUnmount(() => {\n    if (raf) cancelAnimationFrame(raf);\n    raf = 0;\n    clearTimeout(wheelTimer);\n    audio?.pause();\n  });\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    role=\"listbox\"\n    tabindex=\"0\"\n    aria-label=\"Option wheel\"\n    :class=\"[\n      'option-wheel',\n      side === 'right' && 'option-wheel--right',\n      isDragging && 'option-wheel--dragging',\n      props.class,\n    ]\"\n    :data-ready=\"ready ? '' : undefined\"\n    :style=\"rootStyle\"\n    @pointerdown=\"handlePointerDown\"\n    @pointermove=\"handlePointerMove\"\n    @pointerup=\"handlePointerEnd\"\n    @pointercancel=\"handlePointerEnd\"\n    @keydown=\"handleKeyDown\"\n  >\n    <div\n      v-for=\"(label, index) in items\"\n      :key=\"`${label}-${index}`\"\n      role=\"option\"\n      :aria-selected=\"selectedIndex === index\"\n      :class=\"[\n        'option-wheel__item',\n        selectedIndex === index && 'option-wheel__item--selected',\n      ]\"\n      @click=\"handleItemClick(index)\"\n    >\n      {{ label }}\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .option-wheel {\n    --ow-text-color: #a6a6a6;\n    --ow-active-color: #ffffff;\n    --ow-font-size: 3rem;\n    --ow-inset: 80px;\n\n    position: relative;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    cursor: grab;\n    user-select: none;\n    touch-action: none;\n    outline: none;\n  }\n\n  .option-wheel:focus-visible {\n    box-shadow: inset 0 0 0 2px\n      color-mix(in srgb, var(--ow-active-color) 45%, transparent);\n  }\n\n  .option-wheel--dragging {\n    cursor: grabbing;\n  }\n\n  /* Each option is absolutely centred, then offset along the curve by the\n     rAF loop through transform/opacity/filter, so everything stays in step. */\n  .option-wheel__item {\n    position: absolute;\n    top: 50%;\n    left: var(--ow-inset);\n    white-space: nowrap;\n    font-size: var(--ow-font-size);\n    line-height: 1;\n    font-weight: 200;\n    transform-origin: left center;\n    cursor: pointer;\n    will-change: transform, opacity, filter;\n    /* --ow-p goes 0 -> 1 as an option approaches the middle of the wheel */\n    color: color-mix(\n      in srgb,\n      var(--ow-active-color) calc(var(--ow-p, 0) * 100%),\n      var(--ow-text-color)\n    );\n  }\n\n  .option-wheel:not([data-ready]) .option-wheel__item {\n    visibility: hidden;\n  }\n\n  .option-wheel--right .option-wheel__item {\n    left: auto;\n    right: var(--ow-inset);\n    transform-origin: right center;\n  }\n\n  .option-wheel__item--selected {\n    font-weight: 500;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/option-wheel/OptionWheel.vue"
    },
    {
      "path": "registry/new-york/option-wheel/index.ts",
      "content": "export { default as OptionWheel } from './OptionWheel.vue';\nexport type { OptionWheelProps, OptionWheelSide } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/option-wheel/index.ts"
    },
    {
      "path": "registry/new-york/option-wheel/types.ts",
      "content": "/** Edge of the container the wheel curves around. */\nexport type OptionWheelSide = 'left' | 'right';\n\n/**\n * Props for the OptionWheel registry component.\n */\nexport interface OptionWheelProps {\n  /** Labels rendered as the wheel options. */\n  items?: string[];\n  /** Index of the option selected on mount. */\n  defaultSelected?: number;\n  /** Resting color of the option labels. */\n  textColor?: string;\n  /** Color an option blends toward as it reaches the middle. */\n  activeColor?: string;\n  /** Edge of the container the wheel curves around. */\n  side?: OptionWheelSide;\n  /** Font size of the option labels in rem. */\n  fontSize?: number;\n  /** Distance between options as a multiple of the font size. */\n  spacing?: number;\n  /** Depth of the curve; 0 flattens the wheel into a straight list. */\n  curve?: number;\n  /** Angle in degrees between neighbouring options. */\n  tilt?: number;\n  /** Blur in px added per step away from the middle. */\n  blur?: number;\n  /** Opacity lost per step away from the middle. */\n  fade?: number;\n  /** Opacity floor for the furthest options. */\n  minOpacity?: number;\n  /** Easing time constant in ms. */\n  smoothing?: number;\n  /** Padding in px between the anchored edge and the options. */\n  inset?: number;\n  /** Wrap around instead of stopping at the ends. */\n  loop?: boolean;\n  /** Allow dragging the wheel with a pointer. */\n  draggable?: boolean;\n  /** URL of a short tick played when the selection changes. Empty disables it. */\n  soundUrl?: string;\n  /** Playback volume of the tick, from 0 to 1. */\n  soundVolume?: number;\n  /** Extra classes on the root. */\n  class?: string;\n}\n\n/** Active pointer drag. */\nexport interface OptionWheelDrag {\n  y: number;\n  start: number;\n  id: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/option-wheel/types.ts"
    }
  ]
}
