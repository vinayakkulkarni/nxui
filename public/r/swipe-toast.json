{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "swipe-toast",
  "type": "registry:ui",
  "title": "Swipe Toast",
  "description": "Toast that swipes down to dismiss and burns a thin fuse along its edge for the time it has left.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/swipe-toast/SwipeToast.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n  import type { CSSProperties } from 'vue';\n  import { animate, motionValue } from 'motion-v';\n  import { useEventListener, usePreferredReducedMotion } from '@vueuse/core';\n  import type {\n    SwipeToastCloseReason,\n    SwipeToastDrag,\n    SwipeToastPhase,\n    SwipeToastProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<SwipeToastProps>(), {\n    title: 'File archived',\n    description: '',\n    icon: '',\n    actionLabel: '',\n    open: true,\n    background: '#27272a',\n    color: '#f5f5f5',\n    fuseColor: '#f5a524',\n    width: 356,\n    radius: 12,\n    slideMs: 400,\n    settleBounce: 0.2,\n    swipeDistance: 40,\n    duration: 4000,\n    fuse: 'bottom',\n    pauseOnHover: true,\n    closeButton: false,\n    inline: false,\n    dismissible: true,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    action: [];\n    close: [reason: SwipeToastCloseReason];\n  }>();\n\n  const EASE_OUT: [number, number, number, number] = [0.23, 1, 0.32, 1];\n  const FLICK = 0.11;\n  const DEAD_ZONE = 3;\n  const RESIST_PX = 24;\n  const COLLAPSE_MS = 200;\n  const EXIT = 0.7;\n  const BURN: Keyframe[] = [\n    { transform: 'scaleX(1)' },\n    { transform: 'scaleX(0)' },\n  ];\n\n  const reduced = usePreferredReducedMotion();\n  const phase = ref<SwipeToastPhase>('open');\n  const instant = ref(false);\n  const mounted = ref(false);\n  const swiping = ref(false);\n  const cardRef = ref<HTMLDivElement | null>(null);\n  const fuseRef = ref<HTMLElement | null>(null);\n\n  let fuseAnim: Animation | null = null;\n  let drag: SwipeToastDrag | null = null;\n  const flags = {\n    hover: false,\n    interacting: false,\n    focus: false,\n    hidden: false,\n  };\n  let lastInput: 'pointer' | 'keyboard' = 'pointer';\n  let pendingClose: SwipeToastCloseReason | null = null;\n  let closeTimer: ReturnType<typeof setTimeout> | undefined;\n  let leaving = false;\n\n  const y = motionValue(0);\n  const fade = motionValue(1);\n  const unsubY = y.on('change', paintY);\n  const unsubFade = fade.on('change', paintFade);\n\n  function paintY(v: number) {\n    if (cardRef.value) cardRef.value.style.transform = `translateY(${v}px)`;\n  }\n  function paintFade(v: number) {\n    if (cardRef.value) cardRef.value.style.opacity = String(v);\n  }\n\n  function rubberband(over: number, dim: number, c = 0.55) {\n    return (over * dim * c) / (dim + c * Math.abs(over));\n  }\n  function velocityOf(hist: Array<[number, number]>) {\n    const first = hist[0];\n    const last = hist[hist.length - 1];\n    if (hist.length < 2 || !first || !last) return 0;\n    return performance.now() - last[0] > 100\n      ? 0\n      : (last[1] - first[1]) / Math.max(1, last[0] - first[0]);\n  }\n\n  function syncFuse() {\n    const a = fuseAnim;\n    if (!a) return;\n    if (flags.hover || flags.interacting || flags.focus || flags.hidden)\n      a.pause();\n    else if (a.playState === 'paused') a.play();\n  }\n\n  function finish(why: SwipeToastCloseReason) {\n    phase.value = 'gone';\n    leaving = false;\n    if (props.inline)\n      closeTimer = setTimeout(() => emit('close', why), COLLAPSE_MS);\n    else emit('close', why);\n  }\n\n  function close(why: SwipeToastCloseReason) {\n    if (phase.value !== 'open' || leaving) return;\n    if (drag) {\n      pendingClose = why;\n      return;\n    }\n    fuseAnim?.pause();\n    const now =\n      why === 'escape' ||\n      ((why === 'action' || why === 'close') && lastInput === 'keyboard');\n    instant.value = now;\n    phase.value = 'closing';\n    clearTimeout(closeTimer);\n    closeTimer = setTimeout(\n      () => finish(why),\n      now ? 0 : props.slideMs * EXIT + 60,\n    );\n  }\n\n  function rescue() {\n    clearTimeout(closeTimer);\n    instant.value = false;\n    y.set(0);\n    fade.set(1);\n    phase.value = 'open';\n  }\n\n  function armFuse(onCleanup?: (fn: () => void) => void) {\n    if (phase.value !== 'open' || props.duration <= 0 || !fuseRef.value) return;\n    fuseAnim?.cancel();\n    const a = fuseRef.value.animate(BURN, {\n      duration: props.duration,\n      easing: 'linear',\n      fill: 'forwards',\n    });\n    a.onfinish = () => close('timeout');\n    fuseAnim = a;\n    syncFuse();\n    onCleanup?.(() => {\n      a.onfinish = null;\n      a.pause();\n    });\n  }\n\n  watch(\n    () => props.open,\n    (open) => {\n      if (!open) close('programmatic');\n      else if (phase.value !== 'open') rescue();\n    },\n  );\n\n  watch([phase, () => props.duration], (_v, _o, onCleanup) => {\n    armFuse(onCleanup);\n  });\n\n  watch(\n    () => props.pauseOnHover,\n    (on) => {\n      if (!on) {\n        flags.hover = false;\n        syncFuse();\n      }\n    },\n  );\n\n  useEventListener(\n    () => (mounted.value ? document : null),\n    'visibilitychange',\n    () => {\n      flags.hidden = document.hidden;\n      syncFuse();\n    },\n  );\n\n  onMounted(() => {\n    paintY(y.get());\n    paintFade(fade.get());\n    requestAnimationFrame(() =>\n      requestAnimationFrame(() => {\n        mounted.value = true;\n      }),\n    );\n    armFuse();\n    if (!props.open) close('programmatic');\n  });\n\n  onBeforeUnmount(() => {\n    clearTimeout(closeTimer);\n    fuseAnim?.cancel();\n    y.stop();\n    fade.stop();\n    unsubY();\n    unsubFade();\n  });\n\n  function swipeOut(dy: number, v: number) {\n    fuseAnim?.pause();\n    leaving = true;\n    pendingClose = null;\n    if (reduced.value !== 'reduce' && cardRef.value) {\n      animate(y, dy + cardRef.value.offsetHeight, {\n        type: 'spring',\n        duration: 0.3,\n        bounce: 0,\n        velocity: v * 1000,\n      });\n    }\n    animate(fade, 0, { duration: 0.2, ease: EASE_OUT }).then(() =>\n      finish('swipe'),\n    );\n  }\n\n  function onPointerDown(e: PointerEvent) {\n    lastInput = 'pointer';\n    const target = e.target;\n    if (\n      e.button !== 0 ||\n      !props.dismissible ||\n      drag ||\n      leaving ||\n      (target instanceof Element && target.closest('button'))\n    )\n      return;\n    if (phase.value === 'closing') rescue();\n    try {\n      cardRef.value?.setPointerCapture(e.pointerId);\n    } catch {\n      // capture is best-effort\n    }\n    y.stop();\n    drag = {\n      id: e.pointerId,\n      startY: e.clientY,\n      grab: null,\n      moved: false,\n      hist: [[performance.now(), y.get()]],\n    };\n    flags.interacting = true;\n    syncFuse();\n  }\n\n  function onPointerMove(e: PointerEvent) {\n    const d = drag;\n    if (!d || d.id !== e.pointerId) return;\n    if (d.grab === null) {\n      if (Math.abs(e.clientY - d.startY) < DEAD_ZONE) return;\n      d.grab = e.clientY - y.get();\n      swiping.value = true;\n    }\n    const raw = e.clientY - d.grab;\n    const next = raw >= 0 ? raw : rubberband(raw, RESIST_PX);\n    y.set(next);\n    d.moved = true;\n    d.hist.push([performance.now(), next]);\n    if (d.hist.length > 4) d.hist.shift();\n  }\n\n  function onPointerUp(e: PointerEvent) {\n    const d = drag;\n    if (!d || d.id !== e.pointerId) return;\n    drag = null;\n    swiping.value = false;\n    try {\n      cardRef.value?.releasePointerCapture(e.pointerId);\n    } catch {\n      // release is best-effort\n    }\n    flags.interacting = false;\n    const dy = y.get();\n    const v = velocityOf(d.hist);\n    if (dy > 0 && (v > FLICK || (dy >= props.swipeDistance && v >= 0))) {\n      swipeOut(dy, v);\n      return;\n    }\n    if (d.moved) {\n      animate(\n        y,\n        0,\n        reduced.value === 'reduce'\n          ? { duration: 0.2, ease: EASE_OUT }\n          : {\n              type: 'spring',\n              duration: 0.5,\n              bounce: props.settleBounce,\n              velocity: v * 1000,\n            },\n      );\n    }\n    const queued = pendingClose;\n    pendingClose = null;\n    if (queued) close(queued);\n    else syncFuse();\n  }\n\n  function onPointerEnter(e: PointerEvent) {\n    if (props.pauseOnHover && e.pointerType === 'mouse') {\n      flags.hover = true;\n      syncFuse();\n    }\n  }\n  function onPointerLeave(e: PointerEvent) {\n    if (e.pointerType === 'mouse') {\n      flags.hover = false;\n      syncFuse();\n    }\n  }\n  function onFocus() {\n    flags.focus = true;\n    syncFuse();\n  }\n  function onBlur(e: FocusEvent) {\n    const next = e.relatedTarget;\n    if (!(next instanceof Node) || !cardRef.value?.contains(next)) {\n      flags.focus = false;\n      syncFuse();\n    }\n  }\n  function onKeyDown(e: KeyboardEvent) {\n    if (e.key === 'Enter' || e.key === ' ') lastInput = 'keyboard';\n    if (e.key === 'Escape' && props.dismissible) {\n      e.stopPropagation();\n      close('escape');\n    }\n  }\n  function onAction() {\n    emit('action');\n    close('action');\n  }\n  function onClose() {\n    close('close');\n  }\n\n  const rootStyle = computed<CSSProperties>(() => ({\n    '--st-bg': props.background,\n    '--st-ink': props.color,\n    '--st-fuse': props.fuseColor,\n    '--st-w': `${props.width}px`,\n    '--st-radius': `${props.radius}px`,\n    '--st-slide': `${props.slideMs}ms`,\n    '--st-gap': '10px',\n  }));\n</script>\n\n<template>\n  <div\n    :class=\"['swipe-toast', props.class]\"\n    :data-phase=\"phase\"\n    :data-inline=\"inline ? 'true' : 'false'\"\n    :data-fuse=\"duration > 0 ? fuse : 'none'\"\n    :data-dismissible=\"dismissible ? 'true' : 'false'\"\n    :data-instant=\"instant ? '' : undefined\"\n    :data-mounted=\"mounted ? 'true' : 'false'\"\n    :style=\"rootStyle\"\n  >\n    <div class=\"swipe-toast__gate\">\n      <div class=\"swipe-toast__lift\">\n        <div\n          ref=\"cardRef\"\n          class=\"swipe-toast__card\"\n          role=\"status\"\n          aria-live=\"polite\"\n          aria-atomic=\"true\"\n          tabindex=\"0\"\n          :data-swiping=\"swiping ? '' : undefined\"\n          @pointerdown=\"onPointerDown\"\n          @pointermove=\"onPointerMove\"\n          @pointerup=\"onPointerUp\"\n          @pointercancel=\"onPointerUp\"\n          @pointerenter=\"onPointerEnter\"\n          @pointerleave=\"onPointerLeave\"\n          @focus=\"onFocus\"\n          @blur=\"onBlur\"\n          @keydown=\"onKeyDown\"\n        >\n          <span\n            v-if=\"icon || $slots.icon\"\n            class=\"swipe-toast__icon\"\n            aria-hidden=\"true\"\n          >\n            <slot name=\"icon\">\n              <Icon :name=\"icon\" />\n            </slot>\n          </span>\n          <span class=\"swipe-toast__body\">\n            <span class=\"swipe-toast__title\">\n              <slot name=\"title\">{{ title }}</slot>\n            </span>\n            <span\n              v-if=\"description || $slots.description\"\n              class=\"swipe-toast__desc\"\n            >\n              <slot name=\"description\">{{ description }}</slot>\n            </span>\n          </span>\n          <button\n            v-if=\"actionLabel\"\n            type=\"button\"\n            class=\"swipe-toast__action\"\n            @click=\"onAction\"\n          >\n            {{ actionLabel }}\n          </button>\n          <button\n            v-if=\"closeButton\"\n            type=\"button\"\n            class=\"swipe-toast__close\"\n            aria-label=\"Close\"\n            @click=\"onClose\"\n          >\n            <Icon name=\"lucide:x\" class=\"size-3\" />\n          </button>\n          <i ref=\"fuseRef\" class=\"swipe-toast__fuse\" aria-hidden=\"true\"></i>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .swipe-toast {\n    --st-bg: #27272a;\n    --st-ink: #f5f5f5;\n    --st-fuse: #f5a524;\n    --st-fuse-h: 2px;\n    --st-w: 356px;\n    --st-radius: 12px;\n    --st-slide: 400ms;\n    --st-gap: 10px;\n    --st-offset: 32px;\n    --st-z: 999999999;\n    --st-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n\n    display: grid;\n    grid-template-rows: 1fr;\n    width: min(var(--st-w), 100%);\n    color: var(--st-ink);\n    font-family: inherit;\n    font-size: 13px;\n    line-height: 1.5;\n  }\n\n  .swipe-toast[data-inline='false'] {\n    position: fixed;\n    right: var(--st-offset);\n    bottom: calc(var(--st-offset) + env(safe-area-inset-bottom, 0px));\n    z-index: var(--st-z);\n    width: min(var(--st-w), calc(100vw - 2 * var(--st-offset)));\n  }\n\n  @media (max-width: 600px) {\n    .swipe-toast[data-inline='false'] {\n      --st-offset: 16px;\n    }\n  }\n\n  .swipe-toast[data-inline='true'] {\n    transition: grid-template-rows var(--st-slide) var(--st-ease-out);\n  }\n\n  .swipe-toast[data-inline='true'][data-mounted='false'] {\n    grid-template-rows: 0fr;\n  }\n\n  .swipe-toast[data-inline='true'][data-phase='closing'],\n  .swipe-toast[data-inline='true'][data-phase='gone'] {\n    grid-template-rows: 0fr;\n  }\n\n  .swipe-toast[data-inline='true'][data-phase='closing'] {\n    transition-duration: calc(var(--st-slide) * 0.7);\n  }\n\n  .swipe-toast[data-inline='true'][data-phase='gone'] {\n    transition-duration: 200ms;\n  }\n\n  .swipe-toast__gate {\n    min-height: 0;\n  }\n\n  .swipe-toast[data-inline='true'] .swipe-toast__lift {\n    margin-top: var(--st-gap);\n  }\n\n  .swipe-toast__lift {\n    opacity: 1;\n    transform: translateY(0);\n    transition:\n      transform var(--st-slide) var(--st-ease-out),\n      opacity calc(var(--st-slide) * 0.6) ease;\n  }\n\n  .swipe-toast[data-mounted='false'] .swipe-toast__lift {\n    opacity: 0;\n    transform: translateY(100%);\n  }\n\n  .swipe-toast[data-phase='closing'] .swipe-toast__lift {\n    opacity: 0;\n    transform: translateY(100%);\n    transition:\n      transform calc(var(--st-slide) * 0.7) var(--st-ease-out),\n      opacity calc(var(--st-slide) * 0.5) ease;\n  }\n\n  .swipe-toast[data-phase='gone'] .swipe-toast__lift {\n    opacity: 0;\n    visibility: hidden;\n    transform: translateY(100%);\n  }\n\n  .swipe-toast[data-instant] .swipe-toast__lift {\n    transition-duration: 0s;\n  }\n\n  .swipe-toast__card {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 16px;\n    border-radius: var(--st-radius);\n    overflow: hidden;\n    background: var(--st-bg);\n    box-shadow:\n      0 1px 2px rgba(0, 0, 0, 0.05),\n      0 4px 12px rgba(0, 0, 0, 0.1);\n    cursor: grab;\n    outline: none;\n    touch-action: none;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .swipe-toast__card:focus-visible {\n    box-shadow:\n      0 0 0 2px color-mix(in srgb, var(--st-ink) 45%, transparent),\n      0 4px 12px rgba(0, 0, 0, 0.1);\n  }\n\n  .swipe-toast__card[data-swiping] {\n    cursor: grabbing;\n  }\n\n  .swipe-toast[data-dismissible='false'] .swipe-toast__card {\n    cursor: default;\n    touch-action: auto;\n  }\n\n  .swipe-toast__icon {\n    display: inline-flex;\n    flex: none;\n    width: 18px;\n    height: 18px;\n  }\n\n  .swipe-toast__icon :deep(svg) {\n    width: 100%;\n    height: 100%;\n  }\n\n  .swipe-toast__body {\n    display: flex;\n    flex: 1 1 auto;\n    flex-direction: column;\n    gap: 1px;\n    min-width: 0;\n  }\n\n  .swipe-toast__title {\n    font-weight: 500;\n    line-height: 1.5;\n  }\n\n  .swipe-toast__desc {\n    color: color-mix(in srgb, var(--st-ink) 66%, transparent);\n    font-weight: 400;\n    line-height: 1.4;\n  }\n\n  .swipe-toast__action,\n  .swipe-toast__close {\n    flex: none;\n    border: 0;\n    font: inherit;\n    cursor: pointer;\n    outline: none;\n    touch-action: manipulation;\n    -webkit-tap-highlight-color: transparent;\n    transition:\n      transform 160ms var(--st-ease-out),\n      background-color 160ms ease,\n      opacity 160ms ease;\n  }\n\n  .swipe-toast__action:focus-visible,\n  .swipe-toast__close:focus-visible {\n    box-shadow: 0 0 0 2px var(--st-fuse);\n  }\n\n  .swipe-toast__action {\n    height: 24px;\n    padding: 0 8px;\n    border-radius: 5px;\n    background: var(--st-ink);\n    color: var(--st-bg);\n    font-size: 12px;\n    font-weight: 500;\n  }\n\n  .swipe-toast__close {\n    position: relative;\n    display: grid;\n    place-items: center;\n    width: 24px;\n    height: 24px;\n    border-radius: 5px;\n    background: transparent;\n    color: inherit;\n  }\n\n  .swipe-toast__close::before {\n    content: '';\n    position: absolute;\n    inset: -8px;\n  }\n\n  .swipe-toast__action:active,\n  .swipe-toast__close:active {\n    transform: scale(0.97);\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .swipe-toast__action:hover {\n      opacity: 0.88;\n    }\n\n    .swipe-toast__close:hover {\n      background: color-mix(in srgb, var(--st-ink) 10%, transparent);\n    }\n  }\n\n  .swipe-toast__fuse {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    height: var(--st-fuse-h);\n    background: linear-gradient(\n      90deg,\n      transparent 0%,\n      color-mix(in srgb, var(--st-fuse) 18%, transparent) 9%,\n      color-mix(in srgb, var(--st-fuse) 50%, transparent) 18%,\n      color-mix(in srgb, var(--st-fuse) 84%, transparent) 28%,\n      var(--st-fuse) 38%,\n      var(--st-fuse) 62%,\n      color-mix(in srgb, var(--st-fuse) 84%, transparent) 72%,\n      color-mix(in srgb, var(--st-fuse) 50%, transparent) 82%,\n      color-mix(in srgb, var(--st-fuse) 18%, transparent) 91%,\n      transparent 100%\n    );\n    transform-origin: left center;\n    pointer-events: none;\n  }\n\n  .swipe-toast[data-fuse='top'] .swipe-toast__fuse {\n    top: 0;\n    bottom: auto;\n  }\n\n  .swipe-toast[data-fuse='none'] .swipe-toast__fuse {\n    opacity: 0;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .swipe-toast__lift {\n      transform: none !important;\n      transition: opacity 200ms ease;\n    }\n\n    .swipe-toast__action:active,\n    .swipe-toast__close:active {\n      transform: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/swipe-toast/SwipeToast.vue"
    },
    {
      "path": "registry/new-york/swipe-toast/index.ts",
      "content": "export { default as SwipeToast } from './SwipeToast.vue';\nexport type {\n  SwipeToastProps,\n  SwipeToastFuse,\n  SwipeToastCloseReason,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/swipe-toast/index.ts"
    },
    {
      "path": "registry/new-york/swipe-toast/types.ts",
      "content": "export type SwipeToastFuse = 'bottom' | 'top' | 'none';\n\nexport type SwipeToastCloseReason =\n  | 'timeout'\n  | 'swipe'\n  | 'action'\n  | 'close'\n  | 'escape'\n  | 'programmatic';\n\nexport type SwipeToastPhase = 'open' | 'closing' | 'gone';\n\nexport interface SwipeToastProps {\n  /** The first line. */\n  title?: string;\n  /** The dimmer second line. Empty hides it. */\n  description?: string;\n  /** Iconify name of an 18px icon before the text (or use the `icon` slot). */\n  icon?: string;\n  /** The inverted button label. Empty hides it. */\n  actionLabel?: string;\n  /** Flip to false to close from outside. True again re-enters. */\n  open?: boolean;\n  /** The card surface, and the action text. */\n  background?: string;\n  /** Ink: title, description and the action fill. */\n  color?: string;\n  /** The burning line. */\n  fuseColor?: string;\n  /** Card width in pixels, capped at the parent when inline. */\n  width?: number;\n  /** Corner radius in pixels. */\n  radius?: number;\n  /** How long the rise and the drop take, in ms. */\n  slideMs?: number;\n  /** Overshoot of the return after an abandoned swipe. 0 stops dead. */\n  settleBounce?: number;\n  /** How far a slow drag must go before release dismisses. */\n  swipeDistance?: number;\n  /** Milliseconds until it closes itself. 0 keeps it until dismissed. */\n  duration?: number;\n  /** Which edge the line burns along. */\n  fuse?: SwipeToastFuse;\n  /** Hovering freezes the line and the timer. */\n  pauseOnHover?: boolean;\n  /** Adds a cross at the end of the row. */\n  closeButton?: boolean;\n  /** In flow inside the parent instead of fixed to the viewport corner. */\n  inline?: boolean;\n  /** Off removes the swipe and Escape. */\n  dismissible?: boolean;\n  class?: string;\n}\n\nexport interface SwipeToastDrag {\n  id: number;\n  startY: number;\n  grab: number | null;\n  moved: boolean;\n  hist: Array<[number, number]>;\n}\n\nexport interface SwipeToastDemoItem {\n  id: number;\n  open: boolean;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/swipe-toast/types.ts"
    }
  ]
}
