{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "timezone-companion",
  "type": "registry:ui",
  "title": "Timezone Companion",
  "description": "Two timezone tools in one: a meeting-overlap finder with a find-best-time scrubber, and a live world clock with day-phase badges.",
  "dependencies": ["motion-v"],
  "files": [
    {
      "path": "registry/new-york/timezone-companion/TimezoneCompanion.vue",
      "content": "<script setup lang=\"ts\">\n  import { ref, computed, watch, onMounted, onBeforeUnmount } from 'vue';\n  import { motion } from 'motion-v';\n  import type { TimezoneCity, TimezoneMode } from './types';\n  import { cn } from '~/lib/utils';\n\n  const props = withDefaults(\n    defineProps<{\n      mode?: TimezoneMode;\n      cities?: TimezoneCity[];\n      class?: string;\n    }>(),\n    {\n      mode: 'meeting',\n      cities: () => [\n        {\n          name: 'San Francisco',\n          tz: 'America/Los_Angeles',\n          offset: -7,\n          workStart: 9,\n          workEnd: 17,\n        },\n        {\n          name: 'New York',\n          tz: 'America/New_York',\n          offset: -4,\n          workStart: 9,\n          workEnd: 17,\n        },\n        {\n          name: 'São Paulo',\n          tz: 'America/Sao_Paulo',\n          offset: -3,\n          workStart: 8,\n          workEnd: 18,\n        },\n        {\n          name: 'London',\n          tz: 'Europe/London',\n          offset: 1,\n          workStart: 9,\n          workEnd: 17,\n        },\n      ],\n      class: '',\n    },\n  );\n\n  const mode = ref<TimezoneMode>(props.mode);\n  const utcHours = ref(12); // 0..23, UTC-based hour being explored\n  const now = ref(new Date());\n\n  const localHour = computed(\n    () => (utcHours.value + 24) % 24,\n  );\n\n  function cityLocalHour(city: TimezoneCity): number {\n    return (utcHours.value + city.offset + 24) % 24;\n  }\n\n  function inWorkingHours(city: TimezoneCity): boolean {\n    const h = cityLocalHour(city);\n    return h >= city.workStart && h < city.workEnd;\n  }\n\n  const inWorkingCount = computed(\n    () => props.cities.filter(inWorkingHours).length,\n  );\n\n  const bestHour = computed(() => {\n    let best = -1;\n    let bestCount = -1;\n    for (let h = 0; h < 24; h++) {\n      const count = props.cities.filter((c) => {\n        const ch = (h + c.offset + 24) % 24;\n        return ch >= c.workStart && ch < c.workEnd;\n      }).length;\n      if (count > bestCount) {\n        bestCount = count;\n        best = h;\n      }\n    }\n    return best;\n  });\n\n  /** 0..1 progress of a city's hour through its working window. */\n  function workProgress(city: TimezoneCity): number {\n    const h = cityLocalHour(city);\n    if (h < city.workStart || h >= city.workEnd) return 0;\n    return (h - city.workStart) / (city.workEnd - city.workStart);\n  }\n\n  function findBestTime() {\n    const target = bestHour.value;\n    if (target < 0) return;\n    const start = utcHours.value;\n    const delta = ((target - start + 24) % 24);\n    const steps = delta;\n    let s = 0;\n    const tick = () => {\n      utcHours.value = (start + s + 24) % 24;\n      s++;\n      if (s <= steps) requestAnimationFrame(tick);\n    };\n    tick();\n  }\n\n  const clockTick = computed(() => {\n    const d = now.value;\n    const hh = String(d.getUTCHours()).padStart(2, '0');\n    const mm = String(d.getUTCMinutes()).padStart(2, '0');\n    return { hh, mm };\n  });\n\n  function clockTime(city: TimezoneCity): { hh: string; mm: string; phase: string } {\n    const d = new Date(\n      now.value.getTime() + city.offset * 3600_000,\n    );\n    const h = d.getUTCHours();\n    const phase =\n      h >= 5 && h < 9\n        ? 'BEFORE WORK'\n        : h >= 9 && h < 17\n          ? 'WORKING'\n          : h >= 17 && h < 22\n            ? 'WRAPPING UP'\n            : 'NIGHT';\n    return {\n      hh: String(d.getUTCHours()).padStart(2, '0'),\n      mm: String(d.getUTCMinutes()).padStart(2, '0'),\n      phase,\n    };\n  }\n\n  const offsetLabel: Record<string, string> = {\n    'America/Los_Angeles': 'PDT',\n    'America/New_York': 'EDT',\n    'America/Sao_Paulo': 'UTC-3',\n    'Europe/London': 'BST',\n  };\n\n  const phaseColor: Record<string, string> = {\n    NIGHT: 'bg-indigo-500/12 text-indigo-400 dark:text-indigo-300',\n    'BEFORE WORK': 'bg-amber-500/12 text-amber-600 dark:text-amber-300',\n    WORKING: 'bg-emerald-500/12 text-emerald-600 dark:text-emerald-300',\n    'WRAPPING UP': 'bg-orange-500/12 text-orange-600 dark:text-orange-300',\n  };\n\n  let clockTimer = 0;\n  watch(\n    () => props.mode,\n    (m) => (mode.value = m),\n  );\n  onMounted(() => {\n    clockTimer = window.setInterval(() => {\n      now.value = new Date();\n    }, 30_000);\n  });\n  onBeforeUnmount(() => window.clearInterval(clockTimer));\n</script>\n\n<template>\n  <div\n    :class=\"\n      cn(\n        'w-full max-w-md rounded-3xl border border-border/60 bg-card p-5 shadow-xl shadow-black/5 dark:border-white/6',\n        props.class,\n      )\n    \"\n  >\n    <!-- header -->\n    <div class=\"flex items-center justify-between\">\n      <p class=\"text-sm font-medium\">\n        {{ mode === 'meeting' ? 'Meeting Finder' : 'World Clock' }}\n      </p>\n      <div class=\"flex items-center gap-0.5 rounded-full border border-border/60 p-0.5 text-xs\">\n        <button\n          type=\"button\"\n          :class=\"\n            cn(\n              'rounded-full px-2.5 py-1 transition-colors',\n              mode === 'meeting' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground',\n            )\n          \"\n          @click=\"mode = 'meeting'\"\n        >\n          Meeting\n        </button>\n        <button\n          type=\"button\"\n          :class=\"\n            cn(\n              'rounded-full px-2.5 py-1 transition-colors',\n              mode === 'clock' ? 'bg-primary text-primary-foreground' : 'text-muted-foreground',\n            )\n          \"\n          @click=\"mode = 'clock'\"\n        >\n          Clock\n        </button>\n      </div>\n    </div>\n\n    <!-- MEETING MODE -->\n    <template v-if=\"mode === 'meeting'\">\n      <div class=\"mt-5 flex items-center justify-between\">\n        <p class=\"text-xs text-muted-foreground\">\n          {{ inWorkingCount }} of {{ cities.length }} in working hours\n        </p>\n        <p class=\"text-xs tabular-nums text-muted-foreground\">\n          {{ String(localHour).padStart(2, '0') }}:00 UTC\n        </p>\n      </div>\n\n      <!-- hour timeline -->\n      <div class=\"mt-4\">\n        <div class=\"relative h-9\">\n          <div class=\"absolute inset-0 rounded-xl bg-primary/6 dark:bg-white/6\"></div>\n          <motion.div\n            class=\"absolute top-0 h-full rounded-xl bg-primary/15 dark:bg-white/12\"\n            :style=\"{ left: `${(localHour / 24) * 100}%`, width: `${100 / 24}%` }\"\n            :transition=\"{ type: 'spring', stiffness: 200, damping: 28 }\"\n          ></motion.div>\n          <Icon name=\"lucide:grip-vertical\" class=\"absolute top-1/2 size-3 -translate-y-1/2 text-muted-foreground\" :style=\"{ left: `calc(${(localHour / 24) * 100}% - 6px)` }\" />\n        </div>\n        <input\n          type=\"range\"\n          min=\"0\"\n          max=\"23\"\n          step=\"1\"\n          :value=\"utcHours\"\n          class=\"mt-2 w-full accent-primary\"\n          aria-label=\"Explore hour\"\n          @input=\"utcHours = Number(($event.target as HTMLInputElement).value)\"\n        />\n      </div>\n\n      <!-- city rows -->\n      <div class=\"mt-4 space-y-2\">\n        <div\n          v-for=\"city in cities\"\n          :key=\"city.name\"\n          :class=\"\n            cn(\n              'flex items-center justify-between rounded-xl px-3 py-2.5 text-sm transition-colors',\n              inWorkingHours(city) ? 'bg-primary/6 dark:bg-white/6' : 'opacity-60',\n            )\n          \"\n        >\n          <span class=\"font-medium\">{{ city.name }}</span>\n          <span class=\"flex items-center gap-2\">\n            <span\n              :class=\"\n                cn(\n                  'size-1.5 rounded-full',\n                  inWorkingHours(city) ? 'bg-emerald-500' : 'bg-muted-foreground/40',\n                )\n              \"\n            ></span>\n            <span class=\"tabular-nums text-muted-foreground\">\n              {{ String(cityLocalHour(city)).padStart(2, '0') }}:00\n            </span>\n          </span>\n        </div>\n      </div>\n\n      <button\n        type=\"button\"\n        class=\"mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-3 py-2.5 text-sm font-medium text-primary-foreground transition-transform hover:scale-[1.01] active:scale-[0.99]\"\n        @click=\"findBestTime\"\n      >\n        Find best time\n        <Icon name=\"lucide:sparkles\" class=\"size-3.5\" />\n      </button>\n    </template>\n\n    <!-- CLOCK MODE -->\n    <template v-else>\n      <p class=\"mt-2 text-xs tabular-nums text-muted-foreground\">\n        {{ clockTick.hh }}:{{ clockTick.mm }} UTC · live\n      </p>\n      <div class=\"mt-4 space-y-2\">\n        <component\n          :is=\"motion.div\"\n          v-for=\"city in cities\"\n          :key=\"city.name\"\n          :initial=\"{ opacity: 0, y: 10 }\"\n          :animate=\"{ opacity: 1, y: 0 }\"\n          :transition=\"{ delay: cities.indexOf(city) * 0.06, type: 'spring', stiffness: 260, damping: 26 }\"\n          class=\"flex items-center justify-between rounded-xl border border-border/50 px-3 py-3 dark:border-white/6\"\n        >\n          <div>\n            <p class=\"text-sm font-medium\">{{ city.name }}</p>\n            <p class=\"text-xs text-muted-foreground\">\n              {{ offsetLabel[city.tz] ?? `UTC${city.offset >= 0 ? '+' : ''}${city.offset}` }}\n            </p>\n          </div>\n          <div class=\"text-right\">\n            <p class=\"text-lg font-bold tabular-nums tracking-tight\">\n              {{ clockTime(city).hh }}:{{ clockTime(city).mm }}\n            </p>\n            <span\n              :class=\"\n                cn(\n                  'mt-0.5 inline-block rounded-full px-2 py-0.5 text-[10px] font-medium tracking-wide',\n                  phaseColor[clockTime(city).phase] ?? '',\n                )\n              \"\n            >\n              {{ clockTime(city).phase }}\n            </span>\n          </div>\n        </component>\n      </div>\n    </template>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/timezone-companion/TimezoneCompanion.vue"
    },
    {
      "path": "registry/new-york/timezone-companion/index.ts",
      "content": "export { default as TimezoneCompanion } from './TimezoneCompanion.vue';\nexport type {\n  TimezoneCompanionProps,\n  TimezoneCity,\n  TimezoneMode,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/timezone-companion/index.ts"
    },
    {
      "path": "registry/new-york/timezone-companion/types.ts",
      "content": "export type TimezoneMode = 'meeting' | 'clock';\n\nexport interface TimezoneCity {\n  /** City label. */\n  name: string;\n  /** IANA timezone, e.g. 'America/Los_Angeles'. */\n  tz: string;\n  /** UTC offset hours, e.g. -7. */\n  offset: number;\n  /** Working-hours window in local 24h time, e.g. [9, 17]. */\n  workStart: number;\n  workEnd: number;\n}\n\nexport interface TimezoneCompanionProps {\n  /** View mode: meeting overlap finder or world clock. */\n  mode?: TimezoneMode;\n  cities?: TimezoneCity[];\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/timezone-companion/types.ts"
    }
  ]
}
