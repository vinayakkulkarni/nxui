    {
      "path": "registry/new-york/power-monitor/power-monitor.ts",
      "content": "import type { PowerMonitorSeries } from './types';\n\n/** Small seeded PRNG so sample data is the same on the server and client. */\nfunction seeded(seed: number): () => number {\n  let a = seed >>> 0;\n  return () => {\n    a = (a + 1831565813) >>> 0;\n    let t = a;\n    t = Math.imul(t ^ (t >>> 15), t | 1);\n    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nconst round = (v: number, d = 2): number => Number(v.toFixed(d));\nconst pad = (n: number): string => String(n).padStart(2, '0');\n\n/** Clear-sky curve between sunrise and sunset, 0..1. */\nfunction sun(hour: number, rise = 6.6, set = 19.6): number {\n  if (hour <= rise || hour >= set) return 0;\n  return Math.sin((Math.PI * (hour - rise)) / (set - rise)) ** 1.25;\n}\n\n/** Typical home load for an hour of the day, in kW. */\nfunction load(hour: number): number {\n  const bump = (center: number, width: number, height: number): number =>\n    height * Math.exp(-(((hour - center) / width) ** 2));\n  return (\n    0.32 + bump(7.6, 0.9, 1.1) + bump(12.6, 1, 0.55) + bump(19.5, 1.6, 1.4)\n  );\n}\n\n/** Sample day: 20-minute columns with the cursor at 14:20. */\nexport function createPowerMonitorDaySeries(): PowerMonitorSeries {\n  const rand = seeded(15);\n  const solar: number[] = [];\n  const home: number[] = [];\n  const columnLabels: string[] = [];\n  for (let i = 0; i < 72; i++) {\n    const hour = i / 3;\n    // A cloud bank in the morning, then a clear, bright afternoon.\n    const cloud = hour > 9.4 && hour < 10.4 ? 0.7 : 1;\n    const skew = hour < 14.3 ? 0.62 + 0.38 * ((hour - 6.6) / 7.7) : 1;\n    solar.push(round(5.4 * sun(hour) * cloud * skew * (0.94 + rand() * 0.1)));\n    home.push(round(load(hour) * (0.85 + rand() * 0.3)));\n    columnLabels.push(`${pad(Math.floor(hour))}:${pad((i % 3) * 20)}`);\n  }\n  return {\n    range: 'day',\n    label: 'Day',\n    date: 'Oct 15',\n    unit: 'kW',\n    solar,\n    home,\n    columnLabels,\n    ticks: [0, 6, 12, 18, 24].map((h) => ({ at: h / 24, label: pad(h) })),\n    now: 43,\n    summary: [\n      { label: 'Solar so far', value: '29.8 kWh', color: '' },\n      { label: 'Home use', value: '11.8 kWh', color: '' },\n      { label: 'Forecast to sunset', value: '+13.7 kWh', color: '', dim: true },\n    ],\n  };\n}\n\nfunction weekSeries(): PowerMonitorSeries {\n  const rand = seeded(7);\n  const days = ['Fri', 'Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu'];\n  const sky = [0.72, 0.95, 0.9, 0.55, 0.82, 0.88, 1];\n  const solar: number[] = [];\n  const home: number[] = [];\n  const columnLabels: string[] = [];\n  days.forEach((day, d) => {\n    for (let b = 0; b < 8; b++) {\n      const hour = b * 3 + 1.5;\n      solar.push(round(4.8 * sun(hour) * (sky[d] ?? 1) * (0.9 + rand() * 0.2)));\n      home.push(round(load(hour) * (0.85 + rand() * 0.3)));\n      columnLabels.push(`${day} ${pad(b * 3)}:00`);\n    }\n  });\n  return {\n    range: 'week',\n    label: 'Week',\n    date: 'Oct 9 – 15',\n    unit: 'kW',\n    solar,\n    home,\n    columnLabels,\n    ticks: days.map((day, d) => ({ at: (d + 0.5) / 7, label: day.charAt(0) })),\n    now: 52,\n    summary: [\n      { label: 'Solar this week', value: '214 kWh', color: '' },\n      { label: 'Home use', value: '86.4 kWh', color: '' },\n      { label: 'Forecast to sunset', value: '+13.7 kWh', color: '', dim: true },\n    ],\n  };\n}\n\nfunction monthSeries(): PowerMonitorSeries {\n  const rand = seeded(10);\n  const solar: number[] = [];\n  const home: number[] = [];\n  const columnLabels: string[] = [];\n  for (let day = 1; day <= 30; day++) {\n    const cloudy = rand() < 0.22;\n    const value = (cloudy ? 14 : 30) + rand() * 12;\n    const use = 10 + rand() * 6;\n    for (let half = 0; half < 2; half++) {\n      solar.push(round(value * (0.96 + half * 0.04), 1));\n      home.push(round(use, 1));\n      columnLabels.push(`Oct ${day}`);\n    }\n  }\n  return {\n    range: 'month',\n    label: 'Month',\n    date: 'October',\n    unit: 'kWh',\n    solar,\n    home,\n    columnLabels,\n    ticks: [1, 8, 15, 22, 30].map((d) => ({\n      at: (d - 0.5) / 30,\n      label: String(d),\n    })),\n    now: 29,\n    summary: [\n      { label: 'Solar this month', value: '498 kWh', color: '' },\n      { label: 'Home use', value: '192 kWh', color: '' },\n      {\n        label: 'Forecast to month end',\n        value: '+472 kWh',\n        color: '',\n        dim: true,\n      },\n    ],\n  };\n}\n\nfunction yearSeries(): PowerMonitorSeries {\n  const rand = seeded(26);\n  const months = 'JFMAMJJASOND'.split('');\n  const names = [\n    'Jan',\n    'Feb',\n    'Mar',\n    'Apr',\n    'May',\n    'Jun',\n    'Jul',\n    'Aug',\n    'Sep',\n    'Oct',\n    'Nov',\n    'Dec',\n  ];\n  const solar: number[] = [];\n  const home: number[] = [];\n  const columnLabels: string[] = [];\n  names.forEach((name, m) => {\n    const season = 0.45 + 0.55 * Math.sin((Math.PI * (m + 0.5)) / 12);\n    for (let b = 0; b < 5; b++) {\n      solar.push(Math.round(1050 * season * (0.92 + rand() * 0.12)));\n      home.push(Math.round(330 + (m < 2 || m > 9 ? 90 : 20) + rand() * 40));\n      columnLabels.push(name);\n    }\n  });\n  return {\n    range: 'year',\n    label: 'Year',\n    date: '2026',\n    unit: 'kWh',\n    solar,\n    home,\n    columnLabels,\n    ticks: months.map((label, m) => ({ at: (m + 0.5) / 12, label })),\n    now: 47,\n    summary: [\n      { label: 'Solar this year', value: '7.9 MWh', color: '' },\n      { label: 'Home use', value: '3.4 MWh', color: '' },\n      {\n        label: 'Forecast to year end',\n        value: '+1.1 MWh',\n        color: '',\n        dim: true,\n      },\n    ],\n  };\n}\n\n/** Sample series for every range, generated deterministically. */\nexport function createPowerMonitorSeries(): PowerMonitorSeries[] {\n  return [\n    createPowerMonitorDaySeries(),\n    weekSeries(),\n    monthSeries(),\n    yearSeries(),\n  ];\n}\n\n/** Two decimals under 10, one under 100, whole numbers above. */\nexport function formatReading(value: number): string {\n  if (value < 10) return value.toFixed(2);\n  if (value < 100) return value.toFixed(1);\n  return String(Math.round(value));\n}\n\n/**\n * Builds one SVG path out of many square cells, so the whole pixel grid\n * renders as a handful of elements.\n */\nexport function cellPath(\n  cells: ReadonlyArray<readonly [number, number]>,\n  size: number,\n): string {\n  let d = '';\n  for (const [x, y] of cells) {\n    d += `M${x.toFixed(2)} ${y.toFixed(2)}h${size}v${size}h-${size}z`;\n  }\n  return d;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/power-monitor/power-monitor.ts"
    },
    {
      "path": "registry/new-york/power-monitor/types.ts",
      "content": "/** Time span shown by the chart. */\nexport type PowerMonitorRange = 'day' | 'week' | 'month' | 'year';\n\nexport interface PowerMonitorTick {\n  /** Position along the chart, from 0 (left edge) to 1 (right edge). */\n  at: number;\n  label: string;\n}\n\nexport interface PowerMonitorSummaryRow {\n  label: string;\n  value: string;\n  /** Colour of the small LED square in front of the row. */\n  color: string;\n  /** Dim the LED, e.g. for a forecast row. */\n  dim?: boolean;\n}\n\nexport interface PowerMonitorSeries {\n  range: PowerMonitorRange;\n  /** Label in the segmented control, e.g. `Day`. */\n  label: string;\n  /** Text shown next to the segmented control, e.g. `Oct 15`. */\n  date: string;\n  /** Unit for chart values, e.g. `kW` or `kWh`. */\n  unit: string;\n  /** Solar per column. Drawn above the baseline. */\n  solar: number[];\n  /** Home use per column. Drawn below the baseline. */\n  home: number[];\n  /** Cursor label per column, e.g. `14:20`. */\n  columnLabels: string[];\n  ticks: PowerMonitorTick[];\n  /** Column index of \"now\". Later columns are drawn dimmed as a forecast. */\n  now: number;\n  summary: PowerMonitorSummaryRow[];\n}\n\nexport interface PowerMonitorCursor {\n  index: number;\n  label: string;\n  solar: number;\n  home: number;\n  forecast: boolean;\n}\n\nexport interface PowerMonitorChartProps {\n  solar: number[];\n  home: number[];\n  columnLabels: string[];\n  ticks: PowerMonitorTick[];\n  now: number;\n  /** Changes when the range changes, to replay the reveal. */\n  revealKey: string;\n  rowsUp: number;\n  rowsDown: number;\n  color: string;\n  homeColor: string;\n}\n\nexport interface PowerMonitorProps {\n  title?: string;\n  /** Replaces the automatic `Live · updated 2 s ago` line. */\n  subtitle?: string;\n  /** Text in the status pill. */\n  status?: string;\n  /** Solar production right now, in kW. */\n  solar?: number;\n  /** Peak production today, in kW. */\n  peak?: number;\n  /** Home use right now, in kW. */\n  home?: number;\n  /** Power going into the battery, in kW. */\n  toBattery?: number;\n  /** Power exported to the grid, in kW. */\n  exportPower?: number;\n  /** Let live values drift gently on their own. */\n  live?: boolean;\n  /** Milliseconds between live updates. */\n  interval?: number;\n  /** Chart data per range. Defaults to a generated sample day, week, month and year. */\n  series?: PowerMonitorSeries[];\n  /** Rows of pixels above the baseline. */\n  rowsUp?: number;\n  /** Rows of pixels below the baseline. */\n  rowsDown?: number;\n  /** Solar and LCD accent colour. */\n  color?: string;\n  homeColor?: string;\n  batteryColor?: string;\n  exportColor?: string;\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/power-monitor/types.ts"
    }
