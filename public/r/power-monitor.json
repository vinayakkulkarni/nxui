      "path": "registry/new-york/power-monitor/index.ts",
      "content": "export { default as PowerMonitor } from './PowerMonitor.vue';\nexport { default as PowerMonitorChart } from './PowerMonitorChart.vue';\nexport {\n  createPowerMonitorDaySeries,\n  createPowerMonitorSeries,\n  formatReading,\n} from './power-monitor';\nexport type {\n  PowerMonitorChartProps,\n  PowerMonitorCursor,\n  PowerMonitorProps,\n  PowerMonitorRange,\n  PowerMonitorSeries,\n  PowerMonitorSummaryRow,\n  PowerMonitorTick,\n} from './types';\n",
