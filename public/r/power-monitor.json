{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "power-monitor",
  "type": "registry:ui",
  "title": "Power Monitor",
  "description": "Live home-energy card with an LCD readout, a pixel-grid solar and home-use chart with a time cursor, and a Day, Week, Month and Year switch.",
  "dependencies": ["@vueuse/core"],
  "registryDependencies": ["https://nxui.geoql.in/r/segment-display.json"],
  "files": [
    {
      "path": "registry/new-york/power-monitor/PowerMonitor.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, nextTick, onMounted, ref, watch } from 'vue';\n  import {\n    useElementVisibility,\n    useIntervalFn,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import SegmentDisplay from '../segment-display/SegmentDisplay.vue';\n  import PowerMonitorChart from './PowerMonitorChart.vue';\n  import {\n    createPowerMonitorDaySeries,\n    createPowerMonitorSeries,\n    formatReading,\n  } from './power-monitor';\n  import type {\n    PowerMonitorCursor,\n    PowerMonitorProps,\n    PowerMonitorRange,\n    PowerMonitorSeries,\n    PowerMonitorSummaryRow,\n  } from './types';\n\n  const props = withDefaults(defineProps<PowerMonitorProps>(), {\n    title: 'Power now',\n    subtitle: undefined,\n    status: 'Live',\n    solar: 4.82,\n    peak: 5.7,\n    home: 2.14,\n    toBattery: 1.96,\n    exportPower: 0.72,\n    live: true,\n    interval: 3000,\n    series: undefined,\n    rowsUp: 11,\n    rowsDown: 8,\n    color: '#ff9a2e',\n    homeColor: '#e9e9e9',\n    batteryColor: '#4ade80',\n    exportColor: '#7ea6ff',\n    class: '',\n  });\n\n  const range = defineModel<PowerMonitorRange>('range', { default: 'day' });\n  const emit = defineEmits<{ cursor: [value: PowerMonitorCursor | null] }>();\n\n  const SAMPLE = createPowerMonitorSeries();\n  const FALLBACK = createPowerMonitorDaySeries();\n  const allSeries = computed(() => props.series ?? SAMPLE);\n  const current = computed<PowerMonitorSeries>(\n    () =>\n      allSeries.value.find((s) => s.range === range.value) ??\n      allSeries.value[0] ??\n      FALLBACK,\n  );\n\n  // Live readings drift around the props without leaving them.\n  const step = ref(0);\n  const secondsAgo = ref(2);\n  const drift = (seed: number, amount: number): number =>\n    1 +\n    amount *\n      (Math.sin(step.value * 1.7 + seed) * 0.6 +\n        Math.sin(step.value * 0.63 + seed * 2.3) * 0.4);\n\n  const liveSolar = computed(() => props.solar * drift(0.4, 0.035));\n  const liveHome = computed(() => props.home * drift(2.1, 0.05));\n  const surplus = computed(() => Math.max(0, liveSolar.value - liveHome.value));\n  const baseSurplus = computed(() =>\n    Math.max(0.001, props.toBattery + props.exportPower),\n  );\n  const liveExport = computed(\n    () => (props.exportPower / baseSurplus.value) * surplus.value,\n  );\n  const liveBattery = computed(() => surplus.value - liveExport.value);\n\n  const root = ref<HTMLElement | null>(null);\n  const visible = useElementVisibility(root);\n\n  const ticker = useIntervalFn(\n    () => {\n      step.value += 1;\n      secondsAgo.value = 0;\n    },\n    () => props.interval,\n    { immediate: false },\n  );\n  const clock = useIntervalFn(\n    () => {\n      secondsAgo.value += 1;\n    },\n    1000,\n    { immediate: false },\n  );\n\n  function syncTimers(): void {\n    if (props.live && visible.value) {\n      ticker.resume();\n      clock.resume();\n    } else {\n      ticker.pause();\n      clock.pause();\n    }\n  }\n  watch([() => props.live, visible], syncTimers);\n  onMounted(syncTimers);\n\n  const subtitleText = computed(\n    () =>\n      props.subtitle ??\n      (props.live ? `Live · updated ${secondsAgo.value} s ago` : 'Paused'),\n  );\n\n  // The day chart's \"now\" column follows the live reading.\n  const chartSolar = computed(() => {\n    const s = current.value;\n    if (s.range !== 'day') return s.solar;\n    return s.solar.map((v, i) => (i === s.now ? liveSolar.value : v));\n  });\n\n  const cursor = ref<number | null>(null);\n  watch(range, () => {\n    cursor.value = null;\n  });\n\n  const inspecting = computed(() => cursor.value !== null);\n  const bigValue = computed(() => {\n    if (cursor.value === null) return liveSolar.value;\n    return chartSolar.value[cursor.value] ?? 0;\n  });\n  const bigUnit = computed(() =>\n    cursor.value === null ? 'kW' : current.value.unit,\n  );\n  const bigLabel = computed(() => {\n    if (cursor.value === null) return 'Solar producing';\n    const label = current.value.columnLabels[cursor.value] ?? '';\n    return cursor.value > current.value.now\n      ? `Forecast · ${label}`\n      : `Solar · ${label}`;\n  });\n  const peakText = computed(() => {\n    if (current.value.range === 'day') return `Peak ${props.peak} kW`;\n    const max = Math.max(...current.value.solar);\n    return `Peak ${formatReading(max)} ${current.value.unit}`;\n  });\n\n  watch(cursor, (index) => {\n    if (index === null) {\n      emit('cursor', null);\n      return;\n    }\n    const s = current.value;\n    emit('cursor', {\n      index,\n      label: s.columnLabels[index] ?? '',\n      solar: chartSolar.value[index] ?? 0,\n      home: s.home[index] ?? 0,\n      forecast: index > s.now,\n    });\n  });\n\n  const readings = computed(() => [\n    { label: 'Home', value: liveHome.value, color: props.homeColor },\n    {\n      label: 'To battery',\n      value: liveBattery.value,\n      color: props.batteryColor,\n    },\n    { label: 'Export', value: liveExport.value, color: props.exportColor },\n  ]);\n\n  const summary = computed(() =>\n    current.value.summary.map((row: PowerMonitorSummaryRow, i: number) => ({\n      ...row,\n      color: row.color || (i === 1 ? props.homeColor : props.color),\n    })),\n  );\n\n  // Segmented control with a sliding pill.\n  const tabs = ref<HTMLButtonElement[]>([]);\n  const tabList = ref<HTMLElement | null>(null);\n  const pill = ref({ left: 0, width: 0 });\n  const activeIndex = computed(() =>\n    Math.max(\n      0,\n      allSeries.value.findIndex((s) => s.range === range.value),\n    ),\n  );\n\n  function measurePill(): void {\n    const el = tabs.value[activeIndex.value];\n    if (!el) return;\n    pill.value = { left: el.offsetLeft, width: el.offsetWidth };\n  }\n  useResizeObserver(tabList, measurePill);\n  watch(activeIndex, () => nextTick(measurePill));\n  onMounted(measurePill);\n\n  function select(value: PowerMonitorRange): void {\n    range.value = value;\n  }\n\n  function onTabKeydown(event: KeyboardEvent): void {\n    const count = allSeries.value.length;\n    let next = activeIndex.value;\n    if (event.key === 'ArrowRight') next = (next + 1) % count;\n    else if (event.key === 'ArrowLeft') next = (next - 1 + count) % count;\n    else if (event.key === 'Home') next = 0;\n    else if (event.key === 'End') next = count - 1;\n    else return;\n    event.preventDefault();\n    const target = allSeries.value[next];\n    if (!target) return;\n    range.value = target.range;\n    nextTick(() => tabs.value[next]?.focus());\n  }\n</script>\n\n<template>\n  <article\n    ref=\"root\"\n    :class=\"\n      cn(\n        'flex w-full max-w-88 flex-col gap-3.5 rounded-[1.75rem] border border-border bg-card p-3 text-card-foreground shadow-[0_24px_48px_-20px_rgb(0_0_0/0.25)] dark:border-white/8 dark:bg-[#1c1c1e] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.06),0_24px_48px_-16px_rgb(0_0_0/0.7)]',\n        props.class,\n      )\n    \"\n    :style=\"{ '--pm-accent': props.color }\"\n  >\n    <header class=\"flex items-center gap-3 px-1.5 pt-1.5\">\n      <span\n        class=\"flex size-9 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-foreground shadow-[inset_0_1px_0_rgb(255_255_255/0.6)] dark:border-white/8 dark:bg-linear-to-b dark:from-[#2e2e30] dark:to-[#1f1f21] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.08),0_2px_6px_rgb(0_0_0/0.5)]\"\n      >\n        <Icon name=\"lucide:sun\" class=\"size-4.5\" />\n      </span>\n      <div class=\"min-w-0 flex-1\">\n        <p class=\"truncate text-[15px]/tight font-medium\">{{ props.title }}</p>\n        <p class=\"truncate text-sm/tight text-muted-foreground tabular-nums\">\n          {{ subtitleText }}\n        </p>\n      </div>\n      <span\n        class=\"flex items-center gap-1.5 rounded-full border border-border bg-muted px-2.5 py-1 text-sm/none text-muted-foreground dark:border-white/6 dark:bg-black/30\"\n      >\n        <span\n          class=\"size-1.5 rounded-full bg-(--pm-accent) shadow-[0_0_6px_var(--pm-accent)]\"\n          :class=\"props.live ? 'motion-safe:animate-pulse' : ''\"\n        />\n        {{ props.status }}\n      </span>\n    </header>\n\n    <section\n      class=\"rounded-[1.25rem] border border-black/40 bg-[#0d0d0d] px-3.5 pt-3.5 pb-3 text-white shadow-[inset_0_2px_10px_rgb(0_0_0/0.8),0_1px_0_rgb(255_255_255/0.05)] dark:border-white/6\"\n      aria-label=\"Live power\"\n    >\n      <div\n        class=\"flex items-baseline justify-between text-sm tracking-wider text-(--pm-accent)/65\"\n      >\n        <span class=\"uppercase\">{{ bigLabel }}</span>\n        <span class=\"tracking-normal tabular-nums\">{{ peakText }}</span>\n      </div>\n      <div class=\"mt-2 flex items-end gap-2\">\n        <SegmentDisplay\n          :value=\"formatReading(bigValue)\"\n          :digits=\"3\"\n          :color=\"\n            inspecting && (cursor ?? 0) > current.now\n              ? `color-mix(in oklab, ${props.color} 55%, black)`\n              : props.color\n          \"\n          :label=\"`${formatReading(bigValue)} ${bigUnit}`\"\n          class=\"text-6xl\"\n        />\n        <span class=\"pb-1 text-base text-(--pm-accent)/80\">{{ bigUnit }}</span>\n      </div>\n      <div class=\"mt-3 grid grid-cols-3 gap-2\">\n        <div v-for=\"item in readings\" :key=\"item.label\" class=\"min-w-0\">\n          <p\n            class=\"truncate text-sm tracking-wider text-(--pm-accent)/60 uppercase\"\n          >\n            {{ item.label }}\n          </p>\n          <p class=\"mt-1 flex items-end gap-1.5\">\n            <SegmentDisplay\n              :value=\"item.value.toFixed(2)\"\n              :digits=\"3\"\n              :color=\"item.color\"\n              class=\"text-xl\"\n            />\n            <span class=\"text-sm/none text-white/45\">kW</span>\n          </p>\n        </div>\n      </div>\n      <PowerMonitorChart\n        v-model:cursor=\"cursor\"\n        class=\"mt-3\"\n        :solar=\"chartSolar\"\n        :home=\"current.home\"\n        :column-labels=\"current.columnLabels\"\n        :ticks=\"current.ticks\"\n        :now=\"current.now\"\n        :reveal-key=\"current.range\"\n        :rows-up=\"props.rowsUp\"\n        :rows-down=\"props.rowsDown\"\n        :color=\"props.color\"\n        :home-color=\"props.homeColor\"\n      />\n    </section>\n\n    <div class=\"flex items-center justify-between gap-2 px-0.5\">\n      <div\n        ref=\"tabList\"\n        role=\"tablist\"\n        aria-label=\"Chart range\"\n        class=\"relative flex rounded-full border border-border bg-muted p-1 dark:border-white/6 dark:bg-black/35 dark:shadow-[inset_0_1px_3px_rgb(0_0_0/0.6)]\"\n      >\n        <span\n          class=\"absolute inset-y-1 rounded-full bg-background shadow-sm transition-[left,width] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none dark:bg-[#3a3a3c] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.1),0_2px_6px_rgb(0_0_0/0.5)]\"\n          :style=\"{ left: `${pill.left}px`, width: `${pill.width}px` }\"\n          aria-hidden=\"true\"\n        />\n        <button\n          v-for=\"s in allSeries\"\n          :key=\"s.range\"\n          ref=\"tabs\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"s.range === range\"\n          :tabindex=\"s.range === range ? 0 : -1\"\n          :class=\"[\n            'relative rounded-full px-3 py-1.5 text-sm/none transition-colors outline-none focus-visible:ring-2 focus-visible:ring-(--pm-accent)/70',\n            s.range === range\n              ? 'text-foreground'\n              : 'text-muted-foreground hover:text-foreground',\n          ]\"\n          @click=\"select(s.range)\"\n          @keydown=\"onTabKeydown\"\n        >\n          {{ s.label }}\n        </button>\n      </div>\n      <span class=\"truncate text-sm text-muted-foreground tabular-nums\">\n        {{ current.date }}\n      </span>\n    </div>\n\n    <ul class=\"flex flex-col gap-2.5 px-2 pb-2\">\n      <li\n        v-for=\"row in summary\"\n        :key=\"row.label\"\n        class=\"flex items-center gap-2.5 text-sm\"\n      >\n        <span\n          class=\"size-2 shrink-0 rounded-[2px] ring-1 ring-black/25 dark:ring-2 dark:ring-black/60\"\n          :style=\"{\n            backgroundColor: row.dim\n              ? `color-mix(in oklab, ${row.color} 40%, black)`\n              : row.color,\n            boxShadow: row.dim ? undefined : `0 0 6px ${row.color}`,\n          }\"\n        />\n        <span class=\"flex-1 truncate text-muted-foreground\">{{\n          row.label\n        }}</span>\n        <span\n          class=\"tabular-nums\"\n          :class=\"row.dim ? 'text-muted-foreground' : 'text-foreground'\"\n        >\n          {{ row.value }}\n        </span>\n      </li>\n    </ul>\n  </article>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/power-monitor/PowerMonitor.vue"
    },
    {
      "path": "registry/new-york/power-monitor/PowerMonitorChart.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref } from 'vue';\n  import { cellPath } from './power-monitor';\n  import type { PowerMonitorChartProps } from './types';\n\n  const props = defineProps<PowerMonitorChartProps>();\n  const cursor = defineModel<number | null>('cursor', { default: null });\n\n  // Pixel pitch, cell size and the gap that holds the dashed baseline.\n  const PITCH = 4.4;\n  const CELL = 3.5;\n  const GAP = 2.6;\n\n  const plot = ref<HTMLElement | null>(null);\n  const dragging = ref(false);\n\n  const cols = computed(() => props.solar.length);\n  const width = computed(() => cols.value * PITCH - (PITCH - CELL));\n  const baseY = computed(() => props.rowsUp * PITCH);\n  const height = computed(() => baseY.value + GAP + props.rowsDown * PITCH);\n  const scale = computed(() => {\n    const max = Math.max(...props.solar, 0.001);\n    return max / props.rowsUp;\n  });\n\n  function solarRows(v: number): number {\n    if (v <= 0) return 0;\n    const rows = Math.round(v / scale.value);\n    return Math.min(\n      props.rowsUp,\n      Math.max(v > scale.value * 0.2 ? 1 : 0, rows),\n    );\n  }\n\n  function homeRows(v: number): number {\n    if (v <= 0) return 0;\n    return Math.min(props.rowsDown, Math.max(1, Math.round(v / scale.value)));\n  }\n\n  const paths = computed(() => {\n    const off: [number, number][] = [];\n    const past: [number, number][] = [];\n    const future: [number, number][] = [];\n    const home: [number, number][] = [];\n    for (let i = 0; i < cols.value; i++) {\n      const x = i * PITCH;\n      const up = solarRows(props.solar[i] ?? 0);\n      const down = i <= props.now ? homeRows(props.home[i] ?? 0) : 0;\n      for (let r = 0; r < props.rowsUp; r++) {\n        const cell: [number, number] = [x, baseY.value - (r + 1) * PITCH + 0.9];\n        if (r >= up) off.push(cell);\n        else if (i <= props.now) past.push(cell);\n        else future.push(cell);\n      }\n      for (let r = 0; r < props.rowsDown; r++) {\n        const cell: [number, number] = [x, baseY.value + GAP + r * PITCH];\n        if (r < down) home.push(cell);\n        else off.push(cell);\n      }\n    }\n    return {\n      off: cellPath(off, CELL),\n      past: cellPath(past, CELL),\n      future: cellPath(future, CELL),\n      home: cellPath(home, CELL),\n    };\n  });\n\n  const active = computed(() => cursor.value ?? props.now);\n  const label = computed(() => props.columnLabels[active.value] ?? '');\n  const percent = computed(() => {\n    const center = active.value * PITCH + CELL / 2;\n    return Math.min(92, Math.max(8, (center / width.value) * 100));\n  });\n\n  function indexAt(clientX: number): number {\n    const box = plot.value?.getBoundingClientRect();\n    if (!box || box.width === 0) return props.now;\n    const ratio = (clientX - box.left) / box.width;\n    return Math.min(\n      cols.value - 1,\n      Math.max(0, Math.floor(ratio * cols.value)),\n    );\n  }\n\n  function onPointerMove(event: PointerEvent): void {\n    if (event.pointerType !== 'mouse' && !dragging.value) return;\n    cursor.value = indexAt(event.clientX);\n  }\n\n  function onPointerDown(event: PointerEvent): void {\n    dragging.value = true;\n    plot.value?.setPointerCapture(event.pointerId);\n    cursor.value = indexAt(event.clientX);\n  }\n\n  function onPointerUp(event: PointerEvent): void {\n    dragging.value = false;\n    if (plot.value?.hasPointerCapture(event.pointerId)) {\n      plot.value.releasePointerCapture(event.pointerId);\n    }\n    if (event.pointerType !== 'mouse') cursor.value = null;\n  }\n\n  function onPointerLeave(): void {\n    if (!dragging.value) cursor.value = null;\n  }\n\n  function onKeydown(event: KeyboardEvent): void {\n    const step = Math.max(1, Math.round(cols.value / 12));\n    const moves: Record<string, number> = {\n      ArrowLeft: -1,\n      ArrowDown: -1,\n      ArrowRight: 1,\n      ArrowUp: 1,\n      PageDown: -step,\n      PageUp: step,\n    };\n    let next: number | null = null;\n    if (event.key in moves) next = active.value + (moves[event.key] ?? 0);\n    else if (event.key === 'Home') next = 0;\n    else if (event.key === 'End') next = cols.value - 1;\n    else if (event.key === 'Escape') {\n      cursor.value = null;\n      return;\n    }\n    if (next === null) return;\n    event.preventDefault();\n    cursor.value = Math.min(cols.value - 1, Math.max(0, next));\n  }\n\n  function onBlur(): void {\n    cursor.value = null;\n  }\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-1.5\" :style=\"{ '--pm-accent': props.color }\">\n    <div\n      class=\"relative flex h-6 items-center justify-between text-xs tracking-wider text-(--pm-accent)/65 uppercase\"\n    >\n      <span\n        class=\"flex items-center gap-1 transition-opacity duration-200\"\n        :class=\"percent < 22 ? 'opacity-0' : ''\"\n      >\n        Solar\n        <span\n          class=\"size-2.5 bg-current [clip-path:polygon(50%_0,100%_100%,0_100%)]\"\n        />\n      </span>\n      <span\n        class=\"flex items-center gap-1 transition-opacity duration-200\"\n        :class=\"percent > 78 ? 'opacity-0' : ''\"\n      >\n        Home\n        <span\n          class=\"size-2.5 bg-current [clip-path:polygon(0_0,100%_0,50%_100%)]\"\n        />\n      </span>\n      <span\n        class=\"pointer-events-none absolute top-0 -translate-x-1/2 rounded-md bg-(--pm-accent) px-1.5 py-0.5 text-sm/tight font-medium tracking-normal whitespace-nowrap text-black tabular-nums shadow-[0_0_12px_-2px_var(--pm-accent)] normal-case transition-[left] duration-100 ease-out motion-reduce:transition-none\"\n        :style=\"{ left: `${percent}%` }\"\n        aria-hidden=\"true\"\n      >\n        {{ label }}\n      </span>\n    </div>\n\n    <div\n      ref=\"plot\"\n      role=\"slider\"\n      tabindex=\"0\"\n      aria-label=\"Chart cursor\"\n      :aria-valuemin=\"0\"\n      :aria-valuemax=\"cols - 1\"\n      :aria-valuenow=\"active\"\n      :aria-valuetext=\"label\"\n      class=\"relative cursor-crosshair touch-none rounded-sm outline-none select-none focus-visible:ring-2 focus-visible:ring-(--pm-accent)/70 focus-visible:ring-offset-4 focus-visible:ring-offset-black\"\n      @pointermove=\"onPointerMove\"\n      @pointerdown=\"onPointerDown\"\n      @pointerup=\"onPointerUp\"\n      @pointercancel=\"onPointerUp\"\n      @pointerleave=\"onPointerLeave\"\n      @keydown=\"onKeydown\"\n      @blur=\"onBlur\"\n    >\n      <svg\n        :viewBox=\"`0 0 ${width} ${height}`\"\n        class=\"block h-auto w-full overflow-visible\"\n        aria-hidden=\"true\"\n      >\n        <path :d=\"paths.off\" fill=\"#ffffff\" opacity=\"0.055\" />\n        <line\n          x1=\"0\"\n          :x2=\"width\"\n          :y1=\"baseY + GAP / 2 - 0.3\"\n          :y2=\"baseY + GAP / 2 - 0.3\"\n          stroke=\"#ffffff\"\n          stroke-opacity=\"0.35\"\n          stroke-width=\"0.45\"\n          stroke-dasharray=\"1.2 0.9\"\n        />\n        <g :key=\"props.revealKey\" class=\"power-monitor-reveal\">\n          <path :d=\"paths.future\" :fill=\"props.color\" opacity=\"0.32\" />\n          <path :d=\"paths.home\" :fill=\"props.homeColor\" opacity=\"0.82\" />\n          <path :d=\"paths.past\" :fill=\"props.color\" />\n        </g>\n        <rect\n          :x=\"-0.6\"\n          y=\"-0.6\"\n          :width=\"CELL + 1.2\"\n          :height=\"height + 1.2\"\n          rx=\"0.8\"\n          :fill=\"props.color\"\n          fill-opacity=\"0.12\"\n          :stroke=\"props.color\"\n          stroke-width=\"0.55\"\n          class=\"transition-transform duration-100 ease-out motion-reduce:transition-none\"\n          :style=\"{ transform: `translateX(${active * PITCH}px)` }\"\n        />\n      </svg>\n    </div>\n\n    <div\n      class=\"relative mt-1 h-5 text-sm tracking-wider text-(--pm-accent)/55 tabular-nums\"\n      aria-hidden=\"true\"\n    >\n      <span\n        v-for=\"(tick, i) in props.ticks\"\n        :key=\"`${tick.label}-${i}`\"\n        class=\"absolute top-0\"\n        :class=\"\n          tick.at <= 0.01\n            ? 'left-0'\n            : tick.at >= 0.99\n              ? 'right-0'\n              : '-translate-x-1/2'\n        \"\n        :style=\"\n          tick.at > 0.01 && tick.at < 0.99\n            ? { left: `${tick.at * 100}%` }\n            : undefined\n        \"\n      >\n        {{ tick.label }}\n      </span>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .power-monitor-reveal {\n    animation: power-monitor-reveal 520ms cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  @keyframes power-monitor-reveal {\n    from {\n      clip-path: inset(0 100% 0 0);\n    }\n    to {\n      clip-path: inset(0 0 0 0);\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .power-monitor-reveal {\n      animation: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/power-monitor/PowerMonitorChart.vue"
    },
