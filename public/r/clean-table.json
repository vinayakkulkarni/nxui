{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "clean-table",
  "type": "registry:ui",
  "title": "Clean Table",
  "description": "A quiet, paginated table with segmented tabs, a keyboard-focused search, zebra rows, mono columns, status pills and row selection.",
  "dependencies": ["@tanstack/vue-table", "@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/clean-table/CleanTable.vue",
      "content": "<script setup lang=\"ts\" generic=\"TRow extends CleanTableRow\">\n  import { computed, onMounted, ref, useId, watch } from 'vue';\n  import { useEventListener } from '@vueuse/core';\n  import {\n    columnFilteringFeature,\n    createFilteredRowModel,\n    createPaginatedRowModel,\n    createSortedRowModel,\n    filterFn_includesString,\n    globalFilteringFeature,\n    isFunction,\n    rowPaginationFeature,\n    rowSelectionFeature,\n    rowSortingFeature,\n    sortFn_alphanumeric,\n    tableFeatures,\n    useTable,\n  } from '@tanstack/vue-table';\n  import type {\n    ColumnDef,\n    PaginationState,\n    RowSelectionState,\n    SortDirection,\n    SortingState,\n    Updater,\n  } from '@tanstack/vue-table';\n  import type {\n    CleanTableAriaSort,\n    CleanTableColumn,\n    CleanTableProps,\n    CleanTableRow,\n  } from './types';\n\n  const props = withDefaults(defineProps<CleanTableProps<TRow>>(), {\n    tabs: () => [],\n    pageSize: 10,\n    searchPlaceholder: 'Search',\n    shortcut: 'mod+k',\n    emptyText: 'No results.',\n    caption: '',\n    class: '',\n  });\n\n  const emit = defineEmits<{ rowClick: [row: TRow] }>();\n\n  const tab = defineModel<string>('tab', { default: '' });\n\n  const features = tableFeatures({\n    rowSortingFeature,\n    sortedRowModel: createSortedRowModel(),\n    sortFns: { alphanumeric: sortFn_alphanumeric },\n    columnFilteringFeature,\n    globalFilteringFeature,\n    filteredRowModel: createFilteredRowModel(),\n    filterFns: { includesString: filterFn_includesString },\n    rowPaginationFeature,\n    paginatedRowModel: createPaginatedRowModel(),\n    rowSelectionFeature,\n  });\n\n  const columns = computed<ColumnDef<typeof features, TRow>[]>(() =>\n    props.columns.map((column) => ({\n      id: column.key,\n      header: column.header,\n      accessorFn: (row: TRow) => row[column.key],\n      enableSorting: column.sortable !== false,\n    })),\n  );\n\n  const sorting = ref<SortingState>([]);\n  const query = ref('');\n  const pagination = ref<PaginationState>({\n    pageIndex: 0,\n    pageSize: props.pageSize,\n  });\n  const selection = ref<RowSelectionState>({});\n\n  watch(\n    () => props.pageSize,\n    (pageSize) => {\n      pagination.value = { pageIndex: 0, pageSize };\n    },\n  );\n\n  // A new tab is a new data set: start it on page one with nothing selected.\n  watch(tab, () => {\n    pagination.value = { ...pagination.value, pageIndex: 0 };\n    selection.value = {};\n    query.value = '';\n  });\n\n  function resolve<T>(updater: Updater<T>, current: T): T {\n    return isFunction(updater) ? updater(current) : updater;\n  }\n\n  const table = useTable({\n    features,\n    columns,\n    data: computed(() => props.data),\n    state: computed(() => ({\n      sorting: sorting.value,\n      globalFilter: query.value,\n      pagination: pagination.value,\n      rowSelection: selection.value,\n    })),\n    getRowId: (row: TRow) => String(row[props.rowKey]),\n    globalFilterFn: 'includesString',\n    enableSortingRemoval: true,\n    enableRowSelection: true,\n    onSortingChange: (updater: Updater<SortingState>) => {\n      sorting.value = resolve(updater, sorting.value);\n    },\n    onGlobalFilterChange: (updater: Updater<string>) => {\n      query.value = resolve(updater, query.value);\n    },\n    onPaginationChange: (updater: Updater<PaginationState>) => {\n      pagination.value = resolve(updater, pagination.value);\n    },\n    onRowSelectionChange: (updater: Updater<RowSelectionState>) => {\n      selection.value = resolve(updater, selection.value);\n    },\n  });\n\n  const byKey = computed(\n    () => new Map(props.columns.map((column) => [column.key, column])),\n  );\n\n  function columnFor(id: string): CleanTableColumn<TRow> | undefined {\n    return byKey.value.get(id as CleanTableColumn<TRow>['key']);\n  }\n\n  function valueOf(id: string, row: TRow): unknown {\n    const column = columnFor(id);\n    return column ? row[column.key] : undefined;\n  }\n\n  function alignClass(id: string): string {\n    const align = columnFor(id)?.align;\n    if (align === 'end') return 'text-right';\n    if (align === 'center') return 'text-center';\n    return 'text-left';\n  }\n\n  function cellClass(id: string): string {\n    const column = columnFor(id);\n    return [\n      alignClass(id),\n      // Mono values (dates, counters) never truncate; text columns do.\n      column?.mono\n        ? 'font-mono tracking-wider whitespace-nowrap tabular-nums'\n        : 'max-w-0 truncate',\n      column?.muted ? 'text-muted-foreground' : 'text-foreground/90',\n    ].join(' ');\n  }\n\n  const rows = computed(() => table.getRowModel().rows);\n  const pageCount = computed(() => Math.max(table.getPageCount(), 1));\n  const filteredCount = computed(() => table.getFilteredRowModel().rows.length);\n  const totalCount = computed(() => props.total ?? filteredCount.value);\n  // Selected rows on the current page, matching the \"N of 10\" footer.\n  const selectedCount = computed(\n    () => rows.value.filter((row) => row.getIsSelected()).length,\n  );\n\n  function sortIcon(direction: false | SortDirection): string {\n    if (direction === 'asc') return 'lucide:arrow-up';\n    if (direction === 'desc') return 'lucide:arrow-down';\n    return '';\n  }\n\n  function ariaSort(direction: false | SortDirection): CleanTableAriaSort {\n    if (direction === 'asc') return 'ascending';\n    if (direction === 'desc') return 'descending';\n    return 'none';\n  }\n\n  function onSearch(event: Event): void {\n    if (!(event.target instanceof HTMLInputElement)) return;\n    query.value = event.target.value;\n    pagination.value = { ...pagination.value, pageIndex: 0 };\n  }\n\n  // Keyboard shortcut that focuses the search field.\n  const searchId = useId();\n  const searchEl = ref<HTMLInputElement | null>(null);\n  const isMac = ref(true);\n\n  const shortcutParts = computed(() => {\n    const parts = props.shortcut.toLowerCase().split('+');\n    const key = parts.at(-1) ?? '';\n    return { mod: parts.includes('mod'), key };\n  });\n\n  const shortcutLabel = computed(() => {\n    const { mod, key } = shortcutParts.value;\n    const label = key.length === 1 ? key.toUpperCase() : key;\n    if (!mod) return label;\n    return `${isMac.value ? '⌘' : 'Ctrl'} + ${label}`;\n  });\n\n  useEventListener('keydown', (event: KeyboardEvent) => {\n    if (!props.shortcut) return;\n    const { mod, key } = shortcutParts.value;\n    if (event.key.toLowerCase() !== key) return;\n    const modPressed = event.metaKey || event.ctrlKey;\n    if (mod !== modPressed) return;\n    const target = event.target;\n    if (\n      !mod &&\n      target instanceof HTMLElement &&\n      (target.isContentEditable ||\n        /^(?:INPUT|TEXTAREA|SELECT)$/.test(target.tagName))\n    )\n      return;\n    event.preventDefault();\n    searchEl.value?.focus();\n  });\n\n  // Read after mount so the server and first client render agree on the label.\n  onMounted(() => {\n    isMac.value = /mac|iphone|ipad/i.test(navigator.userAgent);\n  });\n\n  function onRowKey(event: KeyboardEvent, toggle: () => void): void {\n    if (event.key !== 'Enter' && event.key !== ' ') return;\n    event.preventDefault();\n    toggle();\n  }\n</script>\n\n<template>\n  <div :class=\"['flex w-full flex-col gap-8', props.class]\">\n    <div class=\"flex flex-wrap items-center justify-between gap-3\">\n      <div\n        v-if=\"props.tabs.length\"\n        role=\"tablist\"\n        class=\"flex items-center gap-0.5 rounded-xl border border-border/60 bg-muted/50 p-1\"\n      >\n        <button\n          v-for=\"item in props.tabs\"\n          :key=\"item.value\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"tab === item.value\"\n          :class=\"[\n            'rounded-lg px-3.5 py-1.5 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-ring',\n            tab === item.value\n              ? 'bg-background text-foreground shadow-xs dark:bg-white/8'\n              : 'text-muted-foreground hover:text-foreground',\n          ]\"\n          @click=\"tab = item.value\"\n        >\n          {{ item.label }}\n        </button>\n      </div>\n      <span v-else />\n\n      <div class=\"relative w-full sm:w-75\">\n        <Icon\n          name=\"lucide:search\"\n          class=\"pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground\"\n        />\n        <label :for=\"searchId\" class=\"sr-only\">{{\n          props.searchPlaceholder\n        }}</label>\n        <input\n          :id=\"searchId\"\n          ref=\"searchEl\"\n          type=\"search\"\n          :value=\"query\"\n          :placeholder=\"props.searchPlaceholder\"\n          class=\"h-10 w-full rounded-xl border border-border/60 bg-muted/50 pr-16 pl-9 text-sm outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30 [&::-webkit-search-cancel-button]:hidden\"\n          @input=\"onSearch\"\n        />\n        <kbd\n          v-if=\"props.shortcut\"\n          aria-hidden=\"true\"\n          class=\"pointer-events-none absolute top-1/2 right-2.5 -translate-y-1/2 rounded-md bg-muted px-1.5 py-0.5 font-sans text-[0.6875rem] text-muted-foreground\"\n        >\n          {{ shortcutLabel }}\n        </kbd>\n      </div>\n    </div>\n\n    <div class=\"overflow-x-auto\">\n      <table\n        class=\"w-full min-w-225 border-separate border-spacing-0 text-[0.8125rem]\"\n      >\n        <caption v-if=\"props.caption\" class=\"sr-only\">\n          {{\n            props.caption\n          }}\n        </caption>\n        <colgroup>\n          <col\n            v-for=\"column in props.columns\"\n            :key=\"column.key\"\n            :class=\"column.width\"\n          />\n          <col class=\"w-10\" />\n        </colgroup>\n        <thead>\n          <tr v-for=\"group in table.getHeaderGroups()\" :key=\"group.id\">\n            <th\n              v-for=\"header in group.headers\"\n              :key=\"header.id\"\n              scope=\"col\"\n              :aria-sort=\"ariaSort(header.column.getIsSorted())\"\n              :class=\"[\n                'h-11 border-b border-border/60 px-4 text-sm font-normal whitespace-nowrap text-muted-foreground',\n                alignClass(header.column.id),\n              ]\"\n            >\n              <button\n                v-if=\"header.column.getCanSort()\"\n                type=\"button\"\n                :class=\"[\n                  'inline-flex items-center gap-1 rounded-sm transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring',\n                  header.column.getIsSorted() ? 'text-foreground' : '',\n                ]\"\n                @click=\"header.column.getToggleSortingHandler()?.($event)\"\n              >\n                {{ columnFor(header.column.id)?.header }}\n                <Icon\n                  v-if=\"sortIcon(header.column.getIsSorted())\"\n                  :name=\"sortIcon(header.column.getIsSorted())\"\n                  class=\"size-3.5\"\n                />\n              </button>\n              <span v-else>{{ columnFor(header.column.id)?.header }}</span>\n            </th>\n            <th class=\"border-b border-border/60\" aria-hidden=\"true\" />\n          </tr>\n          <tr aria-hidden=\"true\">\n            <th :colspan=\"props.columns.length + 1\" class=\"h-4\" />\n          </tr>\n        </thead>\n        <tbody>\n          <tr\n            v-for=\"(row, index) in rows\"\n            :key=\"row.id\"\n            tabindex=\"0\"\n            :aria-selected=\"row.getIsSelected()\"\n            :class=\"[\n              'group cursor-pointer outline-none *:transition-colors',\n              row.getIsSelected()\n                ? '*:bg-primary/12 dark:*:bg-white/10'\n                : index % 2 === 1\n                  ? '*:bg-muted/50 dark:*:bg-white/2.5'\n                  : '',\n              'hover:*:bg-muted dark:hover:*:bg-white/5 focus-visible:*:bg-muted dark:focus-visible:*:bg-white/5',\n            ]\"\n            @click=\"\n              row.toggleSelected();\n              emit('rowClick', row.original);\n            \"\n            @keydown=\"onRowKey($event, () => row.toggleSelected())\"\n          >\n            <td\n              v-for=\"cell in row.getAllCells()\"\n              :key=\"cell.id\"\n              :class=\"[\n                'h-11.5 px-4 first:rounded-l-lg',\n                cellClass(cell.column.id),\n              ]\"\n            >\n              <slot\n                :name=\"`cell-${cell.column.id}`\"\n                :row=\"row.original\"\n                :value=\"valueOf(cell.column.id, row.original)\"\n              >\n                {{ valueOf(cell.column.id, row.original) }}\n              </slot>\n            </td>\n            <td class=\"rounded-r-lg pr-4 text-right text-muted-foreground/60\">\n              <span class=\"flex items-center justify-end\">\n                <Icon\n                  name=\"lucide:chevron-right\"\n                  class=\"size-4 transition-transform group-hover:translate-x-0.5\"\n                />\n              </span>\n            </td>\n          </tr>\n          <tr v-if=\"rows.length === 0\">\n            <td\n              :colspan=\"props.columns.length + 1\"\n              class=\"h-24 text-center text-muted-foreground\"\n            >\n              {{ props.emptyText }}\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div\n      class=\"flex items-center justify-between gap-4 px-4 text-xs text-muted-foreground\"\n    >\n      <p aria-live=\"polite\">\n        <span class=\"text-foreground/90\">\n          {{ selectedCount }} of {{ rows.length }}\n        </span>\n        <span class=\"ml-2.5 opacity-70\">of {{ totalCount }}</span>\n      </p>\n      <div class=\"flex items-center gap-3\">\n        <p>\n          Page\n          <span class=\"ml-1 text-foreground/90\">\n            {{ pagination.pageIndex + 1 }} of\n            {{ pageCount }}\n          </span>\n        </p>\n        <div class=\"flex items-center gap-1.5\">\n          <button\n            type=\"button\"\n            aria-label=\"Previous page\"\n            :disabled=\"!table.getCanPreviousPage()\"\n            class=\"grid size-5 place-items-center rounded-full bg-muted text-foreground/80 transition-colors hover:bg-muted-foreground/30 focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-40\"\n            @click=\"table.previousPage()\"\n          >\n            <Icon name=\"lucide:chevron-left\" class=\"size-3.5\" />\n          </button>\n          <button\n            type=\"button\"\n            aria-label=\"Next page\"\n            :disabled=\"!table.getCanNextPage()\"\n            class=\"grid size-5 place-items-center rounded-full bg-muted text-foreground/80 transition-colors hover:bg-muted-foreground/30 focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-40\"\n            @click=\"table.nextPage()\"\n          >\n            <Icon name=\"lucide:chevron-right\" class=\"size-3.5\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/clean-table/CleanTable.vue"
    },
    {
      "path": "registry/new-york/clean-table/CleanTableStatus.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import type { CleanTableStatusKind, CleanTableStatusProps } from './types';\n\n  const props = defineProps<CleanTableStatusProps>();\n\n  const STYLES: Record<CleanTableStatusKind, { label: string; class: string }> =\n    {\n      progress: {\n        label: 'In Progress',\n        class:\n          'bg-lime-500/15 text-lime-700 dark:bg-[oklch(0.3_0.05_110)] dark:text-[oklch(0.82_0.15_110)]',\n      },\n      complete: {\n        label: 'Complete',\n        class:\n          'bg-emerald-500/12 text-emerald-700 dark:bg-[oklch(0.26_0.05_160)] dark:text-[oklch(0.72_0.15_160)]',\n      },\n      error: {\n        label: 'Error',\n        class:\n          'bg-red-500/12 text-red-700 dark:bg-[oklch(0.25_0.06_25)] dark:text-[oklch(0.65_0.19_25)]',\n      },\n    };\n\n  const style = computed(() => STYLES[props.status]);\n</script>\n\n<template>\n  <span\n    :class=\"[\n      'inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs whitespace-nowrap',\n      style.class,\n    ]\"\n  >\n    <!-- In progress: a ring with a three-quarter pie inside it. -->\n    <span\n      v-if=\"props.status === 'progress'\"\n      aria-hidden=\"true\"\n      class=\"grid size-3.5 place-items-center rounded-full border-[1.5px] border-current\"\n    >\n      <span\n        class=\"size-2 rounded-full bg-[conic-gradient(currentColor_0_75%,transparent_75%)]\"\n      />\n    </span>\n    <span\n      v-else\n      aria-hidden=\"true\"\n      class=\"grid size-3.5 place-items-center rounded-full bg-current\"\n    >\n      <Icon\n        :name=\"props.status === 'complete' ? 'lucide:check' : 'lucide:minus'\"\n        :class=\"[\n          'size-2.5 text-background',\n          props.status === 'error' ? 'rotate-90' : '',\n        ]\"\n      />\n    </span>\n    {{ props.label ?? style.label }}\n  </span>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/clean-table/CleanTableStatus.vue"
    },
    {
      "path": "registry/new-york/clean-table/index.ts",
      "content": "export { default as CleanTable } from './CleanTable.vue';\nexport { default as CleanTableStatus } from './CleanTableStatus.vue';\nexport type {\n  CleanTableColumn,\n  CleanTableProps,\n  CleanTableRow,\n  CleanTableStatusKind,\n  CleanTableTab,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/clean-table/index.ts"
    },
    {
      "path": "registry/new-york/clean-table/types.ts",
      "content": "/** Any object type, including interfaces (which have no index signature). */\nexport type CleanTableRow = object;\n\nexport type CleanTableAriaSort = 'ascending' | 'descending' | 'none';\n\nexport type CleanTableStatusKind = 'progress' | 'complete' | 'error';\n\nexport interface CleanTableColumn<TRow extends CleanTableRow = CleanTableRow> {\n  /** Row field shown in this column; also names the `#cell-<key>` slot. */\n  key: Extract<keyof TRow, string>;\n  header: string;\n  align?: 'start' | 'center' | 'end';\n  /** Renders the value in the monospace face, as the reference does for dates and counts. */\n  mono?: boolean;\n  /** Fades the value to the muted color. */\n  muted?: boolean;\n  sortable?: boolean;\n  /** Tailwind width class for the column, e.g. `w-40`. Long text truncates. */\n  width?: string;\n}\n\nexport interface CleanTableTab {\n  value: string;\n  label: string;\n}\n\nexport interface CleanTableProps<TRow extends CleanTableRow = CleanTableRow> {\n  columns: CleanTableColumn<TRow>[];\n  data: TRow[];\n  /** Field that uniquely identifies a row. */\n  rowKey: Extract<keyof TRow, string>;\n  /** Segmented tabs above the table. Bind the active one with `v-model:tab`. */\n  tabs?: CleanTableTab[];\n  pageSize?: number;\n  /** Total record count for the footer, e.g. from a server. Defaults to the filtered row count. */\n  total?: number;\n  searchPlaceholder?: string;\n  /**\n   * Key that focuses the search field. `mod+k` means ⌘K on macOS and Ctrl+K\n   * elsewhere; a single key such as `/` works when no field has focus. Pass an\n   * empty string to turn it off.\n   */\n  shortcut?: string;\n  emptyText?: string;\n  caption?: string;\n  class?: string;\n}\n\nexport interface CleanTableStatusProps {\n  status: CleanTableStatusKind;\n  label?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/clean-table/types.ts"
    }
  ]
}
