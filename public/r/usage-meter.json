{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "usage-meter",
  "type": "registry:ui",
  "title": "Usage Meter",
  "description": "A plan usage card with a range switch, rolling credit total, stacked category meter, per-day bars, quota stats and a limit state.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/usage-meter/UsageMeter.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    nextTick,\n    onMounted,\n    ref,\n    useTemplateRef,\n    watch,\n  } from 'vue';\n  import { useResizeObserver } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import type {\n    UsageMeterCategory,\n    UsageMeterDay,\n    UsageMeterProps,\n    UsageMeterStat,\n  } from './types';\n  import UsageMeterBars from './UsageMeterBars.vue';\n  import UsageMeterNumber from './UsageMeterNumber.vue';\n  import UsageMeterStats from './UsageMeterStats.vue';\n  import { formatCount, percentOf } from './usage-meter';\n\n  const props = withDefaults(defineProps<UsageMeterProps>(), {\n    workspace: 'nxui',\n    plan: 'Pro plan',\n    resets: '',\n    limit: 10000,\n    unit: 'credits',\n    accent: '',\n    upgradeLabel: 'Upgrade',\n    addCreditsLabel: 'Add credits',\n    limitLabel: 'Limit reached',\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    upgrade: [];\n    'add-credits': [];\n    'range-change': [value: string];\n  }>();\n\n  const range = defineModel<string>('range', { default: '' });\n\n  const NO_STATS: UsageMeterStat[] = [];\n  const NO_DAYS: UsageMeterDay[] = [];\n\n  const current = computed(\n    () =>\n      props.ranges.find((item) => item.value === range.value) ??\n      props.ranges[0],\n  );\n  const activeValue = computed(() => current.value?.value ?? '');\n\n  function usageOf(category: UsageMeterCategory): number {\n    return current.value?.usage[category.key] ?? 0;\n  }\n\n  const total = computed(() =>\n    props.categories.reduce((sum, category) => sum + usageOf(category), 0),\n  );\n  const percent = computed(() => percentOf(total.value, props.limit));\n  const atLimit = computed(() => total.value >= props.limit);\n  const left = computed(() => Math.max(0, props.limit - total.value));\n\n  const segments = computed(() => {\n    const scale = Math.max(props.limit, total.value);\n    let offset = 0;\n    return props.categories.map((category) => {\n      const value = usageOf(category);\n      const width = scale > 0 ? (value / scale) * 100 : 0;\n      const center = offset + width / 2;\n      offset += width;\n      return {\n        category,\n        value,\n        width,\n        center,\n        share: percentOf(value, total.value),\n        style: {\n          '--um-c': category.color,\n          '--um-cd': category.darkColor ?? category.color,\n        },\n      };\n    });\n  });\n\n  const hovered = ref('');\n  const hoveredSegment = computed(() =>\n    segments.value.find((segment) => segment.category.key === hovered.value),\n  );\n  const tooltipLeft = computed(() => {\n    const center = hoveredSegment.value?.center ?? 50;\n    return `${Math.min(80, Math.max(20, center))}%`;\n  });\n\n  const days = computed<UsageMeterDay[]>(() => {\n    const item = current.value;\n    if (!item) return NO_DAYS;\n    const count = Math.max(item.days ?? item.daily.length, item.daily.length);\n    return Array.from({ length: count }, (_, index) => ({\n      label: item.dayLabels?.[index] ?? `Day ${index + 1}`,\n      value: item.daily[index] ?? 0,\n      future: index >= item.daily.length,\n    }));\n  });\n  const stats = computed(() => current.value?.stats ?? NO_STATS);\n  const firstCategory = computed(() => props.categories[0]);\n  const barAccent = computed(\n    () => props.accent || firstCategory.value?.color || 'currentColor',\n  );\n  const barAccentDark = computed(\n    () =>\n      props.accent ||\n      firstCategory.value?.darkColor ||\n      firstCategory.value?.color ||\n      'currentColor',\n  );\n\n  watch(activeValue, () => {\n    hovered.value = '';\n  });\n\n  // Segmented control\n  const tablist = useTemplateRef<HTMLElement>('tablist');\n  const tabs = useTemplateRef<HTMLButtonElement[]>('tabs');\n  const indicator = ref({ left: 0, width: 0 });\n  const measured = ref(false);\n\n  function measure(): void {\n    const index = props.ranges.findIndex(\n      (item) => item.value === activeValue.value,\n    );\n    const tab = tabs.value?.[index];\n    if (!tab) return;\n    indicator.value = { left: tab.offsetLeft, width: tab.offsetWidth };\n    measured.value = true;\n  }\n\n  onMounted(measure);\n  useResizeObserver(tablist, measure);\n  watch(activeValue, () => {\n    nextTick(measure);\n  });\n\n  function select(value: string): void {\n    if (value === activeValue.value) return;\n    range.value = value;\n    emit('range-change', value);\n  }\n\n  function onTabKeydown(event: KeyboardEvent): void {\n    const count = props.ranges.length;\n    if (count === 0) return;\n    const index = props.ranges.findIndex(\n      (item) => item.value === activeValue.value,\n    );\n    let next = -1;\n    if (event.key === 'ArrowRight') next = (index + 1) % count;\n    else if (event.key === 'ArrowLeft') next = (index - 1 + count) % count;\n    else if (event.key === 'Home') next = 0;\n    else if (event.key === 'End') next = count - 1;\n    if (next < 0) return;\n    event.preventDefault();\n    const item = props.ranges[next];\n    if (!item) return;\n    select(item.value);\n    tabs.value?.[next]?.focus();\n  }\n\n  function onEnter(key: string): void {\n    hovered.value = key;\n  }\n\n  function onLeave(): void {\n    hovered.value = '';\n  }\n\n  function onUpgrade(): void {\n    emit('upgrade');\n  }\n\n  function onAddCredits(): void {\n    emit('add-credits');\n  }\n</script>\n\n<template>\n  <div\n    :class=\"\n      cn(\n        'w-full max-w-md rounded-[1.75rem] border border-border bg-muted/80 p-1 text-foreground dark:bg-background',\n        props.class,\n      )\n    \"\n  >\n    <div\n      class=\"rounded-3xl border border-border bg-card p-5 shadow-sm dark:bg-muted/45\"\n    >\n      <!-- Header -->\n      <div class=\"flex flex-wrap items-start justify-between gap-3\">\n        <div class=\"min-w-36 flex-1\">\n          <p class=\"truncate text-sm font-semibold\">{{ workspace }}</p>\n          <p class=\"mt-0.5 flex min-w-0 gap-1.5 text-xs text-muted-foreground\">\n            <span class=\"truncate\">{{ plan }}</span>\n            <template v-if=\"resets\">\n              <span aria-hidden=\"true\">·</span>\n              <span class=\"truncate\">{{ resets }}</span>\n            </template>\n          </p>\n        </div>\n        <div\n          ref=\"tablist\"\n          role=\"tablist\"\n          aria-label=\"Usage range\"\n          class=\"relative flex shrink-0 rounded-xl border border-border bg-muted p-0.5 dark:bg-background\"\n          @keydown=\"onTabKeydown\"\n        >\n          <span\n            v-if=\"measured\"\n            aria-hidden=\"true\"\n            class=\"absolute inset-y-0.5 left-0 rounded-[0.55rem] bg-card shadow-sm ring-1 ring-border transition-[translate,width] duration-300 ease-out motion-reduce:transition-none dark:bg-muted\"\n            :style=\"{\n              width: `${indicator.width}px`,\n              translate: `${indicator.left}px 0`,\n            }\"\n          />\n          <button\n            v-for=\"item in ranges\"\n            ref=\"tabs\"\n            :key=\"item.value\"\n            type=\"button\"\n            role=\"tab\"\n            :aria-selected=\"item.value === activeValue\"\n            :tabindex=\"item.value === activeValue ? 0 : -1\"\n            :class=\"[\n              'relative z-10 rounded-[0.55rem] px-2 py-1 text-xs whitespace-nowrap transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring/60 sm:px-2.5',\n              item.value === activeValue\n                ? 'font-medium text-foreground'\n                : 'text-muted-foreground hover:text-foreground',\n              item.value === activeValue &&\n                !measured &&\n                'bg-card shadow-sm dark:bg-muted',\n            ]\"\n            @click=\"select(item.value)\"\n          >\n            {{ item.label }}\n          </button>\n        </div>\n      </div>\n\n      <!-- Total -->\n      <div class=\"mt-6 flex items-end justify-between gap-3\">\n        <p class=\"flex min-w-0 items-baseline gap-2\">\n          <UsageMeterNumber\n            :value=\"total\"\n            class=\"text-4xl font-semibold tracking-tight tabular-nums\"\n          />\n          <span class=\"truncate text-sm text-muted-foreground\">\n            of {{ formatCount(limit) }} {{ unit }}\n          </span>\n        </p>\n        <p\n          class=\"flex shrink-0 items-center gap-1.5 pb-1 text-sm font-medium tabular-nums\"\n        >\n          <span v-if=\"atLimit\" aria-hidden=\"true\" class=\"relative flex size-2\">\n            <span\n              class=\"absolute inset-0 animate-ping rounded-full bg-amber-500/60 motion-reduce:animate-none\"\n            />\n            <span class=\"relative size-2 rounded-full bg-amber-500\" />\n          </span>\n          <span><UsageMeterNumber :value=\"percent\" />%</span>\n        </p>\n      </div>\n\n      <!-- Meter -->\n      <div class=\"relative mt-3\">\n        <div\n          role=\"meter\"\n          :aria-valuenow=\"total\"\n          aria-valuemin=\"0\"\n          :aria-valuemax=\"limit\"\n          :aria-valuetext=\"`${formatCount(total)} of ${formatCount(limit)} ${unit}`\"\n          aria-label=\"Usage\"\n          class=\"flex h-2.5 overflow-hidden rounded-full bg-foreground/8\"\n          @mouseleave=\"onLeave\"\n        >\n          <div\n            v-for=\"segment in segments\"\n            :key=\"segment.category.key\"\n            class=\"h-full shrink-0 transition-[width] duration-700 ease-out motion-reduce:transition-none\"\n            :style=\"{ ...segment.style, width: `${segment.width}%` }\"\n            @mouseenter=\"onEnter(segment.category.key)\"\n          >\n            <div\n              :class=\"[\n                'mr-0.5 h-full rounded-[2px] bg-(--um-c) transition-opacity duration-200 dark:bg-(--um-cd)',\n                hovered && hovered !== segment.category.key && 'opacity-35',\n              ]\"\n            />\n          </div>\n        </div>\n        <div\n          :class=\"[\n            'pointer-events-none absolute bottom-full mb-2.5 -translate-x-1/2 rounded-xl border border-border bg-popover px-3 py-2 text-popover-foreground shadow-lg transition-[opacity,left,translate] duration-200 ease-out motion-reduce:transition-none',\n            hoveredSegment\n              ? 'translate-y-0 opacity-100'\n              : 'translate-y-1 opacity-0',\n          ]\"\n          :style=\"{ left: tooltipLeft }\"\n          aria-hidden=\"true\"\n        >\n          <template v-if=\"hoveredSegment\">\n            <p\n              class=\"flex items-center gap-1.5 text-xs text-muted-foreground\"\n              :style=\"hoveredSegment.style\"\n            >\n              <span\n                class=\"size-2 rounded-[2px] bg-(--um-c) dark:bg-(--um-cd)\"\n              />\n              {{ hoveredSegment.category.label }}\n            </p>\n            <p\n              class=\"mt-0.5 text-sm font-semibold whitespace-nowrap tabular-nums\"\n            >\n              {{ formatCount(hoveredSegment.value) }} {{ unit }}\n              <span class=\"font-normal text-muted-foreground\"\n                >· {{ hoveredSegment.share }}%</span\n              >\n            </p>\n          </template>\n        </div>\n      </div>\n\n      <!-- Categories -->\n      <ul class=\"mt-3.5 -mx-2\" aria-label=\"Usage by category\">\n        <li\n          v-for=\"segment in segments\"\n          :key=\"segment.category.key\"\n          :class=\"[\n            'grid transition-[grid-template-rows,opacity] duration-500 ease-out motion-reduce:transition-none',\n            segment.value > 0\n              ? 'grid-rows-[1fr] opacity-100'\n              : 'grid-rows-[0fr] opacity-0',\n          ]\"\n          :aria-hidden=\"segment.value > 0 ? undefined : 'true'\"\n        >\n          <div class=\"min-h-0 overflow-hidden\">\n            <div\n              :tabindex=\"segment.value > 0 ? 0 : -1\"\n              :class=\"[\n                'flex items-center gap-3 rounded-lg px-2 py-1.5 text-sm transition-[background-color,opacity] duration-200 outline-none focus-visible:ring-2 focus-visible:ring-ring/60',\n                hovered === segment.category.key && 'bg-foreground/5',\n                hovered && hovered !== segment.category.key && 'opacity-45',\n              ]\"\n              :style=\"segment.style\"\n              @mouseenter=\"onEnter(segment.category.key)\"\n              @mouseleave=\"onLeave\"\n              @focus=\"onEnter(segment.category.key)\"\n              @blur=\"onLeave\"\n            >\n              <span\n                class=\"size-2 shrink-0 rounded-[2px] bg-(--um-c) dark:bg-(--um-cd)\"\n                aria-hidden=\"true\"\n              />\n              <span class=\"min-w-0 flex-1 truncate\">{{\n                segment.category.label\n              }}</span>\n              <UsageMeterNumber\n                :value=\"segment.value\"\n                class=\"font-medium tabular-nums\"\n              />\n              <span class=\"w-9 text-right text-muted-foreground tabular-nums\">\n                <UsageMeterNumber :value=\"segment.share\" />%\n              </span>\n            </div>\n          </div>\n        </li>\n      </ul>\n\n      <!-- Per day -->\n      <UsageMeterBars\n        class=\"mt-4\"\n        :days=\"days\"\n        :range-key=\"activeValue\"\n        :unit=\"unit\"\n        :accent=\"barAccent\"\n        :accent-dark=\"barAccentDark\"\n      />\n\n      <template v-if=\"stats.length\">\n        <div class=\"my-4 h-px bg-border\" />\n        <UsageMeterStats :stats=\"stats\" />\n      </template>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"flex h-14 items-center justify-between gap-3 pr-1 pl-5\">\n      <Transition\n        mode=\"out-in\"\n        enter-active-class=\"transition duration-200 ease-out motion-reduce:transition-none\"\n        leave-active-class=\"transition duration-150 ease-in motion-reduce:transition-none\"\n        enter-from-class=\"translate-y-1 opacity-0 blur-[2px]\"\n        leave-to-class=\"-translate-y-1 opacity-0 blur-[2px]\"\n      >\n        <p\n          v-if=\"atLimit\"\n          key=\"limit\"\n          class=\"flex items-center gap-2 text-sm font-medium\"\n          role=\"status\"\n        >\n          <span\n            class=\"size-2 rounded-full bg-amber-500 ring-3 ring-amber-500/25\"\n            aria-hidden=\"true\"\n          />\n          {{ limitLabel }}\n        </p>\n        <p v-else key=\"left\" class=\"text-sm text-muted-foreground tabular-nums\">\n          <UsageMeterNumber :value=\"left\" /> {{ unit }} left\n        </p>\n      </Transition>\n      <Transition\n        mode=\"out-in\"\n        enter-active-class=\"transition duration-200 ease-out motion-reduce:transition-none\"\n        leave-active-class=\"transition duration-150 ease-in motion-reduce:transition-none\"\n        enter-from-class=\"scale-95 opacity-0\"\n        leave-to-class=\"scale-95 opacity-0\"\n      >\n        <button\n          v-if=\"atLimit\"\n          key=\"add\"\n          type=\"button\"\n          class=\"h-10 rounded-full bg-foreground px-5 text-sm font-medium text-background shadow-md transition-[opacity,scale] outline-none hover:opacity-90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-muted active:scale-97\"\n          @click=\"onAddCredits\"\n        >\n          {{ addCreditsLabel }}\n        </button>\n        <button\n          v-else\n          key=\"upgrade\"\n          type=\"button\"\n          class=\"h-10 rounded-full border border-border bg-card px-5 text-sm font-medium shadow-sm transition-[background-color,scale] outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-muted active:scale-97\"\n          @click=\"onUpgrade\"\n        >\n          {{ upgradeLabel }}\n        </button>\n      </Transition>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/usage-meter/UsageMeter.vue"
    },
    {
      "path": "registry/new-york/usage-meter/UsageMeterBars.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref, watch } from 'vue';\n  import type { UsageMeterBarsProps } from './types';\n  import { formatCount } from './usage-meter';\n\n  const props = defineProps<UsageMeterBarsProps>();\n\n  const active = ref(-1);\n\n  const used = computed(() => props.days.filter((day) => !day.future));\n  const peak = computed(() =>\n    used.value.reduce((max, day) => Math.max(max, day.value), 0),\n  );\n  const average = computed(() => {\n    if (used.value.length === 0) return 0;\n    const sum = used.value.reduce((total, day) => total + day.value, 0);\n    return Math.round(sum / used.value.length);\n  });\n  const activeDay = computed(() => props.days[active.value]);\n  const dense = computed(() => props.days.length > 12);\n  const accentStyle = computed(() => ({\n    '--um-accent': props.accent,\n    '--um-accent-dark': props.accentDark,\n  }));\n\n  watch(\n    () => props.rangeKey,\n    () => {\n      active.value = -1;\n    },\n  );\n\n  function heightOf(value: number): string {\n    if (peak.value <= 0) return '0%';\n    return `${Math.max(12, (value / peak.value) * 100)}%`;\n  }\n\n  function onEnter(index: number): void {\n    const day = props.days[index];\n    active.value = day && !day.future ? index : -1;\n  }\n\n  function onLeave(): void {\n    active.value = -1;\n  }\n\n  function step(direction: number): void {\n    const last = used.value.length - 1;\n    if (last < 0) return;\n    const start =\n      active.value < 0 ? (direction > 0 ? -1 : last + 1) : active.value;\n    active.value = Math.min(last, Math.max(0, start + direction));\n  }\n\n  function onKeydown(event: KeyboardEvent): void {\n    if (event.key === 'ArrowRight') step(1);\n    else if (event.key === 'ArrowLeft') step(-1);\n    else if (event.key === 'Home') active.value = 0;\n    else if (event.key === 'End') active.value = used.value.length - 1;\n    else if (event.key === 'Escape') active.value = -1;\n    else return;\n    event.preventDefault();\n  }\n</script>\n\n<template>\n  <div :style=\"accentStyle\">\n    <div\n      class=\"flex items-baseline justify-between text-xs text-muted-foreground\"\n    >\n      <span>Per day</span>\n      <span aria-live=\"polite\" class=\"tabular-nums\">\n        <template v-if=\"activeDay\">\n          {{ activeDay.label }} ·\n          <span class=\"font-medium text-foreground\">{{\n            formatCount(activeDay.value)\n          }}</span>\n          {{ unit }}\n        </template>\n        <template v-else>\n          Avg\n          <span class=\"font-medium text-foreground\">{{\n            formatCount(average)\n          }}</span>\n          / day\n        </template>\n      </span>\n    </div>\n    <div\n      role=\"group\"\n      tabindex=\"0\"\n      aria-label=\"Usage per day. Use the arrow keys to read each day.\"\n      class=\"mt-2.5 rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:ring-offset-2 focus-visible:ring-offset-card\"\n      @keydown=\"onKeydown\"\n      @mouseleave=\"onLeave\"\n      @blur=\"onLeave\"\n    >\n      <div\n        :key=\"rangeKey\"\n        :class=\"['flex h-9 items-end', dense ? 'gap-0.5' : 'gap-1.5']\"\n      >\n        <div\n          v-for=\"(day, index) in days\"\n          :key=\"index\"\n          class=\"flex h-full flex-1 items-end\"\n          @mouseenter=\"onEnter(index)\"\n        >\n          <div\n            v-if=\"day.future\"\n            class=\"h-0.5 w-full rounded-full bg-muted-foreground/15\"\n          />\n          <div\n            v-else\n            :class=\"[\n              'um-bar w-full rounded-[3px] transition-colors duration-150',\n              index === active\n                ? 'bg-(--um-accent) dark:bg-(--um-accent-dark)'\n                : 'bg-muted-foreground/20 dark:bg-muted-foreground/25',\n            ]\"\n            :style=\"{\n              height: heightOf(day.value),\n              animationDelay: `${index * 14}ms`,\n            }\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .um-bar {\n    transform-origin: bottom;\n    animation: um-grow 520ms cubic-bezier(0.22, 1, 0.36, 1) both;\n  }\n\n  @keyframes um-grow {\n    from {\n      transform: scaleY(0);\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .um-bar {\n      animation: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/usage-meter/UsageMeterBars.vue"
    },
    {
      "path": "registry/new-york/usage-meter/UsageMeterNumber.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, toRef } from 'vue';\n  import {\n    TransitionPresets,\n    usePreferredReducedMotion,\n    useTransition,\n  } from '@vueuse/core';\n  import type { UsageMeterNumberProps } from './types';\n  import { formatCount } from './usage-meter';\n\n  const props = withDefaults(defineProps<UsageMeterNumberProps>(), {\n    duration: 700,\n    class: '',\n  });\n\n  const motion = usePreferredReducedMotion();\n  const reduce = computed(() => motion.value === 'reduce');\n  const shown = useTransition(toRef(props, 'value'), {\n    duration: props.duration,\n    transition: TransitionPresets.easeOutCubic,\n    disabled: reduce,\n  });\n  const text = computed(() => formatCount(shown.value));\n</script>\n\n<template>\n  <span :class=\"props.class\">{{ text }}</span>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/usage-meter/UsageMeterNumber.vue"
    },
    {
      "path": "registry/new-york/usage-meter/UsageMeterStats.vue",
      "content": "<script setup lang=\"ts\">\n  import type { UsageMeterStat, UsageMeterStatsProps } from './types';\n  import { formatDecimal } from './usage-meter';\n\n  defineProps<UsageMeterStatsProps>();\n\n  function fill(stat: UsageMeterStat): string {\n    if (!stat.max) return '0%';\n    return `${Math.min(100, (stat.value / stat.max) * 100)}%`;\n  }\n\n  function warns(stat: UsageMeterStat): boolean {\n    return Boolean(stat.max) && stat.value / (stat.max ?? 1) >= 0.8;\n  }\n\n  function full(stat: UsageMeterStat): boolean {\n    return Boolean(stat.max) && stat.value >= (stat.max ?? 0);\n  }\n</script>\n\n<template>\n  <dl class=\"grid grid-cols-3 gap-4 sm:gap-5\">\n    <div v-for=\"stat in stats\" :key=\"stat.label\" class=\"min-w-0\">\n      <dt class=\"flex items-center gap-1.5 text-xs text-muted-foreground\">\n        <span class=\"truncate\">{{ stat.label }}</span>\n        <span\n          v-if=\"warns(stat)\"\n          :class=\"[\n            'size-1.5 shrink-0 rounded-full bg-amber-500',\n            full(stat) && 'ring-3 ring-amber-500/25',\n          ]\"\n          aria-hidden=\"true\"\n        />\n      </dt>\n      <dd class=\"mt-0.5 truncate text-sm text-muted-foreground tabular-nums\">\n        <span class=\"font-medium text-foreground\">{{\n          formatDecimal(stat.value)\n        }}</span>\n        of\n        <template v-if=\"stat.max\"\n          >{{ formatDecimal(stat.max)\n          }}{{ stat.unit ? ` ${stat.unit}` : '' }}</template\n        >\n        <template v-else>∞</template>\n        <span class=\"sr-only\">{{ warns(stat) ? ', near the limit' : '' }}</span>\n      </dd>\n      <div\n        :class=\"[\n          'mt-2.5 h-1 overflow-hidden rounded-full',\n          stat.max && 'bg-muted-foreground/15',\n        ]\"\n      >\n        <div\n          v-if=\"stat.max\"\n          class=\"h-full rounded-full bg-foreground/75 transition-[width] duration-700 ease-out motion-reduce:transition-none\"\n          :style=\"{ width: fill(stat) }\"\n        />\n        <div v-else class=\"um-hatch size-full text-muted-foreground/30\" />\n      </div>\n    </div>\n  </dl>\n</template>\n\n<style scoped>\n  .um-hatch {\n    background-image: repeating-linear-gradient(\n      -45deg,\n      currentColor 0 3px,\n      transparent 3px 6px\n    );\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/usage-meter/UsageMeterStats.vue"
    },
    {
      "path": "registry/new-york/usage-meter/index.ts",
      "content": "export { default as UsageMeter } from './UsageMeter.vue';\nexport { default as UsageMeterBars } from './UsageMeterBars.vue';\nexport { default as UsageMeterNumber } from './UsageMeterNumber.vue';\nexport { default as UsageMeterStats } from './UsageMeterStats.vue';\nexport type {\n  UsageMeterBarsProps,\n  UsageMeterCategory,\n  UsageMeterDay,\n  UsageMeterNumberProps,\n  UsageMeterProps,\n  UsageMeterRange,\n  UsageMeterStat,\n  UsageMeterStatsProps,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/usage-meter/index.ts"
    },
