{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "comet-dial",
  "type": "registry:ui",
  "title": "Comet Dial",
  "description": "Circular dial you set by angle, with a comet trail that streaks behind the head when it moves fast and flick momentum.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/comet-dial/CometDial.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n  import { animate, useMotionValue } from 'motion-v';\n  import { usePreferredReducedMotion } from '@vueuse/core';\n  import {\n    arcPath,\n    clamp,\n    decimalsOf,\n    pointAt,\n    velocityOf,\n  } from './comet-dial-math';\n  import type {\n    CometDialChangeEndDetail,\n    CometDialGrip,\n    CometDialProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<CometDialProps>(), {\n    modelValue: undefined,\n    defaultValue: 62,\n    min: 0,\n    max: 100,\n    step: 1,\n    unit: '%',\n    label: 'Level',\n    accent: '#f5f5f5',\n    ink: '#fdfdfd',\n    size: 250,\n    sweep: 320,\n    thickness: 5,\n    speed: 25,\n    tapBounce: 0.2,\n    flickBounce: 0.1,\n    momentum: 1,\n    cometReach: 180,\n    cometWidth: 12,\n    disabled: false,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    'update:modelValue': [value: number];\n    changeEnd: [value: number, detail: CometDialChangeEndDetail];\n  }>();\n\n  const DEAD = 44;\n  const K = 12;\n  const V_FULL = 4;\n  const V_FLICK = 2;\n  const TAU_FOLLOW = 0.06;\n  const TAU_V = 0.05;\n  const DECEL = 0.99;\n  const DRAG_PX = 10;\n  const STALE_MS = 80;\n\n  const motionPref = usePreferredReducedMotion();\n  const reduce = computed(() => motionPref.value === 'reduce');\n\n  const range = computed(() => Math.max(1e-9, props.max - props.min));\n  const gap = computed(() => 360 - props.sweep);\n  const start = computed(() => 90 + gap.value / 2);\n  const end = computed(() => start.value + props.sweep);\n  const decimals = computed(() => decimalsOf(props.step));\n  const stiffness = computed(\n    () => 200 + (clamp(props.speed, 0, 100) / 100) * 700,\n  );\n  const crit = computed(() => 2 * Math.sqrt(stiffness.value));\n  const trackPath = computed(() => arcPath(start.value, end.value));\n  const headR = computed(() => props.thickness * 1.8);\n\n  const rootStyle = computed(() => ({\n    '--cd-accent': props.accent,\n    '--cd-ink': props.ink,\n    '--cd-size': `${props.size}px`,\n    '--cd-figure': `${Math.round(props.size * 0.16)}px`,\n  }));\n\n  function snap(v: number): number {\n    const { min, max, step } = props;\n    return step > 0\n      ? clamp(Math.round((v - min) / step) * step + min, min, max)\n      : clamp(v, min, max);\n  }\n\n  let target = clamp(\n    props.modelValue ?? props.defaultValue,\n    props.min,\n    props.max,\n  );\n  const initialValue = target;\n  const initialText = `${target}${props.unit}`;\n  const initialFigure = target.toFixed(decimalsOf(props.step));\n  const initialAngle =\n    90 +\n    (360 - props.sweep) / 2 +\n    clamp((target - props.min) / Math.max(1e-9, props.max - props.min), 0, 1) *\n      props.sweep;\n  const initialLit = arcPath(90 + (360 - props.sweep) / 2, initialAngle);\n  const [initialCx, initialCy] = pointAt(initialAngle);\n\n  const dragging = ref(false);\n  const svgRef = ref<SVGSVGElement | null>(null);\n  const litRef = ref<SVGPathElement | null>(null);\n  const headRef = ref<SVGCircleElement | null>(null);\n  const figureRef = ref<HTMLSpanElement | null>(null);\n  const comet: SVGPathElement[] = [];\n\n  let grip: CometDialGrip | null = null;\n  let unbind: (() => void) | null = null;\n  let raf = 0;\n  let last = 0;\n  let vel = 0;\n  let rPrev: number | null = null;\n  let text = '';\n  let valueText = '';\n\n  const reading = useMotionValue(target);\n\n  function setComet(el: unknown, j: number) {\n    if (el instanceof SVGPathElement) comet[j] = el;\n  }\n\n  function commit(\n    v: number,\n    finished: boolean,\n    detail?: CometDialChangeEndDetail,\n  ) {\n    const s = snap(v);\n    if (s !== target) {\n      target = s;\n      emit('update:modelValue', s);\n    }\n    if (finished)\n      emit('changeEnd', s, detail ?? { velocity: 0, bounce: props.tapBounce });\n  }\n\n  function wake() {\n    if (raf) return;\n    last = performance.now();\n    rPrev = null;\n    raf = requestAnimationFrame(paint);\n  }\n\n  function launch(\n    to: number,\n    bounce: number,\n    velocity = reading.getVelocity(),\n  ) {\n    reading.stop();\n    if (reduce.value) {\n      reading.jump(to);\n      wake();\n      return;\n    }\n    animate(reading, to, {\n      type: 'spring',\n      stiffness: stiffness.value,\n      damping: crit.value * (1 - clamp(bounce, 0, 0.9)),\n      mass: 1,\n      velocity,\n    });\n    wake();\n  }\n\n  function paint(now: number) {\n    const svg = svgRef.value;\n    if (!svg) {\n      raf = 0;\n      return;\n    }\n    const dt = clamp((now - last) / 1000, 0, 0.05);\n    last = now;\n    const g = grip;\n    if (g && g.at != null) {\n      if (reduce.value) reading.jump(g.at);\n      else\n        reading.set(\n          reading.get() +\n            (g.at - reading.get()) * (1 - Math.exp(-dt / TAU_FOLLOW)),\n        );\n    }\n    const r = reading.get();\n    const vRaw =\n      rPrev == null || dt === 0 || reduce.value\n        ? 0\n        : (r - rPrev) / dt / range.value;\n    rPrev = r;\n    vel += (vRaw - vel) * (1 - Math.exp(-dt / TAU_V));\n    const s = clamp(Math.abs(vel) / V_FULL, 0, 1);\n    const dir = Math.sign(vel) || 1;\n    const f = clamp((r - props.min) / range.value, 0, 1);\n    const a0s = start.value;\n    const a1e = end.value;\n    const ang = a0s + f * props.sweep;\n    litRef.value?.setAttribute('d', f > 0.0005 ? arcPath(a0s, ang) : '');\n    if (headRef.value) {\n      const [cx, cy] = pointAt(ang);\n      headRef.value.setAttribute('cx', cx.toFixed(3));\n      headRef.value.setAttribute('cy', cy.toFixed(3));\n    }\n    const seg = (props.cometReach * s) / K;\n    for (let j = 0; j < K; j++) {\n      const el = comet[j];\n      if (!el) continue;\n      let a0 = dir > 0 ? ang - (j + 1) * seg : ang + j * seg;\n      let a1 = dir > 0 ? ang - j * seg : ang + (j + 1) * seg;\n      a0 = clamp(a0, a0s, a1e);\n      a1 = clamp(a1, a0s, a1e);\n      if (seg < 0.01 || a1 - a0 < 0.01) {\n        if (el.style.opacity !== '0') el.style.opacity = '0';\n        continue;\n      }\n      const w = 1 - j / K;\n      el.setAttribute('d', arcPath(a0, a1));\n      el.setAttribute(\n        'stroke-width',\n        (props.thickness + props.cometWidth * w * s).toFixed(2),\n      );\n      el.style.opacity = (w * s).toFixed(3);\n    }\n    const shown = clamp(r, props.min, props.max).toFixed(decimals.value);\n    if (shown !== text) {\n      text = shown;\n      if (figureRef.value) figureRef.value.textContent = shown;\n      svg.setAttribute('aria-valuenow', shown);\n    }\n    const vt = `${target}${props.unit}`;\n    if (vt !== valueText) {\n      valueText = vt;\n      svg.setAttribute('aria-valuetext', vt);\n    }\n    const moving = !!g || reading.isAnimating() || Math.abs(vel) > 0.002;\n    if (!moving) {\n      for (const el of comet)\n        if (el && el.style.opacity !== '0') el.style.opacity = '0';\n    }\n    raf = moving ? requestAnimationFrame(paint) : 0;\n  }\n\n  function localPoint(cx: number, cy: number): [number, number] {\n    const svg = svgRef.value;\n    if (!svg) return [0, 0];\n    const b = svg.getBoundingClientRect();\n    return [\n      ((cx - b.left) / b.width) * 200 - 100,\n      ((cy - b.top) / b.height) * 200 - 100,\n    ];\n  }\n\n  function angleAt(cx: number, cy: number): number {\n    const [x, y] = localPoint(cx, cy);\n    const sweep = props.sweep;\n    let rel = ((Math.atan2(y, x) * 180) / Math.PI - start.value + 720) % 360;\n    const g = grip;\n    if (rel > sweep) {\n      if (g && g.side) rel = g.side === 'hi' ? sweep : 0;\n      else rel = rel < sweep + gap.value / 2 ? sweep : 0;\n    } else if (g) g.side = rel > sweep / 2 ? 'hi' : 'lo';\n    return props.min + (rel / sweep) * range.value;\n  }\n\n  function onWindowMove(e: PointerEvent) {\n    const g = grip;\n    if (!e.isTrusted || !g || g.id !== e.pointerId) return;\n    if (!g.moved) {\n      if (Math.hypot(e.clientX - g.x0, e.clientY - g.y0) < DRAG_PX) return;\n      g.moved = true;\n      reading.stop();\n    }\n    g.at = angleAt(e.clientX, e.clientY);\n    g.hist.push([performance.now(), g.at]);\n    if (g.hist.length > 4) g.hist.shift();\n    commit(g.at, false);\n    wake();\n  }\n\n  function onWindowUp(e: PointerEvent) {\n    const g = grip;\n    if (!e.isTrusted || !g || g.id !== e.pointerId) return;\n    grip = null;\n    unbind?.();\n    unbind = null;\n    dragging.value = false;\n    try {\n      svgRef.value?.releasePointerCapture(e.pointerId);\n    } catch {\n      // Already released.\n    }\n    if (!g.moved) {\n      commit(target, true);\n      return;\n    }\n    const lastSample = g.hist[g.hist.length - 1];\n    const stale = !lastSample || performance.now() - lastSample[0] > STALE_MS;\n    const v = e.type === 'pointercancel' || stale ? 0 : velocityOf(g.hist);\n    const bounce =\n      props.tapBounce +\n      (props.flickBounce - props.tapBounce) *\n        clamp(Math.abs(v) / range.value / V_FLICK, 0, 1);\n    const to = snap(\n      (g.at ?? target) + (v / 1000) * (DECEL / (1 - DECEL)) * props.momentum,\n    );\n    commit(to, true, { velocity: v, bounce });\n    launch(to, bounce, v);\n  }\n\n  function onPointerDown(e: PointerEvent) {\n    if (props.disabled || grip || e.button > 0) return;\n    const [x, y] = localPoint(e.clientX, e.clientY);\n    if (Math.hypot(x, y) < DEAD) return;\n    e.preventDefault();\n    const svg = svgRef.value;\n    if (!svg) return;\n    try {\n      svg.setPointerCapture(e.pointerId);\n    } catch {\n      // Pointer already gone.\n    }\n    svg.focus({ preventScroll: true });\n    grip = {\n      id: e.pointerId,\n      at: null,\n      hist: [],\n      side: null,\n      moved: false,\n      x0: e.clientX,\n      y0: e.clientY,\n    };\n    const at = angleAt(e.clientX, e.clientY);\n    grip.hist.push([performance.now(), at]);\n    dragging.value = true;\n    commit(at, false);\n    launch(snap(at), props.tapBounce);\n    window.addEventListener('pointermove', onWindowMove);\n    window.addEventListener('pointerup', onWindowUp);\n    window.addEventListener('pointercancel', onWindowUp);\n    unbind = () => {\n      window.removeEventListener('pointermove', onWindowMove);\n      window.removeEventListener('pointerup', onWindowUp);\n      window.removeEventListener('pointercancel', onWindowUp);\n    };\n  }\n\n  function onKeyDown(e: KeyboardEvent) {\n    if (props.disabled) return;\n    const t = target;\n    const step = props.step;\n    const big = e.shiftKey ? 10 : 1;\n    let to: number;\n    switch (e.key) {\n      case 'ArrowRight':\n      case 'ArrowUp':\n        to = t + step * big;\n        break;\n      case 'ArrowLeft':\n      case 'ArrowDown':\n        to = t - step * big;\n        break;\n      case 'PageUp':\n        to = t + step * 10;\n        break;\n      case 'PageDown':\n        to = t - step * 10;\n        break;\n      case 'Home':\n        to = props.min;\n        break;\n      case 'End':\n        to = props.max;\n        break;\n      default:\n        return;\n    }\n    e.preventDefault();\n    to = snap(to);\n    reading.stop();\n    reading.jump(to);\n    commit(to, true);\n    wake();\n  }\n\n  function repaint() {\n    text = '';\n    valueText = '';\n    paint(performance.now());\n  }\n\n  onMounted(repaint);\n\n  watch(\n    [\n      () => props.min,\n      () => props.max,\n      () => props.step,\n      () => props.sweep,\n      () => props.thickness,\n      () => props.cometReach,\n      () => props.cometWidth,\n      () => props.unit,\n    ],\n    repaint,\n    { flush: 'post' },\n  );\n\n  watch(\n    () => props.modelValue,\n    (value) => {\n      if (value === undefined || grip) return;\n      const s = snap(value);\n      if (s === target) return;\n      target = s;\n      launch(s, props.tapBounce);\n    },\n  );\n\n  onBeforeUnmount(() => {\n    cancelAnimationFrame(raf);\n    unbind?.();\n    reading.stop();\n  });\n</script>\n\n<template>\n  <div\n    :class=\"['comet-dial', props.class]\"\n    :data-dragging=\"dragging ? '' : undefined\"\n    :data-disabled=\"disabled ? '' : undefined\"\n    :style=\"rootStyle\"\n  >\n    <svg\n      ref=\"svgRef\"\n      class=\"comet-dial__ring\"\n      viewBox=\"0 0 200 200\"\n      role=\"slider\"\n      :tabindex=\"disabled ? -1 : 0\"\n      :aria-label=\"label\"\n      :aria-valuemin=\"min\"\n      :aria-valuemax=\"max\"\n      :aria-valuenow=\"initialValue\"\n      :aria-valuetext=\"initialText\"\n      :aria-disabled=\"disabled || undefined\"\n      @pointerdown=\"onPointerDown\"\n      @keydown=\"onKeyDown\"\n    >\n      <path\n        class=\"comet-dial__track\"\n        :d=\"trackPath\"\n        :stroke-width=\"thickness\"\n      />\n      <path\n        ref=\"litRef\"\n        class=\"comet-dial__lit\"\n        :d=\"initialLit\"\n        :stroke-width=\"thickness\"\n      />\n      <g class=\"comet-dial__comet\">\n        <path\n          v-for=\"j in K\"\n          :key=\"j\"\n          :ref=\"(el) => setComet(el, j - 1)\"\n          style=\"opacity: 0\"\n        />\n      </g>\n      <circle\n        ref=\"headRef\"\n        class=\"comet-dial__head\"\n        :cx=\"initialCx\"\n        :cy=\"initialCy\"\n        :r=\"headR\"\n      />\n    </svg>\n    <div class=\"comet-dial__readout\" aria-hidden=\"true\">\n      <span class=\"comet-dial__value\">\n        <span ref=\"figureRef\" class=\"comet-dial__figure\">{{\n          initialFigure\n        }}</span>\n        <span v-if=\"unit\" class=\"comet-dial__unit\">{{ unit }}</span>\n      </span>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .comet-dial {\n    position: relative;\n    width: var(--cd-size);\n    height: var(--cd-size);\n    color: var(--cd-ink);\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .comet-dial__ring {\n    position: absolute;\n    inset: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    outline: none;\n    cursor: grab;\n    touch-action: none;\n  }\n\n  .comet-dial__ring:focus-visible {\n    outline: 2px solid var(--cd-accent);\n    outline-offset: 4px;\n  }\n\n  .comet-dial[data-dragging] .comet-dial__ring {\n    cursor: grabbing;\n  }\n\n  .comet-dial__track,\n  .comet-dial__lit,\n  .comet-dial__comet path {\n    fill: none;\n    stroke-linecap: round;\n  }\n\n  .comet-dial__track {\n    stroke: var(--cd-ink);\n    opacity: 0.24;\n  }\n\n  .comet-dial__lit {\n    stroke: var(--cd-accent);\n    opacity: 0.7;\n  }\n\n  .comet-dial__comet path {\n    stroke: var(--cd-accent);\n  }\n\n  .comet-dial__head {\n    fill: var(--cd-accent);\n  }\n\n  .comet-dial__readout {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-items: center;\n    pointer-events: none;\n  }\n\n  .comet-dial__value {\n    display: inline-flex;\n    align-items: baseline;\n    gap: 0.06em;\n    font-size: var(--cd-figure);\n    font-weight: 500;\n    line-height: 1;\n    letter-spacing: -0.04em;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .comet-dial__unit {\n    font-size: 0.5em;\n    opacity: 0.5;\n  }\n\n  .comet-dial[data-disabled] {\n    opacity: 0.55;\n  }\n\n  .comet-dial[data-disabled] .comet-dial__ring {\n    cursor: default;\n    pointer-events: none;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/comet-dial/CometDial.vue"
    },
    {
      "path": "registry/new-york/comet-dial/comet-dial-math.ts",
      "content": "/** Ring radius in the 200×200 viewBox. */\nconst RING_R = 80;\n\nexport function clamp(v: number, lo: number, hi: number): number {\n  return Math.min(hi, Math.max(lo, v));\n}\n\nexport function velocityOf(hist: Array<[number, number]>): number {\n  const a = hist[0];\n  const b = hist[hist.length - 1];\n  if (!a || !b || hist.length < 2) return 0;\n  return ((b[1] - a[1]) / Math.max(1, b[0] - a[0])) * 1000;\n}\n\nexport function decimalsOf(step: number): number {\n  const s = String(step);\n  const i = s.indexOf('.');\n  return i === -1 ? 0 : s.length - i - 1;\n}\n\nexport function pointAt(deg: number): [number, number] {\n  const a = (deg * Math.PI) / 180;\n  return [100 + Math.cos(a) * RING_R, 100 + Math.sin(a) * RING_R];\n}\n\nexport function arcPath(a0: number, a1: number): string {\n  const [x0, y0] = pointAt(a0);\n  const [x1, y1] = pointAt(a1);\n  return `M ${x0.toFixed(3)} ${y0.toFixed(3)} A ${RING_R} ${RING_R} 0 ${a1 - a0 > 180 ? 1 : 0} 1 ${x1.toFixed(3)} ${y1.toFixed(3)}`;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/comet-dial/comet-dial-math.ts"
    },
    {
      "path": "registry/new-york/comet-dial/index.ts",
      "content": "export { default as CometDial } from './CometDial.vue';\nexport type { CometDialProps, CometDialChangeEndDetail } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/comet-dial/index.ts"
    },
    {
      "path": "registry/new-york/comet-dial/types.ts",
      "content": "/**\n * Props for the CometDial registry component.\n */\nexport interface CometDialProps {\n  /** Controlled value (v-model). A change from outside launches the reading on the tap spring. */\n  modelValue?: number;\n  /** Initial value when uncontrolled. */\n  defaultValue?: number;\n  /** Lowest value. */\n  min?: number;\n  /** Highest value. */\n  max?: number;\n  /** Snapping grid, and the keyboard nudge. */\n  step?: number;\n  /** Suffix after the figure. Empty hides it. */\n  unit?: string;\n  /** Accessible name of the slider. */\n  label?: string;\n  /** The lit arc, the bead and the comet. */\n  accent?: string;\n  /** The track and the readout. */\n  ink?: string;\n  /** Diameter in pixels. Everything inside scales with it. */\n  size?: number;\n  /** Degrees the arc covers, with the gap centred at the bottom. */\n  sweep?: number;\n  /** Stroke width of the track and the arc. The bead follows it. */\n  thickness?: number;\n  /** How quickly the reading arrives, 0 to 100. */\n  speed?: number;\n  /** Ring-down after a tap. 0 stops dead. */\n  tapBounce?: number;\n  /** Ring-down after a full-speed flick. */\n  flickBounce?: number;\n  /** How far a flick carries the reading past where you let go. */\n  momentum?: number;\n  /** Degrees of trail behind the bead at full speed. */\n  cometReach?: number;\n  /** Extra stroke width at the head of the trail at full speed. */\n  cometWidth?: number;\n  /** Dims the dial and ignores input. */\n  disabled?: boolean;\n  /** Additional classes on the root element. */\n  class?: string;\n}\n\n/** Detail passed with `change-end`. */\nexport interface CometDialChangeEndDetail {\n  /** Release velocity in value units per second. */\n  velocity: number;\n  /** Bounce the release earned. */\n  bounce: number;\n}\n\n/** Internal drag state while the ring is held. */\nexport interface CometDialGrip {\n  id: number;\n  at: number | null;\n  hist: Array<[number, number]>;\n  side: 'lo' | 'hi' | null;\n  moved: boolean;\n  x0: number;\n  y0: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/comet-dial/types.ts"
    }
  ]
}
