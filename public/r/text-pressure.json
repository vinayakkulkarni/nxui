{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "text-pressure",
  "type": "registry:ui",
  "title": "Text Pressure",
  "description": "Variable-font letters that swell near the cursor, with click ripples, idle wave or pulse motion and a pressure color.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/text-pressure/TextPressure.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, ref, watch } from 'vue';\n  import {\n    useEventListener,\n    useIntersectionObserver,\n    usePreferredReducedMotion,\n    useRafFn,\n    useResizeObserver,\n    useStyleTag,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import {\n    MAX_RIPPLES,\n    RIPPLE_LIFE,\n    ROBOTO_FLEX_URL,\n    clamp01,\n    dist,\n    getIdlePressure,\n    getRipplePressure,\n  } from './text-pressure-math';\n  import type { ComponentPublicInstance, CSSProperties } from 'vue';\n  import type {\n    TextPressureApplied,\n    TextPressurePoint,\n    TextPressureProps,\n    TextPressureRipple,\n  } from './types';\n\n  const props = withDefaults(defineProps<TextPressureProps>(), {\n    text: 'Compressa',\n    fontFamily: 'Roboto Flex',\n    fontUrl: ROBOTO_FLEX_URL,\n    width: true,\n    weight: true,\n    italic: true,\n    alpha: false,\n    flex: true,\n    stroke: false,\n    scale: false,\n    radius: 0.5,\n    smoothing: 0.5,\n    idle: 'none',\n    idleSpeed: 1,\n    clickRipple: true,\n    textColor: 'currentColor',\n    pressureColor: '',\n    strokeColor: '#FF0000',\n    strokeWidth: 3,\n    minFontSize: 24,\n    class: '',\n  });\n\n  const containerRef = ref<HTMLDivElement | null>(null);\n  const titleRef = ref<HTMLHeadingElement | null>(null);\n  const spans: (HTMLSpanElement | null)[] = [];\n  const fontSize = ref(props.minFontSize);\n  const scaleY = ref(1);\n  const visible = ref(true);\n  const reducedMotion = usePreferredReducedMotion();\n\n  const chars = computed(() => Array.from(props.text));\n\n  useStyleTag(computed(() => `@import url('${props.fontUrl}');`));\n\n  const mouse: TextPressurePoint = { x: 0, y: 0 };\n  const cursor = { x: 0, y: 0, seen: false };\n  const ripples: TextPressureRipple[] = [];\n  let applied: (TextPressureApplied | null)[] = [];\n  let last = 0;\n  let idleFrames = 0;\n  let clock = 0;\n  let engage = props.idle === 'wave' || props.idle === 'pulse' ? 0 : 1;\n\n  function setSpanRef(\n    index: number,\n    el: Element | ComponentPublicInstance | null,\n  ): void {\n    spans[index] = el instanceof HTMLSpanElement ? el : null;\n  }\n\n  function tick(now: number): boolean {\n    const container = containerRef.value;\n    const title = titleRef.value;\n    if (!container || !title) return false;\n    const elapsed = last ? Math.min(now - last, 64) : 1000 / 60;\n    last = now;\n\n    const idleMode =\n      (props.idle === 'wave' || props.idle === 'pulse') &&\n      reducedMotion.value !== 'reduce'\n        ? props.idle\n        : 'none';\n    const lag = 1000 * props.smoothing * props.smoothing;\n    const follow = lag > 1 ? 1 - Math.exp(-elapsed / lag) : 1;\n    mouse.x += (cursor.x - mouse.x) * follow;\n    mouse.y += (cursor.y - mouse.y) * follow;\n\n    let present = 1;\n    if (idleMode !== 'none') {\n      const box = container.getBoundingClientRect();\n      const inside =\n        cursor.x >= box.left &&\n        cursor.x <= box.right &&\n        cursor.y >= box.top &&\n        cursor.y <= box.bottom;\n      present = cursor.seen && inside ? 1 : 0;\n    }\n    engage += (present - engage) * (1 - Math.exp(-elapsed / 320));\n    if (Math.abs(present - engage) < 0.002) engage = present;\n    const idling = idleMode !== 'none' && engage < 1;\n    if (idling) clock += (elapsed / 1000) * props.idleSpeed;\n\n    while (ripples.length && now - ripples[0]!.start > RIPPLE_LIFE * 1000) {\n      ripples.shift();\n    }\n\n    const titleRect = title.getBoundingClientRect();\n    const maxDist = Math.max(titleRect.width * props.radius, 1);\n    const spread = Math.max(props.radius * 2, 0.2);\n    const centers = spans.map((span) => {\n      if (!span) return null;\n      const rect = span.getBoundingClientRect();\n      return { x: rect.x + rect.width / 2, y: rect.y + rect.height / 2 };\n    });\n\n    let changed = false;\n    spans.forEach((span, i) => {\n      const center = centers[i];\n      if (!span || !center) return;\n\n      let pressure = clamp01(1 - dist(mouse, center) / maxDist);\n      if (idling) {\n        const position =\n          (center.x - titleRect.left) / Math.max(titleRect.width, 1);\n        const resting = getIdlePressure(idleMode, position, clock, spread);\n        pressure = resting + (pressure - resting) * engage;\n      }\n      if (ripples.length) {\n        const swell = getRipplePressure(ripples, center, now, titleRect.width);\n        pressure = 1 - (1 - pressure) * (1 - swell);\n      }\n\n      const wdth = props.width ? Math.floor(5 + 200 * pressure) : 100;\n      const wght = props.weight ? Math.floor(100 + 900 * pressure) : 400;\n      const italVal = props.italic ? pressure.toFixed(2) : '0';\n      const alphaVal = props.alpha ? pressure.toFixed(2) : '';\n      const tint = Math.round((1 - (1 - pressure) * (1 - pressure)) * 100);\n      const color = props.pressureColor\n        ? `color-mix(in oklab, ${props.pressureColor} ${tint}%, ${props.textColor})`\n        : '';\n      const settings = `'wght' ${wght}, 'wdth' ${wdth}, 'ital' ${italVal}`;\n      const previous = applied[i];\n\n      if (\n        !previous ||\n        previous.span !== span ||\n        previous.settings !== settings ||\n        previous.alphaVal !== alphaVal ||\n        previous.color !== color\n      ) {\n        span.style.fontVariationSettings = settings;\n        span.style.opacity = alphaVal;\n        span.style.color = color;\n        applied[i] = { span, settings, alphaVal, color };\n        changed = true;\n      }\n    });\n\n    const moving =\n      Math.abs(cursor.x - mouse.x) > 0.1 || Math.abs(cursor.y - mouse.y) > 0.1;\n    const animating =\n      moving || idling || engage !== present || ripples.length > 0;\n    idleFrames = animating ? 0 : idleFrames + 1;\n    return animating || (changed && idleFrames < 60);\n  }\n\n  const { pause, resume, isActive } = useRafFn(\n    ({ timestamp }) => {\n      if (!tick(timestamp)) {\n        last = 0;\n        pause();\n      }\n    },\n    { immediate: false },\n  );\n\n  function wake(): void {\n    if (!isActive.value && visible.value) resume();\n  }\n\n  function track(x: number, y: number): void {\n    cursor.x = x;\n    cursor.y = y;\n    cursor.seen = true;\n    wake();\n  }\n\n  function onMouseMove(event: MouseEvent): void {\n    track(event.clientX, event.clientY);\n  }\n\n  function onTouch(event: TouchEvent): void {\n    const touch = event.touches[0];\n    if (touch) track(touch.clientX, touch.clientY);\n  }\n\n  function onLeave(): void {\n    cursor.seen = false;\n    wake();\n  }\n\n  function onPress(event: PointerEvent): void {\n    if (!props.clickRipple) return;\n    ripples.push({\n      x: event.clientX,\n      y: event.clientY,\n      start: performance.now(),\n    });\n    if (ripples.length > MAX_RIPPLES) ripples.shift();\n    wake();\n  }\n\n  useEventListener('mousemove', onMouseMove);\n  useEventListener('touchstart', onTouch, { passive: true });\n  useEventListener('touchmove', onTouch, { passive: true });\n  useEventListener('touchend', onLeave);\n  useEventListener('touchcancel', onLeave);\n  useEventListener('scroll', wake, { passive: true, capture: true });\n\n  useIntersectionObserver(containerRef, (entries) => {\n    const entry = entries[entries.length - 1];\n    if (!entry) return;\n    visible.value = entry.isIntersecting;\n    if (entry.isIntersecting) wake();\n    else pause();\n  });\n\n  function resize(): void {\n    const container = containerRef.value;\n    if (!container) return;\n    const { width: containerW, height: containerH } =\n      container.getBoundingClientRect();\n    const count = chars.value.length;\n    const next = Math.max(\n      count ? containerW / (count / 2) : props.minFontSize,\n      props.minFontSize,\n    );\n    fontSize.value = next;\n    scaleY.value = props.scale && containerH > 0 ? containerH / next : 1;\n  }\n\n  useResizeObserver(containerRef, resize);\n\n  watch(\n    [() => chars.value.length, () => props.minFontSize, () => props.scale],\n    resize,\n  );\n\n  watch(props, wake);\n\n  watch([fontSize, scaleY, chars], () => {\n    applied = [];\n    wake();\n  });\n\n  onMounted(() => {\n    useEventListener(document.documentElement, 'mouseleave', onLeave);\n    useEventListener(document.fonts, 'loadingdone', wake);\n    const container = containerRef.value;\n    if (container) {\n      const { left, top, width, height } = container.getBoundingClientRect();\n      mouse.x = left + width / 2;\n      mouse.y = top + height / 2;\n      cursor.x = mouse.x;\n      cursor.y = mouse.y;\n    }\n    resize();\n    wake();\n  });\n\n  const titleStyle = computed<CSSProperties>(() => ({\n    fontFamily: props.fontFamily,\n    fontSize: `${fontSize.value}px`,\n    transform: `scale(1, ${scaleY.value})`,\n    color: props.textColor,\n    '--text-pressure-stroke-width': `${props.strokeWidth}px`,\n    '--text-pressure-stroke-color': props.strokeColor,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"containerRef\"\n    :class=\"cn('relative size-full bg-transparent', props.class)\"\n    @pointerdown=\"onPress\"\n  >\n    <h1\n      ref=\"titleRef\"\n      :aria-label=\"text\"\n      :class=\"\n        cn(\n          'm-0 w-full origin-top text-center leading-none font-thin whitespace-nowrap uppercase select-none',\n          flex && 'flex justify-between',\n          stroke && 'is-stroke',\n        )\n      \"\n      :style=\"titleStyle\"\n    >\n      <span\n        v-for=\"(char, i) in chars\"\n        :key=\"i\"\n        :ref=\"(el) => setSpanRef(i, el)\"\n        :data-char=\"char\"\n        aria-hidden=\"true\"\n        class=\"inline-block\"\n      >\n        {{ char }}\n      </span>\n    </h1>\n  </div>\n</template>\n\n<style scoped>\n  .is-stroke span {\n    position: relative;\n  }\n\n  .is-stroke span::after {\n    content: attr(data-char);\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: transparent;\n    z-index: -1;\n    -webkit-text-stroke-width: var(--text-pressure-stroke-width);\n    -webkit-text-stroke-color: var(--text-pressure-stroke-color);\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/text-pressure/TextPressure.vue"
    },
    {
      "path": "registry/new-york/text-pressure/index.ts",
      "content": "export { default as TextPressure } from './TextPressure.vue';\nexport type { TextPressureIdle, TextPressureProps } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/text-pressure/index.ts"
    },
    {
      "path": "registry/new-york/text-pressure/text-pressure-math.ts",
      "content": "import type {\n  TextPressureIdle,\n  TextPressurePoint,\n  TextPressureRipple,\n} from './types';\n\nexport const RIPPLE_LIFE = 1.3;\nexport const MAX_RIPPLES = 6;\nconst WAVE_PERIOD = 3.2;\nconst PULSE_PERIOD = 2.8;\nconst PULSE_DEPTH = 0.42;\n\nexport const ROBOTO_FLEX_URL =\n  'https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,100..1000&display=swap';\n\nexport function dist(a: TextPressurePoint, b: TextPressurePoint): number {\n  const dx = b.x - a.x;\n  const dy = b.y - a.y;\n  return Math.sqrt(dx * dx + dy * dy);\n}\n\nexport function clamp01(value: number): number {\n  return Math.min(1, Math.max(0, value));\n}\n\nexport function getIdlePressure(\n  mode: TextPressureIdle,\n  position: number,\n  clock: number,\n  spread: number,\n): number {\n  if (mode === 'wave') {\n    const crest =\n      0.5 +\n      0.5 * Math.cos(Math.PI * 2 * (position / spread - clock / WAVE_PERIOD));\n    return crest * crest;\n  }\n  if (mode === 'pulse') {\n    const lag = Math.abs(position - 0.5) * 0.4;\n    const breath =\n      0.5 - 0.5 * Math.cos(Math.PI * 2 * (clock / PULSE_PERIOD - lag));\n    return PULSE_DEPTH * breath * breath * (3 - 2 * breath);\n  }\n  return 0;\n}\n\nexport function getRipplePressure(\n  ripples: TextPressureRipple[],\n  point: TextPressurePoint,\n  now: number,\n  span: number,\n): number {\n  const band = Math.max(span * 0.14, 32);\n  let total = 0;\n  for (const ripple of ripples) {\n    const age = (now - ripple.start) / 1000;\n    if (age <= 0 || age >= RIPPLE_LIFE) continue;\n    const offset = (dist(ripple, point) - age * span * 1.25) / band;\n    if (offset <= -1 || offset >= 1) continue;\n    const fade = 1 - age / RIPPLE_LIFE;\n    const swell =\n      (1 - offset * offset) ** 2 * fade * fade * Math.min(1, age / 0.06);\n    total = 1 - (1 - total) * (1 - swell);\n  }\n  return total;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/text-pressure/text-pressure-math.ts"
    },
    {
      "path": "registry/new-york/text-pressure/types.ts",
      "content": "export type TextPressureIdle = 'none' | 'wave' | 'pulse';\n\nexport interface TextPressurePoint {\n  x: number;\n  y: number;\n}\n\nexport interface TextPressureRipple extends TextPressurePoint {\n  start: number;\n}\n\nexport interface TextPressureApplied {\n  span: HTMLSpanElement;\n  settings: string;\n  alphaVal: string;\n  color: string;\n}\n\nexport interface TextPressureProps {\n  /** Text content that will be displayed and animated. */\n  text?: string;\n  /** Name of the variable font family. */\n  fontFamily?: string;\n  /** Stylesheet URL that loads the variable font. Needs width, weight and italic axes. */\n  fontUrl?: string;\n  /** Varies the width axis of the font with pressure. */\n  width?: boolean;\n  /** Varies the weight axis of the font with pressure. */\n  weight?: boolean;\n  /** Varies the italic axis of the font with pressure. */\n  italic?: boolean;\n  /** Fades letters out the further they are from the cursor. */\n  alpha?: boolean;\n  /** Spreads the letters across the full width. */\n  flex?: boolean;\n  /** Draws an outline behind each letter. */\n  stroke?: boolean;\n  /** Stretches the text vertically to fill the height of its container. */\n  scale?: boolean;\n  /** How far the cursor's pull reaches, as a fraction of the text width. */\n  radius?: number;\n  /** How softly the letters follow the cursor, from 0 (instant) to 1 (floaty). */\n  smoothing?: number;\n  /** What the letters do while the pointer is away. */\n  idle?: TextPressureIdle;\n  /** Speed of the idle wave or pulse. */\n  idleSpeed?: number;\n  /** Clicking sends a wave of pressure rippling outward through the letters. */\n  clickRipple?: boolean;\n  /** Fill color of the text. */\n  textColor?: string;\n  /** Letters blend toward this color as they swell. Empty keeps one color. */\n  pressureColor?: string;\n  /** Color of the outline when stroke is on. */\n  strokeColor?: string;\n  /** Width of the outline when stroke is on, in px. */\n  strokeWidth?: number;\n  /** Minimum font size in px. */\n  minFontSize?: number;\n  /** Classes merged onto the heading. */\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/text-pressure/types.ts"
    }
  ]
}
