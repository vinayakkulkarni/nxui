{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "equipment-panel",
  "type": "registry:ui",
  "title": "Equipment Panel",
  "description": "A home-energy equipment card with three LCD readouts, an All/Alerts filtered device table and rows that open to a live chart.",
  "dependencies": ["@vueuse/core"],
  "registryDependencies": ["https://nxui.geoql.in/r/segment-display.json"],
  "files": [
    {
      "path": "registry/new-york/equipment-panel/EquipmentPanel.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref, useTemplateRef, watch } from 'vue';\n  import {\n    useElementVisibility,\n    useIntervalFn,\n    usePreferredReducedMotion,\n    useTimeoutFn,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import SegmentDisplay from '../segment-display/SegmentDisplay.vue';\n  import EquipmentPanelBar from './EquipmentPanelBar.vue';\n  import EquipmentPanelRow from './EquipmentPanelRow.vue';\n  import {\n    DEFAULT_DEVICES,\n    DEFAULT_TILES,\n    GREEN,\n    ORANGE,\n    wobble,\n  } from './equipment-panel';\n  import type {\n    EquipmentDevice,\n    EquipmentFilter,\n    EquipmentLive,\n    EquipmentPanelProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<EquipmentPanelProps>(), {\n    title: 'Equipment',\n    subtitle: undefined,\n    icon: 'lucide:text',\n    tiles: () => DEFAULT_TILES,\n    devices: () => DEFAULT_DEVICES,\n    expanded: undefined,\n    filter: undefined,\n    live: true,\n    firmware: 'Firmware 26.4.1 · up to date',\n    addLabel: 'Add device',\n    accent: ORANGE,\n    okColor: GREEN,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    'update:expanded': [id: string | null];\n    'update:filter': [value: EquipmentFilter];\n    action: [device: EquipmentDevice];\n    add: [];\n  }>();\n\n  // Open row and filter work with or without v-model.\n  const openId = ref<string | null>(props.expanded ?? 'inverter');\n  watch(\n    () => props.expanded,\n    (v) => {\n      if (v !== undefined) openId.value = v;\n    },\n  );\n  const mode = ref<EquipmentFilter>(props.filter ?? 'all');\n  watch(\n    () => props.filter,\n    (v) => {\n      if (v !== undefined) mode.value = v;\n    },\n  );\n\n  function toggle(id: string): void {\n    openId.value = openId.value === id ? null : id;\n    emit('update:expanded', openId.value);\n  }\n\n  function setFilter(value: EquipmentFilter): void {\n    mode.value = value;\n    emit('update:filter', value);\n  }\n\n  const alerts = computed(() =>\n    props.devices.filter((d) => d.status === 'warn'),\n  );\n  const rows = computed(() =>\n    mode.value === 'alerts' ? alerts.value : props.devices,\n  );\n  const subtitleText = computed(\n    () =>\n      props.subtitle ??\n      `${props.devices.length} devices · ${alerts.value.length ? 'all reporting' : 'all healthy'}`,\n  );\n\n  const FILTERS: EquipmentFilter[] = ['all', 'alerts'];\n  function onFilterKeydown(event: KeyboardEvent): void {\n    if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;\n    event.preventDefault();\n    const next = mode.value === 'all' ? 'alerts' : 'all';\n    setFilter(next);\n    const list = event.currentTarget;\n    if (list instanceof HTMLElement) {\n      const tabs = list.querySelectorAll<HTMLButtonElement>('[role=\"tab\"]');\n      tabs[FILTERS.indexOf(next)]?.focus();\n    }\n  }\n\n  // Live values: a tick counter drives a small deterministic wobble.\n  const root = useTemplateRef<HTMLElement>('root');\n  const visible = useElementVisibility(root);\n  const reduced = usePreferredReducedMotion();\n  const tick = ref(0);\n  const { pause, resume } = useIntervalFn(() => (tick.value += 1), 1800, {\n    immediate: false,\n  });\n  watch(\n    [visible, reduced, () => props.live],\n    ([isVisible, motionPref, live]) => {\n      if (isVisible && live && motionPref !== 'reduce') resume();\n      else pause();\n    },\n    { immediate: true },\n  );\n\n  const tiles = computed(() =>\n    props.tiles.map((tile, i) => {\n      const f = wobble(\n        tick.value,\n        i + 1,\n        tile.key === 'battery' ? 0.008 : 0.03,\n      );\n      const value = tile.value * f;\n      return {\n        tile,\n        text: value.toFixed(tile.decimals ?? 0),\n        level: Math.min(1, tile.level * f),\n      };\n    }),\n  );\n\n  function series(base: number[], start: number): number[] {\n    const n = base.length;\n    const last = base[n - 1] ?? 0;\n    return Array.from({ length: n }, (_, i) => {\n      const k = start + i;\n      if (k < n) return base[k] ?? last;\n      return last + 0.55 * Math.sin(k * 0.62) + 0.3 * Math.sin(k * 1.7) - 0.2;\n    });\n  }\n\n  const live = computed(() =>\n    props.devices.map((d, i) => ({\n      power:\n        d.status === 'idle'\n          ? d.power\n          : d.power * wobble(tick.value, i + 4, 0.025),\n      temp: d.temp === null ? null : d.temp * wobble(tick.value, i + 9, 0.012),\n      points: d.chart ? series(d.chart.points, tick.value) : [],\n    })),\n  );\n  const EMPTY: number[] = [];\n  function liveOf(device: EquipmentDevice): EquipmentLive {\n    const i = props.devices.indexOf(device);\n    return (\n      live.value[i] ?? { power: device.power, temp: device.temp, points: EMPTY }\n    );\n  }\n\n  const busyId = ref<string | null>(null);\n  const { start: finishCheck } = useTimeoutFn(\n    () => (busyId.value = null),\n    1400,\n    { immediate: false },\n  );\n  function onAction(device: EquipmentDevice): void {\n    busyId.value = device.id;\n    finishCheck();\n    emit('action', device);\n  }\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    :class=\"\n      cn(\n        '@container w-full max-w-154 rounded-[28px] border border-border bg-card p-3 text-card-foreground shadow-[0_24px_60px_-20px_rgba(0,0,0,0.25)] dark:border-white/8 dark:bg-neutral-800/70 dark:shadow-[0_30px_70px_-20px_rgba(0,0,0,0.8),inset_0_1px_0_rgba(255,255,255,0.04)]',\n        props.class,\n      )\n    \"\n  >\n    <div class=\"flex items-center gap-3 px-1 pt-1 pb-3\">\n      <span\n        class=\"grid size-8.5 shrink-0 place-items-center rounded-full border border-border bg-muted shadow-sm dark:border-white/8 dark:bg-neutral-700/60\"\n      >\n        <Icon :name=\"props.icon\" class=\"size-4\" />\n      </span>\n      <div class=\"min-w-0 flex-1 leading-tight\">\n        <p class=\"truncate text-sm font-medium\">{{ props.title }}</p>\n        <p class=\"truncate text-[13px] text-muted-foreground\">\n          {{ subtitleText }}\n        </p>\n      </div>\n      <div\n        class=\"flex rounded-full border border-border bg-muted p-1 text-[13px] dark:border-white/6 dark:bg-black/25\"\n        role=\"tablist\"\n        aria-label=\"Filter devices\"\n        @keydown=\"onFilterKeydown\"\n      >\n        <button\n          v-for=\"f in FILTERS\"\n          :key=\"f\"\n          type=\"button\"\n          role=\"tab\"\n          :aria-selected=\"mode === f\"\n          :tabindex=\"mode === f ? 0 : -1\"\n          class=\"rounded-full px-3 py-1 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-orange-400/60\"\n          :class=\"\n            mode === f\n              ? 'bg-background text-foreground shadow-sm dark:bg-neutral-700/80'\n              : 'text-muted-foreground hover:text-foreground'\n          \"\n          @click=\"setFilter(f)\"\n        >\n          {{ f === 'all' ? 'All' : `Alerts ${alerts.length}` }}\n        </button>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-3 gap-2\">\n      <div\n        v-for=\"t in tiles\"\n        :key=\"t.tile.key\"\n        class=\"min-w-0 rounded-2xl border border-black bg-neutral-950 px-2.5 pt-2.5 pb-3 shadow-[inset_0_2px_12px_rgba(0,0,0,0.85)] @lg:px-3.5 dark:border-white/6\"\n      >\n        <div\n          class=\"flex items-baseline justify-between gap-2 text-[10px] tracking-widest uppercase @lg:text-xs\"\n          :style=\"{ color: props.accent }\"\n        >\n          <span class=\"font-medium opacity-60\">{{ t.tile.label }}</span>\n          <span\n            class=\"hidden truncate tracking-normal normal-case opacity-45 @md:inline\"\n            >{{ t.tile.note }}</span\n          >\n        </div>\n        <div class=\"mt-1.5 flex items-baseline gap-1.5 @lg:mt-2\">\n          <SegmentDisplay\n            :value=\"t.text\"\n            :color=\"t.tile.color\"\n            :ghost=\"0.1\"\n            class=\"text-[22px] @md:text-[28px] @lg:text-[34px]\"\n            :label=\"`${t.tile.label} ${t.text} ${t.tile.unit ?? ''}`\"\n          />\n          <span\n            class=\"text-[11px] @lg:text-[13px]\"\n            :style=\"{ color: props.accent }\"\n            >{{ t.tile.unit }}</span\n          >\n        </div>\n        <EquipmentPanelBar\n          :level=\"t.level\"\n          :cells=\"14\"\n          :color=\"t.tile.color\"\n          cell-class=\"h-2 flex-1 @lg:h-2.5\"\n          class=\"mt-2 w-full @lg:w-11/12\"\n        />\n      </div>\n    </div>\n\n    <div\n      class=\"mt-3 rounded-[22px] border border-border bg-neutral-50/60 p-1 dark:border-white/6 dark:bg-black/15\"\n    >\n      <div\n        class=\"grid grid-cols-[1.25rem_minmax(0,1fr)_4.5rem_2.75rem_1rem] gap-x-2 px-3 pt-2.5 pb-1.5 text-[13px] text-muted-foreground @md:grid-cols-[1.25rem_minmax(0,1fr)_6.75rem_5rem_3.5rem_1rem] @md:gap-x-3\"\n        aria-hidden=\"true\"\n      >\n        <span />\n        <span>Device</span>\n        <span class=\"hidden @md:inline\">Level</span>\n        <span class=\"text-right\">Power</span>\n        <span class=\"text-right\">Temp</span>\n        <span />\n      </div>\n      <TransitionGroup\n        tag=\"ul\"\n        class=\"relative\"\n        enter-from-class=\"opacity-0 -translate-y-1\"\n        leave-to-class=\"opacity-0\"\n        enter-active-class=\"transition duration-300\"\n        leave-active-class=\"absolute inset-x-0 transition duration-200\"\n        move-class=\"transition-transform duration-300\"\n      >\n        <EquipmentPanelRow\n          v-for=\"device in rows\"\n          :key=\"device.id\"\n          :device=\"device\"\n          :open=\"openId === device.id\"\n          :accent=\"props.accent\"\n          :ok-color=\"props.okColor\"\n          :power=\"liveOf(device).power\"\n          :temp=\"liveOf(device).temp\"\n          :points=\"liveOf(device).points\"\n          :busy=\"busyId === device.id\"\n          @toggle=\"toggle(device.id)\"\n          @action=\"onAction(device)\"\n        />\n      </TransitionGroup>\n    </div>\n\n    <div class=\"flex items-center justify-between gap-3 px-1 pt-3\">\n      <span\n        class=\"inline-flex min-w-0 items-center gap-2 text-[13px] text-muted-foreground\"\n      >\n        <span\n          class=\"size-1.5 shrink-0 rounded-full\"\n          :style=\"{\n            backgroundColor: props.okColor,\n            boxShadow: `0 0 6px ${props.okColor}`,\n          }\"\n        />\n        <span class=\"truncate\">{{ props.firmware }}</span>\n      </span>\n      <button\n        type=\"button\"\n        class=\"inline-flex h-9 shrink-0 items-center gap-1.5 rounded-full border border-border bg-muted px-4 text-sm font-medium transition-colors outline-none hover:bg-neutral-200 focus-visible:ring-2 focus-visible:ring-orange-400/60 dark:border-white/8 dark:bg-neutral-700/50 dark:hover:bg-neutral-700\"\n        @click=\"emit('add')\"\n      >\n        <Icon name=\"lucide:plus\" class=\"size-4\" />\n        {{ props.addLabel }}\n      </button>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/equipment-panel/EquipmentPanel.vue"
    },
    {
      "path": "registry/new-york/equipment-panel/EquipmentPanelBar.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import type { EquipmentBarProps } from './types';\n\n  const props = withDefaults(defineProps<EquipmentBarProps>(), {\n    cellClass: 'h-3 w-2',\n    trackClass: 'bg-white/7',\n  });\n\n  const lit = computed(() =>\n    Math.round(Math.min(1, Math.max(0, props.level)) * props.cells),\n  );\n  const cells = computed(() =>\n    Array.from({ length: props.cells }, (_, i) => i < lit.value),\n  );\n</script>\n\n<template>\n  <span\n    class=\"flex gap-0.75\"\n    role=\"meter\"\n    :aria-valuenow=\"Math.round(props.level * 100)\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n  >\n    <span\n      v-for=\"(on, i) in cells\"\n      :key=\"i\"\n      class=\"rounded-[2px] transition-[background-color,box-shadow] duration-500 motion-reduce:transition-none\"\n      :class=\"[props.cellClass, on ? '' : props.trackClass]\"\n      :style=\"\n        on\n          ? {\n              backgroundColor: props.color,\n              boxShadow: `0 0 5px ${props.color}66`,\n            }\n          : undefined\n      \"\n    />\n  </span>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/equipment-panel/EquipmentPanelBar.vue"
    },
    {
      "path": "registry/new-york/equipment-panel/EquipmentPanelChart.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, useTemplateRef } from 'vue';\n  import { useElementSize } from '@vueuse/core';\n  import { smoothPath } from './equipment-panel';\n  import type { EquipmentChartProps } from './types';\n\n  const props = defineProps<EquipmentChartProps>();\n\n  const H = 40;\n  const box = useTemplateRef<HTMLElement>('box');\n  const { width } = useElementSize(box);\n  const W = computed(() => Math.max(40, width.value || 200));\n\n  const scale = computed(() => {\n    const pts = props.chart.points;\n    const lo = props.chart.min ?? Math.min(...pts) - 2;\n    const hi = Math.max(props.chart.limit ?? Math.max(...pts), ...pts) + 0.5;\n    return { lo, hi };\n  });\n\n  function y(v: number): number {\n    const { lo, hi } = scale.value;\n    return H - ((v - lo) / (hi - lo || 1)) * H;\n  }\n\n  const coords = computed<[number, number][]>(() => {\n    const pts = props.chart.points;\n    const step = pts.length > 1 ? (W.value - 4) / (pts.length - 1) : 0;\n    return pts.map((v, i) => [i * step, y(v)]);\n  });\n  const path = computed(() => smoothPath(coords.value));\n  const end = computed(() => coords.value.at(-1));\n  const limitY = computed(() =>\n    props.chart.limit === undefined ? null : y(props.chart.limit),\n  );\n</script>\n\n<template>\n  <div\n    class=\"relative flex min-h-17 flex-1 items-end overflow-hidden rounded-xl border border-black bg-neutral-950 px-3 pt-2 pb-2.5 shadow-[inset_0_2px_10px_rgba(0,0,0,0.85)] dark:border-white/6\"\n  >\n    <span\n      class=\"absolute top-2 left-3 text-[11px] font-medium tracking-[0.12em] uppercase opacity-60\"\n      :style=\"{ color: props.color }\"\n    >\n      {{ props.chart.label }}\n    </span>\n    <div ref=\"box\" class=\"mt-5 h-10 w-full @md:w-[58%]\">\n      <svg\n        :viewBox=\"`0 0 ${W} ${H}`\"\n        class=\"size-full overflow-visible\"\n        role=\"img\"\n        :aria-label=\"`${props.chart.label}: ${props.chart.points.at(-1)?.toFixed(1)}`\"\n      >\n        <line\n          v-if=\"limitY !== null\"\n          x1=\"0\"\n          :x2=\"W\"\n          :y1=\"limitY\"\n          :y2=\"limitY\"\n          :stroke=\"props.color\"\n          stroke-opacity=\"0.5\"\n          stroke-dasharray=\"2 3\"\n        />\n        <path\n          :d=\"path\"\n          fill=\"none\"\n          :stroke=\"props.color\"\n          stroke-width=\"1.6\"\n          stroke-linecap=\"round\"\n        />\n        <circle\n          v-if=\"end\"\n          :cx=\"end[0]\"\n          :cy=\"end[1]\"\n          r=\"2.6\"\n          :fill=\"props.color\"\n          :style=\"{ filter: `drop-shadow(0 0 3px ${props.color})` }\"\n        />\n      </svg>\n    </div>\n    <div\n      class=\"absolute top-1/2 right-3 hidden -translate-y-1/2 text-right text-[13px]/snug @md:block\"\n    >\n      <p\n        v-if=\"props.chart.limitLabel\"\n        class=\"opacity-55\"\n        :style=\"{ color: props.color }\"\n      >\n        {{ props.chart.limitLabel }}\n      </p>\n      <p v-if=\"props.chart.note\" :style=\"{ color: props.color }\">\n        {{ props.chart.note }}\n      </p>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/equipment-panel/EquipmentPanelChart.vue"
    },
    {
      "path": "registry/new-york/equipment-panel/EquipmentPanelRow.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, useId } from 'vue';\n  import EquipmentPanelBar from './EquipmentPanelBar.vue';\n  import EquipmentPanelChart from './EquipmentPanelChart.vue';\n  import type { EquipmentRowProps } from './types';\n\n  const props = defineProps<EquipmentRowProps>();\n  const emit = defineEmits<{ toggle: []; action: [] }>();\n\n  const detailId = `equipment-detail-${useId()}`;\n\n  const dot = computed(() => {\n    if (props.device.status === 'warn') return props.accent;\n    if (props.device.status === 'ok') return props.okColor;\n    return '';\n  });\n  const powerText = computed(() => {\n    const sign = props.device.signed && props.power > 0 ? '+' : '';\n    return `${sign}${props.power.toFixed(2)} kW`;\n  });\n  const chart = computed(() =>\n    props.device.chart\n      ? { ...props.device.chart, points: props.points }\n      : undefined,\n  );\n</script>\n\n<template>\n  <li\n    class=\"relative rounded-2xl border transition-[border-color,background-color,box-shadow] duration-300 after:absolute after:inset-x-3 after:-bottom-px after:h-px after:bg-border last:after:hidden dark:after:bg-white/5\"\n    :class=\"\n      props.open\n        ? 'bg-neutral-50 after:hidden dark:bg-white/3'\n        : 'border-transparent'\n    \"\n    :style=\"\n      props.open\n        ? {\n            borderColor: `${dot || props.accent}80`,\n            boxShadow: `0 0 0 1px ${dot || props.accent}14`,\n          }\n        : undefined\n    \"\n  >\n    <button\n      type=\"button\"\n      class=\"grid w-full grid-cols-[1.25rem_minmax(0,1fr)_4.5rem_2.75rem_1rem] items-center gap-x-2 rounded-2xl px-3 py-2.5 text-left outline-none focus-visible:ring-2 focus-visible:ring-orange-400/60 @md:grid-cols-[1.25rem_minmax(0,1fr)_6.75rem_5rem_3.5rem_1rem] @md:gap-x-3\"\n      :aria-expanded=\"props.open\"\n      :aria-controls=\"detailId\"\n      @click=\"emit('toggle')\"\n    >\n      <span\n        class=\"size-1.5 justify-self-center rounded-full\"\n        :class=\"dot ? '' : 'bg-neutral-300 dark:bg-neutral-600'\"\n        :style=\"\n          dot\n            ? { backgroundColor: dot, boxShadow: `0 0 6px ${dot}` }\n            : undefined\n        \"\n      />\n      <span class=\"min-w-0 leading-tight\">\n        <span class=\"block truncate text-sm font-medium\">{{\n          props.device.name\n        }}</span>\n        <span class=\"block truncate text-[13px] text-muted-foreground\">{{\n          props.device.detail\n        }}</span>\n      </span>\n      <EquipmentPanelBar\n        :level=\"props.device.level\"\n        :cells=\"10\"\n        :color=\"props.device.levelColor ?? props.accent\"\n        cell-class=\"h-3 w-2\"\n        track-class=\"bg-neutral-200 dark:bg-white/6\"\n        class=\"hidden @md:flex\"\n      />\n      <span\n        class=\"text-right text-[13px] tabular-nums\"\n        :class=\"\n          props.device.status === 'idle'\n            ? 'text-muted-foreground'\n            : 'font-medium'\n        \"\n      >\n        {{ powerText }}\n      </span>\n      <span\n        class=\"text-right text-[13px] tabular-nums\"\n        :class=\"\n          props.device.status === 'warn'\n            ? 'font-medium'\n            : 'text-muted-foreground'\n        \"\n        :style=\"\n          props.device.status === 'warn' ? { color: props.accent } : undefined\n        \"\n      >\n        {{ props.temp === null ? '—' : `${Math.round(props.temp)} °C` }}\n      </span>\n      <Icon\n        name=\"lucide:chevron-down\"\n        class=\"size-4 text-muted-foreground transition-transform duration-300\"\n        :class=\"props.open ? 'rotate-180 text-foreground' : ''\"\n      />\n    </button>\n    <div\n      :id=\"detailId\"\n      class=\"grid transition-[grid-template-rows,opacity] duration-300 ease-out motion-reduce:transition-none\"\n      :class=\"\n        props.open ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'\n      \"\n      :inert=\"!props.open\"\n    >\n      <div class=\"overflow-hidden\">\n        <div class=\"flex items-center gap-3 px-3 pb-3 @md:pl-10\">\n          <EquipmentPanelChart\n            v-if=\"chart\"\n            :chart=\"chart\"\n            :color=\"props.accent\"\n          />\n          <div\n            v-else\n            class=\"flex min-h-17 flex-1 items-center gap-6 rounded-xl border border-black bg-neutral-950 px-3 text-[11px] tracking-[0.12em] uppercase shadow-[inset_0_2px_10px_rgba(0,0,0,0.85)] dark:border-white/6\"\n            :style=\"{ color: props.device.levelColor ?? props.accent }\"\n          >\n            <span\n              ><span class=\"block opacity-60\">Level</span\n              ><span class=\"text-base\"\n                >{{ Math.round(props.device.level * 100) }} %</span\n              ></span\n            >\n            <span\n              ><span class=\"block opacity-60\">Power</span\n              ><span class=\"text-base\">{{ powerText }}</span></span\n            >\n          </div>\n          <button\n            v-if=\"props.device.action\"\n            type=\"button\"\n            class=\"inline-flex h-9 shrink-0 items-center gap-2 rounded-full border border-border bg-muted px-4 text-sm font-medium transition-colors outline-none hover:bg-neutral-200 focus-visible:ring-2 focus-visible:ring-orange-400/60 disabled:opacity-70 dark:border-white/8 dark:bg-neutral-700/50 dark:hover:bg-neutral-700\"\n            :disabled=\"props.busy\"\n            @click=\"emit('action')\"\n          >\n            <Icon\n              v-if=\"props.busy\"\n              name=\"lucide:loader-circle\"\n              class=\"size-4 animate-spin\"\n            />\n            {{ props.busy ? 'Checking…' : props.device.action }}\n          </button>\n        </div>\n      </div>\n    </div>\n  </li>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/equipment-panel/EquipmentPanelRow.vue"
    },
    {
      "path": "registry/new-york/equipment-panel/equipment-panel.ts",
      "content": "import type { EquipmentDevice, EquipmentTile } from './types';\n\nexport const GREEN = '#4ade80';\nexport const ORANGE = '#ff9a2e';\nconst BLUE = '#7aa2ff';\n\nexport const DEFAULT_TILES: EquipmentTile[] = [\n  {\n    key: 'battery',\n    label: 'Battery',\n    note: '17.3 kWh',\n    value: 64,\n    unit: '%',\n    level: 0.64,\n    color: GREEN,\n  },\n  {\n    key: 'inverter',\n    label: 'Inverter',\n    note: 'of 7.6',\n    value: 4.82,\n    decimals: 2,\n    unit: 'kW',\n    level: 0.63,\n    color: ORANGE,\n  },\n  {\n    key: 'grid',\n    label: 'Grid',\n    note: 'exporting',\n    value: 0.72,\n    decimals: 2,\n    unit: 'kW',\n    level: 0.12,\n    color: BLUE,\n  },\n];\n\nexport const DEFAULT_DEVICES: EquipmentDevice[] = [\n  {\n    id: 'battery-a',\n    name: 'Battery A',\n    detail: 'Garage wall · 13.5 kWh',\n    status: 'ok',\n    level: 0.7,\n    levelColor: GREEN,\n    power: 0.98,\n    signed: true,\n    temp: 24,\n  },\n  {\n    id: 'battery-b',\n    name: 'Battery B',\n    detail: 'Garage wall · 13.5 kWh',\n    status: 'ok',\n    level: 0.6,\n    levelColor: GREEN,\n    power: 0.98,\n    signed: true,\n    temp: 25,\n  },\n  {\n    id: 'inverter',\n    name: 'Inverter',\n    detail: 'Hybrid · 7.6 kW',\n    status: 'warn',\n    level: 0.8,\n    levelColor: ORANGE,\n    power: 4.82,\n    temp: 41,\n    action: 'Run check',\n    chart: {\n      label: 'Heatsink temp',\n      points: [\n        33.6, 33.4, 33.3, 33.5, 34.4, 35.6, 36.6, 37.6, 38.3, 38.6, 39.1, 39.2,\n        38.9, 38.5, 38.7, 39.2,\n      ],\n      limit: 45,\n      limitLabel: 'Limit 45 °C',\n      note: 'Fan 70 %',\n      min: 31,\n    },\n  },\n  {\n    id: 'solar',\n    name: 'Solar array',\n    detail: '2 strings · 18 panels',\n    status: 'ok',\n    level: 0.8,\n    levelColor: ORANGE,\n    power: 4.82,\n    temp: null,\n  },\n  {\n    id: 'ev',\n    name: 'EV charger',\n    detail: 'Driveway · starts 23:00',\n    status: 'idle',\n    level: 0,\n    power: 0,\n    temp: null,\n  },\n];\n\n/**\n * Small deterministic wobble for the live mode. Returns a factor around 1.\n * `t` is the tick count, `seed` keeps each value out of step with the others.\n */\nexport function wobble(t: number, seed: number, amount: number): number {\n  if (t === 0) return 1;\n  return (\n    1 +\n    amount *\n      (Math.sin(t * 0.83 + seed * 1.91) * 0.6 +\n        Math.sin(t * 0.37 + seed * 0.7) * 0.4)\n  );\n}\n\n/** Smooth SVG path through points with Catmull-Rom curves. */\nexport function smoothPath(points: [number, number][]): string {\n  if (!points.length) return '';\n  const f = (n: number): string => n.toFixed(1);\n  const first = points[0];\n  if (!first) return '';\n  let d = `M${f(first[0])} ${f(first[1])}`;\n  for (let i = 0; i < points.length - 1; i += 1) {\n    const p0 = points[i - 1] ?? points[i];\n    const p1 = points[i];\n    const p2 = points[i + 1];\n    const p3 = points[i + 2] ?? p2;\n    if (!p0 || !p1 || !p2 || !p3) continue;\n    const c1x = p1[0] + (p2[0] - p0[0]) / 6;\n    const c1y = p1[1] + (p2[1] - p0[1]) / 6;\n    const c2x = p2[0] - (p3[0] - p1[0]) / 6;\n    const c2y = p2[1] - (p3[1] - p1[1]) / 6;\n    d += ` C${f(c1x)} ${f(c1y)} ${f(c2x)} ${f(c2y)} ${f(p2[0])} ${f(p2[1])}`;\n  }\n  return d;\n}\n",
