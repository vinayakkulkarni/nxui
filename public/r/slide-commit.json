    {
      "path": "registry/new-york/slide-commit/slide-commit-utils.ts",
      "content": "export function clamp(value: number, min: number, max: number): number {\n  return Math.min(max, Math.max(min, value));\n}\n\n/** Black or white, whichever reads better on the given hex colour. */\nexport function onColor(hex: string): string {\n  const raw = hex.replace('#', '');\n  const full =\n    raw.length === 3 ? [...raw].map((ch) => ch + ch).join('') : raw.slice(0, 6);\n  const n = Number.parseInt(full, 16);\n  if (Number.isNaN(n)) return '#ffffff';\n  const yiq =\n    (((n >> 16) & 255) * 299 + ((n >> 8) & 255) * 587 + (n & 255) * 114) / 1000;\n  return yiq >= 128 ? '#111111' : '#ffffff';\n}\n\nexport function velocityOf(hist: Array<[number, number]>): number {\n  const a = hist[0];\n  const b = hist[hist.length - 1];\n  if (!a || !b || hist.length < 2) return 0;\n  return ((b[1] - a[1]) / Math.max(1, b[0] - a[0])) * 1000;\n}\n\nexport function isThenable(value: unknown): value is PromiseLike<unknown> {\n  return (\n    typeof value === 'object' &&\n    value !== null &&\n    'then' in value &&\n    typeof value.then === 'function'\n  );\n}\n",
      "type": "registry:ui",
      "target": "components/ui/slide-commit/slide-commit-utils.ts"
    },
    {
      "path": "registry/new-york/slide-commit/types.ts",
      "content": "/** Lifecycle phase of the slider. */\nexport type SlideCommitPhase = 'idle' | 'pending' | 'done' | 'error';\n\n/**\n * Props for the SlideCommit registry component.\n */\nexport interface SlideCommitProps {\n  /** Track text, and the accessible name. */\n  label?: string;\n  /** Pill text after success. */\n  doneLabel?: string;\n  /** Track text after a failure. */\n  errorLabel?: string;\n  /**\n   * Runs when the handle reaches the end (also bound by `@confirm`).\n   * Return a promise to show the spinner until it settles; a rejection shakes and returns.\n   */\n  onConfirm?: () => unknown;\n  /** Track fill. */\n  trackColor?: string;\n  /** Handle fill. Text on it picks black or white for contrast. */\n  handleColor?: string;\n  /** Pill fill on success. */\n  successColor?: string;\n  /** Handle fill and error text on failure. */\n  dangerColor?: string;\n  /** Width in pixels. */\n  width?: number;\n  /** Height in pixels. */\n  height?: number;\n  /** Corner radius in pixels, capped at half the height. */\n  radius?: number;\n  /** How quickly the handle travels on its springs, 0 to 100. */\n  speed?: number;\n  /** Bounce when the handle springs back home. */\n  returnBounce?: number;\n  /** How far the track dips when the pill lands. 0 turns it off. */\n  landingDip?: number;\n  /** How long the done pill stays before it resets, in ms. 0 keeps it. */\n  holdMs?: number;\n  /** Dims the slider and ignores input. */\n  disabled?: boolean;\n  /** Additional classes on the root element. */\n  class?: string;\n}\n\n/** Internal drag state while the handle is held. */\nexport interface SlideCommitGrip {\n  id: number;\n  grab: number | null;\n  moved: boolean;\n  hist: Array<[number, number]>;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/slide-commit/types.ts"
    }
  ]
}
