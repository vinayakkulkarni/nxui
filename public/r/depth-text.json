{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "depth-text",
  "type": "registry:ui",
  "title": "Depth Text",
  "description": "Display type extruded from stacked layers in 3D that tilts toward the pointer, orbits when idle, and presses in on hover.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/depth-text/DepthText.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, useTemplateRef, watch } from 'vue';\n  import {\n    useEventListener,\n    useIntersectionObserver,\n    useMediaQuery,\n    usePreferredReducedMotion,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import {\n    FLOAT_EASE,\n    INTRO_MS,\n    MAX_LAYERS,\n    PRESS_EXTRA,\n    PUSH_DAMPING,\n    PUSH_STIFFNESS,\n    clamp,\n    getFadeColor,\n    getLayerColor,\n    getTransform,\n  } from './depth-text-utils';\n  import type {\n    DepthTextLayer,\n    DepthTextMotion,\n    DepthTextProps,\n    DepthTextRotation,\n  } from './types';\n\n  const props = withDefaults(defineProps<DepthTextProps>(), {\n    text: 'Elevate',\n    layers: 34,\n    depth: 2.4,\n    faceColor: 'currentColor',\n    depthColor: '#7c3aed',\n    gradientDepth: false,\n    tilt: 7.5,\n    pointerTracking: true,\n    smoothing: 0.14,\n    perspective: 900,\n    autoOrbit: true,\n    orbitSpeed: 0.35,\n    hoverPush: 0,\n    float: false,\n    fontSize: 'clamp(3rem, 12vw, 7rem)',\n    fontWeight: 900,\n    shadow: true,\n    outline: false,\n    intro: true,\n    class: '',\n  });\n\n  const rootRef = useTemplateRef<HTMLSpanElement>('root');\n  const stageRef = useTemplateRef<HTMLSpanElement>('stage');\n\n  const reducedMotionPref = usePreferredReducedMotion();\n  const reducedMotion = computed(() => reducedMotionPref.value === 'reduce');\n  const finePointer = useMediaQuery('(hover: hover) and (pointer: fine)');\n\n  let rotation: DepthTextRotation | null = null;\n  const motion: DepthTextMotion = { push: 0, velocity: 0, float: 0 };\n  let introProgress = props.intro ? 0 : 1;\n\n  const safeLayers = computed(() =>\n    clamp(Math.round(Number(props.layers) || 1), 2, MAX_LAYERS),\n  );\n  const safeDepth = computed(() => clamp(Number(props.depth) || 0, 0, 12));\n  const safeTilt = computed(() => clamp(Number(props.tilt) || 0, 0, 12));\n  const safeSmoothing = computed(() =>\n    clamp(Number(props.smoothing) || 0.14, 0.02, 0.35),\n  );\n  const safePerspective = computed(() =>\n    clamp(Number(props.perspective) || 900, 300, 2000),\n  );\n  const safeOrbitSpeed = computed(() =>\n    clamp(Number(props.orbitSpeed) || 0, 0, 2),\n  );\n  const safePush = computed(() => clamp(Number(props.hoverPush) || 0, 0, 1));\n  const extent = computed(() => safeLayers.value * safeDepth.value);\n  const baseX = computed(() => -safeTilt.value * 0.32);\n  const baseY = computed(() => safeTilt.value * 0.42);\n\n  const initialTransform = getTransform(baseX.value, baseY.value);\n\n  const depthLayers = computed<DepthTextLayer[]>(() =>\n    Array.from({ length: safeLayers.value }, (_, layerIndex) => {\n      const index = safeLayers.value - layerIndex;\n      return {\n        index,\n        color: props.gradientDepth\n          ? getFadeColor(\n              props.depthColor,\n              index,\n              safeLayers.value,\n              props.outline,\n            )\n          : getLayerColor(\n              props.faceColor,\n              props.depthColor,\n              index,\n              safeLayers.value,\n            ),\n        transform: `translateZ(calc(var(--depth-text-grow, 1) * ${(-index * safeDepth.value).toFixed(2)}px))`,\n      };\n    }),\n  );\n\n  function setup(root: HTMLSpanElement, stage: HTMLSpanElement) {\n    const tilt = safeTilt.value;\n    const smoothing = safeSmoothing.value;\n    const orbitSpeed = safeOrbitSpeed.value;\n    const push = safePush.value;\n    const depthExtent = extent.value;\n    const autoOrbit = props.autoOrbit;\n    const float = props.float;\n    const base = { x: baseX.value, y: baseY.value };\n    const reduced = reducedMotion.value;\n    const canTrackPointer =\n      props.pointerTracking && finePointer.value && !reduced;\n    const listensToHover = (push > 0 || float) && !reduced;\n\n    let frameId = 0;\n    let visible = true;\n    let activePointer = false;\n    let hovered = false;\n    let pressed = false;\n    let lastTime = 0;\n    let size = root.offsetHeight;\n    const startTime = performance.now();\n    const current = rotation ?? { ...base };\n    const target = { ...base };\n    rotation = current;\n\n    const sinkAmount = () => clamp(motion.push, -0.25, 1);\n\n    const applyTransform = (now = performance.now()) => {\n      const time = (now - startTime) / 1000;\n      const drift = motion.float;\n      stage.style.transform = getTransform(\n        current.x + (drift ? Math.cos(time * 1.19) * 2 * drift : 0),\n        current.y + (drift ? Math.sin(time * 0.86 + 2.1) * 4 * drift : 0),\n        drift ? Math.sin(time * 1.43) * size * 0.045 * drift : 0,\n        drift ? Math.sin(time * 1.03 + 0.8) * 1.6 * drift : 0,\n        sinkAmount() * depthExtent,\n      );\n    };\n\n    const applyGrow = () => {\n      const progress = introProgress;\n      const grow = progress >= 1 ? 1 : 1 - Math.pow(1 - progress, 3);\n      const value = grow * (1 - sinkAmount());\n      stage.style.setProperty(\n        '--depth-text-grow',\n        value === 1 ? '1' : value.toFixed(4),\n      );\n    };\n\n    if (reduced) {\n      introProgress = 1;\n      motion.push = 0;\n      motion.velocity = 0;\n      motion.float = 0;\n      applyGrow();\n      current.x = base.x;\n      current.y = base.y;\n      applyTransform();\n      return () => {};\n    }\n\n    const stop = () => {\n      if (frameId) cancelAnimationFrame(frameId);\n      frameId = 0;\n    };\n\n    const tick = (now: number) => {\n      const delta = lastTime ? Math.min(now - lastTime, 50) : 16;\n      lastTime = now;\n\n      if (introProgress < 1) {\n        introProgress = Math.min(1, introProgress + delta / INTRO_MS);\n      }\n\n      if ((!canTrackPointer || !activePointer) && autoOrbit) {\n        const elapsed = (now - startTime) / 1000;\n        const orbit = elapsed * orbitSpeed * Math.PI * 2;\n        const fallbackAmount = canTrackPointer ? 0.18 : 0.55;\n        target.x = base.x + Math.sin(orbit) * tilt * fallbackAmount;\n        target.y = base.y + Math.cos(orbit * 0.85) * tilt * fallbackAmount;\n      }\n\n      current.x += (target.x - current.x) * smoothing;\n      current.y += (target.y - current.y) * smoothing;\n\n      const pushGoal =\n        push > 0 && (hovered || pressed)\n          ? Math.min(1, push + (pressed ? PRESS_EXTRA : 0))\n          : 0;\n      let remaining = delta / 1000;\n      while (remaining > 0) {\n        const step = Math.min(remaining, 1 / 120);\n        motion.velocity +=\n          (PUSH_STIFFNESS * (pushGoal - motion.push) -\n            PUSH_DAMPING * motion.velocity) *\n          step;\n        motion.push += motion.velocity * step;\n        remaining -= step;\n      }\n      const springIdle =\n        Math.abs(pushGoal - motion.push) < 0.0005 &&\n        Math.abs(motion.velocity) < 0.002;\n      if (springIdle) {\n        motion.push = pushGoal;\n        motion.velocity = 0;\n      }\n\n      const floatGoal = float && !hovered && !pressed ? 1 : 0;\n      motion.float +=\n        (floatGoal - motion.float) * (1 - Math.exp(-delta / 1000 / FLOAT_EASE));\n      if (Math.abs(floatGoal - motion.float) < 0.001) motion.float = floatGoal;\n\n      applyGrow();\n      applyTransform(now);\n\n      const settled =\n        Math.abs(target.x - current.x) < 0.001 &&\n        Math.abs(target.y - current.y) < 0.001;\n      if (\n        !autoOrbit &&\n        !motion.float &&\n        settled &&\n        springIdle &&\n        introProgress >= 1\n      ) {\n        frameId = 0;\n        return;\n      }\n\n      frameId = requestAnimationFrame(tick);\n    };\n\n    const start = () => {\n      if (frameId || !visible) return;\n      lastTime = 0;\n      frameId = requestAnimationFrame(tick);\n    };\n\n    const handlePointerMove = (event: PointerEvent) => {\n      const rect = root.getBoundingClientRect();\n      if (!rect.width || !rect.height) return;\n      activePointer = true;\n      const x = clamp(\n        (event.clientX - (rect.left + rect.width / 2)) / (rect.width * 0.8),\n        -1,\n        1,\n      );\n      const y = clamp(\n        (event.clientY - (rect.top + rect.height / 2)) / (rect.height * 0.8),\n        -1,\n        1,\n      );\n      target.x = base.x - y * tilt;\n      target.y = base.y + x * tilt;\n      start();\n    };\n\n    const handlePointerLeave = () => {\n      activePointer = false;\n      target.x = base.x;\n      target.y = base.y;\n      start();\n    };\n\n    const handlePointerOut = (event: PointerEvent) => {\n      if (!event.relatedTarget) handlePointerLeave();\n    };\n\n    const isHoverPointer = (event: PointerEvent) =>\n      event.pointerType === 'mouse' || event.pointerType === 'pen';\n\n    const handleEnter = (event: PointerEvent) => {\n      if (!isHoverPointer(event)) return;\n      hovered = true;\n      start();\n    };\n\n    const handleLeave = () => {\n      hovered = false;\n      pressed = false;\n      start();\n    };\n\n    const handleDown = () => {\n      pressed = true;\n      start();\n    };\n\n    const handleUp = (event: PointerEvent) => {\n      pressed = false;\n      if (!isHoverPointer(event)) hovered = false;\n      start();\n    };\n\n    const cleanups: (() => void)[] = [];\n\n    if (canTrackPointer) {\n      cleanups.push(\n        useEventListener('pointermove', handlePointerMove),\n        useEventListener('pointerout', handlePointerOut),\n        useEventListener('blur', handlePointerLeave),\n      );\n    }\n\n    if (listensToHover) {\n      cleanups.push(\n        useEventListener(root, 'pointerenter', handleEnter),\n        useEventListener(root, 'pointerleave', handleLeave),\n        useEventListener(root, 'pointerdown', handleDown),\n        useEventListener(root, 'pointerup', handleUp),\n        useEventListener(root, 'pointercancel', handleLeave),\n      );\n    }\n\n    const intersection = useIntersectionObserver(root, (entries) => {\n      visible = entries[0]?.isIntersecting ?? true;\n      if (visible) start();\n      else stop();\n    });\n    const resize = useResizeObserver(root, () => {\n      size = root.offsetHeight;\n    });\n\n    applyGrow();\n    applyTransform();\n    start();\n\n    return () => {\n      for (const cleanup of cleanups) cleanup();\n      intersection.stop();\n      resize.stop();\n      stop();\n    };\n  }\n\n  onMounted(() => {\n    watch(\n      [\n        () => props.autoOrbit,\n        () => props.pointerTracking,\n        () => props.float,\n        baseX,\n        baseY,\n        safeOrbitSpeed,\n        safeSmoothing,\n        safeTilt,\n        safePush,\n        extent,\n        reducedMotion,\n        finePointer,\n      ],\n      (_value, _old, onCleanup) => {\n        const root = rootRef.value;\n        const stage = stageRef.value;\n        if (!root || !stage) return;\n        onCleanup(setup(root, stage));\n      },\n      { immediate: true },\n    );\n  });\n\n  const rootStyle = computed<Record<string, string | number>>(() => ({\n    '--depth-text-perspective': `${safePerspective.value}px`,\n    '--depth-text-font-size': props.fontSize,\n    '--depth-text-font-weight': props.fontWeight,\n    '--depth-text-face-color': props.faceColor,\n    '--depth-text-shadow':\n      props.shadow && !props.gradientDepth\n        ? `0 0.18em 0.32em color-mix(in srgb, ${props.depthColor} 24%, rgba(0, 0, 0, 0.42))`\n        : 'none',\n    '--depth-text-face-shadow': props.shadow\n      ? '0 0.035em 0.07em rgba(0, 0, 0, 0.28)'\n      : 'none',\n  }));\n\n  // Static on purpose: the rAF loop owns transform and grow after mount.\n  const stageStyle: Record<string, string | number> = {\n    transform: initialTransform,\n    '--depth-text-grow': props.intro ? 0 : 1,\n  };\n</script>\n\n<template>\n  <span\n    ref=\"root\"\n    :class=\"['depth-text', outline && 'depth-text--outline', props.class]\"\n    :style=\"rootStyle\"\n  >\n    <span ref=\"stage\" class=\"depth-text__stage\" :style=\"stageStyle\">\n      <span\n        v-for=\"layer in depthLayers\"\n        :key=\"layer.index\"\n        aria-hidden=\"true\"\n        :class=\"[\n          'depth-text__layer',\n          layer.index === safeLayers && 'depth-text__layer--back',\n        ]\"\n        :style=\"{ color: layer.color, transform: layer.transform }\"\n        >{{ text }}</span\n      >\n      <span class=\"depth-text__face\">{{ text }}</span>\n    </span>\n  </span>\n</template>\n\n<style scoped>\n  .depth-text {\n    display: inline-block;\n    perspective: var(--depth-text-perspective);\n    perspective-origin: 50% 48%;\n    isolation: isolate;\n  }\n\n  .depth-text__stage {\n    position: relative;\n    display: inline-grid;\n    place-items: center;\n    transform-style: preserve-3d;\n    transform-origin: 50% 50%;\n    will-change: transform;\n  }\n\n  .depth-text__layer,\n  .depth-text__face {\n    grid-area: 1 / 1;\n    display: inline-block;\n    font-size: var(--depth-text-font-size);\n    font-weight: var(--depth-text-font-weight);\n    line-height: 0.86;\n    letter-spacing: -0.065em;\n    white-space: nowrap;\n    user-select: none;\n    transform-style: preserve-3d;\n    backface-visibility: hidden;\n    font-kerning: normal;\n    text-rendering: geometricPrecision;\n  }\n\n  .depth-text__layer {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n  }\n\n  .depth-text__layer--back {\n    text-shadow: var(--depth-text-shadow);\n  }\n\n  .depth-text--outline .depth-text__layer {\n    -webkit-text-fill-color: transparent;\n    -webkit-text-stroke: max(1px, 0.012em) currentColor;\n  }\n\n  .depth-text__face {\n    position: relative;\n    z-index: 1;\n    color: var(--depth-text-face-color);\n    text-shadow: var(--depth-text-face-shadow);\n    transform: translateZ(0.6px);\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .depth-text {\n      cursor: default;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .depth-text__stage {\n      will-change: auto;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/depth-text/DepthText.vue"
    },
    {
      "path": "registry/new-york/depth-text/depth-text-utils.ts",
      "content": "export const MAX_LAYERS = 64;\nexport const INTRO_MS = 1200;\nexport const PUSH_STIFFNESS = 260;\nexport const PUSH_DAMPING = 17;\nexport const PRESS_EXTRA = 0.25;\nexport const FLOAT_EASE = 0.7;\n\nexport function clamp(value: number, min: number, max: number): number {\n  return Math.min(Math.max(value, min), max);\n}\n\nexport function getLayerColor(\n  faceColor: string,\n  depthColor: string,\n  index: number,\n  total: number,\n): string {\n  const progress = total <= 1 ? 1 : index / total;\n  const eased = progress * progress;\n  const faceMix = Math.round((1 - eased) * 72 + 4);\n  return `color-mix(in srgb, color-mix(in srgb, ${faceColor} ${faceMix}%, ${depthColor}) 92%, black)`;\n}\n\nexport function getFadeColor(\n  depthColor: string,\n  index: number,\n  total: number,\n  outline: boolean,\n): string {\n  const reach = (layer: number) =>\n    Math.pow(clamp(1 - (layer - 0.5) / total, 0, 1), 1.6);\n  const here = reach(index);\n  const behind = index >= total ? 0 : reach(index + 1);\n  const alpha = outline\n    ? here\n    : behind >= 1\n      ? 1\n      : 1 - (1 - here) / (1 - behind);\n  return `color-mix(in srgb, ${depthColor} ${(clamp(alpha, 0, 1) * 100).toFixed(2)}%, transparent)`;\n}\n\nexport function getTransform(\n  rotateX: number,\n  rotateY: number,\n  lift = 0,\n  roll = 0,\n  sink = 0,\n): string {\n  return [\n    lift ? `translateY(${lift.toFixed(2)}px)` : '',\n    roll ? `rotateZ(${roll.toFixed(3)}deg)` : '',\n    `rotateX(${rotateX.toFixed(3)}deg) rotateY(${rotateY.toFixed(3)}deg)`,\n    sink ? `translateZ(${(-sink).toFixed(2)}px)` : '',\n  ]\n    .filter(Boolean)\n    .join(' ');\n}\n",
      "type": "registry:ui",
      "target": "components/ui/depth-text/depth-text-utils.ts"
    },
    {
      "path": "registry/new-york/depth-text/index.ts",
      "content": "export { default as DepthText } from './DepthText.vue';\nexport type { DepthTextProps } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/depth-text/index.ts"
    },
    {
      "path": "registry/new-york/depth-text/types.ts",
      "content": "export interface DepthTextProps {\n  /** The word or short phrase rendered as extruded type. */\n  text?: string;\n  /** Number of stacked copies that form the extrusion (2–64). */\n  layers?: number;\n  /** Spacing in pixels between each layer of the extrusion. */\n  depth?: number;\n  /** Color of the front face. Follows the surrounding text color by default. */\n  faceColor?: string;\n  /** Tint the extrusion fades into toward the back. */\n  depthColor?: string;\n  /** Paint the extrusion in the depth color behind the face and fade it out toward the back. */\n  gradientDepth?: boolean;\n  /** Resting angle and maximum pointer-driven rotation, in degrees. */\n  tilt?: number;\n  /** Smoothed pointer parallax on fine pointer devices. */\n  pointerTracking?: boolean;\n  /** Damping used to ease rotation toward the pointer target. */\n  smoothing?: number;\n  /** Perspective distance in pixels for the 3D stack. */\n  perspective?: number;\n  /** Subtle orbit when pointer tracking is unavailable or idle. */\n  autoOrbit?: boolean;\n  /** Speed of the fallback orbit in cycles per second. */\n  orbitSpeed?: number;\n  /** How far hovering presses the text into the page, 0 to 1. 0 turns it off. */\n  hoverPush?: number;\n  /** Let the text bob and sway gently while it is not hovered. */\n  float?: boolean;\n  /** CSS font-size value for the display word. */\n  fontSize?: string;\n  /** Font weight used for every layer. */\n  fontWeight?: number | string;\n  /** Soft drop shadow behind the extrusion. */\n  shadow?: boolean;\n  /** Draw the extrusion as stacked outlines instead of solid layers. */\n  outline?: boolean;\n  /** Grow the extrusion out from the flat face on mount. */\n  intro?: boolean;\n  class?: string;\n}\n\nexport interface DepthTextLayer {\n  index: number;\n  color: string;\n  transform: string;\n}\n\nexport interface DepthTextRotation {\n  x: number;\n  y: number;\n}\n\nexport interface DepthTextMotion {\n  push: number;\n  velocity: number;\n  float: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/depth-text/types.ts"
    }
  ]
}
