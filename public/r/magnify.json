{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "magnify",
  "type": "registry:ui",
  "title": "Magnify",
  "description": "A paper poster with one huge letter and a magnifying glass that shows the tiny characters the letter is printed from.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/magnify/Magnify.vue",
      "content": "<script setup lang=\"ts\">\n  // Vue port of Magnify from Pin UI (https://pinui.xyz), MIT licence.\n  import { computed, ref, useId, useTemplateRef, watch } from 'vue';\n  import {\n    unrefElement,\n    usePreferredReducedMotion,\n    useResizeObserver,\n    useTimeoutFn,\n  } from '@vueuse/core';\n  import { motion, useMotionValue, useSpring, useTransform } from 'motion-v';\n  import { cn } from '~/lib/utils';\n  import MagnifyMicro from './MagnifyMicro.vue';\n  import {\n    COLORS,\n    FRAME_IN,\n    FRAME_SHOW,\n    FRAME_TRANSITION,\n    GLYPH_IN,\n    GLYPH_SHOW,\n    GLYPH_SIZE,\n    GLYPH_TRANSITION,\n    GRAIN_MATRIX,\n    H,\n    HANDLE_ANGLE,\n    HIDDEN,\n    HINT_IN,\n    HINT_SHOW,\n    KEY_MOVES,\n    LENS_FADE,\n    LENS_FLOAT,\n    LENS_HELD,\n    LENS_OUTER,\n    LENS_SPRING,\n    LENS_STILL,\n    LIFT_SPRING,\n    OFFSTAGE,\n    R0,\n    REST,\n    SHADOW_SPRING,\n    SHOWN,\n    TINT,\n    W,\n    ZOOM_SPRING,\n    baseline,\n    clamp,\n  } from './magnify-data';\n  import type { MagnifyExpose, MagnifyProps } from './types';\n\n  const props = withDefaults(defineProps<MagnifyProps>(), {\n    theme: 'light',\n    glyph: 'A',\n    micro: 'a',\n    zoom: 2.6,\n    zoomMax: 4.2,\n    lensRadius: 50,\n    size: 380,\n    intro: true,\n    hint: true,\n    class: '',\n  });\n\n  const emit = defineEmits<{ 'zoom-change': [zoomed: boolean] }>();\n\n  const prefersReduced = usePreferredReducedMotion();\n  const reduced = computed(() => prefersReduced.value === 'reduce');\n  /* decided once, so a late media-query answer never restarts the intro */\n  const play = props.intro && !reduced.value;\n\n  const uid = useId().replace(/[^\\w-]/g, '');\n  const grainId = `${uid}-grain`;\n  const clipId = `${uid}-micro`;\n\n  const frameRef = useTemplateRef('frame');\n  const scale = ref(1);\n  const active = ref(false);\n  const zoomed = ref(false);\n  const landed = ref(!play);\n\n  const colors = computed(() => COLORS[props.theme]);\n  const dark = computed(() => props.theme === 'dark');\n  const letter = computed(() => (props.glyph || 'A').slice(0, 2));\n  const tiny = computed(() => props.micro || 'a');\n\n  const start = play ? OFFSTAGE : REST;\n  const tx = useMotionValue(start.x);\n  const ty = useMotionValue(start.y);\n  const x = useSpring(tx, LENS_SPRING);\n  const y = useSpring(ty, LENS_SPRING);\n\n  /* k scales the whole lens drawing; the inner zoom is divided by k, so the\n     magnification you ask for is the magnification you get */\n  const k = computed(() => props.lensRadius / R0);\n  const zoom = useSpring(props.zoom, ZOOM_SPRING);\n  const kValue = useMotionValue(k.value);\n  watch(k, (value) => kValue.set(value));\n  const innerZoom = useTransform(() => zoom.get() / kValue.get());\n  const innerX = useTransform(() => R0 - x.get() * innerZoom.get());\n  const innerY = useTransform(() => R0 - y.get() * innerZoom.get());\n  const tilt = useTransform(() => {\n    /* reading x subscribes the transform to it; its velocity rides along */\n    x.get();\n    const velocity = x.getVelocity();\n    return reduced.value ? 0 : Math.max(-8, Math.min(8, velocity / 140));\n  });\n\n  /* the poster is drawn at 500 wide and scaled to whatever width it is given */\n  useResizeObserver(frameRef, (entries) => {\n    const entry = entries[0];\n    if (entry) scale.value = entry.contentRect.width / W;\n  });\n\n  /* the lens drops in once the letter has printed */\n  const { start: dropIn } = useTimeoutFn(\n    () => {\n      tx.set(REST.x);\n      ty.set(REST.y);\n    },\n    1250,\n    { immediate: false },\n  );\n  const { start: land } = useTimeoutFn(\n    () => {\n      landed.value = true;\n    },\n    1900,\n    { immediate: false },\n  );\n  if (play) {\n    dropIn();\n    land();\n  }\n\n  watch(\n    [zoomed, () => props.zoom, () => props.zoomMax],\n    ([isZoomed, rest, max]) => zoom.set(isZoomed ? max : rest),\n  );\n\n  function setZoomed(next: boolean): void {\n    if (zoomed.value === next) return;\n    zoomed.value = next;\n    emit('zoom-change', next);\n  }\n\n  function toggleZoom(): void {\n    setZoomed(!zoomed.value);\n  }\n\n  function moveTo(px: number, py: number): void {\n    active.value = true;\n    tx.set(clamp(px, W));\n    ty.set(clamp(py, H));\n  }\n\n  function onMove(event: PointerEvent): void {\n    const el = unrefElement(frameRef);\n    if (!landed.value || !el) return;\n    const r = el.getBoundingClientRect();\n    moveTo(\n      (event.clientX - r.left) / scale.value,\n      (event.clientY - r.top) / scale.value,\n    );\n  }\n\n  function rest(): void {\n    active.value = false;\n    setZoomed(false);\n    tx.set(REST.x);\n    ty.set(REST.y);\n  }\n\n  function onClick(): void {\n    if (landed.value) toggleZoom();\n  }\n\n  function onKey(event: KeyboardEvent): void {\n    const step = event.shiftKey ? 30 : 10;\n    const move = KEY_MOVES[event.key];\n    if (move) {\n      event.preventDefault();\n      moveTo(tx.get() + move.x * step, ty.get() + move.y * step);\n    } else if (event.key === 'Enter' || event.key === ' ') {\n      event.preventDefault();\n      toggleZoom();\n    } else if (event.key === 'Escape') {\n      rest();\n    }\n  }\n\n  const lensMotion = computed(() => {\n    if (active.value) return LENS_HELD;\n    return landed.value && !reduced.value ? LENS_FLOAT : LENS_STILL;\n  });\n\n  const shadowMotion = computed(() => ({\n    x: active.value ? 16 : 9,\n    y: active.value ? 20 : 12,\n    opacity: (active.value ? 0.22 : 0.32) * (dark.value ? 1.6 : 1),\n    filter: active.value ? 'blur(9px)' : 'blur(5px)',\n  }));\n\n  const ariaLabel = computed(\n    () =>\n      `Poster of a large letter ${letter.value} printed from tiny ${tiny.value} characters, with a magnifying glass. Move the pointer or use the arrow keys to inspect; click or press Enter to zoom.`,\n  );\n\n  const hintTransition = { delay: play ? 2 : 0, duration: 0.6 };\n\n  const tintStyle = {\n    background: `radial-gradient(circle at 34% 28%, rgba(255,255,255,.55), rgba(255,255,255,0) 26%), radial-gradient(circle at 50% 50%, rgba(190,214,190,${TINT * 0.26}) 55%, rgba(120,150,120,${TINT}) 100%)`,\n    boxShadow: `inset 0 0 10px 2px rgba(50,70,50,${TINT * 1.2}), inset 0 0 2px rgba(0,0,0,.6)`,\n  };\n  const handleStyle = {\n    transform: `rotate(${HANDLE_ANGLE}deg)`,\n    transformOrigin: '0 0',\n  };\n  const ringStyle = {\n    width: `${LENS_OUTER}px`,\n    height: `${LENS_OUTER}px`,\n    left: `${-LENS_OUTER / 2}px`,\n    top: `${-LENS_OUTER / 2}px`,\n  };\n\n  defineExpose<MagnifyExpose>({ moveTo, setZoomed, toggleZoom, rest });\n</script>\n\n<template>\n  <div\n    :class=\"cn('pmag', props.class)\"\n    :data-theme=\"theme\"\n    :style=\"{ '--pmag-size': `${size}px` }\"\n  >\n    <motion.div\n      ref=\"frame\"\n      role=\"img\"\n      :aria-label=\"ariaLabel\"\n      tabindex=\"0\"\n      class=\"pmag__frame\"\n      :initial=\"play ? FRAME_IN : false\"\n      :animate=\"FRAME_SHOW\"\n      :transition=\"FRAME_TRANSITION\"\n      @pointermove=\"onMove\"\n      @pointerdown=\"onMove\"\n      @pointerleave=\"rest\"\n      @click=\"onClick\"\n      @keydown=\"onKey\"\n    >\n      <div class=\"pmag__canvas\" :style=\"{ transform: `scale(${scale})` }\">\n        <!-- the paper, with grain and a soft light across it -->\n        <div\n          class=\"pmag__paper pmag__fade\"\n          :style=\"{ background: colors.paper }\"\n        >\n          <svg class=\"pmag__grain\" aria-hidden=\"true\">\n            <filter :id=\"grainId\">\n              <feTurbulence\n                type=\"fractalNoise\"\n                base-frequency=\"0.9\"\n                num-octaves=\"2\"\n                stitch-tiles=\"stitch\"\n              />\n              <feColorMatrix :values=\"GRAIN_MATRIX[theme]\" />\n            </filter>\n            <rect width=\"100%\" height=\"100%\" :filter=\"`url(#${grainId})`\" />\n          </svg>\n          <div class=\"pmag__sheen\" />\n        </div>\n\n        <!-- the letter: its outline traces, then the ink floods in -->\n        <svg\n          :viewBox=\"`0 0 ${W} ${H}`\"\n          :width=\"W\"\n          :height=\"H\"\n          class=\"pmag__letter\"\n          aria-hidden=\"true\"\n        >\n          <g\n            :style=\"{ fill: colors.ink, stroke: colors.ink }\"\n            class=\"pmag__fade\"\n          >\n            <motion.text\n              :key=\"letter\"\n              :x=\"W / 2\"\n              :y=\"baseline(GLYPH_SIZE)\"\n              text-anchor=\"middle\"\n              class=\"pmag__glyph-shape\"\n              :style=\"{ strokeDasharray: 3200 }\"\n              :initial=\"play ? GLYPH_IN : false\"\n              :animate=\"GLYPH_SHOW\"\n              :transition=\"GLYPH_TRANSITION\"\n            >\n              {{ letter }}\n            </motion.text>\n          </g>\n        </svg>\n\n        <!-- the lens -->\n        <motion.div\n          class=\"pmag__lens\"\n          :style=\"{ x, y }\"\n          :initial=\"play ? HIDDEN : false\"\n          :animate=\"SHOWN\"\n          :transition=\"LENS_FADE\"\n        >\n          <motion.div :style=\"{ scale: k }\">\n            <motion.div\n              :style=\"{ rotate: tilt }\"\n              :animate=\"lensMotion\"\n              :transition=\"LIFT_SPRING\"\n            >\n              <!-- the shadow it casts on the paper, lifting when held -->\n              <motion.div\n                class=\"pmag__abs\"\n                :animate=\"shadowMotion\"\n                :transition=\"SHADOW_SPRING\"\n              >\n                <div\n                  class=\"pmag__abs pmag__shadow pmag__round\"\n                  :style=\"ringStyle\"\n                />\n                <div class=\"pmag__abs\" :style=\"handleStyle\">\n                  <div class=\"pmag__abs pmag__shadow pmag__handleShadow\" />\n                </div>\n              </motion.div>\n\n              <!-- the handle: a steel collar, a ferrule and a black grip -->\n              <div class=\"pmag__abs\" :style=\"handleStyle\">\n                <div class=\"pmag__abs pmag__collar\" />\n                <div class=\"pmag__abs pmag__ferrule\" />\n                <div class=\"pmag__abs pmag__grip\" />\n              </div>\n\n              <!-- the metal rim -->\n              <div class=\"pmag__abs pmag__rim\" :style=\"ringStyle\" />\n\n              <!-- the glass, carrying its own copy of the poster at the zoom -->\n              <div class=\"pmag__abs pmag__glass\">\n                <motion.div\n                  class=\"pmag__abs pmag__inner\"\n                  :style=\"{\n                    x: innerX,\n                    y: innerY,\n                    scale: innerZoom,\n                    originX: 0,\n                    originY: 0,\n                  }\"\n                >\n                  <MagnifyMicro\n                    :glyph=\"letter\"\n                    :micro=\"tiny\"\n                    :ink=\"colors.ink\"\n                    :paper=\"colors.paper\"\n                    :clip-id=\"clipId\"\n                  />\n                </motion.div>\n                <div class=\"pmag__abs pmag__tint\" :style=\"tintStyle\" />\n                <div class=\"pmag__abs pmag__glint\" />\n              </div>\n            </motion.div>\n          </motion.div>\n        </motion.div>\n      </div>\n    </motion.div>\n\n    <motion.p\n      v-if=\"hint\"\n      class=\"pmag__hint\"\n      :initial=\"play ? HINT_IN : false\"\n      :animate=\"HINT_SHOW\"\n      :transition=\"hintTransition\"\n    >\n      Move to inspect · Click to zoom\n    </motion.p>\n  </div>\n</template>\n\n<style scoped>\n  /* A paper poster drawn in a fixed 500 × 680 space and scaled to its width,\n     with one huge letter and a magnifying glass over it. The paper, ink and\n     shadow cross-fade when the theme switches, rather than snapping. */\n  .pmag {\n    --pmag-hint: #a3a3a3;\n    --pmag-ring: rgb(115 115 115 / 0.6);\n    --pmag-shadow:\n      0 1px 0 rgb(0 0 0 / 0.04), 6px 10px 22px -10px rgb(0 0 0 / 0.28),\n      1px 2px 4px rgb(0 0 0 / 0.08);\n    --pmag-grain-blend: multiply;\n    --pmag-glass-blend: multiply;\n    --pmag-sheen:\n      radial-gradient(\n        120% 90% at 30% 20%,\n        rgb(255 255 255 / 0.25),\n        transparent 60%\n      ),\n      linear-gradient(180deg, transparent 70%, rgb(0 0 0 / 0.035));\n\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 20px;\n    width: 100%;\n    font-family: inherit;\n    -webkit-font-smoothing: antialiased;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .pmag[data-theme='dark'] {\n    --pmag-hint: #737373;\n    --pmag-shadow:\n      0 0 0 1px rgb(255 255 255 / 0.05), 0 24px 60px -20px rgb(0 0 0 / 0.8);\n    --pmag-grain-blend: overlay;\n    --pmag-glass-blend: soft-light;\n    --pmag-sheen: radial-gradient(\n      120% 90% at 30% 15%,\n      rgb(255 255 255 / 0.05),\n      transparent 60%\n    );\n  }\n\n  .pmag *,\n  .pmag *::before,\n  .pmag *::after {\n    box-sizing: border-box;\n  }\n\n  /* the poster: its own width, never wider than its container, at the paper's proportions */\n  .pmag__frame {\n    position: relative;\n    width: min(var(--pmag-size, 380px), 100%);\n    aspect-ratio: 500 / 680;\n    border-radius: 2px;\n    outline: none;\n    cursor: none;\n    touch-action: none;\n    user-select: none;\n  }\n\n  .pmag__frame:focus-visible {\n    box-shadow: 0 0 0 2px var(--pmag-ring);\n    outline-offset: 8px;\n  }\n\n  .pmag__canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 500px;\n    height: 680px;\n    transform-origin: 0 0;\n    /* the frame takes every press, so focus never lands on the SVG letter */\n    pointer-events: none;\n  }\n\n  .pmag__abs {\n    position: absolute;\n    top: 0;\n    left: 0;\n  }\n\n  /* the theme cross-fade, on every surface that takes a colour */\n  .pmag__fade {\n    transition:\n      fill 0.45s ease,\n      stroke 0.45s ease,\n      background-color 0.45s ease,\n      box-shadow 0.45s ease;\n  }\n\n  .pmag__paper {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    border-radius: 2px;\n    box-shadow: var(--pmag-shadow);\n  }\n\n  .pmag__grain {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    opacity: 0.16;\n    mix-blend-mode: var(--pmag-grain-blend);\n  }\n\n  .pmag__sheen {\n    position: absolute;\n    inset: 0;\n    background: var(--pmag-sheen);\n  }\n\n  .pmag__letter {\n    position: absolute;\n    inset: 0;\n  }\n\n  .pmag__glyph-shape {\n    font-family: inherit;\n    font-size: 500px;\n    font-weight: 700;\n  }\n\n  /* ---------- the lens ---------- */\n\n  .pmag__lens {\n    position: absolute;\n    top: 0;\n    left: 0;\n    pointer-events: none;\n  }\n\n  .pmag__shadow {\n    background: #000000;\n  }\n\n  .pmag__round {\n    border-radius: 50%;\n  }\n\n  .pmag__handleShadow {\n    top: -7.5px;\n    left: 52px;\n    width: 125px;\n    height: 15px;\n    border-radius: 999px;\n  }\n\n  .pmag__collar {\n    top: -5px;\n    left: 53px;\n    width: 30px;\n    height: 10px;\n    border-radius: 2px;\n    background: linear-gradient(\n      180deg,\n      #f4f4f4 0%,\n      #9a9a9a 45%,\n      #5e5e5e 55%,\n      #d0d0d0 100%\n    );\n  }\n\n  .pmag__ferrule {\n    top: -7px;\n    left: 78px;\n    width: 10px;\n    height: 14px;\n    border-radius: 2px;\n    background: linear-gradient(\n      180deg,\n      #fafafa 0%,\n      #a8a8a8 45%,\n      #626262 58%,\n      #cfcfcf 100%\n    );\n  }\n\n  .pmag__grip {\n    top: -8px;\n    left: 87px;\n    width: 92px;\n    height: 16px;\n    border-radius: 3px 9px 9px 3px;\n    background: linear-gradient(\n      180deg,\n      #5a5a5a 0%,\n      #1d1d1d 30%,\n      #050505 60%,\n      #2b2b2b 100%\n    );\n  }\n\n  .pmag[data-theme='dark'] .pmag__grip {\n    box-shadow: 0 0 0 0.5px rgb(255 255 255 / 0.12);\n  }\n\n  .pmag__rim {\n    border-radius: 50%;\n    background: conic-gradient(\n      from 210deg,\n      #f7f7f7,\n      #8e8e8e 18%,\n      #ececec 32%,\n      #6c6c6c 50%,\n      #dedede 66%,\n      #9a9a9a 82%,\n      #f7f7f7\n    );\n    box-shadow:\n      0 0 0 0.75px rgb(0 0 0 / 0.35),\n      inset 0 0 1.5px rgb(0 0 0 / 0.5);\n  }\n\n  .pmag__glass {\n    top: -50px;\n    left: -50px;\n    width: 100px;\n    height: 100px;\n    overflow: hidden;\n    border-radius: 50%;\n  }\n\n  .pmag__inner {\n    width: 500px;\n    height: 680px;\n  }\n\n  .pmag__tint {\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    mix-blend-mode: var(--pmag-glass-blend);\n  }\n\n  .pmag__glint {\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    background: radial-gradient(\n      ellipse 40% 22% at 36% 24%,\n      rgb(255 255 255 / 0.45),\n      transparent 70%\n    );\n  }\n\n  .pmag__hint {\n    margin: 0;\n    color: var(--pmag-hint);\n    font-size: 10px;\n    letter-spacing: 0.25em;\n    text-align: center;\n    text-transform: uppercase;\n    user-select: none;\n    transition: color 0.45s ease;\n  }\n\n  /* on a touch screen there is no pointer to hide */\n  @media (hover: none) {\n    .pmag__frame {\n      cursor: default;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pmag__fade,\n    .pmag__hint {\n      transition: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/magnify/Magnify.vue"
    },
    {
      "path": "registry/new-york/magnify/MagnifyMicro.vue",
      "content": "<script setup lang=\"ts\">\n  // Vue port of Magnify from Pin UI (https://pinui.xyz), MIT licence.\n  import { computed } from 'vue';\n  import { GLYPH_SIZE, H, MICRO_SIZE, W, baseline } from './magnify-data';\n  import type { MagnifyMicroProps } from './types';\n\n  /* What the lens sees: rows of micro-type, clipped to the big letter. */\n  const props = defineProps<MagnifyMicroProps>();\n\n  const rowH = MICRO_SIZE * 0.93;\n  const rows = Math.ceil(H / rowH) + 1;\n  const rowYs = Array.from({ length: rows }, (_, i) => (i + 1) * rowH);\n\n  const line = computed(() => {\n    const perRow = Math.ceil(W / (MICRO_SIZE * 0.5 * props.micro.length)) + 2;\n    return props.micro.repeat(perRow);\n  });\n</script>\n\n<template>\n  <svg\n    :viewBox=\"`0 0 ${W} ${H}`\"\n    :width=\"W\"\n    :height=\"H\"\n    class=\"pmag__micro\"\n    aria-hidden=\"true\"\n  >\n    <defs>\n      <clipPath :id=\"clipId\">\n        <text\n          :x=\"W / 2\"\n          :y=\"baseline(GLYPH_SIZE)\"\n          text-anchor=\"middle\"\n          class=\"pmag__glyph-shape\"\n        >\n          {{ glyph }}\n        </text>\n      </clipPath>\n    </defs>\n    <rect :width=\"W\" :height=\"H\" :style=\"{ fill: paper }\" class=\"pmag__fade\" />\n    <g\n      :clip-path=\"`url(#${clipId})`\"\n      :style=\"{ fill: ink }\"\n      class=\"pmag__microText pmag__fade\"\n    >\n      <text v-for=\"(y, i) in rowYs\" :key=\"i\" :x=\"-(i % 3) * 0.9\" :y=\"y\">\n        {{ line }}\n      </text>\n    </g>\n  </svg>\n</template>\n\n<style scoped>\n  .pmag__micro {\n    display: block;\n  }\n\n  .pmag__glyph-shape {\n    font-family: inherit;\n    font-size: 500px;\n    font-weight: 700;\n  }\n\n  .pmag__microText {\n    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n    font-size: 5.6px;\n  }\n\n  .pmag__fade {\n    transition: fill 0.45s ease;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pmag__fade {\n      transition: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/magnify/MagnifyMicro.vue"
    },
    {
      "path": "registry/new-york/magnify/index.ts",
      "content": "export { default as Magnify } from './Magnify.vue';\nexport { default as MagnifyMicro } from './MagnifyMicro.vue';\nexport type {\n  MagnifyColors,\n  MagnifyExpose,\n  MagnifyMicroProps,\n  MagnifyPoint,\n  MagnifyProps,\n  MagnifyTheme,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/magnify/index.ts"
    },
    {
      "path": "registry/new-york/magnify/magnify-data.ts",
      "content": "import type { VariantType } from 'motion-v';\nimport type { MagnifyColors, MagnifyPoint, MagnifyTheme } from './types';\n\n/* The poster is drawn in a fixed 500 × 680 space and scaled to fit. */\nexport const W = 500;\nexport const H = 680;\n/* The lens is drawn at this glass radius and scaled to `lensRadius`. */\nexport const R0 = 50;\nconst RIM = 6;\nexport const LENS_OUTER = (R0 + RIM) * 2;\nexport const OFFSTAGE: MagnifyPoint = { x: 600, y: -140 };\nexport const REST: MagnifyPoint = { x: 330, y: 254 };\nexport const HANDLE_ANGLE = 42;\nexport const TINT = 0.38;\nexport const GLYPH_SIZE = 500;\nexport const MICRO_SIZE = 5.6;\n\nexport const COLORS: Record<MagnifyTheme, MagnifyColors> = {\n  light: { paper: '#ebe7da', ink: '#161616' },\n  dark: { paper: '#1d1c1a', ink: '#ece6d6' },\n};\n\nexport const GRAIN_MATRIX: Record<MagnifyTheme, string> = {\n  light: '0 0 0 0 0.35  0 0 0 0 0.32  0 0 0 0 0.25  0 0 0 0.9 0',\n  dark: '0 0 0 0 0.9  0 0 0 0 0.88  0 0 0 0 0.82  0 0 0 0.9 0',\n};\n\nexport const KEY_MOVES: Record<string, MagnifyPoint> = {\n  ArrowLeft: { x: -1, y: 0 },\n  ArrowRight: { x: 1, y: 0 },\n  ArrowUp: { x: 0, y: -1 },\n  ArrowDown: { x: 0, y: 1 },\n};\n\nexport function baseline(size: number): number {\n  return 340 + size * 0.36;\n}\n\nexport function clamp(v: number, max: number): number {\n  return Math.max(0, Math.min(max, v));\n}\n\n/* motion */\n\nexport const LENS_SPRING = { stiffness: 260, damping: 28, mass: 0.9 };\nexport const ZOOM_SPRING = { stiffness: 200, damping: 22 };\nexport const LIFT_SPRING = {\n  type: 'spring',\n  stiffness: 300,\n  damping: 20,\n} as const;\nexport const SHADOW_SPRING = {\n  type: 'spring',\n  stiffness: 200,\n  damping: 22,\n} as const;\n\nexport const FRAME_IN = { opacity: 0, y: 40, rotate: -2.5, scale: 0.96 };\nexport const FRAME_SHOW = { opacity: 1, y: 0, rotate: 0, scale: 1 };\nexport const FRAME_TRANSITION = {\n  type: 'spring',\n  stiffness: 90,\n  damping: 16,\n} as const;\n\nexport const GLYPH_IN = {\n  strokeDashoffset: 3200,\n  fillOpacity: 0,\n  strokeWidth: 1.5,\n};\nexport const GLYPH_SHOW = {\n  strokeDashoffset: 0,\n  fillOpacity: 1,\n  strokeWidth: 0,\n};\nexport const GLYPH_TRANSITION = {\n  strokeDashoffset: {\n    delay: 0.3,\n    duration: 1,\n    ease: [0.65, 0, 0.35, 1] as const,\n  },\n  fillOpacity: { delay: 0.95, duration: 0.5, ease: 'easeOut' },\n  strokeWidth: { delay: 1.45, duration: 0.3 },\n} as const;\n\nexport const HIDDEN = { opacity: 0 };\nexport const SHOWN = { opacity: 1 };\nexport const LENS_FADE = { delay: 1.2, duration: 0.3 };\n\nexport const LENS_HELD = { scale: 1.04 };\nexport const LENS_FLOAT: VariantType = {\n  scale: [1, 1.012, 1],\n  transition: { duration: 3.2, repeat: Infinity, ease: 'easeInOut' },\n};\nexport const LENS_STILL = { scale: 1 };\n\nexport const HINT_IN = { opacity: 0, y: 6 };\nexport const HINT_SHOW = { opacity: 1, y: 0 };\n",
      "type": "registry:ui",
      "target": "components/ui/magnify/magnify-data.ts"
    },
    {
      "path": "registry/new-york/magnify/types.ts",
      "content": "export type MagnifyTheme = 'light' | 'dark';\n\nexport interface MagnifyPoint {\n  x: number;\n  y: number;\n}\n\nexport interface MagnifyColors {\n  paper: string;\n  ink: string;\n}\n\nexport interface MagnifyProps {\n  theme?: MagnifyTheme;\n  /** The big letter on the poster. */\n  glyph?: string;\n  /** The tiny characters it is printed from, seen through the lens. */\n  micro?: string;\n  /** Magnification at rest. */\n  zoom?: number;\n  /** Magnification after a click or Enter. */\n  zoomMax?: number;\n  /** The glass's radius, in poster units (the poster is 500 wide). */\n  lensRadius?: number;\n  /** The poster's width in px; it never grows past its container. */\n  size?: number;\n  /** The outline trace and the lens dropping in on arrival. */\n  intro?: boolean;\n  /** The \"Move to inspect\" line under the poster. */\n  hint?: boolean;\n  class?: string;\n}\n\nexport interface MagnifyMicroProps {\n  glyph: string;\n  micro: string;\n  ink: string;\n  paper: string;\n  clipId: string;\n}\n\n/** Imperative hooks, so a host (e.g. an idle demo) can drive the lens. */\nexport interface MagnifyExpose {\n  /** Move the lens to a point in poster units (500 × 680). */\n  moveTo: (x: number, y: number) => void;\n  /** Set the zoom state. */\n  setZoomed: (zoomed: boolean) => void;\n  /** Toggle between the rest zoom and the max zoom. */\n  toggleZoom: () => void;\n  /** Put the lens back at rest and drop the zoom. */\n  rest: () => void;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/magnify/types.ts"
    }
  ]
