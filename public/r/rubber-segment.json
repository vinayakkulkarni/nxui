{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "rubber-segment",
  "type": "registry:ui",
  "title": "Rubber Segment",
  "description": "Segmented control whose rubber thumb stretches across the gap and squashes into place.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/rubber-segment/RubberSegment.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    onBeforeUnmount,\n    onMounted,\n    ref,\n    useTemplateRef,\n    watch,\n  } from 'vue';\n  import { animate, motionValue } from 'motion-v';\n  import type { MotionValue } from 'motion-v';\n  import { usePreferredReducedMotion, useResizeObserver } from '@vueuse/core';\n  import type {\n    RubberSegmentDrag,\n    RubberSegmentOption,\n    RubberSegmentProps,\n    RubberSegmentSlot,\n  } from './types';\n  import {\n    DEADZONE,\n    DILATE,\n    EASE_OUT,\n    FLICK,\n    HANDOFF,\n    MAX_VELOCITY,\n    SIZES,\n    SLOP,\n    SPRING_MOMENTUM,\n    SPRING_RELAX,\n    SPRING_UI,\n    clamp,\n    nearestSlot,\n    project,\n    rubber,\n    velocityOf,\n  } from './rubber-segment-math';\n\n  const props = withDefaults(defineProps<RubberSegmentProps>(), {\n    modelValue: undefined,\n    defaultValue: undefined,\n    trackColor: '#27272a',\n    thumbColor: '#fafafa',\n    textColor: '#fafafa',\n    activeTextColor: '#18181b',\n    size: 'md',\n    radius: 10,\n    inset: 3,\n    equalSlots: true,\n    stretch: 100,\n    squash: 3,\n    speed: 1,\n    glide: 75,\n    draggable: true,\n    disabled: false,\n    ariaLabel: 'Segmented control',\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    'update:modelValue': [value: string];\n    change: [value: string, index: number];\n  }>();\n\n  const list = computed<RubberSegmentOption[]>(() =>\n    props.items.map((item) =>\n      typeof item === 'string' ? { value: item, label: item } : item,\n    ),\n  );\n  const inner = ref<string | undefined>(\n    props.defaultValue ?? list.value[0]?.value,\n  );\n  const current = computed(() =>\n    props.modelValue !== undefined ? props.modelValue : inner.value,\n  );\n  const index = computed(() =>\n    Math.max(\n      0,\n      list.value.findIndex((item) => item.value === current.value),\n    ),\n  );\n\n  const reducedMotion = usePreferredReducedMotion();\n  const reduce = computed(() => reducedMotion.value === 'reduce');\n\n  const trackRef = useTemplateRef<HTMLDivElement>('track');\n  const thumbRef = useTemplateRef<HTMLDivElement>('thumb');\n\n  let slots: RubberSegmentSlot[] = [];\n  let box: DOMRect | null = null;\n  let committed = index.value;\n  let handoff: ReturnType<typeof setTimeout> | undefined;\n  let drag: RubberSegmentDrag | null = null;\n  let gen = 0;\n  let measured = false;\n\n  const edgeL = motionValue(0);\n  const edgeR = motionValue(0);\n  const innerW = motionValue(0);\n  const thumbRadius = computed(() => Math.max(0, props.radius - props.inset));\n  const preset = computed(() => SIZES[props.size] ?? SIZES.md);\n\n  const trackStyle = computed(() => ({\n    '--rs-track': props.trackColor,\n    '--rs-thumb': props.thumbColor,\n    '--rs-ink': props.textColor,\n    '--rs-ink-active': props.activeTextColor,\n    '--rs-radius': `${props.radius}px`,\n    '--rs-inset': `${props.inset}px`,\n    '--rs-thumb-radius': `${thumbRadius.value}px`,\n    '--rs-h': `${preset.value.height}px`,\n    '--rs-font': `${preset.value.font}px`,\n    '--rs-pad': `${preset.value.pad}px`,\n    '--rs-min': `${preset.value.min}px`,\n  }));\n\n  function paint() {\n    const el = thumbRef.value;\n    if (!el || !measured) return;\n    const right = Math.max(0, innerW.get() - edgeR.get());\n    const left = Math.max(0, edgeL.get());\n    el.style.clipPath = `inset(0 ${right}px 0 ${left}px round ${thumbRadius.value}px)`;\n  }\n\n  const unsubscribers = [\n    edgeL.on('change', paint),\n    edgeR.on('change', paint),\n    innerW.on('change', paint),\n  ];\n\n  function t(seconds: number): number {\n    return seconds / props.speed;\n  }\n\n  function buttons(): HTMLButtonElement[] {\n    const track = trackRef.value;\n    if (!track) return [];\n    return Array.from(\n      track.querySelectorAll<HTMLButtonElement>(\n        ':scope > .rubber-segment__item',\n      ),\n    );\n  }\n\n  function jumpTo(i: number) {\n    const s = slots[i];\n    if (!s) return;\n    clearTimeout(handoff);\n    gen += 1;\n    edgeL.jump(s.l);\n    edgeR.jump(s.r);\n  }\n\n  function measure() {\n    const track = trackRef.value;\n    if (!track) return;\n    const rect = track.getBoundingClientRect();\n    box = rect;\n    const els = buttons();\n    slots = list.value.map((_, i) => {\n      const el = els[i];\n      if (!el) return { l: 0, r: 0 };\n      const r = el.getBoundingClientRect();\n      return {\n        l: r.left - rect.left - props.inset,\n        r: r.right - rect.left - props.inset,\n      };\n    });\n    measured = true;\n    innerW.set(rect.width - props.inset * 2);\n    jumpTo(committed);\n    paint();\n  }\n\n  useResizeObserver(trackRef, measure);\n\n  onMounted(() => {\n    measure();\n    document.fonts?.ready.then(measure);\n  });\n\n  watch(\n    [\n      () => list.value.map((item) => item.value).join('|'),\n      () => props.size,\n      () => props.inset,\n      () => props.equalSlots,\n      () => props.radius,\n    ],\n    measure,\n    { flush: 'post' },\n  );\n\n  watch(\n    index,\n    (i) => {\n      if (!drag && committed !== i) {\n        committed = i;\n        jumpTo(i);\n      }\n    },\n    { flush: 'post' },\n  );\n\n  onBeforeUnmount(() => {\n    clearTimeout(handoff);\n    edgeL.stop();\n    edgeR.stop();\n    unsubscribers.forEach((off) => off());\n  });\n\n  function commit(i: number) {\n    committed = i;\n    if (i === index.value) return;\n    const item = list.value[i];\n    if (!item) return;\n    if (props.modelValue === undefined) inner.value = item.value;\n    emit('update:modelValue', item.value);\n    emit('change', item.value, i);\n  }\n\n  function velocityFor(mv: MotionValue<number>, v: number | null): number {\n    return clamp(\n      v === null ? mv.getVelocity() : v,\n      -MAX_VELOCITY,\n      MAX_VELOCITY,\n    );\n  }\n\n  function land(\n    to: number,\n    v: number | null,\n    flick: boolean,\n    withSquash: boolean,\n  ) {\n    const b = slots[to];\n    if (!b) return;\n    gen += 1;\n    const g = gen;\n    const dir =\n      Math.sign((b.l + b.r) / 2 - (edgeL.get() + edgeR.get()) / 2) || 1;\n    const lead = dir > 0 ? edgeR : edgeL;\n    const leadTo = dir > 0 ? b.r : b.l;\n    const trail = dir > 0 ? edgeL : edgeR;\n    const trailTo = dir > 0 ? b.l : b.r;\n    animate(lead, leadTo, {\n      ...(flick ? SPRING_MOMENTUM : SPRING_UI),\n      duration: t(flick ? 0.4 : 0.3),\n      velocity: velocityFor(lead, v),\n    });\n    const trailVelocity = velocityFor(trail, v);\n    if (!withSquash || props.squash <= 0) {\n      animate(trail, trailTo, {\n        ...SPRING_UI,\n        duration: t(0.3),\n        velocity: trailVelocity,\n      });\n      return;\n    }\n    animate(trail, trailTo + dir * props.squash, {\n      ...SPRING_UI,\n      duration: t(0.3),\n      velocity: trailVelocity,\n    }).then(() => {\n      if (gen === g) {\n        animate(trail, trailTo, { ...SPRING_RELAX, duration: t(0.16) });\n      }\n    });\n  }\n\n  function travel(from: number, to: number) {\n    const a = slots[from];\n    const b = slots[to];\n    if (!a || !b) return;\n    clearTimeout(handoff);\n    gen += 1;\n    if (reduce.value) {\n      edgeL.jump(b.l);\n      edgeR.jump(b.r);\n      return;\n    }\n    const u = props.stretch / 100;\n    const tween = { duration: t(DILATE), ease: EASE_OUT };\n    animate(edgeL, b.l + (Math.min(a.l, b.l) - b.l) * u, tween);\n    animate(edgeR, b.r + (Math.max(a.r, b.r) - b.r) * u, tween);\n    handoff = setTimeout(() => land(to, null, false, true), t(HANDOFF) * 1000);\n  }\n\n  function localX(e: PointerEvent): number {\n    return e.clientX - (box ? box.left : 0) - props.inset;\n  }\n\n  function slotOf(e: Event): number {\n    const target = e.currentTarget;\n    if (!(target instanceof HTMLElement)) return -1;\n    return Number(target.dataset.index ?? -1);\n  }\n\n  function handlePointerDown(e: PointerEvent) {\n    if (props.disabled || drag || e.button !== 0) return;\n    const target = e.currentTarget;\n    if (!(target instanceof HTMLElement)) return;\n    const i = slotOf(e);\n    box = trackRef.value?.getBoundingClientRect() ?? null;\n    try {\n      target.setPointerCapture(e.pointerId);\n    } catch {\n      // capture is best-effort\n    }\n    const x = localX(e);\n    const onThumb = props.draggable && x >= edgeL.get() && x <= edgeR.get();\n    drag = {\n      id: e.pointerId,\n      x0: x,\n      slot: i,\n      onThumb,\n      live: false,\n      offset: 0,\n      w: 0,\n      hist: [[e.timeStamp, x]],\n    };\n    if (onThumb) {\n      clearTimeout(handoff);\n      gen += 1;\n      edgeL.stop();\n      edgeR.stop();\n    } else if (!reduce.value) {\n      target.dataset.pressed = '';\n    }\n  }\n\n  function handlePointerMove(e: PointerEvent) {\n    const d = drag;\n    if (!d || e.pointerId !== d.id || !d.onThumb) return;\n    const x = localX(e);\n    d.hist.push([e.timeStamp, x]);\n    if (d.hist.length > 8) d.hist.shift();\n    if (!d.live) {\n      if (Math.abs(x - d.x0) < DEADZONE) return;\n      d.live = true;\n      d.offset = x - edgeL.get();\n      d.w = edgeR.get() - edgeL.get();\n      if (trackRef.value) trackRef.value.dataset.held = '';\n    }\n    const width = innerW.get();\n    const l = x - d.offset;\n    const maxL = width - d.w;\n    if (reduce.value) {\n      const c = clamp(l, 0, maxL);\n      edgeL.set(c);\n      edgeR.set(c + d.w);\n    } else if (l < 0) {\n      edgeL.set(0);\n      edgeR.set(d.w - rubber(-l, d.w));\n    } else if (l > maxL) {\n      edgeR.set(width);\n      edgeL.set(maxL + rubber(l - maxL, d.w));\n    } else {\n      edgeL.set(l);\n      edgeR.set(l + d.w);\n    }\n  }\n\n  function release(d: RubberSegmentDrag) {\n    drag = null;\n    if (trackRef.value) delete trackRef.value.dataset.held;\n    const el = buttons()[d.slot];\n    if (el) delete el.dataset.pressed;\n  }\n\n  function handlePointerUp(e: PointerEvent) {\n    const d = drag;\n    if (!d || e.pointerId !== d.id) return;\n    release(d);\n    const x = localX(e);\n    if (!d.live) {\n      if (Math.abs(x - d.x0) <= SLOP && d.slot !== committed) {\n        const from = committed;\n        commit(d.slot);\n        travel(from, d.slot);\n      }\n      return;\n    }\n    const v = velocityOf(d.hist, e.timeStamp);\n    const flick = Math.abs(v) > FLICK;\n    let to = nearestSlot(\n      slots,\n      (edgeL.get() + edgeR.get()) / 2 + project(v, props.glide),\n    );\n    if (flick && to === committed) {\n      to = clamp(to + Math.sign(v), 0, list.value.length - 1);\n    }\n    commit(to);\n    if (reduce.value) jumpTo(to);\n    else land(to, v, flick, flick);\n  }\n\n  function handlePointerCancel(e: PointerEvent) {\n    const d = drag;\n    if (!d || e.pointerId !== d.id) return;\n    release(d);\n    if (!d.live) return;\n    if (reduce.value) jumpTo(committed);\n    else land(committed, null, false, false);\n  }\n\n  function handleKeyDown(e: KeyboardEvent) {\n    if (props.disabled) return;\n    const last = list.value.length - 1;\n    const i = index.value;\n    let next: number | null = null;\n    if (e.key === 'ArrowRight' || e.key === 'ArrowDown')\n      next = Math.min(last, i + 1);\n    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp')\n      next = Math.max(0, i - 1);\n    else if (e.key === 'Home') next = 0;\n    else if (e.key === 'End') next = last;\n    if (next === null) return;\n    e.preventDefault();\n    if (next === i) return;\n    commit(next);\n    jumpTo(next);\n    buttons()[next]?.focus();\n  }\n</script>\n\n<template>\n  <div\n    ref=\"track\"\n    role=\"radiogroup\"\n    :aria-label=\"ariaLabel\"\n    :aria-disabled=\"disabled || undefined\"\n    :data-equal=\"equalSlots ? '' : undefined\"\n    :data-draggable=\"draggable && !disabled ? '' : undefined\"\n    :class=\"['rubber-segment', props.class]\"\n    :style=\"trackStyle\"\n    @pointermove=\"handlePointerMove\"\n    @pointerup=\"handlePointerUp\"\n    @pointercancel=\"handlePointerCancel\"\n    @lostpointercapture=\"handlePointerCancel\"\n  >\n    <button\n      v-for=\"(item, i) in list\"\n      :key=\"item.value\"\n      type=\"button\"\n      role=\"radio\"\n      class=\"rubber-segment__item\"\n      :data-index=\"i\"\n      :aria-checked=\"i === index\"\n      :tabindex=\"i === index ? 0 : -1\"\n      :disabled=\"disabled\"\n      @pointerdown=\"handlePointerDown\"\n      @keydown=\"handleKeyDown\"\n    >\n      <Icon v-if=\"item.icon\" :name=\"item.icon\" class=\"size-3.5\" />\n      {{ item.label }}\n    </button>\n    <div\n      ref=\"thumb\"\n      class=\"rubber-segment__thumb\"\n      aria-hidden=\"true\"\n      style=\"clip-path: inset(0 100% 0 0)\"\n    >\n      <span\n        v-for=\"item in list\"\n        :key=\"item.value\"\n        class=\"rubber-segment__item rubber-segment__copy\"\n      >\n        <Icon v-if=\"item.icon\" :name=\"item.icon\" class=\"size-3.5\" />\n        {{ item.label }}\n      </span>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .rubber-segment {\n    --rs-idle: 0.7;\n    --rs-hover: 0.9;\n    --rs-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n\n    position: relative;\n    display: inline-grid;\n    grid-auto-flow: column;\n    grid-auto-columns: auto;\n    vertical-align: middle;\n    padding: var(--rs-inset);\n    border-radius: var(--rs-radius);\n    background: var(--rs-track);\n    font-family: inherit;\n    touch-action: pan-y;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .rubber-segment[data-equal] {\n    grid-auto-columns: minmax(0, 1fr);\n  }\n\n  .rubber-segment[aria-disabled='true'] {\n    opacity: 0.5;\n    pointer-events: none;\n  }\n\n  .rubber-segment__item {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    height: calc(var(--rs-h) - var(--rs-inset) * 2);\n    min-width: var(--rs-min);\n    margin: 0;\n    padding: 0 var(--rs-pad);\n    border: 0;\n    border-radius: var(--rs-thumb-radius);\n    background: none;\n    color: var(--rs-ink);\n    opacity: var(--rs-idle);\n    font: inherit;\n    font-size: var(--rs-font);\n    font-weight: 500;\n    line-height: 1;\n    white-space: nowrap;\n    cursor: pointer;\n    outline: none;\n    transition:\n      opacity 160ms ease,\n      transform 160ms var(--rs-ease-out);\n  }\n\n  .rubber-segment__item[aria-checked='true'] {\n    cursor: default;\n  }\n\n  .rubber-segment[data-draggable] .rubber-segment__item[aria-checked='true'] {\n    cursor: grab;\n  }\n\n  .rubber-segment[data-held],\n  .rubber-segment[data-held] .rubber-segment__item {\n    cursor: grabbing;\n  }\n\n  .rubber-segment__item[data-pressed] {\n    transform: scale(0.96);\n  }\n\n  .rubber-segment__item:focus-visible {\n    outline: 2px solid var(--rs-thumb);\n    outline-offset: 3px;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .rubber-segment__item[aria-checked='false']:hover {\n      opacity: var(--rs-hover);\n    }\n  }\n\n  .rubber-segment__thumb {\n    position: absolute;\n    inset: var(--rs-inset);\n    display: grid;\n    grid-auto-flow: column;\n    grid-auto-columns: auto;\n    background: var(--rs-thumb);\n    color: var(--rs-ink-active);\n    pointer-events: none;\n  }\n\n  .rubber-segment[data-equal] .rubber-segment__thumb {\n    grid-auto-columns: minmax(0, 1fr);\n  }\n\n  .rubber-segment__copy {\n    color: inherit;\n    opacity: 1;\n    cursor: default;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .rubber-segment__item {\n      transition: opacity 160ms ease;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/rubber-segment/RubberSegment.vue"
    },
    {
      "path": "registry/new-york/rubber-segment/index.ts",
      "content": "export { default as RubberSegment } from './RubberSegment.vue';\nexport type {\n  RubberSegmentItem,\n  RubberSegmentOption,\n  RubberSegmentProps,\n  RubberSegmentSize,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/rubber-segment/index.ts"
    },
    {
      "path": "registry/new-york/rubber-segment/rubber-segment-math.ts",
      "content": "import type {\n  RubberSegmentSample,\n  RubberSegmentSize,\n  RubberSegmentSizePreset,\n  RubberSegmentSlot,\n} from './types';\n\nexport const EASE_OUT: [number, number, number, number] = [0.23, 1, 0.32, 1];\nexport const SPRING_UI = { type: 'spring' as const, duration: 0.3, bounce: 0 };\nexport const SPRING_MOMENTUM = {\n  type: 'spring' as const,\n  duration: 0.4,\n  bounce: 0.2,\n};\nexport const SPRING_RELAX = {\n  type: 'spring' as const,\n  duration: 0.16,\n  bounce: 0,\n};\nexport const DILATE = 0.19;\nexport const HANDOFF = 0.15;\nexport const FLICK = 110;\nexport const MAX_VELOCITY = 2000;\nexport const DEADZONE = 4;\nexport const SLOP = 10;\nconst RUBBER = 0.55;\n\nexport const SIZES: Record<RubberSegmentSize, RubberSegmentSizePreset> = {\n  sm: { height: 28, font: 12, pad: 10, min: 36 },\n  md: { height: 36, font: 13, pad: 14, min: 44 },\n  lg: { height: 44, font: 14, pad: 18, min: 48 },\n};\n\nexport function clamp(value: number, min: number, max: number): number {\n  return Math.min(max, Math.max(min, value));\n}\n\nexport function rubber(over: number, dim: number): number {\n  return (over * dim * RUBBER) / (dim + RUBBER * Math.abs(over));\n}\n\nexport function project(v: number, glide: number): number {\n  const d = 1 - 0.1 * Math.pow(0.05, glide / 100);\n  return ((v / 1000) * d) / (1 - d);\n}\n\nexport function velocityOf(hist: RubberSegmentSample[], now: number): number {\n  const recent = hist.filter(([t]) => now - t <= 100);\n  const first = recent[0];\n  const last = recent[recent.length - 1];\n  if (recent.length < 2 || !first || !last) return 0;\n  const [t0, x0] = first;\n  const [t1, x1] = last;\n  return t1 - t0 >= 8 ? ((x1 - x0) / (t1 - t0)) * 1000 : 0;\n}\n\nexport function nearestSlot(slots: RubberSegmentSlot[], x: number): number {\n  let best = 0;\n  let bestDist = Infinity;\n  slots.forEach((s, i) => {\n    const dist = Math.abs((s.l + s.r) / 2 - x);\n    if (dist < bestDist) {\n      bestDist = dist;\n      best = i;\n    }\n  });\n  return best;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/rubber-segment/rubber-segment-math.ts"
    },
    {
      "path": "registry/new-york/rubber-segment/types.ts",
      "content": "export type RubberSegmentSize = 'sm' | 'md' | 'lg';\n\nexport interface RubberSegmentOption {\n  value: string;\n  label: string;\n  /** Iconify name rendered before the label, e.g. `lucide:list`. */\n  icon?: string;\n}\n\nexport type RubberSegmentItem = string | RubberSegmentOption;\n\nexport interface RubberSegmentProps {\n  items: RubberSegmentItem[];\n  /** Controlled value (v-model). A change from outside jumps the thumb. */\n  modelValue?: string;\n  /** Initial value when uncontrolled; the first item if omitted. */\n  defaultValue?: string;\n  trackColor?: string;\n  thumbColor?: string;\n  textColor?: string;\n  activeTextColor?: string;\n  size?: RubberSegmentSize;\n  radius?: number;\n  inset?: number;\n  equalSlots?: boolean;\n  stretch?: number;\n  squash?: number;\n  speed?: number;\n  glide?: number;\n  draggable?: boolean;\n  disabled?: boolean;\n  ariaLabel?: string;\n  class?: string;\n}\n\nexport interface RubberSegmentSlot {\n  l: number;\n  r: number;\n}\n\nexport type RubberSegmentSample = [number, number];\n\nexport interface RubberSegmentDrag {\n  id: number;\n  x0: number;\n  slot: number;\n  onThumb: boolean;\n  live: boolean;\n  offset: number;\n  w: number;\n  hist: RubberSegmentSample[];\n}\n\nexport interface RubberSegmentSizePreset {\n  height: number;\n  font: number;\n  pad: number;\n  min: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/rubber-segment/types.ts"
    }
  ]
}
