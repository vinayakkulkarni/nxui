    {
      "path": "registry/new-york/range-calendar/range-calendar.ts",
      "content": "import type {\n  RangeCalendarCell,\n  RangeCalendarDay,\n  RangeCalendarPreset,\n  RangeCalendarWeek,\n} from './types';\n\nexport const DEFAULT_PRESETS: RangeCalendarPreset[] = [\n  { value: '12h', label: '12h', days: 1, hours: 12 },\n  { value: '24h', label: '24h', days: 1, hours: 24 },\n  { value: '1W', label: '1W', days: 7 },\n  { value: '1M', label: '1M', days: 28 },\n  { value: '3M', label: '3M', days: 84 },\n];\n\nexport const NO_DAYS: RangeCalendarDay[] = [];\n\n/** Number of heat steps in the grid and the legend. */\nexport const LEVELS = 5;\n\nconst DAY_MS = 86_400_000;\nconst ISO_DATE = /^(\\d{4})-(\\d{2})-(\\d{2})$/;\nconst ISO_MONTH = /^(\\d{4})-(\\d{2})/;\n/** 2024-01-01 was a Monday; used to build weekday labels. */\nconst A_MONDAY = Math.round(Date.UTC(2024, 0, 1) / DAY_MS);\n\n/**\n * Dates are calendar days, not instants. Everything is done in UTC on\n * day numbers so the time zone of the server or the browser never shifts a day.\n */\nexport function isoToDay(iso: string): number | null {\n  const match = ISO_DATE.exec(iso);\n  if (!match) return null;\n  return Math.round(\n    Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])) / DAY_MS,\n  );\n}\n\nexport function dayToIso(day: number): string {\n  return new Date(day * DAY_MS).toISOString().slice(0, 10);\n}\n\n/** 0 = Monday … 6 = Sunday. */\nfunction weekdayOf(day: number): number {\n  return (new Date(day * DAY_MS).getUTCDay() + 6) % 7;\n}\n\nexport function dayToDate(day: number): Date {\n  return new Date(day * DAY_MS);\n}\n\n/** First and last day number of a `YYYY-MM` month, or `null` if it does not parse. */\nexport function monthBounds(\n  month: string,\n): { first: number; last: number } | null {\n  const match = ISO_MONTH.exec(month);\n  if (!match) return null;\n  const year = Number(match[1]);\n  const index = Number(match[2]) - 1;\n  const first = Math.round(Date.UTC(year, index, 1) / DAY_MS);\n  const last = Math.round(Date.UTC(year, index + 1, 1) / DAY_MS) - 1;\n  return { first, last };\n}\n\n/** Monday-first week rows for a month, padded with `null`. */\nexport function monthWeeks(month: string): RangeCalendarWeek[] {\n  const bounds = monthBounds(month);\n  if (!bounds) return [];\n  const weeks: RangeCalendarWeek[] = [];\n  let week: RangeCalendarWeek = Array.from(\n    { length: weekdayOf(bounds.first) },\n    () => null,\n  );\n  for (let day = bounds.first; day <= bounds.last; day++) {\n    const cell: RangeCalendarCell = {\n      iso: dayToIso(day),\n      day,\n      date: day - bounds.first + 1,\n      weekday: weekdayOf(day),\n    };\n    week.push(cell);\n    if (week.length === 7) {\n      weeks.push(week);\n      week = [];\n    }\n  }\n  if (week.length) {\n    while (week.length < 7) week.push(null);\n    weeks.push(week);\n  }\n  return weeks;\n}\n\n/** Narrow weekday labels, Monday first (`M T W T F S S` in English). */\nexport function weekdayLabels(locale: string): string[] {\n  const format = new Intl.DateTimeFormat(locale, {\n    weekday: 'narrow',\n    timeZone: 'UTC',\n  });\n  return Array.from({ length: 7 }, (_, i) =>\n    format.format(dayToDate(A_MONDAY + i)),\n  );\n}\n\n/** Heat level 1…levels for a value; 0 when there is nothing to compare against. */\nexport function heatLevel(value: number, max: number, levels: number): number {\n  if (max <= 0) return 1;\n  const ratio = Math.min(Math.max(value / max, 0), 1);\n  return Math.min(Math.max(Math.ceil(ratio * levels), 1), levels);\n}\n\nexport function clamp(value: number, min: number, max: number): number {\n  return Math.min(Math.max(value, min), max);\n}\n",
      "type": "registry:ui",
      "target": "components/ui/range-calendar/range-calendar.ts"
    },
    {
      "path": "registry/new-york/range-calendar/types.ts",
      "content": "export interface RangeCalendarDay {\n  /** Local calendar date as `YYYY-MM-DD`. */\n  date: string;\n  /** Count shaded in the heatmap, e.g. stops on the line that day. */\n  value: number;\n}\n\nexport interface RangeCalendarPreset {\n  /** Stored in `v-model:preset` while this preset is active. */\n  value: string;\n  label: string;\n  /** Length of the range in days, ending on `today`. */\n  days: number;\n  /** For sub-day presets such as `12h`: the range is `today` only and the label shows the hours. */\n  hours?: number;\n}\n\nexport interface RangeCalendarCell {\n  /** `YYYY-MM-DD`. */\n  iso: string;\n  /** Days since 1970-01-01 (UTC calendar math, never a wall-clock time). */\n  day: number;\n  /** Day of the month, 1–31. */\n  date: number;\n  /** 0 = Monday … 6 = Sunday. */\n  weekday: number;\n}\n\n/** One week row; `null` pads days that belong to another month. */\nexport type RangeCalendarWeek = (RangeCalendarCell | null)[];\n\nexport interface RangeCalendarProps {\n  /**\n   * The current day as `YYYY-MM-DD`. Later days are disabled and presets end\n   * here. Passed in (not read from the clock) so server and client agree.\n   */\n  today: string;\n  /** Month to show as `YYYY-MM`. Defaults to the month of `today`. */\n  month?: string;\n  /** Per-day values for the heatmap. Days without an entry are disabled. */\n  days?: RangeCalendarDay[];\n  title?: string;\n  subtitle?: string;\n  presets?: RangeCalendarPreset[];\n  /** Noun for the value, used in labels, e.g. `stops`. */\n  unit?: string;\n  /** Left legend label. Defaults to `fewer <unit>`. */\n  legendLow?: string;\n  legendHigh?: string;\n  compareTitle?: string;\n  /** Text under the compare title. Defaults to `previous <N> days`. */\n  compareLabel?: string;\n  /** BCP 47 locale for month and weekday names. */\n  locale?: string;\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/range-calendar/types.ts"
    }
  ]
}
