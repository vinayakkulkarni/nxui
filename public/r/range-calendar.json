      "target": "components/ui/range-calendar/RangeCalendar.vue"
    },
    {
      "path": "registry/new-york/range-calendar/index.ts",
      "content": "export { default as RangeCalendar } from './RangeCalendar.vue';\nexport type {\n  RangeCalendarDay,\n  RangeCalendarPreset,\n  RangeCalendarProps,\n} from './types';\n",
      "type": "registry:ui",
