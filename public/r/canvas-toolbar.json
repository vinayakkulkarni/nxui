{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "canvas-toolbar",
  "type": "registry:ui",
  "title": "Canvas Toolbar",
  "description": "A canvas tool switcher with a sliding active pill and number-key shortcuts, plus a floating selection toolbar with view and action menus.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/canvas-toolbar/CanvasSelectionToolbar.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref, useId } from 'vue';\n  import { onClickOutside } from '@vueuse/core';\n  import CanvasToolbarMenu from './CanvasToolbarMenu.vue';\n  import {\n    DEFAULT_CANVAS_ACTIONS,\n    DEFAULT_CANVAS_VIEWS,\n  } from './canvas-toolbar-defaults';\n  import type {\n    CanvasSelectionMenu,\n    CanvasSelectionToolbarProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<CanvasSelectionToolbarProps>(), {\n    views: () => DEFAULT_CANVAS_VIEWS,\n    actions: () => DEFAULT_CANVAS_ACTIONS,\n    expandLabel: 'Open in full view',\n    moreLabel: 'More actions',\n    label: 'Selection',\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    expand: [];\n    action: [id: string];\n  }>();\n\n  const view = defineModel<string>('view', { default: '' });\n\n  const uid = useId();\n  const rootEl = ref<HTMLElement | null>(null);\n  const viewTrigger = ref<HTMLButtonElement | null>(null);\n  const moreTrigger = ref<HTMLButtonElement | null>(null);\n  const expandBtn = ref<HTMLButtonElement | null>(null);\n  const open = ref<CanvasSelectionMenu | null>(null);\n\n  const current = computed(\n    () => props.views.find((item) => item.id === view.value) ?? props.views[0],\n  );\n\n  function triggerOf(name: CanvasSelectionMenu): HTMLButtonElement | null {\n    return name === 'view' ? viewTrigger.value : moreTrigger.value;\n  }\n\n  function toggle(name: CanvasSelectionMenu): void {\n    open.value = open.value === name ? null : name;\n  }\n\n  function close(restoreFocus: boolean): void {\n    const name = open.value;\n    open.value = null;\n    if (restoreFocus && name) triggerOf(name)?.focus();\n  }\n\n  function onTriggerKey(event: KeyboardEvent, name: CanvasSelectionMenu): void {\n    if (event.key !== 'ArrowDown') return;\n    event.preventDefault();\n    open.value = name;\n  }\n\n  function onViewTriggerKey(event: KeyboardEvent): void {\n    onTriggerKey(event, 'view');\n  }\n\n  function onMoreTriggerKey(event: KeyboardEvent): void {\n    onTriggerKey(event, 'more');\n  }\n\n  function toggleView(): void {\n    toggle('view');\n  }\n\n  function toggleMore(): void {\n    toggle('more');\n  }\n\n  function onPickView(id: string): void {\n    view.value = id;\n    close(true);\n  }\n\n  function onPickAction(id: string): void {\n    emit('action', id);\n    close(true);\n  }\n\n  function onExpand(): void {\n    open.value = null;\n    emit('expand');\n  }\n\n  // Left/Right move between the three buttons, as in an ARIA toolbar.\n  function onToolbarKey(event: KeyboardEvent): void {\n    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;\n    const buttons = [\n      viewTrigger.value,\n      expandBtn.value,\n      moreTrigger.value,\n    ].filter((el): el is HTMLButtonElement => el !== null);\n    const index = buttons.findIndex((el) => el === event.target);\n    if (index < 0) return;\n    event.preventDefault();\n    const step = event.key === 'ArrowRight' ? 1 : -1;\n    buttons[(index + step + buttons.length) % buttons.length]?.focus();\n  }\n\n  onClickOutside(rootEl, () => {\n    if (open.value) close(false);\n  });\n</script>\n\n<template>\n  <div\n    ref=\"rootEl\"\n    role=\"toolbar\"\n    :aria-label=\"props.label\"\n    :class=\"[\n      'relative inline-flex items-center gap-0.5 rounded-2xl border border-border/70 bg-background p-1 shadow-lg dark:border-transparent dark:bg-black/70',\n      props.class,\n    ]\"\n    @keydown=\"onToolbarKey\"\n  >\n    <div v-if=\"props.views.length\" class=\"relative\">\n      <button\n        ref=\"viewTrigger\"\n        type=\"button\"\n        aria-haspopup=\"menu\"\n        :aria-expanded=\"open === 'view'\"\n        :aria-controls=\"open === 'view' ? `${uid}-view` : undefined\"\n        :aria-label=\"`View as ${current?.label ?? ''}`\"\n        class=\"flex h-8 items-center gap-1.5 rounded-xl bg-blue-500 px-3 text-sm font-medium text-white transition-colors hover:bg-blue-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring\"\n        @click=\"toggleView\"\n        @keydown=\"onViewTriggerKey\"\n      >\n        <Icon v-if=\"current\" :name=\"current.icon\" class=\"size-4\" />\n        {{ current?.label }}\n      </button>\n      <CanvasToolbarMenu\n        v-if=\"open === 'view'\"\n        :id=\"`${uid}-view`\"\n        mode=\"radio\"\n        label=\"View as\"\n        :items=\"props.views\"\n        :checked=\"current?.id\"\n        @select=\"onPickView\"\n        @close=\"close\"\n      />\n    </div>\n\n    <button\n      ref=\"expandBtn\"\n      type=\"button\"\n      :aria-label=\"props.expandLabel\"\n      :title=\"props.expandLabel\"\n      class=\"flex size-8 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring dark:text-foreground/85 dark:hover:bg-white/10\"\n      @click=\"onExpand\"\n    >\n      <Icon name=\"lucide:arrow-up-right\" class=\"size-4\" />\n    </button>\n\n    <div class=\"relative\">\n      <button\n        ref=\"moreTrigger\"\n        type=\"button\"\n        aria-haspopup=\"menu\"\n        :aria-expanded=\"open === 'more'\"\n        :aria-controls=\"open === 'more' ? `${uid}-more` : undefined\"\n        :aria-label=\"props.moreLabel\"\n        :class=\"[\n          'flex size-8 items-center justify-center rounded-xl text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring dark:text-foreground/85 dark:hover:bg-white/10',\n          open === 'more' ? 'bg-muted text-foreground dark:bg-white/10' : '',\n        ]\"\n        @click=\"toggleMore\"\n        @keydown=\"onMoreTriggerKey\"\n      >\n        <Icon name=\"lucide:ellipsis\" class=\"size-4\" />\n      </button>\n      <CanvasToolbarMenu\n        v-if=\"open === 'more'\"\n        :id=\"`${uid}-more`\"\n        align=\"end\"\n        :label=\"props.moreLabel\"\n        :items=\"props.actions\"\n        @select=\"onPickAction\"\n        @close=\"close\"\n      />\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/canvas-toolbar/CanvasSelectionToolbar.vue"
    },
    {
      "path": "registry/new-york/canvas-toolbar/CanvasToolbar.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref, useId } from 'vue';\n  import { useEventListener } from '@vueuse/core';\n  import { DEFAULT_CANVAS_TOOLS } from './canvas-toolbar-defaults';\n  import type { CanvasTool, CanvasToolbarProps } from './types';\n\n  const props = withDefaults(defineProps<CanvasToolbarProps>(), {\n    tools: () => DEFAULT_CANVAS_TOOLS,\n    shortcuts: true,\n    label: 'Canvas tools',\n    class: '',\n  });\n\n  const active = defineModel<string>({ default: '' });\n\n  // Every button is the same size, so the indicator offset is index × step.\n  const STEP = 40;\n\n  const uid = useId();\n  const buttonEls = ref<HTMLButtonElement[]>([]);\n  const tipIndex = ref<number | null>(null);\n\n  const activeIndex = computed(() =>\n    props.tools.findIndex((tool) => tool.id === active.value),\n  );\n\n  const focusIndex = computed(() => Math.max(activeIndex.value, 0));\n\n  function shortcutOf(tool: CanvasTool, index: number): string {\n    return tool.shortcut ?? String(index + 1);\n  }\n\n  function tipId(index: number): string {\n    return `${uid}-tip-${index}`;\n  }\n\n  function pick(index: number, focus = false): void {\n    const tool = props.tools[index];\n    if (!tool) return;\n    active.value = tool.id;\n    if (focus) buttonEls.value[index]?.focus();\n  }\n\n  function onKeydown(event: KeyboardEvent): void {\n    const count = props.tools.length;\n    if (!count) return;\n    const current = focusIndex.value;\n    let next = -1;\n    if (event.key === 'ArrowRight' || event.key === 'ArrowDown')\n      next = (current + 1) % count;\n    else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')\n      next = (current - 1 + count) % count;\n    else if (event.key === 'Home') next = 0;\n    else if (event.key === 'End') next = count - 1;\n    if (next < 0) return;\n    event.preventDefault();\n    tipIndex.value = next;\n    pick(next, true);\n  }\n\n  function showTip(index: number): void {\n    tipIndex.value = index;\n  }\n\n  function hideTip(): void {\n    tipIndex.value = null;\n  }\n\n  function isTyping(target: EventTarget | null): boolean {\n    return (\n      target instanceof HTMLElement &&\n      (target.isContentEditable ||\n        /^(?:INPUT|TEXTAREA|SELECT)$/.test(target.tagName))\n    );\n  }\n\n  useEventListener('keydown', (event: KeyboardEvent) => {\n    if (!props.shortcuts || event.defaultPrevented) return;\n    if (event.metaKey || event.ctrlKey || event.altKey) return;\n    if (isTyping(event.target)) return;\n    const key = event.key.toLowerCase();\n    const index = props.tools.findIndex(\n      (tool, i) => shortcutOf(tool, i).toLowerCase() === key,\n    );\n    if (index < 0) return;\n    event.preventDefault();\n    pick(index);\n  });\n\n  const indicatorStyle = computed(() => ({\n    transform: `translateX(${focusIndex.value * STEP}px)`,\n  }));\n\n  const tipStyle = computed(() => ({\n    left: `${(tipIndex.value ?? 0) * STEP + 4 + STEP / 2}px`,\n  }));\n\n  const tipTool = computed(() =>\n    tipIndex.value === null ? undefined : props.tools[tipIndex.value],\n  );\n</script>\n\n<template>\n  <div\n    role=\"radiogroup\"\n    :aria-label=\"props.label\"\n    :class=\"[\n      'relative inline-flex items-center rounded-2xl border border-border/70 bg-background p-1 shadow-sm dark:border-transparent dark:bg-black/55 dark:shadow-none',\n      props.class,\n    ]\"\n    @keydown=\"onKeydown\"\n  >\n    <span\n      v-if=\"activeIndex >= 0\"\n      aria-hidden=\"true\"\n      class=\"pointer-events-none absolute top-1 left-1 h-8 w-10 rounded-xl bg-muted transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] motion-reduce:transition-none dark:bg-white/16\"\n      :style=\"indicatorStyle\"\n    />\n    <button\n      v-for=\"(tool, index) in props.tools\"\n      :key=\"tool.id\"\n      ref=\"buttonEls\"\n      type=\"button\"\n      role=\"radio\"\n      :aria-checked=\"index === activeIndex\"\n      :aria-label=\"tool.label\"\n      :aria-keyshortcuts=\"shortcutOf(tool, index)\"\n      :aria-describedby=\"tipIndex === index ? tipId(index) : undefined\"\n      :tabindex=\"index === focusIndex ? 0 : -1\"\n      :class=\"[\n        'relative z-10 flex h-8 w-10 items-center justify-center rounded-xl transition-colors focus-visible:outline-2 focus-visible:outline-ring',\n        index === activeIndex\n          ? 'text-foreground'\n          : 'text-muted-foreground hover:text-foreground',\n      ]\"\n      @click=\"pick(index)\"\n      @mouseenter=\"showTip(index)\"\n      @mouseleave=\"hideTip\"\n      @focus=\"showTip(index)\"\n      @blur=\"hideTip\"\n    >\n      <Icon :name=\"tool.icon\" class=\"size-4\" />\n    </button>\n\n    <div\n      v-if=\"tipTool && tipIndex !== null\"\n      :id=\"tipId(tipIndex)\"\n      role=\"tooltip\"\n      class=\"pointer-events-none absolute top-full z-20 mt-2 flex -translate-x-1/2 items-center gap-2 rounded-lg bg-foreground px-2 py-1 text-xs whitespace-nowrap text-background shadow-md dark:bg-zinc-800 dark:text-zinc-100\"\n      :style=\"tipStyle\"\n    >\n      {{ tipTool.label }}\n      <kbd\n        class=\"rounded-sm bg-background/15 px-1 font-mono text-[0.6875rem] tabular-nums dark:bg-white/10\"\n      >\n        {{ shortcutOf(tipTool, tipIndex).toUpperCase() }}\n      </kbd>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/canvas-toolbar/CanvasToolbar.vue"
    },
    {
      "path": "registry/new-york/canvas-toolbar/CanvasToolbarMenu.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, ref } from 'vue';\n  import type { CanvasToolbarMenuProps } from './types';\n\n  const props = withDefaults(defineProps<CanvasToolbarMenuProps>(), {\n    mode: 'action',\n    checked: '',\n    align: 'start',\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    select: [id: string];\n    close: [restoreFocus: boolean];\n  }>();\n\n  const itemEls = ref<HTMLButtonElement[]>([]);\n\n  const startIndex = computed(() =>\n    Math.max(\n      props.items.findIndex((item) => item.id === props.checked),\n      0,\n    ),\n  );\n\n  function focusAt(index: number): void {\n    const count = props.items.length;\n    itemEls.value[(index + count) % count]?.focus();\n  }\n\n  function onKeydown(event: KeyboardEvent): void {\n    const index = itemEls.value.findIndex((el) => el === event.target);\n    if (event.key === 'ArrowDown') {\n      event.preventDefault();\n      focusAt(index + 1);\n    } else if (event.key === 'ArrowUp') {\n      event.preventDefault();\n      focusAt(index - 1);\n    } else if (event.key === 'Home') {\n      event.preventDefault();\n      focusAt(0);\n    } else if (event.key === 'End') {\n      event.preventDefault();\n      focusAt(props.items.length - 1);\n    } else if (event.key === 'Escape') {\n      event.preventDefault();\n      event.stopPropagation();\n      emit('close', true);\n    } else if (event.key === 'Tab') {\n      emit('close', false);\n    }\n  }\n\n  function choose(id: string): void {\n    emit('select', id);\n  }\n\n  onMounted(() => {\n    focusAt(startIndex.value);\n  });\n</script>\n\n<template>\n  <div\n    role=\"menu\"\n    :aria-label=\"props.label\"\n    :class=\"[\n      'absolute top-full z-30 mt-2 flex min-w-44 flex-col gap-0.5 rounded-2xl border border-border/70 bg-popover p-1 text-popover-foreground shadow-lg dark:border-white/8 dark:bg-zinc-900',\n      props.align === 'end' ? 'right-0' : 'left-0',\n      props.class,\n    ]\"\n    @keydown=\"onKeydown\"\n  >\n    <button\n      v-for=\"item in props.items\"\n      :key=\"item.id\"\n      ref=\"itemEls\"\n      type=\"button\"\n      tabindex=\"-1\"\n      :role=\"props.mode === 'radio' ? 'menuitemradio' : 'menuitem'\"\n      :aria-checked=\"\n        props.mode === 'radio' ? item.id === props.checked : undefined\n      \"\n      :class=\"[\n        'flex h-8 items-center gap-2.5 rounded-xl px-2.5 text-left text-sm outline-none transition-colors focus-visible:outline-2 focus-visible:outline-ring',\n        item.destructive\n          ? 'text-red-600 hover:bg-red-500/10 focus:bg-red-500/10 dark:text-red-400'\n          : 'hover:bg-muted focus:bg-muted dark:hover:bg-white/8 dark:focus:bg-white/8',\n      ]\"\n      @click=\"choose(item.id)\"\n    >\n      <Icon\n        :name=\"item.icon\"\n        :class=\"[\n          'size-4 shrink-0',\n          item.destructive ? '' : 'text-muted-foreground',\n        ]\"\n      />\n      <span class=\"flex-1\">{{ item.label }}</span>\n      <Icon\n        v-if=\"props.mode === 'radio' && item.id === props.checked\"\n        name=\"lucide:check\"\n        class=\"size-4 text-blue-500\"\n      />\n      <kbd\n        v-else-if=\"item.shortcut\"\n        class=\"font-sans text-xs text-muted-foreground\"\n      >\n        {{ item.shortcut }}\n      </kbd>\n    </button>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/canvas-toolbar/CanvasToolbarMenu.vue"
    },
    {
      "path": "registry/new-york/canvas-toolbar/canvas-toolbar-defaults.ts",
      "content": "import type { CanvasMenuAction, CanvasTool, CanvasViewOption } from './types';\n\nexport const DEFAULT_CANVAS_TOOLS: CanvasTool[] = [\n  { id: 'source', label: 'Data source', icon: 'lucide:box' },\n  { id: 'select', label: 'Select', icon: 'lucide:navigation' },\n  { id: 'note', label: 'Sticky note', icon: 'lucide:sticky-note' },\n  { id: 'frame', label: 'Frame', icon: 'lucide:vector-square' },\n];\n\nexport const DEFAULT_CANVAS_VIEWS: CanvasViewOption[] = [\n  { id: 'chart', label: 'Chart', icon: 'lucide:chart-no-axes-column' },\n  { id: 'table', label: 'Table', icon: 'lucide:table' },\n  { id: 'number', label: 'Number', icon: 'lucide:hash' },\n];\n\nexport const DEFAULT_CANVAS_ACTIONS: CanvasMenuAction[] = [\n  { id: 'duplicate', label: 'Duplicate', icon: 'lucide:copy', shortcut: '⌘D' },\n  { id: 'lock', label: 'Lock', icon: 'lucide:lock', shortcut: '⇧⌘L' },\n  {\n    id: 'delete',\n    label: 'Delete',\n    icon: 'lucide:trash-2',\n    shortcut: '⌫',\n    destructive: true,\n  },\n];\n",
      "type": "registry:ui",
      "target": "components/ui/canvas-toolbar/canvas-toolbar-defaults.ts"
    },
    {
      "path": "registry/new-york/canvas-toolbar/index.ts",
      "content": "export { default as CanvasToolbar } from './CanvasToolbar.vue';\nexport { default as CanvasSelectionToolbar } from './CanvasSelectionToolbar.vue';\nexport { default as CanvasToolbarMenu } from './CanvasToolbarMenu.vue';\nexport {\n  DEFAULT_CANVAS_ACTIONS,\n  DEFAULT_CANVAS_TOOLS,\n  DEFAULT_CANVAS_VIEWS,\n} from './canvas-toolbar-defaults';\nexport type {\n  CanvasMenuAction,\n  CanvasSelectionToolbarProps,\n  CanvasTool,\n  CanvasToolbarMenuProps,\n  CanvasToolbarProps,\n  CanvasViewOption,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/canvas-toolbar/index.ts"
    },
    {
      "path": "registry/new-york/canvas-toolbar/types.ts",
      "content": "export interface CanvasTool {\n  /** Value written to `v-model` when the tool is active. */\n  id: string;\n  label: string;\n  /** Iconify name, e.g. `lucide:navigation`. */\n  icon: string;\n  /** Single key that picks the tool. Defaults to its position (1, 2, 3…). */\n  shortcut?: string;\n}\n\nexport interface CanvasToolbarProps {\n  tools?: CanvasTool[];\n  /** Listens for the tool shortcut keys on the window. Ignored while typing. */\n  shortcuts?: boolean;\n  /** Accessible name for the radio group. */\n  label?: string;\n  class?: string;\n}\n\nexport interface CanvasViewOption {\n  id: string;\n  label: string;\n  icon: string;\n}\n\nexport interface CanvasMenuAction {\n  id: string;\n  label: string;\n  icon: string;\n  /** Hint shown on the right of the item, e.g. `⌘D`. */\n  shortcut?: string;\n  /** Paints the item in the destructive color. */\n  destructive?: boolean;\n}\n\nexport interface CanvasSelectionToolbarProps {\n  /** Ways to show the selected node. Bind the current one with `v-model:view`. */\n  views?: CanvasViewOption[];\n  /** Items in the \"more\" menu. Picking one emits `action`. */\n  actions?: CanvasMenuAction[];\n  expandLabel?: string;\n  moreLabel?: string;\n  /** Accessible name for the toolbar. */\n  label?: string;\n  class?: string;\n}\n\nexport type CanvasSelectionMenu = 'view' | 'more';\n\nexport type CanvasToolbarMenuMode = 'radio' | 'action';\n\nexport interface CanvasToolbarMenuProps {\n  items: CanvasMenuAction[];\n  /** `radio` renders `menuitemradio` rows with a check on `checked`. */\n  mode?: CanvasToolbarMenuMode;\n  checked?: string;\n  label: string;\n  align?: 'start' | 'end';\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/canvas-toolbar/types.ts"
    }
  ]
}
