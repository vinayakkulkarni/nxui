{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "fuse-button",
  "type": "registry:ui",
  "title": "Fuse Button",
  "description": "Action button that turns into an Undo while a fuse burns around the pill; hover pauses it and Escape cancels.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/fuse-button/FuseButton.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, nextTick, onBeforeUnmount, ref, useId, watch } from 'vue';\n  import { useEventListener } from '@vueuse/core';\n  import type {\n    FuseButtonCommitReason,\n    FuseButtonPhase,\n    FuseButtonProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<FuseButtonProps>(), {\n    label: 'Archive',\n    undoLabel: 'Undo',\n    doneLabel: 'Archived',\n    icon: 'lucide:archive',\n    color: '#f5f5f5',\n    background: '#27272a',\n    fuseColor: '#f5a524',\n    size: 'md',\n    radius: 22,\n    undoWindow: 4000,\n    fuse: 'outline',\n    fuseThickness: 1.5,\n    crossfadeMs: 200,\n    commitOn: 'press',\n    pauseOnHover: true,\n    settle: 'reset',\n    disabled: false,\n    type: 'button',\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    /** The action. */\n    commit: [reason: FuseButtonCommitReason];\n    /** The undo face was used (click, Enter/Space or Escape). */\n    undo: [];\n    /** The fuse burned out. */\n    fuseEnd: [];\n    /** Every phase change. */\n    phaseChange: [phase: FuseButtonPhase];\n  }>();\n\n  const LINE: Keyframe[] = [\n    { transform: 'scaleX(1)' },\n    { transform: 'scaleX(0)' },\n  ];\n  const OUTLINE: Keyframe[] = [\n    { strokeDashoffset: 0 },\n    { strokeDashoffset: -1 },\n  ];\n  const SIZES = {\n    sm: { height: 36, font: 13, icon: 14, px: 16 },\n    md: { height: 44, font: 14, icon: 15, px: 20 },\n    lg: { height: 52, font: 15, icon: 17, px: 24 },\n  };\n\n  const phase = ref<FuseButtonPhase>('idle');\n  const instant = ref(false);\n  const rootRef = ref<HTMLElement | null>(null);\n  const idleRef = ref<HTMLButtonElement | null>(null);\n  const undoRef = ref<HTMLButtonElement | null>(null);\n  const lineRef = ref<HTMLElement | null>(null);\n  const rimRef = ref<SVGRectElement | null>(null);\n  const statusId = useId();\n\n  let anim: Animation | null = null;\n  const pause = { hover: false, hidden: false, canHoverPause: false };\n  let lastInput: 'pointer' | 'keyboard' = 'pointer';\n  let windowMs = props.undoWindow;\n\n  const preset = computed(() => SIZES[props.size] ?? SIZES.md);\n\n  function go(next: FuseButtonPhase) {\n    instant.value = lastInput === 'keyboard';\n    phase.value = next;\n    emit('phaseChange', next);\n  }\n\n  function syncPlayState() {\n    const a = anim;\n    if (!a) return;\n    if (pause.hover || pause.hidden) {\n      if (a.playState === 'running') a.pause();\n    } else if (a.playState === 'paused') {\n      a.play();\n    }\n  }\n\n  function light(from = 0) {\n    const el = props.fuse === 'outline' ? rimRef.value : lineRef.value;\n    if (!el) return;\n    anim?.cancel();\n    const a = el.animate(props.fuse === 'outline' ? OUTLINE : LINE, {\n      duration: windowMs,\n      easing: 'linear',\n      fill: 'forwards',\n    });\n    if (from) a.currentTime = from;\n    a.onfinish = () => {\n      emit('fuseEnd');\n      if (props.commitOn === 'fuseEnd') emit('commit', 'fuseEnd');\n      lastInput = 'pointer';\n      go(props.settle === 'stay' ? 'settled' : 'idle');\n    };\n    anim = a;\n    syncPlayState();\n  }\n\n  function arm() {\n    if (props.disabled || phase.value !== 'idle') return;\n    windowMs = props.undoWindow;\n    light();\n    pause.canHoverPause = false;\n    pause.hover = false;\n    if (props.commitOn === 'press') emit('commit', 'press');\n    go('armed');\n  }\n\n  function undo() {\n    if (phase.value !== 'armed') return;\n    const a = anim;\n    if (a) {\n      a.onfinish = null;\n      a.pause();\n    }\n    emit('undo');\n    go('idle');\n  }\n\n  watch(\n    phase,\n    (next) => {\n      const root = rootRef.value;\n      const inside = root?.contains(document.activeElement) ?? false;\n      if (next === 'armed') undoRef.value?.focus({ preventScroll: true });\n      else if (inside)\n        (next === 'idle' ? idleRef.value : root)?.focus({\n          preventScroll: true,\n        });\n    },\n    { flush: 'post' },\n  );\n\n  function handleVisibility() {\n    pause.hidden = document.hidden;\n    syncPlayState();\n  }\n\n  useEventListener(\n    () => (rootRef.value ? document : null),\n    'visibilitychange',\n    handleVisibility,\n  );\n\n  onBeforeUnmount(() => {\n    anim?.cancel();\n  });\n\n  // Switching fuse style mid-burn relights the new element from the same point.\n  watch(\n    () => props.fuse,\n    async () => {\n      const a = anim;\n      if (!a || phase.value !== 'armed') return;\n      await nextTick();\n      light(Number(a.currentTime) || 0);\n    },\n  );\n\n  watch(\n    () => props.pauseOnHover,\n    (on) => {\n      if (on) return;\n      pause.hover = false;\n      syncPlayState();\n    },\n  );\n\n  function handlePointerDown(e: PointerEvent) {\n    lastInput = 'pointer';\n    const pressable =\n      phase.value === 'armed' || (phase.value === 'idle' && !props.disabled);\n    if (e.button === 0 && pressable && rootRef.value)\n      rootRef.value.dataset.pressed = '';\n  }\n\n  function release() {\n    if (rootRef.value) delete rootRef.value.dataset.pressed;\n  }\n\n  function handlePointerEnter(e: PointerEvent) {\n    if (\n      props.pauseOnHover &&\n      e.pointerType === 'mouse' &&\n      pause.canHoverPause\n    ) {\n      pause.hover = true;\n      syncPlayState();\n    }\n  }\n\n  function handlePointerLeave(e: PointerEvent) {\n    release();\n    if (e.pointerType !== 'mouse') return;\n    pause.canHoverPause = true;\n    pause.hover = false;\n    syncPlayState();\n  }\n\n  function handleKeyDown(e: KeyboardEvent) {\n    if (e.key === 'Enter' || e.key === ' ') lastInput = 'keyboard';\n    if (e.key === 'Escape' && phase.value === 'armed') {\n      e.preventDefault();\n      lastInput = 'keyboard';\n      undo();\n    }\n  }\n\n  const rootStyle = computed(() => ({\n    '--fb-ink': props.color,\n    '--fb-bg': props.background,\n    '--fb-fuse': props.fuseColor,\n    '--fb-fuse-h': `${props.fuseThickness}px`,\n    '--fb-radius': `${props.radius}px`,\n    '--fb-fade': `${props.crossfadeMs}ms`,\n    '--fb-h': `${preset.value.height}px`,\n    '--fb-fs': `${preset.value.font}px`,\n    '--fb-icon': `${preset.value.icon}px`,\n    '--fb-px': `${preset.value.px}px`,\n  }));\n</script>\n\n<template>\n  <span\n    ref=\"rootRef\"\n    tabindex=\"-1\"\n    :class=\"['fuse-button', props.class]\"\n    :data-phase=\"phase\"\n    :data-fuse=\"fuse\"\n    :data-instant=\"instant ? '' : undefined\"\n    :aria-disabled=\"phase === 'settled' || undefined\"\n    :style=\"rootStyle\"\n    @pointerdown=\"handlePointerDown\"\n    @pointerup=\"release\"\n    @pointercancel=\"release\"\n    @pointerenter=\"handlePointerEnter\"\n    @pointerleave=\"handlePointerLeave\"\n    @keydown=\"handleKeyDown\"\n  >\n    <button\n      ref=\"idleRef\"\n      :type=\"type\"\n      class=\"fuse-button__face fuse-button__idle\"\n      :disabled=\"disabled\"\n      :inert=\"phase !== 'idle'\"\n      @click=\"arm\"\n    >\n      <span class=\"fuse-button__icon\" aria-hidden=\"true\">\n        <slot name=\"icon\"><Icon :name=\"icon\" /></slot>\n      </span>\n      {{ label }}\n    </button>\n    <button\n      ref=\"undoRef\"\n      type=\"button\"\n      class=\"fuse-button__face fuse-button__undo\"\n      :aria-describedby=\"statusId\"\n      aria-keyshortcuts=\"Escape\"\n      :inert=\"phase !== 'armed'\"\n      @click=\"undo\"\n    >\n      <span\n        class=\"fuse-button__icon fuse-button__icon--undo\"\n        aria-hidden=\"true\"\n      >\n        <Icon name=\"lucide:rotate-ccw\" />\n      </span>\n      {{ undoLabel }}\n      <i\n        v-if=\"fuse !== 'outline'\"\n        ref=\"lineRef\"\n        class=\"fuse-button__fuse\"\n        aria-hidden=\"true\"\n      />\n    </button>\n    <span\n      class=\"fuse-button__face fuse-button__settled\"\n      :inert=\"phase !== 'settled'\"\n    >\n      <span class=\"fuse-button__icon\" aria-hidden=\"true\">\n        <Icon name=\"lucide:check\" />\n      </span>\n      {{ doneLabel }}\n    </span>\n    <svg v-if=\"fuse === 'outline'\" class=\"fuse-button__rim\" aria-hidden=\"true\">\n      <rect ref=\"rimRef\" pathLength=\"1\" />\n    </svg>\n    <span\n      :id=\"statusId\"\n      class=\"fuse-button__status\"\n      role=\"status\"\n      aria-live=\"polite\"\n    >\n      {{ phase === 'idle' ? '' : doneLabel }}\n    </span>\n  </span>\n</template>\n\n<style>\n  .fuse-button {\n    --fb-ink: #f5f5f5;\n    --fb-bg: #27272a;\n    --fb-fuse: #f5a524;\n    --fb-fuse-h: 1.5px;\n    --fb-radius: 22px;\n    --fb-fade: 200ms;\n    --fb-press: 0.97;\n    --fb-h: 44px;\n    --fb-fs: 14px;\n    --fb-icon: 15px;\n    --fb-px: 20px;\n    --fb-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n\n    position: relative;\n    display: inline-grid;\n    grid-template-columns: minmax(0, 1fr);\n    height: var(--fb-h);\n    border-radius: var(--fb-radius);\n    background: var(--fb-bg);\n    color: var(--fb-ink);\n    font-family: inherit;\n    font-size: var(--fb-fs);\n    font-weight: 500;\n    line-height: 1;\n    letter-spacing: 0.01em;\n    overflow: hidden;\n    isolation: isolate;\n    outline: none;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n    transition: transform 160ms var(--fb-ease-out);\n  }\n\n  .fuse-button[data-pressed] {\n    transform: scale(var(--fb-press));\n  }\n\n  .fuse-button:has(:focus-visible) {\n    outline: 2px solid color-mix(in srgb, var(--fb-ink) 60%, transparent);\n    outline-offset: 3px;\n  }\n\n  .fuse-button__idle:focus-visible,\n  .fuse-button__undo:focus-visible {\n    outline: none;\n  }\n\n  @supports not selector(:has(a)) {\n    .fuse-button__idle:focus-visible,\n    .fuse-button__undo:focus-visible {\n      outline: 2px solid color-mix(in srgb, var(--fb-ink) 60%, transparent);\n      outline-offset: -3px;\n    }\n  }\n\n  .fuse-button__face {\n    position: relative;\n    grid-area: 1 / 1;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    width: 100%;\n    height: 100%;\n    min-width: 0;\n    margin: 0;\n    padding: 0 var(--fb-px);\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    letter-spacing: inherit;\n    white-space: nowrap;\n    cursor: pointer;\n    opacity: 0;\n    filter: blur(2px);\n    visibility: hidden;\n    transition:\n      opacity var(--fb-fade) ease,\n      filter var(--fb-fade) ease,\n      visibility 0s linear var(--fb-fade),\n      background-color 160ms ease;\n  }\n\n  .fuse-button[data-phase='idle'] .fuse-button__idle,\n  .fuse-button[data-phase='armed'] .fuse-button__undo,\n  .fuse-button[data-phase='settled'] .fuse-button__settled {\n    opacity: 1;\n    filter: blur(0);\n    visibility: visible;\n    transition-delay: 0s;\n  }\n\n  .fuse-button[data-instant] .fuse-button__face {\n    transition-duration: 0s;\n  }\n\n  .fuse-button__idle:disabled,\n  .fuse-button__settled {\n    cursor: default;\n  }\n\n  .fuse-button[data-phase='idle']:has(.fuse-button__idle:disabled) {\n    opacity: 0.55;\n  }\n\n  .fuse-button__icon {\n    display: inline-flex;\n    width: var(--fb-icon);\n    height: var(--fb-icon);\n  }\n\n  .fuse-button__icon svg,\n  .fuse-button__icon .iconify {\n    width: 100%;\n    height: 100%;\n  }\n\n  .fuse-button__icon--undo {\n    transform: rotate(-70deg);\n    transition: transform var(--fb-fade) var(--fb-ease-out);\n  }\n\n  .fuse-button[data-phase='armed'] .fuse-button__icon--undo {\n    transform: rotate(0deg);\n  }\n\n  .fuse-button__fuse {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: var(--fb-fuse-h);\n    background: var(--fb-fuse);\n    box-shadow: 0 0 6px color-mix(in srgb, var(--fb-fuse) 55%, transparent);\n    transform-origin: left center;\n    pointer-events: none;\n  }\n\n  .fuse-button[data-fuse='top'] .fuse-button__fuse {\n    bottom: auto;\n    top: 0;\n  }\n\n  .fuse-button__rim {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n    pointer-events: none;\n    opacity: 0;\n    filter: drop-shadow(\n      0 0 3px color-mix(in srgb, var(--fb-fuse) 60%, transparent)\n    );\n    transition: opacity var(--fb-fade) ease;\n  }\n\n  .fuse-button[data-phase='armed'] .fuse-button__rim {\n    opacity: 1;\n  }\n\n  .fuse-button[data-instant] .fuse-button__rim {\n    transition-duration: 0s;\n  }\n\n  .fuse-button__rim rect {\n    x: calc(var(--fb-fuse-h) / 2);\n    y: calc(var(--fb-fuse-h) / 2);\n    width: calc(100% - var(--fb-fuse-h));\n    height: calc(100% - var(--fb-fuse-h));\n    rx: max(0px, calc(var(--fb-radius) - var(--fb-fuse-h) / 2));\n    fill: none;\n    stroke: var(--fb-fuse);\n    stroke-width: var(--fb-fuse-h);\n    stroke-linecap: round;\n    stroke-dasharray: 1;\n  }\n\n  .fuse-button__status {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    border: 0;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .fuse-button__idle:not(:disabled):hover,\n    .fuse-button__undo:hover {\n      background: color-mix(in srgb, var(--fb-ink) 7%, transparent);\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .fuse-button[data-pressed] {\n      transform: none;\n    }\n\n    .fuse-button .fuse-button__face {\n      filter: none;\n      transition:\n        opacity var(--fb-fade) ease,\n        visibility 0s linear var(--fb-fade);\n    }\n\n    .fuse-button .fuse-button__icon--undo {\n      transform: none;\n      transition: none;\n    }\n  }\n\n  @media (prefers-contrast: more) {\n    .fuse-button {\n      box-shadow: inset 0 0 0 1px\n        color-mix(in srgb, var(--fb-ink) 40%, transparent);\n    }\n  }\n\n  @media (forced-colors: active) {\n    .fuse-button__fuse {\n      background: Highlight;\n    }\n\n    .fuse-button__rim rect {\n      stroke: Highlight;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/fuse-button/FuseButton.vue"
    },
    {
      "path": "registry/new-york/fuse-button/index.ts",
      "content": "export { default as FuseButton } from './FuseButton.vue';\nexport type {\n  FuseButtonProps,\n  FuseButtonSize,\n  FuseButtonFuse,\n  FuseButtonCommitOn,\n  FuseButtonSettle,\n  FuseButtonPhase,\n  FuseButtonCommitReason,\n  FuseButtonType,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/fuse-button/index.ts"
    },
    {
      "path": "registry/new-york/fuse-button/types.ts",
      "content": "/** Height, font and padding preset. */\nexport type FuseButtonSize = 'sm' | 'md' | 'lg';\n\n/** Where the fuse burns: a ring around the pill, or a line along the bottom/top edge. */\nexport type FuseButtonFuse = 'outline' | 'bottom' | 'top';\n\n/** When `commit` fires: on the press, or only once the fuse burns out. */\nexport type FuseButtonCommitOn = 'press' | 'fuseEnd';\n\n/** What happens after the fuse burns out. */\nexport type FuseButtonSettle = 'reset' | 'stay';\n\n/** Interaction phase. */\nexport type FuseButtonPhase = 'idle' | 'armed' | 'settled';\n\n/** Why `commit` fired. */\nexport type FuseButtonCommitReason = 'press' | 'fuseEnd';\n\n/** Native button type of the idle face. */\nexport type FuseButtonType = 'button' | 'submit' | 'reset';\n\n/**\n * Props for the FuseButton registry component.\n */\nexport interface FuseButtonProps {\n  /** The idle action. */\n  label?: string;\n  /** The armed face that cancels. */\n  undoLabel?: string;\n  /** Announced on press, and shown when `settle` is `'stay'`. */\n  doneLabel?: string;\n  /** Iconify name of the idle icon. The `icon` slot overrides it. */\n  icon?: string;\n  /** Text and icon ink. */\n  color?: string;\n  /** The pill surface. */\n  background?: string;\n  /** The lit line or ring. */\n  fuseColor?: string;\n  /** Height, font and padding preset. */\n  size?: FuseButtonSize;\n  /** Corner radius in pixels. */\n  radius?: number;\n  /** How long the undo stays available, in ms. */\n  undoWindow?: number;\n  /** A ring around the pill, or a line along the bottom or top edge. */\n  fuse?: FuseButtonFuse;\n  /** Line height or rim stroke in pixels. */\n  fuseThickness?: number;\n  /** Crossfade between faces, in ms. */\n  crossfadeMs?: number;\n  /** Fire `commit` on press, or only when the fuse ends. */\n  commitOn?: FuseButtonCommitOn;\n  /** Hovering the pill pauses the fuse (mouse only). */\n  pauseOnHover?: boolean;\n  /** Return to idle, or stay done, after the fuse ends. */\n  settle?: FuseButtonSettle;\n  /** Disables the idle face. */\n  disabled?: boolean;\n  /** Native type of the idle button. */\n  type?: FuseButtonType;\n  /** Extra classes for the pill. */\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/fuse-button/types.ts"
    }
  ]
}
