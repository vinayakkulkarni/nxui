{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "dodge-field",
  "type": "registry:ui",
  "title": "Dodge Field",
  "description": "Wrapper that makes any child dodge the pointer until it relents and glides home.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/dodge-field/DodgeField.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n  import {\n    useEventListener,\n    usePreferredReducedMotion,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import { animate, useMotionValue } from 'motion-v';\n  import type {\n    DodgeFieldAxis,\n    DodgeFieldProps,\n    DodgeFieldState,\n    DodgeFieldWall,\n  } from './types';\n\n  const COUNT_LINE = 0.55;\n  const DEAD_ZONE = 6;\n  const CAUGHT_HOLD_MS = 760;\n  const INSET = 12;\n\n  const props = withDefaults(defineProps<DodgeFieldProps>(), {\n    taunts: () => ['Catch me', 'Nope', 'Too slow', 'Almost', 'Okay, okay'],\n    notice: '',\n    inkColor: 'var(--foreground)',\n    contrastColor: 'var(--background)',\n    fieldHeight: 240,\n    reach: 72,\n    radius: 120,\n    falloff: 2,\n    fleeDuration: 130,\n    returnDuration: 620,\n    returnBounce: 0.1,\n    axis: 'both',\n    wall: 'clamp',\n    patience: 4,\n    disabled: false,\n    class: undefined,\n  });\n\n  const emit = defineEmits<{\n    dodge: [count: number];\n    relent: [];\n    catch: [];\n  }>();\n\n  defineSlots<{\n    default?: (state: DodgeFieldState) => unknown;\n  }>();\n\n  const fieldRef = ref<HTMLDivElement | null>(null);\n  const moverRef = ref<HTMLDivElement | null>(null);\n  const x = useMotionValue(0);\n  const y = useMotionValue(0);\n\n  const reduceMotion = usePreferredReducedMotion();\n  const reduce = computed(() => reduceMotion.value === 'reduce');\n  const mounted = ref(false);\n  const fine = ref(true);\n  const inside = ref(false);\n  const dodges = ref(0);\n  const caught = ref(false);\n  const gave = computed(() => dodges.value >= Math.max(1, props.patience));\n  const still = computed(\n    () => gave.value || caught.value || props.disabled || reduce.value,\n  );\n\n  let pointer: { x: number; y: number } | null = null;\n  let bearing = { x: 1, y: 0 };\n  let armed = true;\n  let room = { x: 0, y: 0 };\n  let raf = 0;\n  let hold: ReturnType<typeof setTimeout> | undefined;\n\n  function wallIt(t: number, span: number, wall: DodgeFieldWall) {\n    if (wall === 'bounce') {\n      if (t > span) return Math.max(-span, 2 * span - t);\n      if (t < -span) return Math.min(span, -2 * span - t);\n      return t;\n    }\n    return Math.min(span, Math.max(-span, t));\n  }\n\n  function bearingOf(dx: number, dy: number, d: number, axis: DodgeFieldAxis) {\n    if (axis === 'x') return { x: Math.sign(dx) || 1, y: 0 };\n    if (axis === 'y') return { x: 0, y: Math.sign(dy) || 1 };\n    return { x: dx / d, y: dy / d };\n  }\n\n  function applyTransform() {\n    const mover = moverRef.value;\n    if (mover) mover.style.transform = `translate(${x.get()}px, ${y.get()}px)`;\n  }\n  const offX = x.on('change', applyTransform);\n  const offY = y.on('change', applyTransform);\n\n  function measure() {\n    const field = fieldRef.value;\n    const mover = moverRef.value;\n    if (!field || !mover) return;\n    room = {\n      x: Math.max(0, (field.clientWidth - mover.offsetWidth) / 2 - INSET),\n      y: Math.max(0, (field.clientHeight - mover.offsetHeight) / 2 - INSET),\n    };\n  }\n  useResizeObserver(fieldRef, measure);\n  useResizeObserver(moverRef, measure);\n\n  function frame() {\n    raf = 0;\n    const field = fieldRef.value;\n    if (!field) return;\n    const rect = field.getBoundingClientRect();\n    const zoom = rect.width / (field.offsetWidth || rect.width) || 1;\n    const dx = pointer\n      ? (pointer.x - (rect.left + rect.width / 2)) / zoom\n      : Infinity;\n    const dy = pointer\n      ? (pointer.y - (rect.top + rect.height / 2)) / zoom\n      : Infinity;\n    const d = Math.hypot(dx, dy);\n    const isInside = d <= props.radius;\n    if (!isInside && !inside.value) return;\n    if (!still.value) {\n      if (d < props.radius * COUNT_LINE) {\n        if (armed) {\n          armed = false;\n          dodges.value += 1;\n        }\n      } else if (d > props.radius) {\n        armed = true;\n      }\n    }\n    if (Number.isFinite(d) && d > DEAD_ZONE)\n      bearing = bearingOf(dx, dy, d, props.axis);\n    const flee =\n      isInside && !still.value ? (1 - d / props.radius) ** props.falloff : 0;\n    const tx = wallIt(-bearing.x * flee * props.reach, room.x, props.wall);\n    const ty = wallIt(-bearing.y * flee * props.reach, room.y, props.wall);\n    if (reduce.value) {\n      x.jump(0);\n      y.jump(0);\n      applyTransform();\n    } else {\n      const cfg =\n        flee > 0\n          ? {\n              type: 'spring' as const,\n              duration: props.fleeDuration / 1000,\n              bounce: 0,\n            }\n          : {\n              type: 'spring' as const,\n              duration: props.returnDuration / 1000,\n              bounce: props.returnBounce,\n            };\n      animate(x, tx, cfg);\n      animate(y, ty, cfg);\n    }\n    if (isInside !== inside.value) inside.value = isInside;\n  }\n\n  function tick() {\n    if (!raf) raf = requestAnimationFrame(frame);\n  }\n\n  function onMove(event: PointerEvent) {\n    if (event.pointerType === 'touch') return;\n    pointer = { x: event.clientX, y: event.clientY };\n    tick();\n  }\n\n  function onLeave() {\n    pointer = null;\n    tick();\n  }\n\n  const listening = computed(\n    () => mounted.value && fine.value && !props.disabled,\n  );\n  const windowTarget = computed(() => (listening.value ? window : undefined));\n  const documentTarget = computed(() =>\n    listening.value ? document : undefined,\n  );\n  useEventListener(windowTarget, 'pointermove', onMove, { passive: true });\n  useEventListener(windowTarget, 'scroll', tick, {\n    passive: true,\n    capture: true,\n  });\n  useEventListener(windowTarget, 'blur', onLeave);\n  useEventListener(documentTarget, 'pointerleave', onLeave);\n\n  let query: MediaQueryList | undefined;\n  function syncFine() {\n    if (query) fine.value = query.matches;\n  }\n\n  onMounted(() => {\n    query = window.matchMedia('(hover: hover) and (pointer: fine)');\n    syncFine();\n    query.addEventListener('change', syncFine);\n    mounted.value = true;\n    measure();\n  });\n\n  watch(listening, (on) => {\n    if (on) return;\n    cancelAnimationFrame(raf);\n    raf = 0;\n  });\n  watch(still, () => {\n    if (mounted.value) tick();\n  });\n  watch(dodges, (count) => {\n    if (count) emit('dodge', count);\n  });\n  watch(gave, (value) => {\n    if (value) emit('relent');\n  });\n\n  onBeforeUnmount(() => {\n    query?.removeEventListener('change', syncFine);\n    cancelAnimationFrame(raf);\n    clearTimeout(hold);\n    offX();\n    offY();\n    x.stop();\n    y.stop();\n  });\n\n  function handleClick() {\n    caught.value = true;\n    emit('catch');\n    clearTimeout(hold);\n    hold = setTimeout(() => {\n      caught.value = false;\n      dodges.value = 0;\n      armed = false;\n    }, CAUGHT_HOLD_MS);\n  }\n\n  const state = computed<DodgeFieldState>(() => ({\n    dodges: dodges.value,\n    gave: gave.value,\n    caught: caught.value,\n    fleeing: inside.value && !still.value,\n  }));\n  const index = computed(() =>\n    gave.value || caught.value\n      ? props.taunts.length - 1\n      : Math.min(dodges.value, Math.max(0, props.taunts.length - 2)),\n  );\n  const fieldStyle = computed(() => ({\n    '--df-ink': props.inkColor,\n    '--df-contrast': props.contrastColor,\n    '--df-height': `${props.fieldHeight}px`,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"fieldRef\"\n    :class=\"['dodge-field', props.class]\"\n    :data-coarse=\"fine ? undefined : ''\"\n    :data-flat=\"reduce ? '' : undefined\"\n    :style=\"fieldStyle\"\n  >\n    <div\n      ref=\"moverRef\"\n      class=\"dodge-field__mover\"\n      :data-fled=\"state.fleeing ? 'true' : 'false'\"\n      :data-relented=\"gave ? 'true' : 'false'\"\n      :data-caught=\"caught ? 'true' : 'false'\"\n      @click=\"handleClick\"\n    >\n      <slot v-bind=\"state\">\n        <button type=\"button\" class=\"dodge-field__pill\" :aria-label=\"taunts[0]\">\n          <span class=\"dodge-field__labels\">\n            <span\n              v-for=\"(taunt, i) in taunts\"\n              :key=\"`${taunt}-${i}`\"\n              class=\"dodge-field__label\"\n              :data-active=\"i === index ? 'true' : 'false'\"\n              aria-hidden=\"true\"\n            >\n              {{ taunt }}\n            </span>\n          </span>\n        </button>\n      </slot>\n    </div>\n    <p v-if=\"!fine && notice\" class=\"dodge-field__notice\">{{ notice }}</p>\n  </div>\n</template>\n\n<style scoped>\n  .dodge-field {\n    --df-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n\n    position: relative;\n    display: grid;\n    place-items: center;\n    width: 100%;\n    height: var(--df-height);\n  }\n\n  .dodge-field__mover {\n    display: inline-grid;\n    will-change: transform;\n  }\n\n  .dodge-field__pill {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    height: 52px;\n    margin: 0;\n    padding: 0 28px;\n    border: 0;\n    border-radius: 999px;\n    background: color-mix(in srgb, var(--df-ink) 8%, transparent);\n    color: color-mix(in srgb, var(--df-ink) 72%, transparent);\n    font-family: inherit;\n    font-size: 18px;\n    font-weight: 500;\n    line-height: 1;\n    letter-spacing: -0.012em;\n    cursor: pointer;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n    transition:\n      transform 160ms var(--df-ease-out),\n      background-color 220ms ease,\n      color 220ms ease;\n  }\n\n  .dodge-field__pill:active {\n    transform: scale(0.97);\n  }\n\n  .dodge-field__pill:focus-visible {\n    outline: 2px solid color-mix(in srgb, var(--df-ink) 60%, transparent);\n    outline-offset: 3px;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .dodge-field__pill:hover {\n      color: color-mix(in srgb, var(--df-ink) 90%, transparent);\n    }\n  }\n\n  .dodge-field__mover[data-relented='true'] .dodge-field__pill {\n    color: var(--df-ink);\n  }\n\n  .dodge-field__mover[data-caught='true'] .dodge-field__pill {\n    background: var(--df-ink);\n    color: var(--df-contrast);\n  }\n\n  .dodge-field__labels {\n    display: grid;\n  }\n\n  .dodge-field__label {\n    grid-area: 1 / 1;\n    white-space: nowrap;\n    transition:\n      opacity 200ms ease,\n      filter 200ms ease;\n  }\n\n  .dodge-field__label[data-active='false'] {\n    opacity: 0;\n    filter: blur(2px);\n  }\n\n  .dodge-field__notice {\n    position: absolute;\n    inset: auto 0 12px;\n    margin: 0;\n    color: color-mix(in srgb, var(--df-ink) 55%, transparent);\n    font-size: 12px;\n    text-align: center;\n    pointer-events: none;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .dodge-field__pill {\n      transition:\n        background-color 220ms ease,\n        color 220ms ease;\n    }\n\n    .dodge-field__pill:active {\n      transform: none;\n    }\n\n    .dodge-field .dodge-field__label {\n      filter: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/dodge-field/DodgeField.vue"
    },
    {
      "path": "registry/new-york/dodge-field/index.ts",
      "content": "export { default as DodgeField } from './DodgeField.vue';\nexport type {\n  DodgeFieldAxis,\n  DodgeFieldProps,\n  DodgeFieldState,\n  DodgeFieldWall,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/dodge-field/index.ts"
    },
    {
      "path": "registry/new-york/dodge-field/types.ts",
      "content": "import type { HTMLAttributes } from 'vue';\n\nexport type DodgeFieldAxis = 'both' | 'x' | 'y';\n\nexport type DodgeFieldWall = 'clamp' | 'bounce';\n\nexport interface DodgeFieldState {\n  /** Counted dodges since the last catch. */\n  dodges: number;\n  /** True once `patience` dodges have been counted and it sits still. */\n  gave: boolean;\n  /** True for a moment after the child is clicked. */\n  caught: boolean;\n  /** True while the pointer is inside the radius and it is running. */\n  fleeing: boolean;\n}\n\nexport interface DodgeFieldProps {\n  /** Labels for the built-in pill: the first at rest, one per dodge, the last once it relents. */\n  taunts?: string[];\n  /** One line shown under the child on touch devices, where nothing dodges. */\n  notice?: string;\n  /** Pill tint, text, caught fill and focus ring all derive from it. */\n  inkColor?: string;\n  /** Text colour while the pill is caught. */\n  contrastColor?: string;\n  /** Height of the invisible field in pixels; its width is the container. */\n  fieldHeight?: number;\n  /** How far it bolts, in pixels, with the pointer on its home. */\n  reach?: number;\n  /** Distance from home at which it starts to react, in pixels. */\n  radius?: number;\n  /** Exponent of the reaction curve. */\n  falloff?: number;\n  /** Settle time of the dart, in milliseconds. */\n  fleeDuration?: number;\n  /** Settle time of the glide home, in milliseconds. */\n  returnDuration?: number;\n  /** Overshoot on the way home. */\n  returnBounce?: number;\n  /** Which way it may flee. */\n  axis?: DodgeFieldAxis;\n  /** At the edge of the field: stop dead, or fold the overflow back. */\n  wall?: DodgeFieldWall;\n  /** Dodges before it gives in and sits still, at least 1. */\n  patience?: number;\n  /** Sits still and stops counting; the child stays clickable. */\n  disabled?: boolean;\n  class?: HTMLAttributes['class'];\n}\n",
      "type": "registry:ui",
      "target": "components/ui/dodge-field/types.ts"
    }
  ]
}
