{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "chroma-grid",
  "type": "registry:ui",
  "title": "Chroma Grid",
  "description": "A grid of grayscale photo cards where a spotlight follows the cursor and brings back color.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/chroma-grid/ChromaGrid.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, onUpdated, ref } from 'vue';\n  import {\n    useEventListener,\n    usePreferredReducedMotion,\n    useRafFn,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import {\n    CHROMA_GRID_DEFAULT_ITEMS,\n    CHROMA_GRID_THEMES,\n    clampValue,\n    falloffStops,\n  } from './chroma-grid-theme';\n  import type { ChromaGridItem, ChromaGridProps } from './types';\n\n  const props = withDefaults(defineProps<ChromaGridProps>(), {\n    items: undefined,\n    columns: 3,\n    minCardWidth: 180,\n    gap: 12,\n    radius: 260,\n    softness: 0.6,\n    damping: 0.45,\n    fadeOut: 0.6,\n    grayscale: 1,\n    dim: 0.12,\n    glow: 0.5,\n    borderGlow: 1,\n    reveal: 'spotlight',\n    aspectRatio: '3 / 2',\n    cardRadius: 22,\n    showInfo: true,\n    frame: false,\n    theme: 'dark',\n    class: '',\n  });\n\n  const rootRef = ref<HTMLElement | null>(null);\n  const reducedMotion = usePreferredReducedMotion();\n\n  const data = computed<ChromaGridItem[]>(() =>\n    props.items?.length ? props.items : CHROMA_GRID_DEFAULT_ITEMS,\n  );\n  const spotlight = computed(() => props.reveal !== 'card');\n\n  const state = {\n    x: 0,\n    y: 0,\n    tx: 0,\n    ty: 0,\n    power: 0,\n    target: 0,\n    primed: false,\n  };\n\n  function place() {\n    const root = rootRef.value;\n    if (!root) return;\n    const box = root.getBoundingClientRect();\n    root.querySelectorAll<HTMLElement>('[data-chroma-area]').forEach((node) => {\n      const rect = node.getBoundingClientRect();\n      node.style.setProperty('--chroma-ox', `${rect.left - box.left}px`);\n      node.style.setProperty('--chroma-oy', `${rect.top - box.top}px`);\n    });\n  }\n\n  function writeVars() {\n    const root = rootRef.value;\n    if (!root) return;\n    root.style.setProperty('--chroma-x', `${state.x.toFixed(2)}px`);\n    root.style.setProperty('--chroma-y', `${state.y.toFixed(2)}px`);\n    root.style.setProperty('--chroma-power', state.power.toFixed(4));\n  }\n\n  const { pause, resume, isActive } = useRafFn(\n    ({ delta }) => {\n      const reduce = reducedMotion.value === 'reduce';\n      const dt = delta > 0 ? Math.min(0.05, delta / 1000) : 1 / 60;\n      const follow = reduce\n        ? 1\n        : 1 - Math.exp(-dt / Math.max(0.01, props.damping * 0.32));\n      state.x += (state.tx - state.x) * follow;\n      state.y += (state.ty - state.y) * follow;\n      const span =\n        state.target > state.power ? 0.1 : Math.max(0.02, props.fadeOut * 0.35);\n      state.power +=\n        (state.target - state.power) * (reduce ? 1 : 1 - Math.exp(-dt / span));\n      const settled =\n        Math.abs(state.tx - state.x) < 0.1 &&\n        Math.abs(state.ty - state.y) < 0.1 &&\n        Math.abs(state.target - state.power) < 0.002;\n      if (settled) state.power = state.target;\n      writeVars();\n      if (settled) pause();\n    },\n    { immediate: false },\n  );\n\n  function wake() {\n    if (!isActive.value) resume();\n  }\n\n  function onMove(event: PointerEvent) {\n    const root = rootRef.value;\n    if (!root || !spotlight.value) return;\n    const box = root.getBoundingClientRect();\n    state.tx = event.clientX - box.left;\n    state.ty = event.clientY - box.top;\n    if (!state.primed || state.power < 0.02) {\n      state.x = state.tx;\n      state.y = state.ty;\n      state.primed = true;\n    }\n    state.target = 1;\n    wake();\n  }\n\n  function onLeave() {\n    state.target = 0;\n    wake();\n  }\n\n  useEventListener(rootRef, 'pointermove', onMove);\n  useEventListener(rootRef, 'pointerdown', onMove);\n  useEventListener(rootRef, 'pointerleave', onLeave);\n  useEventListener(rootRef, 'pointercancel', onLeave);\n  useResizeObserver(rootRef, place);\n\n  onMounted(place);\n  onUpdated(place);\n\n  const rootStyle = computed(() => ({\n    ...(CHROMA_GRID_THEMES[props.theme] ?? CHROMA_GRID_THEMES.dark),\n    '--chroma-cols': String(Math.max(1, Math.round(props.columns))),\n    '--chroma-min': `${Math.max(80, props.minCardWidth)}px`,\n    '--chroma-gap': `${Math.max(0, props.gap)}px`,\n    '--chroma-r': `${Math.max(20, props.radius)}px`,\n    '--chroma-stops': falloffStops(clampValue(props.softness, 0, 1)),\n    '--chroma-gray': String(clampValue(props.grayscale, 0, 1)),\n    '--chroma-dim': String(clampValue(props.dim, 0, 0.9)),\n    '--chroma-glow': String(clampValue(props.glow, 0, 1)),\n    '--chroma-border': String(clampValue(props.borderGlow, 0, 1)),\n    '--chroma-fade': `${Math.max(0, props.fadeOut)}s`,\n    '--chroma-ratio': props.aspectRatio,\n    '--chroma-radius': `${Math.max(0, props.cardRadius)}px`,\n  }));\n\n  function cardKey(item: ChromaGridItem, index: number) {\n    return `${item.title ?? ''}-${index}`;\n  }\n\n  function accentStyle(item: ChromaGridItem) {\n    return { '--chroma-accent': item.accent ?? item.borderColor ?? '#ffffff' };\n  }\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"cn('chroma-grid', frame && 'has-frame', props.class)\"\n    :data-reveal=\"reveal === 'card' ? 'card' : 'spotlight'\"\n    :style=\"rootStyle\"\n  >\n    <div class=\"chroma-grid-inner\">\n      <component\n        :is=\"item.url ? 'a' : 'article'\"\n        v-for=\"(item, index) in data\"\n        :key=\"cardKey(item, index)\"\n        class=\"chroma-card\"\n        data-chroma-area=\"\"\n        :style=\"accentStyle(item)\"\n        :href=\"item.url || undefined\"\n        :target=\"item.url ? '_blank' : undefined\"\n        :rel=\"item.url ? 'noopener noreferrer' : undefined\"\n      >\n        <span class=\"chroma-wash\" aria-hidden=\"true\" />\n        <div class=\"chroma-media\" data-chroma-area=\"\">\n          <img\n            class=\"chroma-mono\"\n            :src=\"item.image\"\n            :alt=\"item.alt ?? item.title ?? ''\"\n            loading=\"lazy\"\n          />\n          <img\n            class=\"chroma-color\"\n            :src=\"item.image\"\n            alt=\"\"\n            aria-hidden=\"true\"\n            loading=\"lazy\"\n          />\n          <span class=\"chroma-media-rim\" aria-hidden=\"true\" />\n        </div>\n        <div\n          v-if=\"showInfo && (item.title || item.subtitle)\"\n          class=\"chroma-info\"\n        >\n          <span v-if=\"item.title\" class=\"chroma-title\">{{ item.title }}</span>\n          <span v-if=\"item.subtitle\" class=\"chroma-subtitle\">\n            {{ item.subtitle }}\n          </span>\n        </div>\n        <span class=\"chroma-card-rim\" aria-hidden=\"true\" />\n        <span class=\"chroma-card-glow\" aria-hidden=\"true\" />\n      </component>\n    </div>\n    <span v-if=\"frame\" class=\"chroma-frame-rim\" aria-hidden=\"true\" />\n  </div>\n</template>\n\n<style scoped>\n  .chroma-grid {\n    --chroma-x: -9999px;\n    --chroma-y: -9999px;\n    --chroma-power: 0;\n    position: relative;\n    width: 100%;\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .chroma-grid.has-frame {\n    padding: 10px;\n    border-radius: calc(var(--chroma-radius) + 10px);\n    background: var(--chroma-frame);\n    box-shadow: var(--chroma-frame-shadow);\n    -webkit-backdrop-filter: blur(20px) saturate(1.6);\n    backdrop-filter: blur(20px) saturate(1.6);\n  }\n\n  .chroma-frame-rim {\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    box-shadow:\n      inset 0 0 0 1px var(--chroma-frame-edge),\n      inset 0 1px 0 var(--chroma-frame-highlight);\n    pointer-events: none;\n  }\n\n  .chroma-grid-inner {\n    display: grid;\n    gap: var(--chroma-gap);\n    grid-template-columns: repeat(\n      auto-fill,\n      minmax(\n        min(\n          100%,\n          max(\n            var(--chroma-min),\n            calc(\n              (100% - (var(--chroma-cols) - 1) * var(--chroma-gap)) /\n                var(--chroma-cols)\n            )\n          )\n        ),\n        1fr\n      )\n    );\n  }\n\n  .chroma-card {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    min-width: 0;\n    padding: 8px;\n    box-sizing: border-box;\n    border-radius: var(--chroma-radius);\n    background: var(--chroma-tile);\n    box-shadow: var(--chroma-tile-shadow);\n    color: var(--chroma-ink);\n    text-decoration: none;\n    overflow: hidden;\n    isolation: isolate;\n    transition: filter 0.25s ease;\n  }\n\n  .chroma-card:hover {\n    filter: var(--chroma-hover);\n  }\n\n  a.chroma-card:active {\n    filter: var(--chroma-press);\n  }\n\n  a.chroma-card:focus-visible {\n    outline: 2px solid var(--chroma-ink);\n    outline-offset: 2px;\n  }\n\n  .chroma-wash,\n  .chroma-color,\n  .chroma-card-glow {\n    -webkit-mask-image: radial-gradient(\n      circle var(--chroma-r) at calc(var(--chroma-x) - var(--chroma-ox, 0px))\n        calc(var(--chroma-y) - var(--chroma-oy, 0px)),\n      var(--chroma-stops)\n    );\n    mask-image: radial-gradient(\n      circle var(--chroma-r) at calc(var(--chroma-x) - var(--chroma-ox, 0px))\n        calc(var(--chroma-y) - var(--chroma-oy, 0px)),\n      var(--chroma-stops)\n    );\n  }\n\n  .chroma-wash {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n    background: radial-gradient(\n      130% 70% at 50% 100%,\n      var(--chroma-accent),\n      transparent 72%\n    );\n    opacity: calc(var(--chroma-glow) * var(--chroma-power) * 0.45);\n  }\n\n  .chroma-media {\n    position: relative;\n    z-index: 1;\n    aspect-ratio: var(--chroma-ratio);\n    border-radius: max(0px, calc(var(--chroma-radius) - 8px));\n    overflow: hidden;\n    background: var(--chroma-well);\n  }\n\n  .chroma-media img {\n    position: absolute;\n    inset: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    user-select: none;\n    -webkit-user-drag: none;\n  }\n\n  .chroma-mono {\n    filter: grayscale(var(--chroma-gray))\n      brightness(calc(1 - var(--chroma-dim)));\n  }\n\n  .chroma-color {\n    opacity: var(--chroma-power);\n  }\n\n  .chroma-media-rim {\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    box-shadow: inset 0 0 0 1px var(--chroma-media-edge);\n    pointer-events: none;\n  }\n\n  .chroma-info {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n    min-width: 0;\n    padding: 2px 6px 4px;\n  }\n\n  .chroma-title {\n    overflow: hidden;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.3;\n    letter-spacing: -0.01em;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .chroma-subtitle {\n    overflow: hidden;\n    font-size: 13px;\n    line-height: 1.35;\n    color: var(--chroma-muted);\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .chroma-card-rim,\n  .chroma-card-glow {\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    border-radius: inherit;\n    pointer-events: none;\n  }\n\n  .chroma-card-rim {\n    box-shadow:\n      inset 0 0 0 1px var(--chroma-tile-edge),\n      inset 0 1px 0 var(--chroma-tile-highlight);\n  }\n\n  .chroma-card-glow {\n    box-shadow:\n      inset 0 0 0 1px var(--chroma-accent),\n      inset 0 0 16px -8px var(--chroma-accent);\n    opacity: calc(var(--chroma-border) * var(--chroma-power));\n  }\n\n  .chroma-grid[data-reveal='card'] .chroma-wash,\n  .chroma-grid[data-reveal='card'] .chroma-color,\n  .chroma-grid[data-reveal='card'] .chroma-card-glow {\n    -webkit-mask-image: none;\n    mask-image: none;\n    opacity: 0;\n    transition: opacity var(--chroma-fade) ease;\n  }\n\n  .chroma-grid[data-reveal='card'] .chroma-card:hover .chroma-wash {\n    opacity: calc(var(--chroma-glow) * 0.45);\n    transition-duration: 0.3s;\n  }\n\n  .chroma-grid[data-reveal='card'] .chroma-card:hover .chroma-color {\n    opacity: 1;\n    transition-duration: 0.3s;\n  }\n\n  .chroma-grid[data-reveal='card'] .chroma-card:hover .chroma-card-glow {\n    opacity: var(--chroma-border);\n    transition-duration: 0.3s;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/chroma-grid/ChromaGrid.vue"
    },
    {
      "path": "registry/new-york/chroma-grid/chroma-grid-theme.ts",
      "content": "import type { ChromaGridItem, ChromaGridTheme } from './types';\n\nexport const CHROMA_GRID_THEMES: Record<\n  ChromaGridTheme,\n  Record<string, string>\n> = {\n  dark: {\n    '--chroma-frame': 'rgba(38, 35, 46, 0.66)',\n    '--chroma-frame-edge': 'rgba(255, 255, 255, 0.08)',\n    '--chroma-frame-highlight': 'rgba(255, 255, 255, 0.07)',\n    '--chroma-frame-shadow':\n      '0 22px 44px -20px rgba(0, 0, 0, 0.8), 0 6px 16px -8px rgba(0, 0, 0, 0.5)',\n    '--chroma-tile': 'linear-gradient(180deg, #3a3644 0%, #27242f 100%)',\n    '--chroma-tile-edge': 'rgba(255, 255, 255, 0.07)',\n    '--chroma-tile-highlight': 'rgba(255, 255, 255, 0.12)',\n    '--chroma-tile-shadow': '0 4px 10px -4px rgba(0, 0, 0, 0.7)',\n    '--chroma-media-edge': 'rgba(255, 255, 255, 0.06)',\n    '--chroma-well': 'rgba(255, 255, 255, 0.08)',\n    '--chroma-ink': '#f4f4f5',\n    '--chroma-muted': 'rgba(244, 244, 245, 0.55)',\n    '--chroma-hover': 'brightness(1.12)',\n    '--chroma-press': 'brightness(0.85)',\n  },\n  light: {\n    '--chroma-frame': 'rgba(240, 240, 243, 0.8)',\n    '--chroma-frame-edge': 'rgba(24, 24, 27, 0.07)',\n    '--chroma-frame-highlight': 'rgba(255, 255, 255, 0.95)',\n    '--chroma-frame-shadow':\n      '0 22px 44px -22px rgba(24, 24, 27, 0.3), 0 6px 16px -10px rgba(24, 24, 27, 0.16)',\n    '--chroma-tile': 'linear-gradient(180deg, #ffffff 0%, #f6f6f8 100%)',\n    '--chroma-tile-edge': 'rgba(24, 24, 27, 0.08)',\n    '--chroma-tile-highlight': 'rgba(255, 255, 255, 1)',\n    '--chroma-tile-shadow': '0 4px 10px -5px rgba(24, 24, 27, 0.25)',\n    '--chroma-media-edge': 'rgba(24, 24, 27, 0.06)',\n    '--chroma-well': 'rgba(24, 24, 27, 0.05)',\n    '--chroma-ink': '#27272a',\n    '--chroma-muted': 'rgba(39, 39, 42, 0.55)',\n    '--chroma-hover': 'brightness(0.97)',\n    '--chroma-press': 'brightness(0.92)',\n  },\n};\n\nexport const CHROMA_GRID_DEFAULT_ITEMS: ChromaGridItem[] = [\n  {\n    image:\n      'https://images.unsplash.com/photo-1514519334989-3d5c8b1a9f91?w=800&q=80&auto=format&fit=crop',\n    title: 'Golden Hour',\n    subtitle: 'Sky study',\n    accent: '#ff8a4c',\n  },\n  {\n    image:\n      'https://images.unsplash.com/photo-1520930528075-4ea5ead759f5?w=800&q=80&auto=format&fit=crop',\n    title: 'Steel Arches',\n    subtitle: 'Sculpture',\n    accent: '#ff5a36',\n  },\n  {\n    image:\n      'https://images.unsplash.com/photo-1511300636408-a63a89df3482?w=800&q=80&auto=format&fit=crop',\n    title: 'Black Beach',\n    subtitle: 'Landscape',\n    accent: '#a98bff',\n  },\n  {\n    image:\n      'https://images.unsplash.com/photo-1524400968894-6e997a66e03f?w=800&q=80&auto=format&fit=crop',\n    title: 'Cloud Front',\n    subtitle: 'Weather',\n    accent: '#ffb27a',\n  },\n  {\n    image:\n      'https://images.unsplash.com/photo-1778849097774-0ab2a873a858?w=800&q=80&auto=format&fit=crop',\n    title: 'Pink Drift',\n    subtitle: 'Sky study',\n    accent: '#ff7eb6',\n  },\n  {\n    image:\n      'https://images.unsplash.com/photo-1501630834273-4b5604d2ee31?w=800&q=80&auto=format&fit=crop',\n    title: 'Cumulus',\n    subtitle: 'Weather',\n    accent: '#7cc4ff',\n  },\n];\n\nexport function clampValue(value: number, min: number, max: number): number {\n  return Math.min(max, Math.max(min, value));\n}\n\n/** 13 smootherstep alpha stops for the spotlight mask. */\nexport function falloffStops(softness: number): string {\n  const core = clampValue(1 - softness, 0, 0.95);\n  const stops: string[] = [];\n  for (let i = 0; i <= 12; i++) {\n    const t = i / 12;\n    const u = clampValue((t - core) / Math.max(0.0001, 1 - core), 0, 1);\n    const alpha = 1 - u * u * u * (u * (u * 6 - 15) + 10);\n    stops.push(`rgba(0, 0, 0, ${alpha.toFixed(3)}) ${(t * 100).toFixed(1)}%`);\n  }\n  return stops.join(', ');\n}\n",
      "type": "registry:ui",
      "target": "components/ui/chroma-grid/chroma-grid-theme.ts"
    },
    {
      "path": "registry/new-york/chroma-grid/index.ts",
      "content": "export { default as ChromaGrid } from './ChromaGrid.vue';\nexport type {\n  ChromaGridItem,\n  ChromaGridProps,\n  ChromaGridReveal,\n  ChromaGridTheme,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/chroma-grid/index.ts"
    },
    {
      "path": "registry/new-york/chroma-grid/types.ts",
      "content": "export interface ChromaGridItem {\n  image: string;\n  title?: string;\n  subtitle?: string;\n  /** Accent for the glow and the lit border. */\n  accent?: string;\n  /** Fallback accent, kept for older item data. */\n  borderColor?: string;\n  /** Alt text for the image. Falls back to the title. */\n  alt?: string;\n  /** Makes the whole card a link (opens in a new tab). */\n  url?: string;\n}\n\nexport type ChromaGridReveal = 'spotlight' | 'card';\nexport type ChromaGridTheme = 'dark' | 'light';\n\nexport interface ChromaGridProps {\n  items?: ChromaGridItem[];\n  /** The most columns the grid shows. */\n  columns?: number;\n  /** Narrowest a card can get, in px. */\n  minCardWidth?: number;\n  /** Space between cards, in px. */\n  gap?: number;\n  /** Size of the color spotlight, in px. */\n  radius?: number;\n  /** Spotlight edge softness, 0 crisp – 1 soft. */\n  softness?: number;\n  /** How smoothly the spotlight trails the cursor. 0 follows exactly. */\n  damping?: number;\n  /** Seconds for colors to fade back after the cursor leaves. */\n  fadeOut?: number;\n  grayscale?: number;\n  dim?: number;\n  glow?: number;\n  borderGlow?: number;\n  reveal?: ChromaGridReveal;\n  /** CSS aspect-ratio value for the images. */\n  aspectRatio?: string;\n  cardRadius?: number;\n  showInfo?: boolean;\n  frame?: boolean;\n  theme?: ChromaGridTheme;\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/chroma-grid/types.ts"
    }
  ]
}
