      "path": "registry/new-york/scrub-field/scrub-field-math.ts",
      "content": "import type { ScrubFieldSize, ScrubFieldSizePreset } from './types';\n\nexport const SPRING_UI = { type: 'spring' as const, duration: 0.3, bounce: 0 };\nexport const LEAN = 4;\n\nexport const SIZES: Record<ScrubFieldSize, ScrubFieldSizePreset> = {\n  sm: { height: 28, font: 12, radius: 6, width: 104 },\n  md: { height: 34, font: 13, radius: 8, width: 128 },\n  lg: { height: 44, font: 16, radius: 10, width: 160 },\n};\n\nexport function clamp(value: number, min: number, max: number): number {\n  return Math.min(max, Math.max(min, value));\n}\n\nexport function decimalsOf(n: number): number {\n  const s = String(n);\n  const i = s.indexOf('.');\n  return i < 0 ? 0 : s.length - i - 1;\n}\n\n/** Black or white ink, whichever reads on the given hex background. */\nexport function onColor(hex: string): string {\n  const raw = hex.replace('#', '');\n  const full =\n    raw.length === 3 ? [...raw].map((ch) => ch + ch).join('') : raw.slice(0, 6);\n  const n = Number.parseInt(full, 16);\n  if (Number.isNaN(n)) return '#ffffff';\n  const yiq =\n    (((n >> 16) & 255) * 299 + ((n >> 8) & 255) * 587 + (n & 255) * 114) / 1000;\n  return yiq >= 128 ? '#111111' : '#ffffff';\n}\n",
      "type": "registry:ui",
      "target": "components/ui/scrub-field/scrub-field-math.ts"
    },
    {
      "path": "registry/new-york/scrub-field/types.ts",
      "content": "export type ScrubFieldSize = 'sm' | 'md' | 'lg';\n\nexport interface ScrubFieldProps {\n  label?: string;\n  suffix?: string;\n  /** Controlled value (v-model). */\n  modelValue?: number;\n  defaultValue?: number;\n  min?: number;\n  max?: number;\n  step?: number;\n  size?: ScrubFieldSize;\n  sensitivity?: number;\n  rubberReach?: number;\n  returnDuration?: number;\n  coarseMultiplier?: number;\n  fineMultiplier?: number;\n  showDelta?: boolean;\n  showDirty?: boolean;\n  showFill?: boolean;\n  accent?: string;\n  chipColor?: string;\n  disabled?: boolean;\n  class?: string;\n}\n\nexport interface ScrubFieldDrag {\n  id: number;\n  x: number;\n  raw: number;\n  mult: number;\n  moved: boolean;\n  before: number;\n  slack: number;\n  left: number;\n}\n\nexport interface ScrubFieldModifiers {\n  shiftKey: boolean;\n  altKey: boolean;\n}\n\nexport interface ScrubFieldSizePreset {\n  height: number;\n  font: number;\n  radius: number;\n  width: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/scrub-field/types.ts"
    }
