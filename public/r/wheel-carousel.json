{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "wheel-carousel",
  "type": "registry:ui",
  "title": "Wheel Carousel",
  "description": "A rotating-wheel picker with inertial drag and scroll, curved fading labels, and a crossfading image for the active item.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/wheel-carousel/WheelCarousel.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, ref, useId, watch } from 'vue';\n  import type { CSSProperties } from 'vue';\n  import {\n    useEventListener,\n    usePreferredReducedMotion,\n    useRafFn,\n  } from '@vueuse/core';\n  import { AnimatePresence, motion } from 'motion-v';\n  import type {\n    WheelCarouselItem,\n    WheelCarouselLabel,\n    WheelCarouselPalette,\n    WheelCarouselProps,\n  } from './types';\n  import {\n    shortestOffset,\n    wheelCarouselAspectRatios,\n    wheelCarouselDarkPalette,\n    wheelCarouselDefaultItems,\n    wheelCarouselLightPalette,\n    wrapIndex,\n  } from './wheel-carousel-data';\n  import { cn } from '~/lib/utils';\n\n  const props = withDefaults(defineProps<WheelCarouselProps>(), {\n    items: () => wheelCarouselDefaultItems,\n    mode: 'system',\n    photoSide: 'left',\n    photoWidth: 24,\n    photoAspect: '3/4',\n    contentWidth: 900,\n    gap: 0,\n    photoRadius: 14,\n    crossfadeDuration: 0.5,\n    radius: 320,\n    spacing: 14,\n    visibleItems: 7,\n    apexInset: 34,\n    textColor: 'rgba(180, 90, 20, 0.45)',\n    selectedColor: 'rgb(180, 84, 30)',\n    showMarker: true,\n    markerColor: 'rgb(232, 121, 46)',\n    markerSize: 16,\n    markerGap: 20,\n    background: 'rgb(255, 246, 236)',\n    panelColor: undefined,\n    scrollSpeed: 0.008,\n    dragSpeed: 0.02,\n    snap: true,\n    momentum: true,\n    appear: true,\n    edgeFade: true,\n    edgeFadeSize: 30,\n    initialIndex: 0,\n    activeIndex: undefined,\n    class: '',\n    photoClass: '',\n    itemClass: '',\n  });\n\n  const emit = defineEmits<{\n    'update:activeIndex': [index: number];\n    activeChange: [item: WheelCarouselItem, index: number];\n  }>();\n\n  const reducedMotion = usePreferredReducedMotion();\n  const reduceMotion = computed(() => reducedMotion.value === 'reduce');\n  const instanceId = useId();\n  const colorMode = useColorMode();\n  const themeReady = ref(false);\n\n  const resolvedMode = computed(() => {\n    if (props.mode !== 'system') return props.mode;\n    return themeReady.value && colorMode.value === 'dark' ? 'dark' : 'light';\n  });\n\n  const carouselItems = computed(() =>\n    props.items.length ? props.items : wheelCarouselDefaultItems,\n  );\n  const itemCount = computed(() => carouselItems.value.length);\n\n  const startingIndex = wrapIndex(\n    props.activeIndex ?? props.initialIndex,\n    itemCount.value,\n  );\n\n  // `rotation` is a continuous item index; whole numbers sit on the apex.\n  const rotation = ref(startingIndex);\n  const selectedIndex = ref(startingIndex);\n  const isDragging = ref(false);\n  const stageRef = ref<HTMLDivElement>();\n\n  let velocity = 0;\n  let dragging = false;\n  let dragOriginY = 0;\n  let dragOriginRotation = startingIndex;\n  let previousDragRotation = startingIndex;\n  let appliedActiveIndex: number | null = null;\n\n  onMounted(() => {\n    themeReady.value = true;\n  });\n\n  const palette = computed<WheelCarouselPalette>(() => {\n    if (resolvedMode.value === 'dark') return wheelCarouselDarkPalette;\n    if (resolvedMode.value === 'light') return wheelCarouselLightPalette;\n    return {\n      background: props.background,\n      text: props.textColor,\n      selected: props.selectedColor,\n      marker: props.markerColor,\n      panel: props.panelColor ?? props.background,\n    };\n  });\n\n  function commitRotation(nextRotation: number) {\n    rotation.value = nextRotation;\n    const nextIndex = wrapIndex(Math.round(nextRotation), itemCount.value);\n    if (nextIndex !== selectedIndex.value) {\n      selectedIndex.value = nextIndex;\n      emit('activeChange', carouselItems.value[nextIndex]!, nextIndex);\n      emit('update:activeIndex', nextIndex);\n    }\n  }\n\n  const { pause, resume, isActive } = useRafFn(tick, { immediate: false });\n\n  function tick() {\n    let keepAnimating = false;\n\n    if (!dragging && Math.abs(velocity) > 0.0008) {\n      commitRotation(rotation.value + velocity);\n      velocity *=\n        props.momentum && !reduceMotion.value ? (props.snap ? 0.9 : 0.94) : 0.8;\n      keepAnimating = true;\n    } else if (!dragging && props.snap) {\n      velocity = 0;\n      const target = Math.round(rotation.value);\n      const delta = target - rotation.value;\n      if (Math.abs(delta) > 0.001 && !reduceMotion.value) {\n        commitRotation(rotation.value + delta * 0.22);\n        keepAnimating = true;\n      } else {\n        commitRotation(target);\n      }\n    } else if (!dragging) {\n      velocity = 0;\n    }\n\n    if (!keepAnimating) pause();\n  }\n\n  function runAnimation() {\n    if (!isActive.value) resume();\n  }\n\n  function moveBy(amount: number) {\n    velocity = 0;\n    commitRotation(rotation.value + amount);\n    runAnimation();\n  }\n\n  function onWheel(event: WheelEvent) {\n    // Leave pinch-zoom alone.\n    if (event.ctrlKey || event.metaKey) return;\n    event.preventDefault();\n    const delta = event.deltaY * props.scrollSpeed;\n    commitRotation(rotation.value + delta);\n    velocity = delta * 0.2;\n    runAnimation();\n  }\n\n  useEventListener(stageRef, 'wheel', onWheel, { passive: false });\n\n  watch(\n    [() => props.activeIndex, itemCount],\n    ([activeIndex, count]) => {\n      if (activeIndex === undefined) return;\n      const controlledIndex = wrapIndex(activeIndex, count);\n      if (appliedActiveIndex === controlledIndex) return;\n      appliedActiveIndex = controlledIndex;\n      const currentIndex = wrapIndex(Math.round(rotation.value), count);\n      let delta = controlledIndex - currentIndex;\n      if (delta > count / 2) delta -= count;\n      if (delta < -count / 2) delta += count;\n      selectedIndex.value = controlledIndex;\n      commitRotation(rotation.value + delta);\n    },\n    { immediate: true },\n  );\n\n  watch(itemCount, (count) => {\n    const normalizedIndex = wrapIndex(selectedIndex.value, count);\n    if (normalizedIndex === selectedIndex.value) return;\n    selectedIndex.value = normalizedIndex;\n    rotation.value = normalizedIndex;\n  });\n\n  function onPointerDown(event: PointerEvent) {\n    if (!event.isPrimary || event.button !== 0) return;\n    dragging = true;\n    isDragging.value = true;\n    velocity = 0;\n    dragOriginY = event.clientY;\n    dragOriginRotation = rotation.value;\n    previousDragRotation = rotation.value;\n    stageRef.value?.setPointerCapture(event.pointerId);\n  }\n\n  function onPointerMove(event: PointerEvent) {\n    if (!dragging) return;\n    const distance = event.clientY - dragOriginY;\n    const nextRotation = dragOriginRotation - distance * props.dragSpeed;\n    velocity = nextRotation - previousDragRotation;\n    previousDragRotation = nextRotation;\n    commitRotation(nextRotation);\n  }\n\n  function onPointerEnd(event: PointerEvent) {\n    if (!dragging) return;\n    dragging = false;\n    isDragging.value = false;\n    const stage = stageRef.value;\n    if (stage?.hasPointerCapture(event.pointerId)) {\n      stage.releasePointerCapture(event.pointerId);\n    }\n    runAnimation();\n  }\n\n  function onKeyDown(event: KeyboardEvent) {\n    if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {\n      event.preventDefault();\n      moveBy(1);\n    }\n    if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {\n      event.preventDefault();\n      moveBy(-1);\n    }\n    if (event.key === 'Home') {\n      event.preventDefault();\n      velocity = 0;\n      commitRotation(rotation.value - selectedIndex.value);\n      runAnimation();\n    }\n    if (event.key === 'End') {\n      event.preventDefault();\n      velocity = 0;\n      commitRotation(\n        rotation.value + itemCount.value - 1 - selectedIndex.value,\n      );\n      runAnimation();\n    }\n  }\n\n  const safeSelectedIndex = computed(() =>\n    wrapIndex(selectedIndex.value, itemCount.value),\n  );\n  const selectedItem = computed(\n    () => carouselItems.value[safeSelectedIndex.value]!,\n  );\n\n  const activeDescendant = computed(() =>\n    Math.abs(\n      shortestOffset(safeSelectedIndex.value, rotation.value, itemCount.value),\n    ) <=\n    props.visibleItems + 1\n      ? `${instanceId}-item-${safeSelectedIndex.value}`\n      : undefined,\n  );\n\n  const maskStyle = computed<CSSProperties>(() => {\n    if (!props.edgeFade) return {};\n    const mask = `linear-gradient(to bottom, transparent 0%, black ${props.edgeFadeSize}%, black ${100 - props.edgeFadeSize}%, transparent 100%)`;\n    return { maskImage: mask, WebkitMaskImage: mask };\n  });\n\n  const markerStyle = computed<CSSProperties>(() => ({\n    left: `calc(${props.apexInset}% - ${props.markerGap}px)`,\n    width: `${props.markerSize}px`,\n    height: `${props.markerSize}px`,\n    marginLeft: `${-props.markerSize}px`,\n    backgroundColor: palette.value.marker,\n  }));\n\n  const wheelLabels = computed(() => {\n    const count = itemCount.value;\n    const labels: WheelCarouselLabel[] = [];\n\n    carouselItems.value.forEach((item, index) => {\n      const offset = shortestOffset(index, rotation.value, count);\n      if (Math.abs(offset) > props.visibleItems + 1) return;\n\n      const angle = offset * props.spacing;\n      const radians = (angle * Math.PI) / 180;\n      const x = -props.radius * (1 - Math.cos(radians));\n      const y = props.radius * Math.sin(radians);\n      const distance = Math.min(Math.abs(offset) / props.visibleItems, 1);\n      const opacity = Math.cos((distance * Math.PI) / 2);\n      const scale = 1 - Math.min(Math.abs(offset) * 0.04, 0.45);\n      const selected = Math.abs(offset) < 0.5;\n\n      labels.push({\n        key: `${item.label}-${index}`,\n        index,\n        label: item.label,\n        selected,\n        style: {\n          left: `${props.apexInset}%`,\n          color: selected ? palette.value.selected : palette.value.text,\n          opacity,\n          transform: `translate(${x}px, ${y}px) translateY(-50%) rotate(${angle}deg) scale(${scale})`,\n        },\n      });\n    });\n\n    return labels;\n  });\n\n  const initialState = computed(() =>\n    props.appear && !reduceMotion.value ? { opacity: 0, y: 18 } : false,\n  );\n  const imageInitial = computed(() =>\n    reduceMotion.value ? false : { opacity: 0, scale: 1.04 },\n  );\n</script>\n\n<template>\n  <motion.div\n    :initial=\"initialState\"\n    :animate=\"{ opacity: 1, y: 0 }\"\n    :transition=\"{\n      duration: reduceMotion ? 0 : 0.7,\n      ease: [0.16, 1, 0.3, 1],\n    }\"\n    :class=\"\n      cn(\n        'flex size-full min-h-105 items-center justify-center overflow-hidden',\n        props.class,\n      )\n    \"\n    :style=\"{ backgroundColor: palette.background }\"\n  >\n    <div\n      ref=\"stageRef\"\n      role=\"listbox\"\n      aria-label=\"Wheel carousel\"\n      :aria-activedescendant=\"activeDescendant\"\n      tabindex=\"0\"\n      :class=\"\n        cn(\n          'flex size-full touch-none items-stretch overflow-hidden outline-none select-none focus-visible:ring-2 focus-visible:ring-current focus-visible:ring-inset',\n          photoSide === 'right' && 'flex-row-reverse',\n          isDragging ? 'cursor-grabbing' : 'cursor-grab',\n        )\n      \"\n      :style=\"{ maxWidth: `${contentWidth}px`, gap: `${gap}px` }\"\n      @pointerdown=\"onPointerDown\"\n      @pointermove=\"onPointerMove\"\n      @pointerup=\"onPointerEnd\"\n      @pointercancel=\"onPointerEnd\"\n      @keydown=\"onKeyDown\"\n    >\n      <div\n        class=\"flex h-full shrink-0 items-center justify-center\"\n        :style=\"{\n          width: `${photoWidth}%`,\n          backgroundColor: palette.background,\n        }\"\n      >\n        <div\n          :class=\"cn('relative max-h-full w-full overflow-hidden', photoClass)\"\n          :style=\"{\n            aspectRatio: wheelCarouselAspectRatios[photoAspect],\n            borderRadius: `${photoRadius}px`,\n            backgroundColor: palette.panel,\n          }\"\n        >\n          <AnimatePresence :initial=\"false\" mode=\"sync\">\n            <motion.img\n              :key=\"`${safeSelectedIndex}-${selectedItem.image}`\"\n              :src=\"selectedItem.image\"\n              :alt=\"selectedItem.imageAlt ?? selectedItem.label\"\n              :initial=\"imageInitial\"\n              :animate=\"{ opacity: 1, scale: 1 }\"\n              :exit=\"{ opacity: 0 }\"\n              :transition=\"{ duration: reduceMotion ? 0 : crossfadeDuration }\"\n              class=\"absolute inset-0 size-full object-cover\"\n              draggable=\"false\"\n            />\n          </AnimatePresence>\n        </div>\n      </div>\n\n      <div\n        class=\"relative h-full min-w-0 flex-1 overflow-hidden\"\n        :style=\"maskStyle\"\n      >\n        <span\n          v-if=\"showMarker\"\n          aria-hidden=\"true\"\n          class=\"absolute top-1/2 z-10 -translate-y-1/2 rounded-full\"\n          :style=\"markerStyle\"\n        ></span>\n\n        <div\n          v-for=\"label in wheelLabels\"\n          :id=\"`${instanceId}-item-${label.index}`\"\n          :key=\"label.key\"\n          role=\"option\"\n          :aria-selected=\"label.selected\"\n          :class=\"\n            cn(\n              'pointer-events-none absolute top-1/2 origin-left text-[clamp(1rem,2.4vw,1.625rem)] leading-none font-medium tracking-[-0.01em] whitespace-nowrap',\n              itemClass,\n            )\n          \"\n          :style=\"label.style\"\n        >\n          {{ label.label }}\n        </div>\n      </div>\n    </div>\n\n    <span class=\"sr-only\" aria-live=\"polite\">\n      {{ selectedItem.label }}, item {{ safeSelectedIndex + 1 }} of\n      {{ itemCount }}\n    </span>\n  </motion.div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/wheel-carousel/WheelCarousel.vue"
    },
    {
      "path": "registry/new-york/wheel-carousel/index.ts",
      "content": "export { default as WheelCarousel } from './WheelCarousel.vue';\nexport {\n  wheelCarouselDefaultItems,\n  wheelCarouselAspectRatios,\n  wheelCarouselDarkPalette,\n  wheelCarouselLightPalette,\n} from './wheel-carousel-data';\nexport type {\n  WheelCarouselItem,\n  WheelCarouselLabel,\n  WheelCarouselMode,\n  WheelCarouselPalette,\n  WheelCarouselPhotoAspect,\n  WheelCarouselPhotoSide,\n  WheelCarouselProps,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/wheel-carousel/index.ts"
    },
    {
      "path": "registry/new-york/wheel-carousel/types.ts",
      "content": "import type { CSSProperties } from 'vue';\n\nexport interface WheelCarouselItem {\n  label: string;\n  image: string;\n  imageAlt?: string;\n}\n\nexport type WheelCarouselMode = 'system' | 'light' | 'dark' | 'custom';\n\nexport type WheelCarouselPhotoSide = 'left' | 'right';\n\nexport type WheelCarouselPhotoAspect = '3/4' | '1/1' | '4/3' | '3/2';\n\nexport interface WheelCarouselPalette {\n  background: string;\n  text: string;\n  selected: string;\n  marker: string;\n  panel: string;\n}\n\n/** A positioned label on the wheel, derived per frame from the rotation. */\nexport interface WheelCarouselLabel {\n  key: string;\n  index: number;\n  label: string;\n  selected: boolean;\n  style: CSSProperties;\n}\n\nexport interface WheelCarouselProps {\n  items?: WheelCarouselItem[];\n  mode?: WheelCarouselMode;\n  photoSide?: WheelCarouselPhotoSide;\n  photoWidth?: number;\n  photoAspect?: WheelCarouselPhotoAspect;\n  contentWidth?: number;\n  gap?: number;\n  photoRadius?: number;\n  crossfadeDuration?: number;\n  radius?: number;\n  spacing?: number;\n  visibleItems?: number;\n  apexInset?: number;\n  textColor?: string;\n  selectedColor?: string;\n  showMarker?: boolean;\n  markerColor?: string;\n  markerSize?: number;\n  markerGap?: number;\n  background?: string;\n  panelColor?: string;\n  scrollSpeed?: number;\n  dragSpeed?: number;\n  snap?: boolean;\n  momentum?: boolean;\n  appear?: boolean;\n  edgeFade?: boolean;\n  edgeFadeSize?: number;\n  initialIndex?: number;\n  activeIndex?: number;\n  class?: string;\n  photoClass?: string;\n  itemClass?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/wheel-carousel/types.ts"
    },
    {
      "path": "registry/new-york/wheel-carousel/wheel-carousel-data.ts",
      "content": "import type {\n  WheelCarouselItem,\n  WheelCarouselPalette,\n  WheelCarouselPhotoAspect,\n} from './types';\n\nfunction unsplash(id: string): string {\n  return `https://images.unsplash.com/photo-${id}?w=1200&q=80&auto=format&fit=crop`;\n}\n\nexport const wheelCarouselDefaultItems: WheelCarouselItem[] = [\n  { label: 'Halcyon Fields', image: unsplash('1520529890308-f503006340b4') },\n  { label: 'Meridian House', image: unsplash('1483366774565-c783b9f70e2c') },\n  { label: 'Norlight Pavilion', image: unsplash('1496865534669-25ec2a3a0fd3') },\n  { label: 'Aperture Studio', image: unsplash('1549791084-5f78368b208b') },\n  { label: 'Solene Tower', image: unsplash('1534094830444-3a1e21f7e3e7') },\n  { label: 'Verdant Mile', image: unsplash('1622396481322-3b83d186701b') },\n  { label: 'Cobalt Works', image: unsplash('1602128110234-2d11c0aaadfe') },\n  { label: 'Lumen Atrium', image: unsplash('1522404419647-18cb51cc5c7a') },\n  { label: 'Marlowe Residence', image: unsplash('1576831371356-d6e9411ae501') },\n  { label: 'Ostara Gallery', image: unsplash('1738844153732-a485f0e78382') },\n  { label: 'Quill & Stone', image: unsplash('1548248823-ce16a73b6d49') },\n  { label: 'Everest Loft', image: unsplash('1665779736808-047a6bbf43a0') },\n  { label: 'Sable Courtyard', image: unsplash('1543067361-9bf996edf6ff') },\n  { label: 'Ridgeline Retreat', image: unsplash('1592274951725-1688461e2019') },\n  { label: 'Aurelia Plaza', image: unsplash('1599669846660-945c5c775181') },\n  { label: 'Northwind Cabin', image: unsplash('1491406213019-05b162a72c20') },\n  { label: 'Onyx Terrace', image: unsplash('1611570885483-095b1b449aa3') },\n  { label: 'Palladium Hall', image: unsplash('1564566698730-9903b9e4a08c') },\n  { label: 'Cirrus Offices', image: unsplash('1676144844767-b25cb5e6c896') },\n  { label: 'Bramble Cottage', image: unsplash('1522743791393-522312deeebf') },\n  { label: 'Vellum Library', image: unsplash('1628270680011-41792b21de87') },\n  { label: 'Halden Bridge', image: unsplash('1478979464727-af7d24e18554') },\n  { label: 'Ember & Ash', image: unsplash('1586073054612-fdd6537fc6d4') },\n  { label: 'Slate Meridian', image: unsplash('1567505477286-9c7269119db7') },\n];\n\nexport const wheelCarouselAspectRatios: Record<\n  WheelCarouselPhotoAspect,\n  string\n> = {\n  '3/4': '3 / 4',\n  '1/1': '1 / 1',\n  '4/3': '4 / 3',\n  '3/2': '3 / 2',\n};\n\nexport const wheelCarouselDarkPalette: WheelCarouselPalette = {\n  background: '#000000',\n  text: 'rgba(255, 255, 255, 0.5)',\n  selected: '#ffffff',\n  marker: '#2c6bff',\n  panel: '#141414',\n};\n\nexport const wheelCarouselLightPalette: WheelCarouselPalette = {\n  background: '#ffffff',\n  text: 'rgba(0, 0, 0, 0.32)',\n  selected: '#0a0a0a',\n  marker: '#2c6bff',\n  panel: '#ededed',\n};\n\nexport function wrapIndex(index: number, length: number): number {\n  return ((index % length) + length) % length;\n}\n\n/** Signed distance from the wheel's rotation to an item, wrapped to ±length/2. */\nexport function shortestOffset(\n  index: number,\n  rotation: number,\n  length: number,\n): number {\n  let offset = index - rotation;\n  while (offset > length / 2) offset -= length;\n  while (offset < -length / 2) offset += length;\n  return offset;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/wheel-carousel/wheel-carousel-data.ts"
    }
  ]
}
