      "content": "import type { Component } from 'vue';\n\nexport type CardNavTheme = 'dark' | 'light';\nexport type CardNavSurface = 'glass' | 'solid';\nexport type CardNavOpenOn = 'click' | 'hover';\nexport type CardNavCardEffect = 'rise' | 'unfold' | 'fade';\n\nexport interface CardNavLink {\n  label: string;\n  /** Links without an href render as buttons. */\n  href?: string;\n  ariaLabel?: string;\n}\n\nexport interface CardNavItem {\n  label: string;\n  description?: string;\n  /** Tints the card. */\n  bgColor?: string;\n  textColor?: string;\n  links?: CardNavLink[];\n}\n\nexport interface CardNavCta {\n  label: string;\n  href?: string;\n  onClick?: (event: MouseEvent) => void;\n}\n\nexport interface CardNavProps {\n  /** Image URL shown in the middle of the bar. Use the `logo` slot for markup. */\n  logo?: string;\n  logoAlt?: string;\n  logoHref?: string;\n  items?: CardNavItem[];\n  cta?: CardNavCta;\n  theme?: CardNavTheme;\n  surface?: CardNavSurface;\n  openOn?: CardNavOpenOn;\n  cardEffect?: CardNavCardEffect;\n  stagger?: number;\n  bounce?: number;\n  speed?: number;\n  cardHeight?: number;\n  maxWidth?: number;\n  accentColor?: string;\n  menuLabel?: boolean;\n  intro?: boolean;\n  defaultOpen?: boolean;\n  /** Controlled open state. Pair with `update:open`. */\n  open?: boolean;\n  /** Renders the links, e.g. `NuxtLink` or `RouterLink`. */\n  linkComponent?: string | Component;\n  ariaLabel?: string;\n  class?: string;\n}\n",
