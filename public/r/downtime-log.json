ns in percent of the group. */\n  ticks: DowntimeTick[];\n}\n\nexport interface DowntimeTrack {\n  machine: string;\n  ticks: DowntimeTick[];\n  bars: DowntimeBar[];\n}\n\nexport interface DowntimeAxisLabel {\n  label: string;\n  left: number;\n}\n",
