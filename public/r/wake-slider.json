{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "wake-slider",
  "type": "registry:ui",
  "title": "Wake Slider",
  "description": "Thumbless range slider of thin bars where drag speed raises a wake behind the handle.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/wake-slider/WakeSlider.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, onUpdated, ref, watch } from 'vue';\n  import { usePreferredReducedMotion } from '@vueuse/core';\n  import {\n    frame,\n    useMotionValue,\n    useMotionValueEvent,\n    useSpring,\n    useVelocity,\n  } from 'motion-v';\n  import type { WakeSliderProps } from './types';\n\n  const SETTLE = 9.23;\n  const FULL_SPEED = 320;\n  const MIN_REACH = 1.5;\n  const FLAT = 0.002;\n\n  const props = withDefaults(defineProps<WakeSliderProps>(), {\n    modelValue: undefined,\n    defaultValue: 50,\n    min: 0,\n    max: 100,\n    step: 1,\n    bars: 32,\n    height: 56,\n    restHeight: 12,\n    gap: 4,\n    fillColor: 'var(--foreground)',\n    trackColor: 'var(--muted)',\n    crestColor: '',\n    sensitivity: 1,\n    reach: 6,\n    skew: 0.6,\n    glide: 0.3,\n    smoothing: 100,\n    showValue: false,\n    formatValue: undefined,\n    disabled: false,\n    ariaLabel: 'Value',\n    class: undefined,\n  });\n\n  const emit = defineEmits<{\n    'update:modelValue': [value: number];\n    change: [value: number];\n  }>();\n\n  function clamp(v: number, lo: number, hi: number) {\n    return Math.min(hi, Math.max(lo, v));\n  }\n  function smoothstep(s: number) {\n    return s * s * (3 - 2 * s);\n  }\n  function toPct(v: number, min: number, max: number) {\n    return max > min ? ((v - min) / (max - min)) * 100 : 0;\n  }\n  function snap(v: number, min: number, max: number, step: number) {\n    if (!(max > min)) return min;\n    if (!(step > 0)) return clamp(v, min, max);\n    const lastWhole =\n      min + Math.floor(Number(((max - min) / step).toFixed(6))) * step;\n    const grid = clamp(\n      Math.round((v - min) / step) * step + min,\n      min,\n      lastWhole,\n    );\n    return Number(\n      (lastWhole < max && Math.abs(v - max) <= Math.abs(v - grid)\n        ? max\n        : grid\n      ).toFixed(6),\n    );\n  }\n\n  const inner = ref(props.defaultValue);\n  const value = computed(() =>\n    clamp(props.modelValue ?? inner.value, props.min, props.max),\n  );\n  const pct = computed(() => toPct(value.value, props.min, props.max));\n  const reduceMotion = usePreferredReducedMotion();\n  const reduce = computed(() => reduceMotion.value === 'reduce');\n  const rest = computed(\n    () => Math.min(props.restHeight, props.height - 1) / props.height,\n  );\n  const text = computed(() =>\n    props.formatValue ? props.formatValue(value.value) : String(value.value),\n  );\n\n  const rootRef = ref<HTMLDivElement | null>(null);\n  const trackRef = ref<HTMLDivElement | null>(null);\n  const handleRef = ref<HTMLButtonElement | null>(null);\n  let pointerId: number | null = null;\n  const pointerFocus = ref(false);\n  let lastAmp = 0;\n  let latest = value.value;\n  watch(value, (v) => {\n    latest = v;\n  });\n\n  const target = useMotionValue(pct.value);\n  const headConfig = computed(() => {\n    const w0 = SETTLE / props.glide;\n    return { stiffness: w0 * w0, damping: 2 * w0, mass: 1 };\n  });\n  const head = useSpring(target, headConfig);\n  const rawSpeed = useVelocity(head);\n  const speedConfig = computed(() => {\n    const wv = 2000 / props.smoothing;\n    return { stiffness: wv * wv, damping: 2.5 * wv, mass: 1 };\n  });\n  const speed = useSpring(rawSpeed, speedConfig);\n\n  watch(pct, (p) => {\n    target.set(p);\n  });\n\n  function paint(force = false) {\n    const track = trackRef.value;\n    if (!track) return;\n    const bars = props.bars;\n    const h = ((reduce.value ? target.get() : head.get()) / 100) * (bars - 1);\n    const v = reduce.value ? 0 : speed.get();\n    const amp = smoothstep(\n      clamp((Math.abs(v) * props.sensitivity) / FULL_SPEED, 0, 1),\n    );\n    const dir = Math.sign(v) || 1;\n    const r = MIN_REACH + (props.reach - MIN_REACH) * amp;\n    const behind = r * (1 + props.skew);\n    const ahead = r * (1 - 0.5 * props.skew);\n    const lit = Math.round(h);\n    const flat = !force && amp < FLAT && lastAmp < FLAT;\n    const els = track.children;\n    for (let i = 0; i < bars; i++) {\n      const el = els[i];\n      if (!(el instanceof HTMLElement)) continue;\n      const on = i <= lit ? 'true' : 'false';\n      if (el.dataset.on !== on) el.dataset.on = on;\n      if (flat) continue;\n      const d = i - h;\n      const reachHere = d * dir < 0 ? behind : ahead;\n      const lift =\n        Math.abs(d) < reachHere\n          ? amp * Math.cos((Math.PI * d) / (2 * reachHere)) ** 2\n          : 0;\n      el.style.transform = `scaleY(${rest.value + lift * (1 - rest.value)})`;\n      const crest = el.firstElementChild;\n      if (crest instanceof HTMLElement) crest.style.opacity = String(lift);\n    }\n    lastAmp = amp;\n  }\n\n  function run() {\n    paint();\n  }\n  function schedule() {\n    frame.render(run, false, true);\n  }\n  useMotionValueEvent(head, 'change', schedule);\n  useMotionValueEvent(speed, 'change', schedule);\n  onMounted(() => paint(true));\n  onUpdated(() => paint(true));\n\n  function commit(next: number) {\n    const clean = snap(next, props.min, props.max, props.step);\n    if (clean === latest) return;\n    latest = clean;\n    if (props.modelValue === undefined) inner.value = clean;\n    emit('update:modelValue', clean);\n    emit('change', clean);\n  }\n\n  function commitFromX(clientX: number) {\n    const track = trackRef.value;\n    if (!track) return;\n    const rect = track.getBoundingClientRect();\n    if (!rect.width) return;\n    let ratio = clamp((clientX - rect.left) / rect.width, 0, 1);\n    if (getComputedStyle(track).direction === 'rtl') ratio = 1 - ratio;\n    commit(props.min + ratio * (props.max - props.min));\n  }\n\n  function onPointerDown(event: PointerEvent) {\n    if (props.disabled || pointerId !== null) return;\n    pointerId = event.pointerId;\n    try {\n      trackRef.value?.setPointerCapture(event.pointerId);\n    } catch {\n      // capture is best effort\n    }\n    rootRef.value?.removeAttribute('data-instant');\n    pointerFocus.value = true;\n    handleRef.value?.focus({ preventScroll: true });\n    commitFromX(event.clientX);\n  }\n\n  function onPointerMove(event: PointerEvent) {\n    if (event.pointerId === pointerId) commitFromX(event.clientX);\n  }\n\n  function endDrag(event: PointerEvent) {\n    if (event.pointerId !== pointerId) return;\n    try {\n      trackRef.value?.releasePointerCapture(event.pointerId);\n    } catch {\n      // already released\n    }\n    pointerId = null;\n  }\n\n  function onBlur() {\n    pointerFocus.value = false;\n  }\n\n  function jumpFor(key: string) {\n    const v = value.value;\n    const s = props.step;\n    switch (key) {\n      case 'ArrowRight':\n      case 'ArrowUp':\n        return v + s;\n      case 'ArrowLeft':\n      case 'ArrowDown':\n        return v - s;\n      case 'PageUp':\n        return v + s * 10;\n      case 'PageDown':\n        return v - s * 10;\n      case 'Home':\n        return props.min;\n      case 'End':\n        return props.max;\n      default:\n        return null;\n    }\n  }\n\n  function onKeyDown(event: KeyboardEvent) {\n    if (props.disabled) return;\n    const next = jumpFor(event.key);\n    if (next === null) return;\n    event.preventDefault();\n    pointerFocus.value = false;\n    const clean = snap(next, props.min, props.max, props.step);\n    const p = toPct(clean, props.min, props.max);\n    rootRef.value?.setAttribute('data-instant', 'true');\n    head.jump(p);\n    speed.jump(0);\n    target.jump(p);\n    commit(clean);\n  }\n\n  const rootStyle = computed(() => ({\n    '--ws-fill': props.fillColor,\n    '--ws-track': props.trackColor,\n    '--ws-crest': props.crestColor || props.fillColor,\n    '--ws-height': `${props.height}px`,\n    '--ws-gap': `${props.gap}px`,\n    '--ws-rest': String(rest.value),\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"['wake-slider', props.class]\"\n    :aria-disabled=\"disabled || undefined\"\n    :style=\"rootStyle\"\n  >\n    <div\n      ref=\"trackRef\"\n      class=\"wake-slider__track\"\n      @pointerdown=\"onPointerDown\"\n      @pointermove=\"onPointerMove\"\n      @pointerup=\"endDrag\"\n      @pointercancel=\"endDrag\"\n      @lostpointercapture=\"endDrag\"\n    >\n      <span v-for=\"i in bars\" :key=\"i\" class=\"wake-slider__bar\">\n        <span v-if=\"crestColor\" class=\"wake-slider__crest\" />\n      </span>\n      <button\n        ref=\"handleRef\"\n        type=\"button\"\n        role=\"slider\"\n        class=\"wake-slider__handle\"\n        :tabindex=\"disabled ? -1 : 0\"\n        :aria-label=\"ariaLabel\"\n        :aria-valuemin=\"min\"\n        :aria-valuemax=\"max\"\n        :aria-valuenow=\"value\"\n        :aria-valuetext=\"text\"\n        :aria-disabled=\"disabled || undefined\"\n        :data-pointer=\"pointerFocus ? 'true' : undefined\"\n        @keydown=\"onKeyDown\"\n        @blur=\"onBlur\"\n      />\n    </div>\n    <span v-if=\"showValue\" class=\"wake-slider__value\" aria-hidden=\"true\">{{\n      text\n    }}</span>\n  </div>\n</template>\n\n<style scoped>\n  .wake-slider {\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    width: 100%;\n    color: inherit;\n  }\n\n  .wake-slider[aria-disabled='true'] {\n    opacity: 0.5;\n    pointer-events: none;\n  }\n\n  .wake-slider__track {\n    position: relative;\n    display: flex;\n    flex: 1 1 auto;\n    align-items: center;\n    gap: var(--ws-gap);\n    height: var(--ws-height);\n    min-height: 44px;\n    touch-action: none;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .wake-slider__track {\n      cursor: grab;\n    }\n\n    .wake-slider__track:active {\n      cursor: grabbing;\n    }\n  }\n\n  .wake-slider__bar {\n    position: relative;\n    flex: 1 1 0;\n    min-width: 0;\n    height: var(--ws-height);\n    border-radius: 9999px;\n    background: var(--ws-track);\n    transform: scaleY(var(--ws-rest));\n    transform-origin: 50% 50%;\n    transition: background-color 120ms ease;\n  }\n\n  .wake-slider__bar[data-on='true'] {\n    background: var(--ws-fill);\n  }\n\n  .wake-slider[data-instant='true'] .wake-slider__bar {\n    transition-duration: 0ms;\n  }\n\n  .wake-slider__crest {\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    background: var(--ws-crest);\n    opacity: 0;\n  }\n\n  .wake-slider__handle {\n    position: absolute;\n    inset: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    border-radius: 12px;\n    background: transparent;\n    outline: none;\n    cursor: inherit;\n    touch-action: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .wake-slider__handle:focus-visible:not([data-pointer='true']) {\n    outline: 2px solid color-mix(in srgb, var(--ws-fill) 60%, transparent);\n    outline-offset: 4px;\n  }\n\n  .wake-slider__value {\n    min-width: 3ch;\n    font-size: 13px;\n    font-variant-numeric: tabular-nums;\n    text-align: right;\n    opacity: 0.6;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .wake-slider__bar {\n      transform: scaleY(var(--ws-rest)) !important;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/wake-slider/WakeSlider.vue"
    },
    {
      "path": "registry/new-york/wake-slider/index.ts",
      "content": "export { default as WakeSlider } from './WakeSlider.vue';\nexport type { WakeSliderProps } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/wake-slider/index.ts"
    },
    {
      "path": "registry/new-york/wake-slider/types.ts",
      "content": "import type { HTMLAttributes } from 'vue';\n\nexport interface WakeSliderProps {\n  /** Controlled value (`v-model`). */\n  modelValue?: number;\n  /** Initial value when uncontrolled. */\n  defaultValue?: number;\n  /** Lowest value. */\n  min?: number;\n  /** Highest value. */\n  max?: number;\n  /** Snapping grid. Large steps move the handle in notches. */\n  step?: number;\n  /** How many bars draw the track. */\n  bars?: number;\n  /** Full bar height in pixels, the ceiling of the wake. */\n  height?: number;\n  /** Bar height at rest in pixels. */\n  restHeight?: number;\n  /** Space between bars in pixels. */\n  gap?: number;\n  /** Lit bars, up to the value. */\n  fillColor?: string;\n  /** Unlit bars. */\n  trackColor?: string;\n  /** Optional tint the raised bars take on by their lift. Empty renders no tint layer. */\n  crestColor?: string;\n  /** How easily speed raises the wake. */\n  sensitivity?: number;\n  /** Half-width of the wake at full speed, in bars. */\n  reach?: number;\n  /** How much wider the wake is behind the handle than ahead. 0 is symmetric. */\n  skew?: number;\n  /** Seconds the handle takes to settle. */\n  glide?: number;\n  /** Milliseconds of velocity lag. */\n  smoothing?: number;\n  /** Shows the value beside the track. */\n  showValue?: boolean;\n  /** Formats the readout and the announced value. */\n  formatValue?: (value: number) => string;\n  /** Fades the slider and ignores input. */\n  disabled?: boolean;\n  /** Accessible name of the slider. */\n  ariaLabel?: string;\n  class?: HTMLAttributes['class'];\n}\n",
      "type": "registry:ui",
      "target": "components/ui/wake-slider/types.ts"
    }
  ]
