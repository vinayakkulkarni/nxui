{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "true-focus",
  "type": "registry:ui",
  "title": "True Focus",
  "description": "Blurs every word but one and marks it with brackets, a box, an underline or a highlight that glides or springs between words.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/true-focus/TrueFocus.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, ref, shallowRef, watch } from 'vue';\n  import type { ComponentPublicInstance, CSSProperties } from 'vue';\n  import { usePreferredReducedMotion, useResizeObserver } from '@vueuse/core';\n  import { motion } from 'motion-v';\n  import { cn } from '~/lib/utils';\n  import type { TrueFocusCorner, TrueFocusProps, TrueFocusRect } from './types';\n\n  const props = withDefaults(defineProps<TrueFocusProps>(), {\n    sentence: 'True Focus',\n    separator: ' ',\n    manualMode: false,\n    focusStyle: 'brackets',\n    order: 'sequential',\n    easing: 'smooth',\n    blurAmount: 5,\n    focusScale: 1,\n    borderColor: 'green',\n    highlightColor: undefined,\n    glowColor: 'transparent',\n    animationDuration: 0.5,\n    pauseBetweenAnimations: 1,\n    cornerSize: 16,\n    borderWidth: 3,\n    unfocusedOpacity: 1,\n    class: '',\n  });\n\n  const CORNERS: TrueFocusCorner[] = [\n    'top-left',\n    'top-right',\n    'bottom-left',\n    'bottom-right',\n  ];\n  const FRAME_GAP = 10;\n  const SMOOTH_EASE = [0.65, 0, 0.35, 1];\n  const SMOOTH_CSS = 'cubic-bezier(0.65, 0, 0.35, 1)';\n  const SPRING_CSS = 'cubic-bezier(0.34, 1.56, 0.64, 1)';\n\n  const containerRef = ref<HTMLElement | null>(null);\n  const wordRefs = shallowRef<(HTMLElement | null)[]>([]);\n  const currentIndex = ref(0);\n  const focusRect = ref<TrueFocusRect | null>(null);\n  const reducedMotion = usePreferredReducedMotion();\n\n  const words = computed(() =>\n    props.sentence.split(props.separator).filter((word) => word.trim() !== ''),\n  );\n  const reduce = computed(() => reducedMotion.value === 'reduce');\n  const duration = computed(() => (reduce.value ? 0 : props.animationDuration));\n  const activeIndex = computed(() =>\n    words.value.length ? currentIndex.value % words.value.length : -1,\n  );\n  const spring = computed(() => props.easing === 'spring' && !reduce.value);\n  const transition = computed(() =>\n    spring.value\n      ? {\n          type: 'spring' as const,\n          visualDuration: duration.value,\n          bounce: 0.38,\n        }\n      : { duration: duration.value, ease: SMOOTH_EASE },\n  );\n\n  function setWordRef(\n    index: number,\n    el: Element | ComponentPublicInstance | null,\n  ) {\n    wordRefs.value[index] = el instanceof HTMLElement ? el : null;\n  }\n\n  function measure() {\n    const word = wordRefs.value[activeIndex.value];\n    if (!containerRef.value || !word) return;\n    const next = {\n      x: word.offsetLeft,\n      y: word.offsetTop,\n      width: word.offsetWidth,\n      height: word.offsetHeight,\n    };\n    const prev = focusRect.value;\n    if (\n      prev &&\n      prev.x === next.x &&\n      prev.y === next.y &&\n      prev.width === next.width &&\n      prev.height === next.height\n    ) {\n      return;\n    }\n    focusRect.value = next;\n  }\n\n  useResizeObserver(\n    () => [containerRef.value, ...wordRefs.value],\n    () => measure(),\n  );\n\n  onMounted(() => {\n    watch(\n      [activeIndex, () => props.sentence, () => props.separator],\n      () => measure(),\n      { immediate: true, flush: 'post' },\n    );\n    watch(\n      [\n        () => props.manualMode,\n        () => props.animationDuration,\n        () => props.pauseBetweenAnimations,\n        () => words.value.length,\n        () => props.order,\n      ],\n      ([manual, anim, pause, count, order], _old, onCleanup) => {\n        if (manual || count < 2) return;\n        const timer = setInterval(\n          () => {\n            const roll = Math.random();\n            const current = currentIndex.value % count;\n            if (order !== 'random') {\n              currentIndex.value = (current + 1) % count;\n              return;\n            }\n            const next = Math.floor(roll * (count - 1));\n            currentIndex.value = next >= current ? next + 1 : next;\n          },\n          (anim + pause) * 1000,\n        );\n        onCleanup(() => clearInterval(timer));\n      },\n      { immediate: true },\n    );\n  });\n\n  const frame = computed<TrueFocusRect | null>(() => {\n    const rect = focusRect.value;\n    if (!rect) return null;\n    const grow = props.focusScale - 1;\n    return {\n      x: rect.x - (rect.width * grow) / 2,\n      y: rect.y - (rect.height * grow) / 2,\n      width: rect.width * props.focusScale,\n      height: rect.height * props.focusScale,\n    };\n  });\n\n  const corners = computed(() => {\n    const f = frame.value;\n    if (!f) return null;\n    const right = f.x + f.width + FRAME_GAP - props.cornerSize;\n    const bottom = f.y + f.height + FRAME_GAP - props.cornerSize;\n    return {\n      'top-left': { x: f.x - FRAME_GAP, y: f.y - FRAME_GAP },\n      'top-right': { x: right, y: f.y - FRAME_GAP },\n      'bottom-left': { x: f.x - FRAME_GAP, y: bottom },\n      'bottom-right': { x: right, y: bottom },\n    };\n  });\n\n  const shapes = computed(() => {\n    const f = frame.value;\n    if (!f) return null;\n    return {\n      box: {\n        x: f.x - FRAME_GAP,\n        y: f.y - FRAME_GAP,\n        width: f.width + FRAME_GAP * 2,\n        height: f.height + FRAME_GAP * 2,\n      },\n      underline: {\n        x: f.x,\n        y: f.y + f.height + FRAME_GAP * 0.4,\n        width: f.width,\n        height: props.borderWidth,\n      },\n      highlight: {\n        x: f.x - f.height * 0.14,\n        y: f.y + f.height * 0.04,\n        width: f.width + f.height * 0.28,\n        height: f.height * 0.92,\n      },\n    };\n  });\n\n  const frameStyle = computed<CSSProperties>(() => ({\n    '--border-color': props.borderColor,\n    '--highlight-color': `color-mix(in srgb, ${props.highlightColor ?? props.borderColor} 30%, transparent)`,\n    '--glow-color': props.glowColor,\n    '--corner-size': `${props.cornerSize}px`,\n    '--border-width': `${props.borderWidth}px`,\n  }));\n\n  function wordStyle(index: number): CSSProperties {\n    const active = index === activeIndex.value;\n    return {\n      filter: `blur(${active ? 0 : props.blurAmount}px)`,\n      opacity: active ? 1 : props.unfocusedOpacity,\n      transform:\n        props.focusScale !== 1\n          ? `scale(${active ? props.focusScale : 1})`\n          : undefined,\n      transition: `filter ${duration.value}s ease, opacity ${duration.value}s ease, transform ${duration.value}s ${spring.value ? SPRING_CSS : SMOOTH_CSS}`,\n    };\n  }\n\n  function onWordEnter(index: number) {\n    if (props.manualMode) currentIndex.value = index;\n  }\n</script>\n\n<template>\n  <div\n    ref=\"containerRef\"\n    :class=\"cn('focus-container', props.class)\"\n    :style=\"frameStyle\"\n  >\n    <motion.span\n      v-if=\"focusStyle === 'highlight' && shapes\"\n      class=\"focus-highlight\"\n      aria-hidden=\"true\"\n      :initial=\"{ ...shapes.highlight, opacity: 0 }\"\n      :animate=\"{ ...shapes.highlight, opacity: 1 }\"\n      :transition=\"transition\"\n    />\n\n    <span\n      v-for=\"(word, index) in words\"\n      :key=\"index\"\n      :ref=\"(el) => setWordRef(index, el)\"\n      :class=\"[\n        'focus-word',\n        { manual: manualMode, active: index === activeIndex && !manualMode },\n      ]\"\n      :style=\"wordStyle(index)\"\n      @mouseenter=\"onWordEnter(index)\"\n    >\n      {{ word }}\n    </span>\n\n    <div\n      v-if=\"shapes && corners && focusStyle !== 'highlight'\"\n      class=\"focus-frame\"\n      aria-hidden=\"true\"\n    >\n      <motion.span\n        v-if=\"focusStyle === 'box'\"\n        class=\"focus-box\"\n        :initial=\"{ ...shapes.box, opacity: 0 }\"\n        :animate=\"{ ...shapes.box, opacity: 1 }\"\n        :transition=\"transition\"\n      />\n      <motion.span\n        v-else-if=\"focusStyle === 'underline'\"\n        class=\"focus-underline\"\n        :initial=\"{ ...shapes.underline, opacity: 0 }\"\n        :animate=\"{ ...shapes.underline, opacity: 1 }\"\n        :transition=\"transition\"\n      />\n      <template v-else>\n        <motion.span\n          v-for=\"corner in CORNERS\"\n          :key=\"corner\"\n          :class=\"['corner', corner]\"\n          :initial=\"{ ...corners[corner], opacity: 0 }\"\n          :animate=\"{ ...corners[corner], opacity: 1 }\"\n          :transition=\"transition\"\n        />\n      </template>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .focus-container {\n    position: relative;\n    display: flex;\n    gap: 1em;\n    justify-content: center;\n    align-items: center;\n    flex-wrap: wrap;\n    outline: none;\n    user-select: none;\n  }\n\n  .focus-word {\n    position: relative;\n    font-size: 3rem;\n    font-weight: 900;\n    cursor: pointer;\n    transition:\n      filter 0.3s ease,\n      color 0.3s ease;\n    outline: none;\n    user-select: none;\n  }\n\n  .focus-word.active {\n    filter: blur(0);\n  }\n\n  .focus-frame {\n    position: absolute;\n    top: 0;\n    left: 0;\n    pointer-events: none;\n  }\n\n  .focus-highlight {\n    position: absolute;\n    top: 0;\n    left: 0;\n    border-radius: 6px;\n    background-color: var(--highlight-color);\n    pointer-events: none;\n  }\n\n  .focus-box {\n    position: absolute;\n    top: 0;\n    left: 0;\n    box-sizing: border-box;\n    border: var(--border-width, 3px) solid var(--border-color, currentColor);\n    border-radius: 6px;\n    filter: drop-shadow(0 0 4px var(--glow-color, transparent));\n  }\n\n  .focus-underline {\n    position: absolute;\n    top: 0;\n    left: 0;\n    border-radius: calc(var(--border-width, 3px) / 2);\n    background-color: var(--border-color, currentColor);\n    filter: drop-shadow(0 0 4px var(--glow-color, transparent));\n  }\n\n  .corner {\n    position: absolute;\n    top: 0;\n    left: 0;\n    box-sizing: border-box;\n    width: var(--corner-size, 1rem);\n    height: var(--corner-size, 1rem);\n    border: var(--border-width, 3px) solid var(--border-color, currentColor);\n    border-radius: 3px;\n    filter: drop-shadow(0 0 4px var(--glow-color, transparent));\n  }\n\n  .top-left {\n    border-right: none;\n    border-bottom: none;\n  }\n\n  .top-right {\n    border-left: none;\n    border-bottom: none;\n  }\n\n  .bottom-left {\n    border-right: none;\n    border-top: none;\n  }\n\n  .bottom-right {\n    border-left: none;\n    border-top: none;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/true-focus/TrueFocus.vue"
    },
    {
      "path": "registry/new-york/true-focus/index.ts",
      "content": "export { default as TrueFocus } from './TrueFocus.vue';\nexport { isTrueFocusPreset, trueFocusPreset } from './true-focus-presets';\nexport type {\n  TrueFocusEasing,\n  TrueFocusOrder,\n  TrueFocusPresetName,\n  TrueFocusPresetValues,\n  TrueFocusProps,\n  TrueFocusStyle,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/true-focus/index.ts"
    },
    {
      "path": "registry/new-york/true-focus/true-focus-presets.ts",
      "content": "import type { TrueFocusPresetName, TrueFocusPresetValues } from './types';\n\nconst LOOK: TrueFocusPresetValues = {\n  sentence: 'True Focus',\n  borderColor: '#5227FF',\n  highlightColor: '#5227FF',\n  easing: 'smooth',\n  order: 'sequential',\n  animationDuration: 0.5,\n  pauseBetweenAnimations: 1,\n  focusStyle: 'brackets',\n  focusScale: 1,\n  blurAmount: 5,\n  unfocusedOpacity: 1,\n  cornerSize: 16,\n  borderWidth: 3,\n};\n\nconst OVERRIDES: Record<TrueFocusPresetName, Partial<TrueFocusPresetValues>> = {\n  classic: {},\n  box: {\n    sentence: 'Less noise, more focus',\n    borderColor: '#ffffff',\n    easing: 'spring',\n    animationDuration: 0.55,\n    pauseBetweenAnimations: 0.9,\n    focusStyle: 'box',\n    focusScale: 1.06,\n    blurAmount: 3,\n    unfocusedOpacity: 0.4,\n    borderWidth: 1.5,\n  },\n  underline: {\n    sentence: 'Make every word count',\n    borderColor: '#ff5a36',\n    easing: 'spring',\n    order: 'random',\n    pauseBetweenAnimations: 0.8,\n    focusStyle: 'underline',\n    blurAmount: 0,\n    unfocusedOpacity: 0.28,\n    borderWidth: 4,\n  },\n  marker: {\n    sentence: 'Mark what matters most',\n    highlightColor: '#4f8dff',\n    animationDuration: 0.6,\n    focusStyle: 'highlight',\n    focusScale: 1.04,\n    blurAmount: 1.5,\n    unfocusedOpacity: 0.5,\n  },\n};\n\n/** Full look for a named preset (the React Bits demo presets). */\nexport function trueFocusPreset(\n  name: TrueFocusPresetName,\n): TrueFocusPresetValues {\n  return { ...LOOK, ...OVERRIDES[name] };\n}\n\nexport function isTrueFocusPreset(\n  value: unknown,\n): value is TrueFocusPresetName {\n  return typeof value === 'string' && value in OVERRIDES;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/true-focus/true-focus-presets.ts"
    },
    {
      "path": "registry/new-york/true-focus/types.ts",
      "content": "export type TrueFocusStyle = 'brackets' | 'box' | 'underline' | 'highlight';\n\nexport type TrueFocusOrder = 'sequential' | 'random';\n\nexport type TrueFocusEasing = 'smooth' | 'spring';\n\nexport interface TrueFocusProps {\n  sentence?: string;\n  /** String used to split the sentence into focusable words. */\n  separator?: string;\n  /** Focus follows the hovered word instead of cycling on its own. */\n  manualMode?: boolean;\n  focusStyle?: TrueFocusStyle;\n  order?: TrueFocusOrder;\n  easing?: TrueFocusEasing;\n  blurAmount?: number;\n  /** Size the focused word grows to. 1 keeps it the same. */\n  focusScale?: number;\n  borderColor?: string;\n  /** Fill of the `highlight` style. Falls back to `borderColor`. */\n  highlightColor?: string;\n  glowColor?: string;\n  /** Seconds the focus takes to move. */\n  animationDuration?: number;\n  /** Seconds the focus rests on each word. */\n  pauseBetweenAnimations?: number;\n  cornerSize?: number;\n  borderWidth?: number;\n  unfocusedOpacity?: number;\n  class?: string;\n}\n\nexport interface TrueFocusRect {\n  x: number;\n  y: number;\n  width: number;\n  height: number;\n}\n\nexport type TrueFocusCorner =\n  | 'top-left'\n  | 'top-right'\n  | 'bottom-left'\n  | 'bottom-right';\n\nexport type TrueFocusPresetName = 'classic' | 'box' | 'underline' | 'marker';\n\nexport interface TrueFocusPresetValues {\n  sentence: string;\n  borderColor: string;\n  highlightColor: string;\n  easing: TrueFocusEasing;\n  order: TrueFocusOrder;\n  animationDuration: number;\n  pauseBetweenAnimations: number;\n  focusStyle: TrueFocusStyle;\n  focusScale: number;\n  blurAmount: number;\n  unfocusedOpacity: number;\n  cornerSize: number;\n  borderWidth: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/true-focus/types.ts"
    }
  ]
}
