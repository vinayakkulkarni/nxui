{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "spring-check",
  "type": "registry:ui",
  "title": "Spring Check",
  "description": "A checkbox row where one spring fills the box, draws the tick and strikes through the label.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/spring-check/SpringCheck.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n  import { usePreferredReducedMotion } from '@vueuse/core';\n  import { animate, motionValue } from 'motion-v';\n  import { readings, springBounce } from './spring-check';\n  import type { SpringCheckProps, SpringCheckStrike } from './types';\n\n  const VISUAL_DURATION = 0.2;\n  // lucide:check geometry, reversed so the stroke draws left to right.\n  const TICK_PATH = 'M4 12l5 5L20 6';\n  const ORIGIN: Record<SpringCheckStrike, string> = {\n    left: 'left center',\n    center: 'center',\n    right: 'right center',\n    none: 'left center',\n  };\n\n  const props = withDefaults(defineProps<SpringCheckProps>(), {\n    label: 'Ship the build',\n    modelValue: undefined,\n    defaultChecked: false,\n    disabled: false,\n    color: '#ffffff',\n    fillColor: '#ffffff',\n    checkColor: '#0b0b0f',\n    boxSize: 28,\n    boxRadius: 9,\n    fontSize: 18,\n    bounce: 0.2,\n    strikeLag: 0.12,\n    doneOpacity: 0.42,\n    strike: 'left',\n    ariaLabel: undefined,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    'update:modelValue': [checked: boolean];\n    change: [checked: boolean];\n  }>();\n\n  const inner = ref(props.defaultChecked);\n  const controlled = computed(() => props.modelValue !== undefined);\n  const on = computed(() =>\n    controlled.value ? props.modelValue === true : inner.value,\n  );\n  const reduced = usePreferredReducedMotion();\n\n  const t = motionValue(on.value ? 1 : 0);\n  const initial = readings(t.get(), props.doneOpacity, props.strikeLag);\n  const rowRef = ref<HTMLButtonElement | null>(null);\n  const boxRef = ref<HTMLSpanElement | null>(null);\n  const fillRef = ref<HTMLSpanElement | null>(null);\n  const tickRef = ref<SVGPathElement | null>(null);\n  const wordRef = ref<HTMLSpanElement | null>(null);\n  const ruleRef = ref<HTMLSpanElement | null>(null);\n  let viaPointer = false;\n  let instant = false;\n  let controls: { stop: () => void } | null = null;\n\n  function write(value: number) {\n    const r = readings(value, props.doneOpacity, props.strikeLag);\n    if (fillRef.value) fillRef.value.style.transform = r.fill;\n    if (boxRef.value) boxRef.value.style.transform = r.box;\n    if (tickRef.value) tickRef.value.style.strokeDashoffset = String(r.tick);\n    if (wordRef.value) wordRef.value.style.opacity = String(r.word);\n    if (ruleRef.value) ruleRef.value.style.transform = r.rule;\n  }\n\n  const unsubscribe = t.on('change', write);\n\n  function run() {\n    const target = on.value ? 1 : 0;\n    controls?.stop();\n    controls = null;\n    if (reduced.value === 'reduce' || instant) {\n      instant = false;\n      t.jump(target);\n      write(target);\n      return;\n    }\n    if (t.get() === target && t.getVelocity() === 0) return;\n    controls = animate(t, target, {\n      type: 'spring',\n      visualDuration: VISUAL_DURATION,\n      bounce: springBounce(props.bounce),\n    });\n  }\n\n  watch([on, reduced, () => props.bounce], run);\n  watch(\n    [() => props.doneOpacity, () => props.strikeLag, () => props.strike],\n    () => write(t.get()),\n    { flush: 'post' },\n  );\n\n  onMounted(() => write(t.get()));\n\n  onBeforeUnmount(() => {\n    controls?.stop();\n    unsubscribe();\n  });\n\n  function onPointerDown(event: PointerEvent) {\n    if (event.button !== 0 || props.disabled) return;\n    viaPointer = true;\n    if (reduced.value !== 'reduce' && rowRef.value)\n      rowRef.value.dataset.pressed = '';\n  }\n\n  function onPointerUp() {\n    if (rowRef.value) delete rowRef.value.dataset.pressed;\n  }\n\n  function onPointerCancel() {\n    viaPointer = false;\n    onPointerUp();\n  }\n\n  function toggle() {\n    if (props.disabled) return;\n    instant = !viaPointer;\n    viaPointer = false;\n    const next = !on.value;\n    if (!controlled.value) inner.value = next;\n    emit('update:modelValue', next);\n    emit('change', next);\n  }\n\n  const cssVars = computed(() => {\n    const ring = props.boxSize >= 24 ? 2 : 1.5;\n    const gap = Math.min(16, Math.max(8, Math.round(props.boxSize * 0.43)));\n    const ruleHeight = Math.max(1.5, Math.round(props.fontSize / 6) / 2);\n    return {\n      '--sc-ink': props.color,\n      '--sc-fill': props.fillColor,\n      '--sc-check': props.checkColor,\n      '--sc-box': `${props.boxSize}px`,\n      '--sc-radius': `${props.boxRadius}px`,\n      '--sc-font': `${props.fontSize}px`,\n      '--sc-ring': `${ring}px`,\n      '--sc-gap': `${gap}px`,\n      '--sc-row': `${Math.max(44, props.boxSize + 16)}px`,\n      '--sc-rule': `${ruleHeight}px`,\n      '--sc-origin': ORIGIN[props.strike],\n    };\n  });\n\n  const boxStyle = { transform: initial.box };\n  const fillStyle = { transform: initial.fill };\n  const tickStyle = { strokeDashoffset: initial.tick };\n  const wordStyle = { opacity: initial.word };\n  const ruleStyle = { transform: initial.rule };\n</script>\n\n<template>\n  <button\n    ref=\"rowRef\"\n    type=\"button\"\n    role=\"checkbox\"\n    :aria-checked=\"on\"\n    :aria-label=\"ariaLabel\"\n    :disabled=\"disabled\"\n    :class=\"['spring-check', props.class]\"\n    :style=\"cssVars\"\n    @pointerdown=\"onPointerDown\"\n    @pointerup=\"onPointerUp\"\n    @pointercancel=\"onPointerCancel\"\n    @pointerleave=\"onPointerCancel\"\n    @click=\"toggle\"\n  >\n    <span class=\"spring-check__press\">\n      <span ref=\"boxRef\" class=\"spring-check__box\" :style=\"boxStyle\">\n        <span class=\"spring-check__ring\" aria-hidden=\"true\" />\n        <span ref=\"fillRef\" class=\"spring-check__fill\" :style=\"fillStyle\" />\n        <svg class=\"spring-check__tick\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path\n            ref=\"tickRef\"\n            :d=\"TICK_PATH\"\n            path-length=\"1\"\n            stroke-dasharray=\"1\"\n            :style=\"tickStyle\"\n          />\n        </svg>\n      </span>\n    </span>\n    <span class=\"spring-check__label\">\n      <span ref=\"wordRef\" class=\"spring-check__word\" :style=\"wordStyle\">\n        <slot>{{ label }}</slot>\n      </span>\n      <span\n        v-if=\"strike !== 'none'\"\n        ref=\"ruleRef\"\n        class=\"spring-check__rule\"\n        aria-hidden=\"true\"\n        :style=\"ruleStyle\"\n      />\n    </span>\n  </button>\n</template>\n\n<style scoped>\n  .spring-check {\n    --sc-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n\n    display: inline-flex;\n    align-items: center;\n    gap: var(--sc-gap);\n    min-height: var(--sc-row);\n    margin: 0;\n    padding: 0;\n    border: 0;\n    background: none;\n    color: var(--sc-ink);\n    font-family: inherit;\n    font-size: var(--sc-font);\n    font-weight: 500;\n    line-height: 1.2;\n    letter-spacing: -0.01em;\n    text-align: left;\n    cursor: pointer;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n    outline: none;\n  }\n\n  .spring-check:disabled {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n\n  .spring-check__press {\n    flex: none;\n    width: var(--sc-box);\n    height: var(--sc-box);\n    border-radius: var(--sc-radius);\n    transition: transform 160ms var(--sc-ease-out);\n  }\n\n  .spring-check[data-pressed] .spring-check__press {\n    transform: scale(0.95);\n  }\n\n  .spring-check:focus-visible .spring-check__press {\n    outline: 2px solid color-mix(in srgb, var(--sc-ink) 45%, transparent);\n    outline-offset: 3px;\n  }\n\n  .spring-check__box {\n    position: relative;\n    display: grid;\n    place-items: center;\n    width: 100%;\n    height: 100%;\n    border-radius: inherit;\n    overflow: hidden;\n    transform-origin: center;\n  }\n\n  .spring-check__ring {\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    box-shadow: inset 0 0 0 var(--sc-ring) var(--sc-ink);\n    opacity: 0.28;\n    transition: opacity 120ms ease;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .spring-check:not(:disabled):hover .spring-check__ring {\n      opacity: 0.5;\n    }\n  }\n\n  .spring-check__fill {\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    background: var(--sc-fill);\n    transform-origin: center;\n  }\n\n  .spring-check__tick {\n    position: relative;\n    width: 68%;\n    height: 68%;\n    overflow: visible;\n    fill: none;\n    stroke: var(--sc-check);\n    stroke-width: 2.6;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .spring-check__label {\n    position: relative;\n    display: inline-block;\n  }\n\n  .spring-check__word {\n    display: inline-block;\n  }\n\n  .spring-check__rule {\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 46%;\n    height: var(--sc-rule);\n    border-radius: 2px;\n    background: currentColor;\n    transform-origin: var(--sc-origin);\n    pointer-events: none;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .spring-check__press {\n      transition: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/spring-check/SpringCheck.vue"
    },
    {
      "path": "registry/new-york/spring-check/index.ts",
      "content": "export { default as SpringCheck } from './SpringCheck.vue';\nexport type { SpringCheckProps, SpringCheckStrike } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/spring-check/index.ts"
    },
    {
      "path": "registry/new-york/spring-check/spring-check.ts",
      "content": "import type { SpringCheckReadings } from './types';\n\nconst RULE_END = 0.84;\nconst SWELL = 0.35;\n\nconst clamp01 = (value: number) => Math.min(1, Math.max(0, value));\n\n/** Damping ratio for a target overshoot fraction. */\nfunction zetaOf(bounce: number): number {\n  if (bounce <= 0) return 1;\n  const log = Math.log(bounce);\n  return -log / Math.sqrt(Math.PI ** 2 + log ** 2);\n}\n\n/** Converts the \"overshoot\" bounce prop into motion's spring `bounce` option. */\nexport function springBounce(bounce: number): number {\n  return 1 - zetaOf(bounce);\n}\n\n/**\n * Maps one spring value onto every part of the row: the fill grows from the\n * center, the box swells past 1, the tick draws, the word fades and the rule wipes.\n */\nexport function readings(\n  t: number,\n  doneOpacity: number,\n  strikeLag: number,\n): SpringCheckReadings {\n  const held = clamp01(t);\n  return {\n    fill: `scale(${Math.max(t, 0)})`,\n    box: `scale(${1 + SWELL * Math.max(0, t - 1)})`,\n    tick: 1 - held,\n    word: 1 - (1 - doneOpacity) * held,\n    rule: `scaleX(${clamp01((held - strikeLag) / (RULE_END - strikeLag))})`,\n  };\n}\n",
      "type": "registry:ui",
      "target": "components/ui/spring-check/spring-check.ts"
    },
    {
      "path": "registry/new-york/spring-check/types.ts",
      "content": "/** Side the strike-through wipes in from, or `none` for no rule. */\nexport type SpringCheckStrike = 'left' | 'center' | 'right' | 'none';\n\n/**\n * Props for the SpringCheck registry component.\n */\nexport interface SpringCheckProps {\n  /** Words beside the box. The strike-through matches their width. Overridden by the default slot. */\n  label?: string;\n  /** Checked state (`v-model`). Leave undefined for uncontrolled use. */\n  modelValue?: boolean;\n  /** Initial state when uncontrolled. */\n  defaultChecked?: boolean;\n  /** Dims the row and ignores input. */\n  disabled?: boolean;\n  /** Ink: the label, the ring, the rule and the focus outline. */\n  color?: string;\n  /** Fill that swells out of the box center. */\n  fillColor?: string;\n  /** Stroke of the tick drawn over the fill. */\n  checkColor?: string;\n  /** Box side in px. Ring, gap and row height derive from it. */\n  boxSize?: number;\n  /** Box corner radius in px. Half the size makes a circle. */\n  boxRadius?: number;\n  /** Label size in px. The rule thickness derives from it. */\n  fontSize?: number;\n  /** How far the fill swells past full. 0 arrives dead, 0.5 rebounds twice. */\n  bounce?: number;\n  /** Where on the spring the rule starts. 0 wipes with the fill, 0.4 waits for the tick. */\n  strikeLag?: number;\n  /** How much ink the words keep once checked. */\n  doneOpacity?: number;\n  /** Where the strike-through wipes from, or no rule at all. */\n  strike?: SpringCheckStrike;\n  /** Accessible name when the label is not text. */\n  ariaLabel?: string;\n  /** Extra classes for the row. */\n  class?: string;\n}\n\n/** Visual readings derived from the spring value. */\nexport interface SpringCheckReadings {\n  fill: string;\n  box: string;\n  tick: number;\n  word: number;\n  rule: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/spring-check/types.ts"
    }
  ]
}
