{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "motion-bento",
  "type": "registry:ui",
  "title": "Motion Bento",
  "description": "A services bento grid with a headline, a call-to-action and cards whose illustrated artwork plays its own loop.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/motion-bento/MotionBento.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, useId, useTemplateRef } from 'vue';\n  import {\n    useElementVisibility,\n    usePreferredReducedMotion,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import MotionBentoCard from './MotionBentoCard.vue';\n  import type { MotionBentoProps, MotionBentoSpan } from './types';\n\n  const props = withDefaults(defineProps<MotionBentoProps>(), {\n    heading: '',\n    highlight: '',\n    ctaLabel: '',\n    ctaHref: '',\n    accent: '#3b8cf0',\n    paused: false,\n    class: '',\n  });\n\n  const emit = defineEmits<{ cta: [] }>();\n\n  const SPAN_CLASS: Record<MotionBentoSpan, string> = {\n    3: 'md:col-span-3',\n    4: 'md:col-span-4',\n    5: 'md:col-span-5',\n    6: 'md:col-span-6',\n    7: 'md:col-span-7',\n    8: 'md:col-span-8',\n    12: 'md:col-span-12',\n  };\n\n  const root = useTemplateRef<HTMLElement>('root');\n  const visible = useElementVisibility(root);\n  const motionPreference = usePreferredReducedMotion();\n  const headingId = useId();\n\n  const still = computed(() => motionPreference.value === 'reduce');\n  const playing = computed(\n    () => visible.value && !props.paused && !still.value,\n  );\n\n  const headingParts = computed(() => {\n    const at = props.highlight ? props.heading.indexOf(props.highlight) : -1;\n    if (at < 0) return { before: props.heading, strong: '', after: '' };\n    return {\n      before: props.heading.slice(0, at),\n      strong: props.highlight,\n      after: props.heading.slice(at + props.highlight.length),\n    };\n  });\n\n  function spanClass(span: MotionBentoSpan | undefined): string {\n    return SPAN_CLASS[span ?? 4];\n  }\n\n  function onCta(): void {\n    emit('cta');\n  }\n</script>\n\n<template>\n  <section\n    ref=\"root\"\n    :aria-labelledby=\"heading ? headingId : undefined\"\n    :class=\"cn('mb-root w-full', props.class)\"\n    :style=\"{ '--mb-accent': accent }\"\n  >\n    <div\n      v-if=\"heading || ctaLabel || $slots.header\"\n      class=\"mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between\"\n    >\n      <slot name=\"header\">\n        <h2\n          :id=\"headingId\"\n          class=\"max-w-96 text-[1.75rem]/[1.2] font-light tracking-tight text-foreground/70\"\n        >\n          {{ headingParts.before\n          }}<span class=\"font-semibold text-foreground\">{{\n            headingParts.strong\n          }}</span\n          >{{ headingParts.after }}\n        </h2>\n      </slot>\n      <slot name=\"cta\">\n        <a\n          v-if=\"ctaLabel && ctaHref\"\n          :href=\"ctaHref\"\n          class=\"mb-cta self-start rounded-lg px-3 py-1.5 text-sm font-medium text-white transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring sm:self-auto\"\n        >\n          {{ ctaLabel }}\n        </a>\n        <button\n          v-else-if=\"ctaLabel\"\n          type=\"button\"\n          class=\"mb-cta self-start rounded-lg px-3 py-1.5 text-sm font-medium text-white transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring sm:self-auto\"\n          @click=\"onCta\"\n        >\n          {{ ctaLabel }}\n        </button>\n      </slot>\n    </div>\n\n    <div class=\"grid grid-cols-1 gap-3 md:grid-cols-12\">\n      <MotionBentoCard\n        v-for=\"(item, index) in items\"\n        :key=\"`${index}-${item.title}`\"\n        :item=\"item\"\n        :playing=\"playing\"\n        :still=\"still\"\n        :class=\"spanClass(item.span)\"\n      >\n        <template v-if=\"!item.art && $slots.art\" #default>\n          <slot\n            name=\"art\"\n            :item=\"item\"\n            :index=\"index\"\n            :playing=\"playing\"\n            :still=\"still\"\n          />\n        </template>\n      </MotionBentoCard>\n    </div>\n  </section>\n</template>\n\n<style scoped>\n  .mb-root {\n    --mb-art:\n      radial-gradient(\n        70% 50% at 50% 105%,\n        rgb(255 255 255 / 0.75),\n        transparent 70%\n      ),\n      linear-gradient(\n        180deg,\n        color-mix(in oklab, var(--mb-accent) 46%, white),\n        color-mix(in oklab, var(--mb-accent) 30%, white)\n      );\n    --mb-tile: #ffffff;\n    --mb-tile-soft: #f3f7fc;\n    --mb-glass: rgb(255 255 255 / 0.42);\n    --mb-line: rgb(255 255 255 / 0.75);\n    --mb-pulse: #ffffff;\n    --mb-tile-shadow:\n      0 14px 30px -14px color-mix(in oklab, var(--mb-accent) 70%, #0b2a55),\n      0 2px 6px -2px rgb(15 40 80 / 0.12);\n  }\n\n  .dark .mb-root {\n    --mb-art:\n      radial-gradient(\n        70% 55% at 50% 110%,\n        color-mix(in oklab, var(--mb-accent) 38%, transparent),\n        transparent 70%\n      ),\n      linear-gradient(\n        180deg,\n        color-mix(in oklab, var(--mb-accent) 20%, var(--card)),\n        color-mix(in oklab, var(--mb-accent) 7%, var(--card))\n      );\n    --mb-tile: color-mix(in oklab, var(--mb-accent) 9%, var(--secondary));\n    --mb-tile-soft: color-mix(in oklab, var(--mb-accent) 14%, var(--secondary));\n    --mb-glass: rgb(255 255 255 / 0.07);\n    --mb-line: color-mix(in oklab, var(--mb-accent) 45%, transparent);\n    --mb-pulse: color-mix(in oklab, var(--mb-accent) 30%, white);\n    --mb-tile-shadow:\n      0 16px 32px -14px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(255 255 255 / 0.07);\n  }\n\n  .mb-cta {\n    background: linear-gradient(\n      180deg,\n      color-mix(in oklab, var(--mb-accent) 80%, white),\n      var(--mb-accent)\n    );\n    box-shadow:\n      inset 0 1px 0 rgb(255 255 255 / 0.35),\n      0 6px 16px -6px var(--mb-accent);\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/MotionBento.vue"
    },
    {
      "path": "registry/new-york/motion-bento/MotionBentoCard.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import MotionBentoCommerce from './MotionBentoCommerce.vue';\n  import MotionBentoDesign from './MotionBentoDesign.vue';\n  import MotionBentoHosting from './MotionBentoHosting.vue';\n  import MotionBentoIntegrations from './MotionBentoIntegrations.vue';\n  import MotionBentoSla from './MotionBentoSla.vue';\n  import type { MotionBentoCardProps } from './types';\n\n  const props = defineProps<MotionBentoCardProps>();\n\n  const ART = {\n    commerce: MotionBentoCommerce,\n    sla: MotionBentoSla,\n    integrations: MotionBentoIntegrations,\n    design: MotionBentoDesign,\n    hosting: MotionBentoHosting,\n  };\n\n  const artComponent = computed(() =>\n    props.item.art ? ART[props.item.art] : null,\n  );\n</script>\n\n<template>\n  <article\n    class=\"flex flex-col rounded-[1.375rem] bg-card p-1.5 shadow-[0_1px_2px_rgb(0_0_0/0.04),0_12px_32px_-16px_rgb(15_40_80/0.18)] ring-1 ring-border/70 transition duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_2px_4px_rgb(0_0_0/0.05),0_28px_48px_-20px_rgb(15_40_80/0.32)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 dark:shadow-[0_12px_32px_-16px_rgb(0_0_0/0.7)]\"\n  >\n    <div\n      class=\"relative h-56 overflow-hidden rounded-2xl bg-(image:--mb-art)\"\n      aria-hidden=\"true\"\n    >\n      <slot>\n        <component\n          :is=\"artComponent\"\n          v-if=\"artComponent\"\n          :playing=\"playing\"\n          :still=\"still\"\n        />\n      </slot>\n    </div>\n    <div class=\"px-4 pt-4 pb-3.5\">\n      <h3 class=\"text-lg/snug font-medium text-foreground/80\">\n        {{ item.title }}\n      </h3>\n      <p\n        v-if=\"item.description\"\n        class=\"mt-1.5 text-sm/snug text-muted-foreground\"\n      >\n        {{ item.description }}\n      </p>\n    </div>\n  </article>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/MotionBentoCard.vue"
    },
    {
      "path": "registry/new-york/motion-bento/MotionBentoCommerce.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import { motion } from 'motion-v';\n  import { useBentoClock } from './use-bento-clock';\n  import type {\n    MotionBentoArtProps,\n    MotionBentoPose,\n    MotionBentoProduct,\n  } from './types';\n\n  const props = withDefaults(defineProps<MotionBentoArtProps>(), {\n    playing: false,\n    still: false,\n  });\n\n  const PRODUCTS: MotionBentoProduct[] = [\n    {\n      name: 'Pulse Watch',\n      price: '$128',\n      icon: 'lucide:watch',\n      tint: 'linear-gradient(140deg, #c9eeff, #7fc9f3)',\n      ink: '#1d3a5c',\n    },\n    {\n      name: 'Trail Backpack',\n      price: '$200',\n      icon: 'lucide:backpack',\n      tint: 'linear-gradient(140deg, #b3c1f7, #8199ec)',\n      ink: '#161d36',\n    },\n    {\n      name: 'Smart Headphone',\n      price: '$149',\n      icon: 'lucide:headphones',\n      tint: 'linear-gradient(140deg, #f7b79c, #b4bdf0)',\n      ink: '#2b334d',\n    },\n  ];\n\n  const CENTER: MotionBentoPose = { x: 0, y: 0, rotate: 0, scale: 1, z: 3 };\n  const POSES: MotionBentoPose[] = [\n    CENTER,\n    { x: 236, y: 78, rotate: 36, scale: 0.97, z: 2 },\n    { x: -236, y: 78, rotate: -36, scale: 0.97, z: 1 },\n  ];\n  const SPRING = { type: 'spring', stiffness: 210, damping: 24, mass: 0.9 };\n  const DOTS = ['bg-foreground/70', 'bg-foreground/25', 'bg-foreground/15'];\n\n  const tick = useBentoClock(() => props.playing, 2200);\n  const step = computed(() => (props.still ? 0 : tick.value));\n\n  function poseOf(index: number): MotionBentoPose {\n    return POSES[(((index - step.value) % 3) + 3) % 3] ?? CENTER;\n  }\n\n  function animateOf(index: number) {\n    const pose = poseOf(index);\n    return { x: pose.x, y: pose.y, rotate: pose.rotate, scale: pose.scale };\n  }\n</script>\n\n<template>\n  <div class=\"absolute inset-0\">\n    <div\n      class=\"absolute bottom-0 left-1/2 flex h-10 -translate-x-1/2 gap-8 opacity-70\"\n    >\n      <span class=\"w-px bg-(--mb-line)\" />\n      <span class=\"w-px bg-(--mb-line)\" />\n      <span class=\"w-px bg-(--mb-line)\" />\n    </div>\n\n    <motion.div\n      v-for=\"(product, index) in PRODUCTS\"\n      :key=\"product.name\"\n      class=\"absolute top-7 left-1/2 -ml-20 w-40 rounded-[1.4rem] bg-(--mb-glass) p-1.5 shadow-(--mb-tile-shadow)\"\n      :style=\"{ zIndex: poseOf(index).z }\"\n      :initial=\"animateOf(index)\"\n      :animate=\"animateOf(index)\"\n      :transition=\"SPRING\"\n    >\n      <div class=\"rounded-2xl bg-(--mb-tile) p-1.5\">\n        <div\n          class=\"grid h-24 place-items-center rounded-xl\"\n          :style=\"{ backgroundImage: product.tint, color: product.ink }\"\n        >\n          <Icon\n            :name=\"product.icon\"\n            class=\"text-[3.25rem] drop-shadow-[0_6px_6px_rgb(0_0_0/0.25)]\"\n          />\n        </div>\n        <div class=\"px-1.5 pt-2 pb-1\">\n          <p class=\"text-xs font-semibold text-foreground\">\n            {{ product.name }}\n          </p>\n          <p class=\"text-[0.5625rem] text-muted-foreground\">\n            Lightweight. All day comfort\n          </p>\n          <p class=\"mt-1.5 text-xs font-semibold text-foreground\">\n            {{ product.price }}\n          </p>\n          <div class=\"mt-1.5 flex gap-1\">\n            <span\n              v-for=\"dot in DOTS\"\n              :key=\"dot\"\n              :class=\"['size-1.5 rounded-full', dot]\"\n            />\n          </div>\n        </div>\n      </div>\n    </motion.div>\n\n    <div\n      class=\"absolute top-3 left-1/2 z-10 flex -translate-x-1/2 items-center gap-1.5 rounded-full bg-(--mb-tile) py-1 pr-2.5 pl-1 text-[0.625rem] font-medium text-foreground shadow-(--mb-tile-shadow) ring-4 ring-(--mb-glass)\"\n    >\n      <span\n        class=\"rounded-full bg-(--mb-tile-soft) px-1.5 py-0.5 font-semibold tabular-nums\"\n      >\n        {{ 136 + step }}\n      </span>\n      Orders Today\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/MotionBentoCommerce.vue"
    },
    {
      "path": "registry/new-york/motion-bento/MotionBentoDesign.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import { useBentoClock } from './use-bento-clock';\n  import type { MotionBentoArtProps } from './types';\n\n  const props = withDefaults(defineProps<MotionBentoArtProps>(), {\n    playing: false,\n    still: false,\n  });\n\n  const DEPTH = [50, 80, 64, 72, 34, 58];\n  const GLOW = [88, 62, 95, 44, 70, 80];\n  const TILES = ['type', 'gradient', 'ring', 'pen', 'shapes'];\n  const STRIP = [...TILES, ...TILES];\n  const SWATCHES = ['bg-violet-500', 'bg-amber-400', 'bg-rose-500'];\n\n  const tick = useBentoClock(() => props.playing, 1300);\n  const depth = computed(() => DEPTH[tick.value % DEPTH.length] ?? 50);\n  const glow = computed(() => GLOW[tick.value % GLOW.length] ?? 88);\n  const playState = computed(() => ({\n    animationPlayState: props.playing ? 'running' : 'paused',\n  }));\n</script>\n\n<template>\n  <div class=\"absolute inset-0\">\n    <div\n      class=\"absolute inset-y-3 left-1/2 -ml-24 w-48 rounded-3xl bg-(--mb-glass) p-1.5 shadow-(--mb-tile-shadow)\"\n    >\n      <div\n        class=\"flex size-full flex-col rounded-[1.1rem] bg-(--mb-tile) px-3 pt-3\"\n      >\n        <div class=\"flex justify-between text-[0.5625rem] font-semibold\">\n          <span class=\"text-foreground\">Depth</span>\n          <span class=\"text-muted-foreground tabular-nums\">\n            {{ (depth / 10).toFixed(1) }}\n          </span>\n        </div>\n        <div class=\"relative mt-1.5 h-px bg-foreground/15\">\n          <div\n            class=\"absolute inset-y-0 left-0 bg-foreground/80 transition-[width] duration-700 ease-out\"\n            :style=\"{ width: `${depth}%` }\"\n          >\n            <span\n              class=\"absolute top-1/2 -right-1 size-2 -translate-y-1/2 rounded-full bg-foreground\"\n            />\n          </div>\n        </div>\n        <div class=\"mt-3 flex justify-between text-[0.5625rem] font-semibold\">\n          <span class=\"text-foreground\">Glow</span>\n          <span class=\"text-muted-foreground tabular-nums\">{{ glow }}</span>\n        </div>\n        <div class=\"relative mt-1.5 h-px bg-foreground/15\">\n          <div\n            class=\"absolute inset-y-0 left-0 bg-foreground/80 transition-[width] duration-700 ease-out\"\n            :style=\"{ width: `${glow}%` }\"\n          >\n            <span\n              class=\"absolute top-1/2 -right-1 size-2 -translate-y-1/2 rounded-full bg-foreground\"\n            />\n          </div>\n        </div>\n        <div class=\"mt-auto mb-2.5 flex items-center gap-1.5\">\n          <div\n            class=\"flex flex-1 items-center gap-1 rounded-full bg-(--mb-tile-soft) p-1\"\n          >\n            <span\n              class=\"size-3 rounded-full border-[3px] border-blue-500 bg-(--mb-tile)\"\n            />\n            <span\n              v-for=\"swatch in SWATCHES\"\n              :key=\"swatch\"\n              :class=\"['size-3 rounded-full', swatch]\"\n            />\n          </div>\n          <div\n            class=\"flex items-center gap-1 rounded-full bg-(--mb-tile-soft) p-1 text-muted-foreground\"\n          >\n            <Icon name=\"lucide:minus\" class=\"text-xs\" />\n            <span\n              class=\"grid size-3.5 place-items-center rounded-full bg-(--mb-tile)\"\n            >\n              <Icon name=\"lucide:plus\" class=\"text-[0.625rem]\" />\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"absolute inset-x-0 top-1/2 -mt-6 overflow-hidden py-3\">\n      <div class=\"mb-design-strip flex w-max\" :style=\"playState\">\n        <div v-for=\"(tile, index) in STRIP\" :key=\"index\" class=\"pr-2.5\">\n          <div\n            class=\"grid size-15 place-items-center rounded-2xl bg-(--mb-tile) shadow-(--mb-tile-shadow) ring-3 ring-(--mb-glass)\"\n          >\n            <span\n              v-if=\"tile === 'type'\"\n              class=\"text-2xl font-semibold tracking-tight text-blue-500\"\n            >\n              Aa\n            </span>\n            <span\n              v-else-if=\"tile === 'gradient'\"\n              class=\"size-11 rounded-xl bg-linear-to-br from-orange-300 via-fuchsia-400 to-blue-500\"\n            />\n            <span\n              v-else-if=\"tile === 'ring'\"\n              class=\"grid size-8 place-items-center rounded-full bg-linear-to-br from-indigo-500 to-sky-300\"\n            >\n              <span class=\"size-3.5 rounded-full bg-(--mb-tile)\" />\n            </span>\n            <span\n              v-else-if=\"tile === 'pen'\"\n              class=\"grid size-9 place-items-center rounded-lg bg-yellow-300 text-neutral-900\"\n            >\n              <Icon name=\"lucide:pen-tool\" class=\"text-xl\" />\n            </span>\n            <Icon\n              v-else\n              name=\"lucide:shapes\"\n              class=\"text-[1.75rem] text-violet-500\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div\n      class=\"mb-design-cursor-a absolute top-11 left-1/2 z-10 -ml-20\"\n      :style=\"playState\"\n    >\n      <span\n        class=\"mb-design-arrow ml-auto block size-2.5 rotate-90 bg-fuchsia-600\"\n      />\n      <span\n        class=\"block rounded-md bg-fuchsia-600 px-1.5 py-0.5 text-[0.625rem] font-medium whitespace-nowrap text-white\"\n      >\n        Web Design\n      </span>\n    </div>\n    <div\n      class=\"mb-design-cursor-b absolute top-31 left-1/2 z-10 -ml-4\"\n      :style=\"playState\"\n    >\n      <span class=\"mb-design-arrow block size-2.5 bg-sky-500\" />\n      <span\n        class=\"ml-2 block rounded-md bg-sky-500 px-1.5 py-0.5 text-[0.625rem] font-medium whitespace-nowrap text-white\"\n      >\n        UI/UX Design\n      </span>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .mb-design-strip {\n    animation: mb-design-scroll 16s linear infinite;\n  }\n\n  .mb-design-arrow {\n    clip-path: polygon(0 0, 100% 42%, 52% 54%, 40% 100%);\n  }\n\n  .mb-design-cursor-a {\n    animation: mb-design-wander-a 7s ease-in-out infinite;\n  }\n\n  .mb-design-cursor-b {\n    animation: mb-design-wander-b 8.5s ease-in-out infinite;\n  }\n\n  @keyframes mb-design-scroll {\n    to {\n      transform: translateX(-50%);\n    }\n  }\n\n  @keyframes mb-design-wander-a {\n    0%,\n    100% {\n      transform: translate(0, 0);\n    }\n    30% {\n      transform: translate(44px, -8px);\n    }\n    55% {\n      transform: translate(24px, 14px);\n    }\n    80% {\n      transform: translate(-8px, 6px);\n    }\n  }\n\n  @keyframes mb-design-wander-b {\n    0%,\n    100% {\n      transform: translate(0, 0);\n    }\n    25% {\n      transform: translate(-46px, 6px);\n    }\n    50% {\n      transform: translate(-20px, -14px);\n    }\n    75% {\n      transform: translate(26px, 4px);\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/MotionBentoDesign.vue"
    },
    {
      "path": "registry/new-york/motion-bento/MotionBentoHosting.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, useId } from 'vue';\n  import type { MotionBentoArtProps } from './types';\n\n  const props = withDefaults(defineProps<MotionBentoArtProps>(), {\n    playing: false,\n    still: false,\n  });\n\n  const LINES = [\n    'M0 150 H46 L72 124 H140',\n    'M400 150 H354 L328 124 H260',\n    'M194 0 V46',\n    'M206 0 V46',\n    'M194 224 V178',\n    'M206 224 V178',\n  ];\n  const BOLT =\n    'M60 10 L24 56 Q21 61 27 61 H47 L38 90 Q37 95 41 91 L77 45 Q80 40 74 40 H54 L63 14 Q65 7 60 10 Z';\n\n  const uid = useId();\n  const fillId = `mb-bolt-fill-${uid}`;\n  const shineId = `mb-bolt-shine-${uid}`;\n  const playState = computed(() => ({\n    animationPlayState: props.playing ? 'running' : 'paused',\n  }));\n</script>\n\n<template>\n  <div class=\"absolute inset-0\">\n    <svg\n      class=\"absolute top-0 left-1/2 -ml-50 h-56 w-100\"\n      viewBox=\"0 0 400 224\"\n      fill=\"none\"\n    >\n      <path\n        v-for=\"line in LINES\"\n        :key=\"line\"\n        :d=\"line\"\n        class=\"stroke-(--mb-line)\"\n        stroke-width=\"1.25\"\n      />\n      <path\n        v-for=\"(line, index) in LINES\"\n        :key=\"`pulse-${line}`\"\n        :d=\"line\"\n        pathLength=\"100\"\n        class=\"mb-host-pulse stroke-(--mb-pulse)\"\n        :style=\"[playState, { animationDelay: `${index * 0.35}s` }]\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n      />\n    </svg>\n\n    <div\n      class=\"mb-host-halo absolute top-1/2 left-1/2 -mt-19 -ml-19 size-38 rounded-[2.1rem] bg-(--mb-glass) ring-1 ring-(--mb-line)\"\n      :style=\"playState\"\n    />\n    <div\n      class=\"absolute top-1/2 left-1/2 -mt-16 -ml-16 grid size-32 place-items-center overflow-hidden rounded-[1.6rem] bg-(--mb-tile) shadow-(--mb-tile-shadow)\"\n    >\n      <svg\n        viewBox=\"0 0 100 100\"\n        class=\"mb-host-bolt size-24 overflow-visible\"\n        :style=\"playState\"\n      >\n        <defs>\n          <linearGradient :id=\"fillId\" x1=\"0.2\" y1=\"0\" x2=\"0.8\" y2=\"1\">\n            <stop offset=\"0\" style=\"stop-color: #bfe3ff\" />\n            <stop offset=\"0.45\" style=\"stop-color: var(--mb-accent)\" />\n            <stop\n              offset=\"1\"\n              style=\"\n                stop-color: color-mix(in oklab, var(--mb-accent) 55%, white);\n              \"\n            />\n          </linearGradient>\n          <linearGradient :id=\"shineId\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" style=\"stop-color: white; stop-opacity: 0.85\" />\n            <stop offset=\"0.5\" style=\"stop-color: white; stop-opacity: 0\" />\n          </linearGradient>\n        </defs>\n        <path :d=\"BOLT\" :fill=\"`url(#${fillId})`\" />\n        <path :d=\"BOLT\" :fill=\"`url(#${shineId})`\" opacity=\"0.6\" />\n        <path\n          :d=\"BOLT\"\n          fill=\"none\"\n          stroke=\"white\"\n          stroke-opacity=\"0.55\"\n          stroke-width=\"1.2\"\n        />\n      </svg>\n      <span\n        class=\"mb-host-shine pointer-events-none absolute inset-y-0 -left-1/2 w-1/3 bg-linear-to-r from-transparent via-white/45 to-transparent dark:via-white/15\"\n        :style=\"playState\"\n      />\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .mb-host-pulse {\n    stroke-dasharray: 10 100;\n    stroke-dashoffset: 110;\n    animation: mb-host-flow 2.4s cubic-bezier(0.5, 0, 0.5, 1) infinite;\n    filter: drop-shadow(0 0 3px var(--mb-pulse));\n  }\n\n  .mb-host-halo {\n    animation: mb-host-breathe 2.8s ease-in-out infinite;\n  }\n\n  .mb-host-bolt {\n    filter: drop-shadow(\n      0 10px 10px color-mix(in oklab, var(--mb-accent) 45%, transparent)\n    );\n    animation: mb-host-float 2.8s ease-in-out infinite;\n  }\n\n  .mb-host-shine {\n    transform: skewX(-18deg);\n    animation: mb-host-sweep 4.2s ease-in-out infinite;\n  }\n\n  @keyframes mb-host-flow {\n    from {\n      stroke-dashoffset: 110;\n    }\n    to {\n      stroke-dashoffset: 0;\n    }\n  }\n\n  @keyframes mb-host-breathe {\n    0%,\n    100% {\n      transform: scale(0.95);\n      opacity: 0.55;\n    }\n    50% {\n      transform: scale(1.03);\n      opacity: 1;\n    }\n  }\n\n  @keyframes mb-host-float {\n    0%,\n    100% {\n      transform: translateY(1px) scale(0.98);\n    }\n    50% {\n      transform: translateY(-2px) scale(1.02);\n    }\n  }\n\n  @keyframes mb-host-sweep {\n    0%,\n    55% {\n      translate: 0 0;\n    }\n    100% {\n      translate: 480% 0;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/MotionBentoHosting.vue"
    },
    {
      "path": "registry/new-york/motion-bento/MotionBentoIntegrations.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, useId } from 'vue';\n  import { motion } from 'motion-v';\n  import { useBentoClock } from './use-bento-clock';\n  import type { MotionBentoArtProps, MotionBentoSatellite } from './types';\n\n  const props = withDefaults(defineProps<MotionBentoArtProps>(), {\n    playing: false,\n    still: false,\n  });\n\n  const RADIUS = 84;\n  const SATELLITES: MotionBentoSatellite[] = [\n    { icon: 'lucide:atom', color: '#0ea5c6', x: 0, y: -RADIUS },\n    { icon: 'lucide:leaf', color: '#15803d', x: RADIUS, y: 0 },\n    { icon: 'lucide:hexagon', color: '#16a34a', x: 0, y: RADIUS },\n    { icon: 'lucide:database', color: '#6366f1', x: -RADIUS, y: 0 },\n  ];\n  const TURN = { type: 'spring', stiffness: 90, damping: 16, mass: 1 };\n\n  const gradientId = `mb-n-${useId()}`;\n  const tick = useBentoClock(() => props.playing, 1500);\n  const turn = computed(() => (props.still ? 0 : tick.value * 90));\n\n  function satelliteStyle(satellite: MotionBentoSatellite) {\n    return {\n      left: `${satellite.x}px`,\n      top: `${satellite.y}px`,\n      color: satellite.color,\n    };\n  }\n</script>\n\n<template>\n  <div class=\"absolute inset-0\">\n    <motion.div\n      class=\"absolute top-1/2 left-1/2 size-0\"\n      :animate=\"{ rotate: turn }\"\n      :transition=\"TURN\"\n    >\n      <span\n        class=\"absolute top-0 -left-21 h-px w-42 bg-(--mb-line)\"\n        aria-hidden=\"true\"\n      />\n      <span\n        class=\"absolute -top-21 left-0 h-42 w-px bg-(--mb-line)\"\n        aria-hidden=\"true\"\n      />\n      <motion.div\n        v-for=\"satellite in SATELLITES\"\n        :key=\"satellite.icon\"\n        class=\"absolute -mt-4.5 -ml-4.5 grid size-9 place-items-center rounded-xl bg-(--mb-tile) shadow-(--mb-tile-shadow) ring-3 ring-(--mb-glass)\"\n        :style=\"satelliteStyle(satellite)\"\n        :animate=\"{ rotate: -turn }\"\n        :transition=\"TURN\"\n      >\n        <Icon :name=\"satellite.icon\" class=\"text-lg\" />\n      </motion.div>\n    </motion.div>\n\n    <div\n      class=\"mb-int-halo absolute top-1/2 left-1/2 -mt-15 -ml-15 size-30 rounded-[1.9rem] bg-(--mb-glass)\"\n      :class=\"{ 'mb-int-halo--on': playing }\"\n    />\n    <div\n      class=\"absolute top-1/2 left-1/2 -mt-11 -ml-11 grid size-22 place-items-center rounded-[1.4rem] bg-(--mb-tile) shadow-(--mb-tile-shadow)\"\n    >\n      <svg viewBox=\"0 0 512 512\" class=\"size-11\">\n        <defs>\n          <linearGradient :id=\"gradientId\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" style=\"stop-color: #7cc4ff\" />\n            <stop offset=\"1\" style=\"stop-color: var(--mb-accent)\" />\n          </linearGradient>\n        </defs>\n        <path\n          d=\"M168 384V176m0 72a88 88 0 0 1 176 0v136\"\n          fill=\"none\"\n          :stroke=\"`url(#${gradientId})`\"\n          stroke-width=\"64\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n        />\n      </svg>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .mb-int-halo--on {\n    animation: mb-int-breathe 3s ease-in-out infinite;\n  }\n\n  @keyframes mb-int-breathe {\n    0%,\n    100% {\n      transform: scale(0.94);\n      opacity: 0.7;\n    }\n    50% {\n      transform: scale(1.04);\n      opacity: 1;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/MotionBentoIntegrations.vue"
    },
    {
      "path": "registry/new-york/motion-bento/MotionBentoSla.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import { motion } from 'motion-v';\n  import { useBentoClock } from './use-bento-clock';\n  import type { MotionBentoArtProps } from './types';\n\n  const props = withDefaults(defineProps<MotionBentoArtProps>(), {\n    playing: false,\n    still: false,\n  });\n\n  /** One loop is 52 ticks of 100 ms. */\n  const LOOP = 52;\n  const STILL_TICK = 30;\n  const EASE = { duration: 0.55, ease: [0.22, 1, 0.36, 1] };\n  const CHIPS = [\n    { value: '24/7', label: 'Support', x: 0, y: -74, at: 15 },\n    { value: '99.9%', label: 'Uptime', x: -112, y: -36, at: 16 },\n    { value: '<1h', label: 'Response', x: 112, y: -36, at: 17 },\n  ];\n\n  const tick = useBentoClock(() => props.playing, 100);\n  const t = computed(() => (props.still ? STILL_TICK : tick.value % LOOP));\n  const closing = computed(() => t.value >= LOOP - 6);\n  const open = computed(() => t.value >= 5 && !closing.value);\n  const raised = computed(() => t.value >= 9 && !closing.value);\n  const checked = computed(() => t.value >= 12 && !closing.value);\n\n  function chipShown(at: number): boolean {\n    return t.value >= at && !closing.value;\n  }\n</script>\n\n<template>\n  <div class=\"absolute inset-0\">\n    <motion.div\n      class=\"absolute top-30 left-1/2 -ml-35 h-44 w-70\"\n      :animate=\"{ y: open ? 0 : 14 }\"\n      :transition=\"EASE\"\n    >\n      <!-- back panel + flap (behind the tile) -->\n      <svg\n        class=\"absolute inset-0 size-full overflow-visible\"\n        viewBox=\"0 0 280 176\"\n      >\n        <rect\n          x=\"0\"\n          y=\"0\"\n          width=\"280\"\n          height=\"176\"\n          rx=\"22\"\n          class=\"fill-(--mb-tile-soft)\"\n        />\n      </svg>\n      <motion.div\n        class=\"absolute inset-x-0 top-0 h-26 origin-top\"\n        :animate=\"{ scaleY: open ? -1 : 1 }\"\n        :transition=\"{ duration: 0.5, ease: [0.65, 0, 0.35, 1] }\"\n      >\n        <svg\n          class=\"size-full overflow-visible\"\n          viewBox=\"0 0 280 104\"\n          preserveAspectRatio=\"none\"\n        >\n          <path\n            d=\"M14 0 H266 Q280 0 270 10 L152 98 Q140 107 128 98 L10 10 Q0 0 14 0 Z\"\n            class=\"fill-(--mb-tile) stroke-(--mb-line)\"\n            stroke-width=\"1\"\n          />\n        </svg>\n      </motion.div>\n\n      <!-- the badge -->\n      <motion.div\n        class=\"absolute top-0 left-1/2 -mt-12 -ml-10 grid size-20 place-items-center rounded-[1.4rem] p-1\"\n        :initial=\"{ y: 70, opacity: 0, scale: 0.8 }\"\n        :animate=\"\n          raised\n            ? { y: 0, opacity: 1, scale: 1 }\n            : { y: 70, opacity: 0, scale: 0.8 }\n        \"\n        :transition=\"{ type: 'spring', stiffness: 220, damping: 20 }\"\n      >\n        <div class=\"mb-sla-badge grid size-full place-items-center rounded-2xl\">\n          <svg viewBox=\"0 0 48 48\" class=\"size-11\">\n            <motion.path\n              d=\"M12 25 L21 33 L36 15\"\n              fill=\"none\"\n              stroke=\"white\"\n              stroke-width=\"4.5\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              :initial=\"{ pathLength: 0 }\"\n              :animate=\"{ pathLength: checked ? 1 : 0 }\"\n              :transition=\"{ duration: 0.45, ease: 'easeOut' }\"\n            />\n          </svg>\n        </div>\n      </motion.div>\n\n      <!-- front pocket -->\n      <svg\n        class=\"pointer-events-none absolute inset-0 size-full overflow-visible\"\n        viewBox=\"0 0 280 176\"\n      >\n        <path\n          d=\"M0 14 L128 96 Q140 104 152 96 L280 14 V154 Q280 176 258 176 H22 Q0 176 0 154 Z\"\n          class=\"fill-(--mb-tile) stroke-(--mb-line)\"\n          stroke-width=\"1\"\n        />\n        <path\n          d=\"M2 172 L126 108 Q140 101 154 108 L278 172\"\n          fill=\"none\"\n          class=\"stroke-foreground/6\"\n          stroke-width=\"1.5\"\n        />\n      </svg>\n    </motion.div>\n\n    <motion.div\n      v-for=\"chip in CHIPS\"\n      :key=\"chip.label\"\n      class=\"absolute top-1/2 left-1/2 z-10 -mt-3 flex -translate-x-1/2 items-center gap-1 rounded-full bg-(--mb-tile) py-0.5 pr-2 pl-0.5 text-[0.5625rem] font-medium whitespace-nowrap text-foreground shadow-(--mb-tile-shadow) ring-3 ring-(--mb-glass)\"\n      :initial=\"{ x: chip.x, y: chip.y + 8, opacity: 0, scale: 0.7 }\"\n      :animate=\"{\n        x: chip.x,\n        y: chipShown(chip.at) ? chip.y : chip.y + 8,\n        opacity: chipShown(chip.at) ? 1 : 0,\n        scale: chipShown(chip.at) ? 1 : 0.7,\n      }\"\n      :transition=\"{ type: 'spring', stiffness: 320, damping: 22 }\"\n    >\n      <span\n        class=\"mb-sla-value rounded-full bg-(--mb-tile-soft) px-1.5 py-0.5 font-semibold\"\n      >\n        {{ chip.value }}\n      </span>\n      {{ chip.label }}\n    </motion.div>\n  </div>\n</template>\n\n<style scoped>\n  .mb-sla-badge {\n    background: linear-gradient(\n      160deg,\n      color-mix(in oklab, var(--mb-accent) 45%, white),\n      var(--mb-accent)\n    );\n    box-shadow:\n      inset 0 2px 0 rgb(255 255 255 / 0.45),\n      inset 0 -6px 12px color-mix(in oklab, var(--mb-accent) 60%, #0b2a55),\n      0 18px 30px -12px var(--mb-accent);\n  }\n\n  .mb-sla-value {\n    color: color-mix(in oklab, var(--mb-accent) 85%, var(--foreground));\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/MotionBentoSla.vue"
    },
    {
      "path": "registry/new-york/motion-bento/index.ts",
      "content": "export { default as MotionBento } from './MotionBento.vue';\nexport { default as MotionBentoCard } from './MotionBentoCard.vue';\nexport { default as MotionBentoCommerce } from './MotionBentoCommerce.vue';\nexport { default as MotionBentoSla } from './MotionBentoSla.vue';\nexport { default as MotionBentoIntegrations } from './MotionBentoIntegrations.vue';\nexport { default as MotionBentoDesign } from './MotionBentoDesign.vue';\nexport { default as MotionBentoHosting } from './MotionBentoHosting.vue';\nexport { useBentoClock } from './use-bento-clock';\nexport type {\n  MotionBentoArt,\n  MotionBentoArtProps,\n  MotionBentoArtSlotProps,\n  MotionBentoCardProps,\n  MotionBentoItem,\n  MotionBentoProps,\n  MotionBentoSpan,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/index.ts"
    },
    {
      "path": "registry/new-york/motion-bento/types.ts",
      "content": "export type MotionBentoArt =\n  | 'commerce'\n  | 'sla'\n  | 'integrations'\n  | 'design'\n  | 'hosting';\n\nexport type MotionBentoSpan = 3 | 4 | 5 | 6 | 7 | 8 | 12;\n\nexport interface MotionBentoItem {\n  /** Card title shown under the artwork. */\n  title: string;\n  /** One-line description under the title. */\n  description?: string;\n  /** Built-in animated artwork. Leave empty to use the `art` slot. */\n  art?: MotionBentoArt;\n  /** Columns out of 12 the card spans from the `md` breakpoint. */\n  span?: MotionBentoSpan;\n}\n\nexport interface MotionBentoProps {\n  /** Cards, placed in order into a 12-column grid. */\n  items: MotionBentoItem[];\n  /** Section headline. */\n  heading?: string;\n  /** Part of `heading` drawn in a heavier weight. */\n  highlight?: string;\n  /** Label of the call-to-action button. Empty hides it. */\n  ctaLabel?: string;\n  /** Turns the call-to-action into a link. */\n  ctaHref?: string;\n  /** Accent colour for the artwork and the button. */\n  accent?: string;\n  /** Freezes every artwork loop. */\n  paused?: boolean;\n  class?: string;\n}\n\nexport interface MotionBentoArtProps {\n  /** Runs the loop. Off-screen or paused bentos pass `false`. */\n  playing?: boolean;\n  /** Shows a finished, static frame (reduced motion). */\n  still?: boolean;\n}\n\nexport interface MotionBentoCardProps {\n  item: MotionBentoItem;\n  playing: boolean;\n  still: boolean;\n}\n\nexport interface MotionBentoArtSlotProps {\n  item: MotionBentoItem;\n  index: number;\n  playing: boolean;\n  still: boolean;\n}\n\nexport interface MotionBentoProduct {\n  name: string;\n  price: string;\n  icon: string;\n  tint: string;\n  ink: string;\n}\n\nexport interface MotionBentoPose {\n  x: number;\n  y: number;\n  rotate: number;\n  scale: number;\n  z: number;\n}\n\nexport interface MotionBentoSatellite {\n  icon: string;\n  color: string;\n  x: number;\n  y: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/types.ts"
    },
    {
      "path": "registry/new-york/motion-bento/use-bento-clock.ts",
      "content": "import { ref, watch } from 'vue';\nimport type { Ref } from 'vue';\nimport { useIntervalFn } from '@vueuse/core';\n\n/** Counts up every `interval` ms while `playing()` is true. */\nexport function useBentoClock(\n  playing: () => boolean,\n  interval: number,\n): Ref<number> {\n  const tick = ref(0);\n  const { pause, resume } = useIntervalFn(\n    () => {\n      tick.value += 1;\n    },\n    interval,\n    { immediate: false },\n  );\n\n  watch(\n    playing,\n    (on) => {\n      if (on) resume();\n      else pause();\n    },\n    { immediate: true },\n  );\n\n  return tick;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/motion-bento/use-bento-clock.ts"
    }
  ]
}
