{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "text-loop",
  "type": "registry:ui",
  "title": "Text Loop",
  "description": "A seamless text marquee along a curved SVG path, with a crossing band, hover pause, drag-to-fling and scroll boost.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/text-loop/TextLoop.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    nextTick,\n    onMounted,\n    shallowRef,\n    useId,\n    useTemplateRef,\n    watch,\n  } from 'vue';\n  import {\n    useEventListener,\n    useIntersectionObserver,\n    usePreferredReducedMotion,\n    useRafFn,\n  } from '@vueuse/core';\n  import {\n    CX,\n    CY,\n    MAX_BOOST,\n    MAX_FLING,\n    VIEW_H,\n    VIEW_W,\n    buildFade,\n    buildPath,\n    circleRadius,\n    clamp,\n    createScaleTween,\n    glideTween,\n    inkOn,\n    tint,\n    tweenValue,\n    wrap,\n  } from './text-loop-geometry';\n  import type { TextLoopMetrics, TextLoopPaint, TextLoopProps } from './types';\n\n  const props = withDefaults(defineProps<TextLoopProps>(), {\n    text: 'Vue ✦ nxui',\n    shape: 'wave',\n    path: undefined,\n    speed: 90,\n    direction: 'forward',\n    separator: '✦',\n    curviness: 90,\n    tilt: 0,\n    fontSize: 46,\n    fontWeight: 800,\n    letterSpacing: 2,\n    uppercase: true,\n    color: undefined,\n    ribbon: true,\n    ribbonColor: '#5227FF',\n    ribbonWidth: 86,\n    edgeFade: 0,\n    pauseOnHover: true,\n    cross: false,\n    crossColor: undefined,\n    crossAngle: 16,\n    draggable: false,\n    scrollBoost: 0,\n    outline: false,\n    outlineWidth: 1.5,\n    class: '',\n  });\n\n  const rootRef = useTemplateRef<HTMLDivElement>('root');\n  const svgRef = useTemplateRef<SVGSVGElement>('svg');\n  const pathRef = useTemplateRef<SVGPathElement>('mainPath');\n  const crossPathRef = useTemplateRef<SVGPathElement>('crossPath');\n  const measureRef = useTemplateRef<SVGTextElement>('measure');\n  const headRef = useTemplateRef<SVGTextPathElement>('head');\n  const tailRef = useTemplateRef<SVGTextPathElement>('tail');\n  const crossHeadRef = useTemplateRef<SVGTextPathElement>('crossHead');\n  const crossTailRef = useTemplateRef<SVGTextPathElement>('crossTail');\n\n  const metrics = shallowRef<TextLoopMetrics>({\n    length: 0,\n    reps: 1,\n    crossLength: 0,\n    crossReps: 1,\n  });\n\n  const pathId = `text-loop-${useId().replace(/[^\\w-]/g, '')}`;\n  const crossId = `${pathId}-cross`;\n  const fadeId = `${pathId}-fade`;\n  const maskId = `${pathId}-mask`;\n  const shadowId = `${pathId}-shadow`;\n  const underId = `${pathId}-under`;\n\n  const custom = computed(() => Boolean(props.path));\n  const d = computed(\n    () =>\n      props.path || buildPath(props.shape, props.curviness, props.ribbonWidth),\n  );\n  const crossD = computed(() => {\n    if (!props.cross) return '';\n    if (props.path) return props.path;\n    const mirrored =\n      props.shape === 'wave' ||\n      props.shape === 'arch' ||\n      props.shape === 'circle';\n    return buildPath(props.shape, props.curviness, props.ribbonWidth, mirrored);\n  });\n  const fade = computed(() => buildFade(props.edgeFade));\n  const fill = computed(\n    () => props.color || (props.ribbon ? '#ffffff' : 'currentColor'),\n  );\n\n  const mainAngle = computed(\n    () => props.tilt + (props.cross ? props.crossAngle / 2 : 0),\n  );\n  const crossAngleDeg = computed(\n    () => props.tilt - (props.cross ? props.crossAngle / 2 : 0),\n  );\n  const mainTransform = computed(() =>\n    mainAngle.value ? `rotate(${mainAngle.value} ${CX} ${CY})` : undefined,\n  );\n  const crossTransform = computed(() =>\n    crossAngleDeg.value\n      ? `rotate(${crossAngleDeg.value} ${CX} ${CY})`\n      : undefined,\n  );\n  const crossTape = computed(\n    () => props.crossColor || tint(props.ribbonColor, 0.62),\n  );\n  const crossFill = computed(() =>\n    props.ribbon ? inkOn(crossTape.value) : props.crossColor || 'currentColor',\n  );\n  const crossDim = computed(() =>\n    !props.ribbon && !props.crossColor ? 0.45 : 1,\n  );\n\n  const unit = computed(() => {\n    const base = props.uppercase ? props.text.toUpperCase() : props.text;\n    const gap = props.separator\n      ? `\\u00A0${props.separator}\\u00A0`\n      : '\\u00A0\\u00A0\\u00A0';\n    return `${base}${gap}`;\n  });\n\n  const textStyle = computed(() => ({\n    fontSize: `${props.fontSize}px`,\n    fontWeight: props.fontWeight,\n    letterSpacing: `${props.letterSpacing}px`,\n  }));\n\n  const loopText = computed(() => unit.value.repeat(metrics.value.reps));\n  const crossText = computed(() => unit.value.repeat(metrics.value.crossReps));\n  const fitLength = computed(() => metrics.value.length || undefined);\n  const crossFit = computed(() => metrics.value.crossLength || undefined);\n\n  function paint(ink: string, opacity: number): TextLoopPaint {\n    return props.outline\n      ? {\n          fill: 'none',\n          stroke: ink,\n          'stroke-opacity': opacity,\n          'stroke-width': props.outlineWidth,\n          'stroke-linejoin': 'round',\n        }\n      : { fill: ink, 'fill-opacity': opacity };\n  }\n  const mainPaint = computed(() => paint(fill.value, 1));\n  const crossPaint = computed(() => paint(crossFill.value, crossDim.value));\n\n  // ---- measurement -------------------------------------------------------\n  function measure() {\n    const pathEl = pathRef.value;\n    const measureEl = measureRef.value;\n    if (!pathEl || !measureEl) return;\n    let length = 0;\n    let unitWidth = 0;\n    let crossLength = 0;\n    try {\n      length = pathEl.getTotalLength();\n      unitWidth = measureEl.getComputedTextLength();\n      crossLength = crossPathRef.value\n        ? crossPathRef.value.getTotalLength()\n        : 0;\n    } catch {\n      return;\n    }\n    if (!length) return;\n    const repsFor = (total: number) =>\n      unitWidth > 0 ? Math.max(1, Math.round(total / unitWidth)) : 1;\n    const prev = metrics.value;\n    const next: TextLoopMetrics = {\n      length,\n      reps: repsFor(length),\n      crossLength,\n      crossReps: repsFor(crossLength),\n    };\n    if (\n      prev.length === next.length &&\n      prev.reps === next.reps &&\n      prev.crossLength === next.crossLength &&\n      prev.crossReps === next.crossReps\n    ) {\n      return;\n    }\n    metrics.value = next;\n  }\n\n  // ---- motion state ------------------------------------------------------\n  const reducedMotion = usePreferredReducedMotion();\n  const reduced = computed(() => reducedMotion.value === 'reduce');\n  const hover = createScaleTween();\n  let progress = 0;\n  let travel = 0;\n  let fling = 0;\n  let boost = 0;\n  let scrollVelocity = 0;\n  let scrollAt = 0;\n  let scrollPos = 0;\n  let scrollSource: EventTarget | null = null;\n  let dragging = false;\n  let pointerId: number | null = null;\n  let lastX = 0;\n  let lastY = 0;\n  let lastT = 0;\n  let velocity = 0;\n  let center = { x: 0, y: 0 };\n\n  const sign = computed(() => (props.direction === 'reverse' ? -1 : 1));\n  const base = computed(() =>\n    reduced.value ? 0 : Math.max(0, props.speed) * sign.value,\n  );\n  const boosting = computed(() => props.scrollBoost > 0 && !reduced.value);\n  const hoverScale = () => tweenValue(hover, performance.now());\n\n  function apply() {\n    const { length, crossLength } = metrics.value;\n    const head = headRef.value;\n    const tail = tailRef.value;\n    if (!head || !tail || !length) return;\n    const offset = wrap(travel, length);\n    progress = offset / length;\n    head.setAttribute('startOffset', String(offset));\n    tail.setAttribute('startOffset', String(offset - length));\n    const crossHead = crossHeadRef.value;\n    const crossTail = crossTailRef.value;\n    if (props.cross && crossHead && crossTail && crossLength > 0) {\n      const crossOffset = wrap(-travel, crossLength);\n      crossHead.setAttribute('startOffset', String(crossOffset));\n      crossTail.setAttribute('startOffset', String(crossOffset - crossLength));\n    }\n  }\n\n  const ticker = useRafFn(\n    ({ delta }) => {\n      if (dragging) return;\n      const dt = Math.min(0.05, delta / 1000);\n      fling *= Math.exp(-dt / 0.55);\n      if (boosting.value) {\n        if (performance.now() - scrollAt > 90) {\n          scrollVelocity *= Math.exp(-dt / 0.12);\n        }\n        const target = clamp(\n          scrollVelocity * props.scrollBoost * 0.35 * sign.value,\n          -MAX_BOOST,\n          MAX_BOOST,\n        );\n        boost += (target - boost) * (1 - Math.exp(-dt / 0.18));\n      }\n      const v = base.value * hoverScale() + fling + boost;\n      if (Math.abs(v) < 0.01) return;\n      travel += v * dt;\n      apply();\n    },\n    { immediate: false },\n  );\n\n  const visible = shallowRef(false);\n  useIntersectionObserver(rootRef, ([entry]) => {\n    visible.value = Boolean(entry?.isIntersecting);\n  });\n\n  watch(\n    [visible, reduced, () => metrics.value.length],\n    ([isVisible, isReduced, length]) => {\n      if (isVisible && !isReduced && length > 0) ticker.resume();\n      else ticker.pause();\n    },\n  );\n\n  // ---- interactions --------------------------------------------------------\n  useEventListener(rootRef, 'pointerenter', (event: PointerEvent) => {\n    if (!props.pauseOnHover || event.pointerType === 'touch') return;\n    glideTween(hover, true, performance.now());\n  });\n  useEventListener(rootRef, 'pointerleave', () => {\n    if (!props.pauseOnHover) return;\n    glideTween(hover, false, performance.now());\n  });\n\n  function onDown(event: PointerEvent) {\n    if (!props.draggable) return;\n    if (event.pointerType === 'mouse' && event.button !== 0) return;\n    const root = rootRef.value;\n    const svg = svgRef.value;\n    if (!root || !svg) return;\n    dragging = true;\n    pointerId = event.pointerId;\n    root.setPointerCapture?.(event.pointerId);\n    lastX = event.clientX;\n    lastY = event.clientY;\n    lastT = performance.now();\n    velocity = base.value * hoverScale() + fling + boost;\n    const rect = svg.getBoundingClientRect();\n    center = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };\n    root.style.cursor = 'grabbing';\n  }\n\n  function onMove(event: PointerEvent) {\n    if (!dragging || event.pointerId !== pointerId) return;\n    const svg = svgRef.value;\n    if (!svg) return;\n    const now = performance.now();\n    let delta: number;\n    if (!custom.value && props.shape === 'circle') {\n      let turn =\n        Math.atan2(event.clientY - center.y, event.clientX - center.x) -\n        Math.atan2(lastY - center.y, lastX - center.x);\n      if (turn > Math.PI) turn -= Math.PI * 2;\n      if (turn < -Math.PI) turn += Math.PI * 2;\n      delta = turn * circleRadius(props.curviness, props.ribbonWidth);\n    } else {\n      const angle = (mainAngle.value * Math.PI) / 180;\n      const scale = VIEW_W / (svg.getBoundingClientRect().width || VIEW_W);\n      delta =\n        ((event.clientX - lastX) * Math.cos(angle) +\n          (event.clientY - lastY) * Math.sin(angle)) *\n        scale;\n    }\n    travel += delta;\n    apply();\n    const dt = Math.max(1, now - lastT) / 1000;\n    velocity = velocity * 0.6 + (delta / dt) * 0.4;\n    lastX = event.clientX;\n    lastY = event.clientY;\n    lastT = now;\n  }\n\n  function onUp(event: PointerEvent) {\n    if (!dragging || event.pointerId !== pointerId) return;\n    dragging = false;\n    pointerId = null;\n    if (rootRef.value) rootRef.value.style.cursor = '';\n    if (reduced.value) return;\n    const release =\n      performance.now() - lastT > 90\n        ? 0\n        : clamp(velocity, -MAX_FLING, MAX_FLING);\n    fling = release - (base.value * hoverScale() + boost);\n  }\n\n  useEventListener(rootRef, 'pointerdown', onDown);\n  useEventListener(rootRef, 'pointermove', onMove);\n  useEventListener(rootRef, 'pointerup', onUp);\n  useEventListener(rootRef, 'pointercancel', onUp);\n\n  function onScroll(event: Event) {\n    if (!boosting.value) return;\n    const root = rootRef.value;\n    const source = event.target;\n    if (!root || !source) return;\n    const isPage =\n      source === document ||\n      source === document.documentElement ||\n      source === document.body;\n    if (!isPage && !(source instanceof Node && source.contains(root))) return;\n    const pos = isPage\n      ? window.scrollY\n      : source instanceof Element\n        ? source.scrollTop\n        : 0;\n    const now = performance.now();\n    if (source !== scrollSource || now - scrollAt > 200) {\n      scrollSource = source;\n      scrollPos = pos;\n      scrollAt = now;\n      return;\n    }\n    const instant = (pos - scrollPos) / (Math.max(8, now - scrollAt) / 1000);\n    scrollVelocity = scrollVelocity * 0.5 + instant * 0.5;\n    scrollPos = pos;\n    scrollAt = now;\n  }\n  useEventListener('scroll', onScroll, { capture: true, passive: true });\n\n  // Upstream rebuilds its effect on these changes, which drops any\n  // in-flight hover pause, throw or scroll push.\n  watch(\n    () => props.pauseOnHover,\n    () => {\n      Object.assign(hover, createScaleTween());\n    },\n  );\n  watch(\n    () => props.scrollBoost,\n    () => {\n      boost = 0;\n      scrollVelocity = 0;\n    },\n  );\n  watch(\n    () => props.draggable,\n    (on) => {\n      if (on || !dragging) return;\n      dragging = false;\n      pointerId = null;\n      if (rootRef.value) rootRef.value.style.cursor = '';\n    },\n  );\n\n  onMounted(() => {\n    measure();\n    document.fonts?.ready.then(measure).catch(() => {});\n    apply();\n  });\n\n  watch(\n    [\n      d,\n      crossD,\n      unit,\n      () => props.fontSize,\n      () => props.fontWeight,\n      () => props.letterSpacing,\n    ],\n    () => {\n      measure();\n      document.fonts?.ready.then(measure).catch(() => {});\n    },\n    { flush: 'post' },\n  );\n\n  watch(\n    [() => metrics.value.length, () => props.cross],\n    ([length], [prevLength]) => {\n      if (length && length !== prevLength) travel = progress * length;\n      void nextTick(apply);\n    },\n    { flush: 'post' },\n  );\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    :class=\"[\n      'text-loop',\n      { 'text-loop--draggable': props.draggable },\n      props.class,\n    ]\"\n  >\n    <svg\n      ref=\"svg\"\n      class=\"text-loop-svg\"\n      :viewBox=\"`0 0 ${VIEW_W} ${VIEW_H}`\"\n      preserveAspectRatio=\"xMidYMid meet\"\n      role=\"img\"\n      :aria-label=\"props.text\"\n    >\n      <defs>\n        <linearGradient\n          v-if=\"fade.length > 0\"\n          :id=\"fadeId\"\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"1\"\n          y2=\"0\"\n        >\n          <stop\n            v-for=\"(stop, i) in fade\"\n            :key=\"i\"\n            :offset=\"stop.offset\"\n            stop-color=\"#ffffff\"\n            :stop-opacity=\"stop.opacity\"\n          />\n        </linearGradient>\n        <mask\n          v-if=\"fade.length > 0\"\n          :id=\"maskId\"\n          maskUnits=\"userSpaceOnUse\"\n          x=\"0\"\n          y=\"0\"\n          :width=\"VIEW_W\"\n          :height=\"VIEW_H\"\n        >\n          <rect :width=\"VIEW_W\" :height=\"VIEW_H\" :fill=\"`url(#${fadeId})`\" />\n        </mask>\n        <template v-if=\"props.cross && props.ribbon\">\n          <filter\n            :id=\"shadowId\"\n            filterUnits=\"userSpaceOnUse\"\n            :x=\"-VIEW_W\"\n            :y=\"-VIEW_H\"\n            :width=\"VIEW_W * 3\"\n            :height=\"VIEW_H * 3\"\n          >\n            <feGaussianBlur\n              :stdDeviation=\"Math.max(4, props.ribbonWidth * 0.11)\"\n            />\n          </filter>\n          <mask\n            :id=\"underId\"\n            maskUnits=\"userSpaceOnUse\"\n            :x=\"-VIEW_W\"\n            :y=\"-VIEW_H\"\n            :width=\"VIEW_W * 3\"\n            :height=\"VIEW_H * 3\"\n          >\n            <g :transform=\"crossTransform\">\n              <path\n                :d=\"crossD\"\n                fill=\"none\"\n                stroke=\"#ffffff\"\n                :stroke-width=\"props.ribbonWidth\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </g>\n          </mask>\n        </template>\n      </defs>\n\n      <text\n        ref=\"measure\"\n        class=\"text-loop-measure\"\n        :style=\"textStyle\"\n        aria-hidden=\"true\"\n        v-text=\"unit\"\n      />\n\n      <g :mask=\"fade.length > 0 ? `url(#${maskId})` : undefined\">\n        <g v-if=\"props.cross\" :transform=\"crossTransform\">\n          <path\n            :id=\"crossId\"\n            ref=\"crossPath\"\n            :d=\"crossD\"\n            fill=\"none\"\n            :stroke=\"props.ribbon ? crossTape : 'none'\"\n            :stroke-width=\"props.ribbon ? props.ribbonWidth : 0\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <text\n            class=\"text-loop-text\"\n            :style=\"textStyle\"\n            v-bind=\"crossPaint\"\n            dominant-baseline=\"central\"\n            aria-hidden=\"true\"\n            :textLength=\"crossFit\"\n            lengthAdjust=\"spacing\"\n          >\n            <textPath\n              ref=\"crossHead\"\n              :href=\"`#${crossId}`\"\n              v-text=\"crossText\"\n            />\n          </text>\n          <text\n            class=\"text-loop-text\"\n            :style=\"textStyle\"\n            v-bind=\"crossPaint\"\n            dominant-baseline=\"central\"\n            aria-hidden=\"true\"\n            :textLength=\"crossFit\"\n            lengthAdjust=\"spacing\"\n          >\n            <textPath\n              ref=\"crossTail\"\n              :href=\"`#${crossId}`\"\n              v-text=\"crossText\"\n            />\n          </text>\n        </g>\n\n        <g v-if=\"props.cross && props.ribbon\" :mask=\"`url(#${underId})`\">\n          <g\n            :filter=\"`url(#${shadowId})`\"\n            :transform=\"`translate(0 ${Math.max(4, props.ribbonWidth * 0.08)})`\"\n          >\n            <g :transform=\"mainTransform\">\n              <path\n                :d=\"d\"\n                fill=\"none\"\n                stroke=\"#000000\"\n                :stroke-opacity=\"0.42\"\n                :stroke-width=\"props.ribbonWidth\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </g>\n          </g>\n        </g>\n\n        <g :transform=\"mainTransform\">\n          <path\n            :id=\"pathId\"\n            ref=\"mainPath\"\n            :d=\"d\"\n            fill=\"none\"\n            :stroke=\"props.ribbon ? props.ribbonColor : 'none'\"\n            :stroke-width=\"props.ribbon ? props.ribbonWidth : 0\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <text\n            class=\"text-loop-text\"\n            :style=\"textStyle\"\n            v-bind=\"mainPaint\"\n            dominant-baseline=\"central\"\n            aria-hidden=\"true\"\n            :textLength=\"fitLength\"\n            lengthAdjust=\"spacing\"\n          >\n            <textPath ref=\"head\" :href=\"`#${pathId}`\" v-text=\"loopText\" />\n          </text>\n          <text\n            class=\"text-loop-text\"\n            :style=\"textStyle\"\n            v-bind=\"mainPaint\"\n            dominant-baseline=\"central\"\n            aria-hidden=\"true\"\n            :textLength=\"fitLength\"\n            lengthAdjust=\"spacing\"\n          >\n            <textPath ref=\"tail\" :href=\"`#${pathId}`\" v-text=\"loopText\" />\n          </text>\n        </g>\n      </g>\n    </svg>\n  </div>\n</template>\n\n<style scoped>\n  .text-loop {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n  }\n\n  .text-loop--draggable {\n    cursor: grab;\n    touch-action: pan-y;\n  }\n\n  .text-loop-svg {\n    display: block;\n    width: 100%;\n    height: auto;\n  }\n\n  .text-loop-text {\n    user-select: none;\n  }\n\n  .text-loop-measure {\n    visibility: hidden;\n    pointer-events: none;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/text-loop/TextLoop.vue"
    },
    {
      "path": "registry/new-york/text-loop/index.ts",
      "content": "export { default as TextLoop } from './TextLoop.vue';\nexport type { TextLoopDirection, TextLoopProps, TextLoopShape } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/text-loop/index.ts"
    },
    {
      "path": "registry/new-york/text-loop/text-loop-geometry.ts",
      "content": "import type {\n  TextLoopFadeStop,\n  TextLoopScaleTween as ScaleTween,\n  TextLoopShape,\n} from './types';\n\nexport const VIEW_W = 1200;\nexport const VIEW_H = 520;\nexport const CX = VIEW_W / 2;\nexport const CY = VIEW_H / 2;\nexport const MAX_FLING = 2600;\nexport const MAX_BOOST = 1600;\n\nconst EDGE_PAD = 6;\nconst FADE_STEPS = 8;\n\nconst smootherstep = (t: number): number => t * t * t * (t * (t * 6 - 15) + 10);\n\nexport const clamp = (v: number, min: number, max: number): number =>\n  Math.min(max, Math.max(min, v));\n\nexport const wrap = (v: number, length: number): number =>\n  ((v % length) + length) % length;\n\nexport function circleRadius(curviness: number, ribbonWidth: number): number {\n  return Math.min(\n    90 + Math.max(0, curviness) * 0.95,\n    Math.max(20, CY - Math.max(0, ribbonWidth) / 2 - EDGE_PAD),\n  );\n}\n\nexport function buildPath(\n  shape: TextLoopShape,\n  curviness: number,\n  ribbonWidth: number,\n  mirrored = false,\n): string {\n  const c = Math.max(0, curviness);\n  const room = Math.max(20, CY - Math.max(0, ribbonWidth) / 2 - EDGE_PAD);\n  const flip = mirrored ? -1 : 1;\n\n  switch (shape) {\n    case 'circle': {\n      const r = circleRadius(curviness, ribbonWidth);\n      if (mirrored) {\n        const rx = r * 1.22;\n        const ry = r * 0.42;\n        return `M ${CX - rx} ${CY} A ${rx} ${ry} 0 1 1 ${CX + rx} ${CY} A ${rx} ${ry} 0 1 1 ${CX - rx} ${CY} Z`;\n      }\n      return `M ${CX - r} ${CY} A ${r} ${r} 0 1 1 ${CX + r} ${CY} A ${r} ${r} 0 1 1 ${CX - r} ${CY} Z`;\n    }\n    case 'infinity': {\n      const r = 150 + c * 1.4;\n      const h = Math.min(60 + c * 0.95, room);\n      return [\n        `M ${CX} ${CY}`,\n        `C ${CX + r * 0.55} ${CY - h} ${CX + r} ${CY - h} ${CX + r} ${CY}`,\n        `C ${CX + r} ${CY + h} ${CX + r * 0.55} ${CY + h} ${CX} ${CY}`,\n        `C ${CX - r * 0.55} ${CY - h} ${CX - r} ${CY - h} ${CX - r} ${CY}`,\n        `C ${CX - r} ${CY + h} ${CX - r * 0.55} ${CY + h} ${CX} ${CY}`,\n        'Z',\n      ].join(' ');\n    }\n    case 'arch': {\n      const rise = Math.min(120 + c * 1.1, room * 2) * flip;\n      return `M 120 ${CY + rise / 2} Q ${CX} ${CY - rise * 1.5} ${VIEW_W - 120} ${CY + rise / 2}`;\n    }\n    case 'line':\n      return `M -320 ${CY} L ${VIEW_W + 320} ${CY}`;\n    case 'wave':\n    default: {\n      const a = Math.min(c * 2.2, room * 2) * flip;\n      return `M -320 ${CY} Q -160 ${CY - a} 0 ${CY} T 320 ${CY} T 640 ${CY} T 960 ${CY} T 1280 ${CY} T ${VIEW_W + 320} ${CY}`;\n    }\n  }\n}\n\nexport function buildFade(edgeFade: number): TextLoopFadeStop[] {\n  const width = Math.min(1, Math.max(0, edgeFade)) * 0.3;\n  if (width <= 0) return [];\n  const stops: TextLoopFadeStop[] = [];\n  for (let i = 0; i <= FADE_STEPS; i++) {\n    const t = i / FADE_STEPS;\n    stops.push({ offset: t * width, opacity: smootherstep(t) });\n  }\n  for (let i = FADE_STEPS; i >= 0; i--) {\n    const t = i / FADE_STEPS;\n    stops.push({ offset: 1 - t * width, opacity: smootherstep(t) });\n  }\n  return stops;\n}\n\nfunction parseHex(value: string | undefined): number[] | null {\n  const match = /^#?([\\da-f]{3}|[\\da-f]{6})$/i.exec(String(value ?? '').trim());\n  if (!match?.[1]) return null;\n  const raw = match[1];\n  const hex = raw.length === 3 ? raw.replace(/./g, (ch) => ch + ch) : raw;\n  return [0, 2, 4].map((i) => Number.parseInt(hex.slice(i, i + 2), 16));\n}\n\n/** Mixes a hex color toward white by `amount` (0–1). */\nexport function tint(color: string, amount: number): string {\n  const rgb = parseHex(color);\n  if (!rgb) return color;\n  return `#${rgb\n    .map((v) =>\n      Math.round(v + (255 - v) * amount)\n        .toString(16)\n        .padStart(2, '0'),\n    )\n    .join('')}`;\n}\n\n/** Picks near-black or white ink for legible text on `color`. */\nexport function inkOn(color: string): string {\n  const rgb = parseHex(color);\n  if (!rgb) return '#ffffff';\n  const [r = 0, g = 0, b = 0] = rgb.map((v) => {\n    const c = v / 255;\n    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;\n  });\n  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.2 ? '#120f17' : '#ffffff';\n}\n\n// GSAP's power2 is a cubic curve.\nconst easePower2Out = (t: number): number => 1 - (1 - t) ** 3;\nconst easePower2InOut = (t: number): number =>\n  t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2;\n\nexport function createScaleTween(): ScaleTween {\n  return { from: 1, to: 1, start: 0, duration: 0, ease: easePower2Out };\n}\n\nexport function tweenValue(tween: ScaleTween, now: number): number {\n  if (tween.duration <= 0) return tween.to;\n  const t = clamp((now - tween.start) / tween.duration, 0, 1);\n  return tween.from + (tween.to - tween.from) * tween.ease(t);\n}\n\nexport function glideTween(tween: ScaleTween, hovered: boolean, now: number) {\n  tween.from = tweenValue(tween, now);\n  tween.to = hovered ? 0 : 1;\n  tween.start = now;\n  tween.duration = hovered ? 600 : 900;\n  tween.ease = hovered ? easePower2Out : easePower2InOut;\n}\n",
