      "content": "export { default as PromptBar } from './PromptBar.vue';\nexport {\n  DEFAULT_COMMANDS,\n  DEFAULT_EFFORTS,\n  DEFAULT_MODELS,\n  DEFAULT_SOURCES,\n} from './prompt-bar';\nexport type {\n  PromptBarAttachResult,\n  PromptBarCommand,\n  PromptBarDictateResult,\n  PromptBarModel,\n  PromptBarProps,\n  PromptBarSendDetail,\n  PromptBarSource,\n} from './types';\n",
