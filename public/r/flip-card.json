{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "flip-card",
  "type": "registry:ui",
  "title": "Flip Card",
  "description": "Two-faced card that flips in 3D on a click, drag or flick and settles on a spring.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/flip-card/FlipCard.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n  import { usePreferredReducedMotion } from '@vueuse/core';\n  import { animate, useMotionValue, useSpring } from 'motion-v';\n  import type {\n    FlipCardEmits,\n    FlipCardGrip,\n    FlipCardProps,\n    FlipCardSlots,\n  } from './types';\n\n  const props = withDefaults(defineProps<FlipCardProps>(), {\n    flipped: undefined,\n    defaultFlipped: false,\n    axis: 'y',\n    flipOnClick: true,\n    draggable: true,\n    dragDistance: 0,\n    tilt: true,\n    tiltMax: 12,\n    glare: true,\n    glareOpacity: 0.22,\n    hoverScale: 1.03,\n    perspective: 1100,\n    stiffness: 170,\n    damping: 20,\n    width: 300,\n    height: 400,\n    radius: 22,\n    background: '#27272a',\n    color: '#f5f5f5',\n    shadow: true,\n    shadowColor: '#000000',\n    shadowOpacity: 0.45,\n    disabled: false,\n    ariaLabel: 'Flip card',\n    class: '',\n  });\n\n  const emit = defineEmits<FlipCardEmits>();\n  defineSlots<FlipCardSlots>();\n\n  const SLOP = { fine: 4, coarse: 8 };\n  const TILT_SPRING = { stiffness: 240, damping: 24, mass: 0.6 };\n  const LIFT_SPRING = { stiffness: 320, damping: 26 };\n  const FLING = 0.16;\n  const HISTORY_MS = 90;\n\n  const clamp = (v: number, lo: number, hi: number) =>\n    Math.min(hi, Math.max(lo, v));\n  const snapTo = (deg: number) => Math.round(deg / 180) * 180;\n  const isBack = (deg: number) => Math.abs(Math.round(deg / 180)) % 2 === 1;\n\n  const motionPref = usePreferredReducedMotion();\n  const reduce = computed(() => motionPref.value === 'reduce');\n  const controlled = computed(() => props.flipped !== undefined);\n  const inner = ref(props.defaultFlipped);\n  const dragging = ref(false);\n  const shown = computed(() =>\n    props.flipped !== undefined ? props.flipped : inner.value,\n  );\n\n  const rootRef = ref<HTMLDivElement | null>(null);\n  const rotorRef = ref<HTMLDivElement | null>(null);\n  const shadowRef = ref<HTMLSpanElement | null>(null);\n\n  let shownNow = shown.value;\n  let grip: FlipCardGrip | null = null;\n  let spin: ReturnType<typeof animate> | null = null;\n  let target = shown.value ? 180 : 0;\n\n  const turn = useMotionValue(target);\n  const tiltX = useSpring(0, TILT_SPRING);\n  const tiltY = useSpring(0, TILT_SPRING);\n  const lift = useSpring(1, LIFT_SPRING);\n  const sheen = useSpring(0, LIFT_SPRING);\n  const gx = useMotionValue(50);\n  const gy = useMotionValue(50);\n\n  function render(): void {\n    const rotor = rotorRef.value;\n    if (rotor) {\n      if (reduce.value) {\n        rotor.style.transform = '';\n        rotor.style.removeProperty('--fc-gx');\n        rotor.style.removeProperty('--fc-gy');\n        rotor.style.removeProperty('--fc-sheen');\n      } else {\n        const t = turn.get();\n        const p = props.perspective;\n        rotor.style.transform =\n          props.axis === 'x'\n            ? `perspective(${p}px) scale(${lift.get()}) rotateY(${tiltY.get()}deg) rotateX(${t + tiltX.get()}deg)`\n            : `perspective(${p}px) scale(${lift.get()}) rotateX(${tiltX.get()}deg) rotateY(${t + tiltY.get()}deg)`;\n        rotor.style.setProperty('--fc-gx', `${gx.get()}%`);\n        rotor.style.setProperty('--fc-gy', `${gy.get()}%`);\n        rotor.style.setProperty('--fc-sheen', `${sheen.get()}`);\n      }\n    }\n    const shade = shadowRef.value;\n    if (shade) {\n      const facing = Math.abs(Math.cos((turn.get() * Math.PI) / 180));\n      const spread = 0.08 + 0.92 * facing;\n      shade.style.transform =\n        props.axis === 'x' ? `scaleY(${spread})` : `scaleX(${spread})`;\n      shade.style.opacity = `${0.1 + 0.9 * facing * facing}`;\n    }\n  }\n\n  const unsubs = [turn, tiltX, tiltY, lift, sheen, gx, gy].map((mv) =>\n    mv.on('change', render),\n  );\n\n  function settle(to: number, velocity: number, instant: boolean): void {\n    spin?.stop();\n    target = to;\n    if (instant || reduce.value) turn.jump(to);\n    else\n      spin = animate(turn, to, {\n        type: 'spring',\n        stiffness: props.stiffness,\n        damping: props.damping,\n        velocity,\n        restDelta: 0.05,\n      });\n    const next = isBack(to);\n    if (next === shownNow) return;\n    shownNow = next;\n    if (!controlled.value) inner.value = next;\n    emit('update:flipped', next);\n    emit('flipChange', next);\n  }\n\n  function flip(instant: boolean): void {\n    const base = snapTo(turn.get());\n    settle(isBack(base) ? base - 180 : base + 180, 0, instant);\n  }\n\n  function rest(): void {\n    tiltX.set(0);\n    tiltY.set(0);\n    sheen.set(0);\n    lift.set(1);\n  }\n\n  watch(shown, (value) => {\n    shownNow = value;\n  });\n\n  watch(\n    () => props.flipped,\n    (value) => {\n      if (value === undefined || isBack(target) === value) return;\n      const base = target;\n      spin?.stop();\n      target = isBack(base) ? base - 180 : base + 180;\n      if (reduce.value) turn.jump(target);\n      else\n        spin = animate(turn, target, {\n          type: 'spring',\n          stiffness: props.stiffness,\n          damping: props.damping,\n          restDelta: 0.05,\n        });\n    },\n  );\n\n  watch(\n    () => props.disabled,\n    (value) => {\n      if (value) rest();\n    },\n  );\n\n  watch(\n    [() => props.axis, () => props.perspective, () => props.shadow, reduce],\n    render,\n    { flush: 'post' },\n  );\n\n  function onPointerDown(e: PointerEvent): void {\n    if (props.disabled || e.button !== 0 || grip) return;\n    const el = e.currentTarget;\n    if (el instanceof HTMLElement) {\n      try {\n        el.setPointerCapture(e.pointerId);\n      } catch {\n        // pointer already released\n      }\n    }\n    spin?.stop();\n    grip = {\n      id: e.pointerId,\n      x: e.clientX,\n      y: e.clientY,\n      base: turn.get(),\n      moved: false,\n      slop: e.pointerType === 'touch' ? SLOP.coarse : SLOP.fine,\n      hist: [],\n    };\n    if (!reduce.value) lift.set(props.hoverScale);\n  }\n\n  function onPointerMove(e: PointerEvent): void {\n    const g = grip;\n    if (g && g.id === e.pointerId) {\n      const d = props.axis === 'x' ? e.clientY - g.y : e.clientX - g.x;\n      if (!g.moved) {\n        if (Math.abs(d) < g.slop || !props.draggable || reduce.value) return;\n        g.moved = true;\n        dragging.value = true;\n        tiltX.set(0);\n        tiltY.set(0);\n        sheen.set(0);\n      }\n      const span =\n        props.dragDistance > 0\n          ? props.dragDistance\n          : props.axis === 'x'\n            ? props.height\n            : props.width;\n      const deg = g.base + (props.axis === 'x' ? -1 : 1) * (d / span) * 180;\n      turn.set(deg);\n      const now = performance.now();\n      g.hist.push({ t: now, v: deg });\n      while (g.hist.length > 2 && now - (g.hist[0]?.t ?? now) > HISTORY_MS)\n        g.hist.shift();\n      return;\n    }\n    if (\n      !props.tilt ||\n      reduce.value ||\n      props.disabled ||\n      e.pointerType === 'touch'\n    )\n      return;\n    const el = e.currentTarget;\n    if (!(el instanceof HTMLElement)) return;\n    const r = el.getBoundingClientRect();\n    const px = clamp((e.clientX - r.left) / r.width, 0, 1);\n    const py = clamp((e.clientY - r.top) / r.height, 0, 1);\n    tiltX.set((0.5 - py) * 2 * props.tiltMax);\n    tiltY.set((px - 0.5) * 2 * props.tiltMax);\n    gx.set(px * 100);\n    gy.set(py * 100);\n    sheen.set(1);\n  }\n\n  function release(e: PointerEvent, cancelled: boolean): void {\n    const g = grip;\n    if (!g || g.id !== e.pointerId) return;\n    grip = null;\n    const el = e.currentTarget;\n    if (el instanceof HTMLElement) {\n      try {\n        if (el.hasPointerCapture(e.pointerId))\n          el.releasePointerCapture(e.pointerId);\n      } catch {\n        // capture already gone\n      }\n    }\n    dragging.value = false;\n    if (e.pointerType === 'touch' || !rootRef.value?.matches(':hover')) rest();\n    if (!g.moved) {\n      if (!cancelled && props.flipOnClick) flip(false);\n      else settle(target, 0, false);\n      return;\n    }\n    const here = turn.get();\n    let velocity = 0;\n    const a = g.hist[0];\n    const b = g.hist[g.hist.length - 1];\n    if (!cancelled && a && b && b.t > a.t && performance.now() - b.t < 60)\n      velocity = ((b.v - a.v) / (b.t - a.t)) * 1000;\n    const to = cancelled\n      ? snapTo(g.base)\n      : clamp(\n          snapTo(here + velocity * FLING),\n          snapTo(here) - 180,\n          snapTo(here) + 180,\n        );\n    settle(to, velocity, false);\n  }\n\n  function onPointerUp(e: PointerEvent): void {\n    release(e, false);\n  }\n\n  function onPointerCancel(e: PointerEvent): void {\n    release(e, true);\n  }\n\n  function onPointerEnter(e: PointerEvent): void {\n    if (!reduce.value && !props.disabled && e.pointerType !== 'touch')\n      lift.set(props.hoverScale);\n  }\n\n  function onPointerLeave(): void {\n    if (!grip) rest();\n  }\n\n  function onKeyDown(e: KeyboardEvent): void {\n    if (props.disabled || (e.key !== 'Enter' && e.key !== ' ')) return;\n    e.preventDefault();\n    if (!e.repeat) flip(true);\n  }\n\n  function onClick(e: MouseEvent): void {\n    if (!props.disabled && e.detail === 0) flip(true);\n  }\n\n  onMounted(render);\n\n  onBeforeUnmount(() => {\n    spin?.stop();\n    unsubs.forEach((off) => off());\n  });\n\n  const rootStyle = computed(() => ({\n    '--fc-w': `${props.width}px`,\n    '--fc-h': `${props.height}px`,\n    '--fc-radius': `${props.radius}px`,\n    '--fc-bg': props.background,\n    '--fc-ink': props.color,\n    '--fc-shadow': props.shadowColor,\n    '--fc-shadow-o': `${props.shadowOpacity}`,\n    '--fc-glare': `${props.glareOpacity}`,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    role=\"button\"\n    :tabindex=\"disabled ? -1 : 0\"\n    :aria-pressed=\"shown\"\n    :aria-label=\"ariaLabel\"\n    :aria-disabled=\"disabled || undefined\"\n    :class=\"['flip-card', props.class]\"\n    :data-axis=\"axis\"\n    :data-draggable=\"draggable && !disabled && !reduce ? '' : undefined\"\n    :data-dragging=\"dragging ? '' : undefined\"\n    :data-disabled=\"disabled ? '' : undefined\"\n    :data-fade=\"reduce ? (shown ? 'back' : 'front') : undefined\"\n    :style=\"rootStyle\"\n    @pointerdown=\"onPointerDown\"\n    @pointermove=\"onPointerMove\"\n    @pointerup=\"onPointerUp\"\n    @pointercancel=\"onPointerCancel\"\n    @lostpointercapture=\"onPointerCancel\"\n    @pointerenter=\"onPointerEnter\"\n    @pointerleave=\"onPointerLeave\"\n    @keydown=\"onKeyDown\"\n    @click=\"onClick\"\n    @dragstart.prevent\n  >\n    <span\n      v-if=\"shadow\"\n      ref=\"shadowRef\"\n      class=\"flip-card__shadow\"\n      aria-hidden=\"true\"\n    />\n    <div ref=\"rotorRef\" class=\"flip-card__rotor\">\n      <div\n        class=\"flip-card__face flip-card__face--front\"\n        :aria-hidden=\"shown\"\n        :inert=\"shown\"\n      >\n        <slot name=\"front\" />\n        <span v-if=\"glare\" class=\"flip-card__glare\" aria-hidden=\"true\" />\n      </div>\n      <div\n        class=\"flip-card__face flip-card__face--back\"\n        :aria-hidden=\"!shown\"\n        :inert=\"!shown\"\n      >\n        <slot name=\"back\" />\n        <span v-if=\"glare\" class=\"flip-card__glare\" aria-hidden=\"true\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .flip-card {\n    position: relative;\n    display: inline-block;\n    width: var(--fc-w);\n    max-width: 100%;\n    height: var(--fc-h);\n    border-radius: var(--fc-radius);\n    outline: none;\n    cursor: pointer;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: pan-y;\n  }\n\n  .flip-card:focus-visible {\n    outline: 2px solid var(--ring, currentColor);\n    outline-offset: 4px;\n  }\n\n  .flip-card[data-axis='x'] {\n    touch-action: pan-x;\n  }\n\n  .flip-card[data-draggable] {\n    cursor: grab;\n  }\n\n  .flip-card[data-dragging] {\n    cursor: grabbing;\n  }\n\n  .flip-card[data-disabled] {\n    cursor: default;\n    opacity: 0.6;\n  }\n\n  .flip-card__shadow {\n    position: absolute;\n    inset: 12% 9% -5%;\n    border-radius: var(--fc-radius);\n    background: color-mix(\n      in srgb,\n      var(--fc-shadow) calc(var(--fc-shadow-o) * 100%),\n      transparent\n    );\n    filter: blur(22px);\n    pointer-events: none;\n  }\n\n  .flip-card__rotor {\n    position: absolute;\n    inset: 0;\n    transform-style: preserve-3d;\n  }\n\n  .flip-card__face {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    border-radius: var(--fc-radius);\n    background: var(--fc-bg);\n    color: var(--fc-ink);\n    backface-visibility: hidden;\n    -webkit-backface-visibility: hidden;\n  }\n\n  .flip-card__face :deep(img) {\n    -webkit-user-drag: none;\n  }\n\n  .flip-card__face--back {\n    transform: rotateY(180deg);\n  }\n\n  .flip-card[data-axis='x'] .flip-card__face--back {\n    transform: rotateX(180deg);\n  }\n\n  .flip-card__glare {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(\n      circle farthest-side at var(--fc-gx, 50%) var(--fc-gy, 50%),\n      rgba(255, 255, 255, var(--fc-glare)) 0%,\n      rgba(255, 255, 255, calc(var(--fc-glare) * 0.76)) 12%,\n      rgba(255, 255, 255, calc(var(--fc-glare) * 0.5)) 26%,\n      rgba(255, 255, 255, calc(var(--fc-glare) * 0.28)) 42%,\n      rgba(255, 255, 255, calc(var(--fc-glare) * 0.12)) 60%,\n      rgba(255, 255, 255, calc(var(--fc-glare) * 0.04)) 78%,\n      rgba(255, 255, 255, 0) 100%\n    );\n    opacity: var(--fc-sheen, 0);\n    pointer-events: none;\n  }\n\n  .flip-card[data-fade] .flip-card__face {\n    transform: none;\n    opacity: 0;\n    backface-visibility: visible;\n    -webkit-backface-visibility: visible;\n    transition: opacity 200ms ease;\n  }\n\n  .flip-card[data-fade='front'] .flip-card__face--front,\n  .flip-card[data-fade='back'] .flip-card__face--back {\n    opacity: 1;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/flip-card/FlipCard.vue"
    },
    {
      "path": "registry/new-york/flip-card/index.ts",
      "content": "export { default as FlipCard } from './FlipCard.vue';\nexport type {\n  FlipCardAxis,\n  FlipCardEmits,\n  FlipCardProps,\n  FlipCardSlots,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/flip-card/index.ts"
    },
    {
      "path": "registry/new-york/flip-card/types.ts",
      "content": "export type FlipCardAxis = 'x' | 'y';\n\nexport interface FlipCardProps {\n  /** Controlled state: true shows the back. Omit it to let the card manage itself. */\n  flipped?: boolean;\n  /** Start on the back face. */\n  defaultFlipped?: boolean;\n  /** `y` turns the card sideways, `x` turns it over the top. */\n  axis?: FlipCardAxis;\n  /** A press without movement flips the card. */\n  flipOnClick?: boolean;\n  /** Drag to turn the card by hand. */\n  draggable?: boolean;\n  /** Pixels of drag for a half turn. 0 uses the card width (or height on x). */\n  dragDistance?: number;\n  /** The card leans toward the cursor on hover. */\n  tilt?: boolean;\n  /** Largest tilt angle in degrees. */\n  tiltMax?: number;\n  /** A soft sheen that follows the cursor. */\n  glare?: boolean;\n  /** Strength of the sheen at its centre. */\n  glareOpacity?: number;\n  /** Lift while hovered or held. */\n  hoverScale?: number;\n  /** Viewing distance in px. Smaller is more dramatic. */\n  perspective?: number;\n  /** Stiffness of the flip spring. */\n  stiffness?: number;\n  /** Damping of the flip spring. */\n  damping?: number;\n  /** Card width in px, capped at the parent. */\n  width?: number;\n  /** Card height in px. */\n  height?: number;\n  /** Corner radius in px. */\n  radius?: number;\n  /** Surface of both faces. */\n  background?: string;\n  /** Text colour of both faces. */\n  color?: string;\n  /** Soft shadow beneath the card that narrows as it turns edge on. */\n  shadow?: boolean;\n  shadowColor?: string;\n  shadowOpacity?: number;\n  /** Dimmed, flat and inert. */\n  disabled?: boolean;\n  /** Accessible name. The face is carried by aria-pressed. */\n  ariaLabel?: string;\n  class?: string;\n}\n\nexport interface FlipCardEmits {\n  'update:flipped': [flipped: boolean];\n  flipChange: [flipped: boolean];\n}\n\nexport interface FlipCardSlots {\n  front?: () => unknown;\n  back?: () => unknown;\n}\n\nexport interface FlipCardSample {\n  t: number;\n  v: number;\n}\n\nexport interface FlipCardGrip {\n  id: number;\n  x: number;\n  y: number;\n  base: number;\n  moved: boolean;\n  slop: number;\n  hist: FlipCardSample[];\n}\n",
      "type": "registry:ui",
      "target": "components/ui/flip-card/types.ts"
    }
