{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "depth-carousel",
  "type": "registry:ui",
  "title": "Depth Carousel",
  "description": "Image carousel whose cards recede along a tilted 3D rail, with drag, wheel, keyboard, dot and auto-advance navigation.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/depth-carousel/DepthCarousel.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onBeforeUnmount, onMounted, ref, watch } from 'vue';\n  import {\n    useEventListener,\n    usePreferredReducedMotion,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import { DEPTH_CAROUSEL_ITEMS } from './defaults';\n  import { clamp, resolveEase, wrapIndex } from './depth-ease';\n  import type { ComponentPublicInstance } from 'vue';\n  import type {\n    DepthCarouselDrag,\n    DepthCarouselEmits,\n    DepthCarouselItem,\n    DepthCarouselProps,\n    DepthCarouselSlide,\n  } from './types';\n\n  const props = withDefaults(defineProps<DepthCarouselProps>(), {\n    items: () => DEPTH_CAROUSEL_ITEMS,\n    cardWidth: 300,\n    cardHeight: 380,\n    radius: 18,\n    tint: '#05060a',\n    depth: 220,\n    spread: 90,\n    tilt: 22,\n    tiltDirection: 'right',\n    perspective: 1400,\n    visibleCards: 4,\n    falloff: 0.2,\n    blur: 6,\n    duration: 700,\n    ease: 'power3.out',\n    autoplay: false,\n    autoplayDelay: 3200,\n    loop: true,\n    showControls: true,\n    showIndicators: true,\n    class: '',\n  });\n\n  const emit = defineEmits<DepthCarouselEmits>();\n\n  const normalizeItem = (it: DepthCarouselItem): DepthCarouselSlide =>\n    typeof it === 'string' ? { image: it, alt: '' } : it;\n\n  const data = computed(() =>\n    (Array.isArray(props.items) ? props.items : []).map(normalizeItem),\n  );\n  const count = computed(() => data.value.length);\n  const easeFn = computed(() => resolveEase(props.ease));\n\n  const motionPref = usePreferredReducedMotion();\n  const reduce = computed(() => motionPref.value === 'reduce');\n\n  const rootRef = ref<HTMLDivElement | null>(null);\n  const cardEls: (HTMLElement | null)[] = [];\n  const overlayEls: (HTMLElement | null)[] = [];\n  const active = ref(0);\n\n  let pos = 0;\n  let focusIndex = 0;\n  let scale = 1;\n  let tweenRaf = 0;\n  let drag: DepthCarouselDrag | null = null;\n  let wheelTimer: ReturnType<typeof setTimeout> | null = null;\n  let autoTimer: ReturnType<typeof setInterval> | null = null;\n  let hovered = false;\n  let focused = false;\n\n  function toElement(\n    el: Element | ComponentPublicInstance | null,\n  ): HTMLElement | null {\n    return el instanceof HTMLElement ? el : null;\n  }\n\n  function setCard(el: Element | ComponentPublicInstance | null, i: number) {\n    cardEls[i] = toElement(el);\n  }\n\n  function setOverlay(el: Element | ComponentPublicInstance | null, i: number) {\n    overlayEls[i] = toElement(el);\n  }\n\n  function layout(p: number): void {\n    const n = count.value;\n    if (!n) return;\n    const dir = props.tiltDirection === 'left' ? -1 : 1;\n    const sc = scale;\n    for (let i = 0; i < n; i++) {\n      const el = cardEls[i];\n      if (!el) continue;\n\n      let d = i - p;\n      if (props.loop && n > 1) {\n        d = wrapIndex(d, n);\n        if (d > n / 2) d -= n;\n      }\n\n      const back = Math.max(0, d);\n      const az = Math.abs(d);\n      const shown = az <= props.visibleCards + 0.5;\n\n      const tz = -props.depth * d;\n      const tx = dir * props.spread * d;\n      const ry = dir * props.tilt * clamp(d, 0, 1);\n\n      let opacity = d < 0 ? Math.max(0, 1 + d) : 1;\n      if (!shown) opacity = 0;\n\n      const brightness = Math.max(0.15, 1 - back * props.falloff);\n      const blurPx =\n        props.blur > 0\n          ? Math.min(\n              props.blur,\n              (back / Math.max(1, props.visibleCards)) * props.blur,\n            )\n          : 0;\n      const zi = Math.round(2000 - d * 20);\n\n      el.style.transform = `translate(-50%, -50%) scale(${sc}) translateX(${tx.toFixed(2)}px) translateZ(${tz.toFixed(2)}px) rotateY(${ry.toFixed(3)}deg)`;\n      el.style.opacity = opacity.toFixed(3);\n      el.style.filter = `brightness(${brightness.toFixed(3)}) blur(${blurPx.toFixed(2)}px)`;\n      el.style.zIndex = String(zi);\n      el.style.pointerEvents = shown && opacity > 0.05 ? 'auto' : 'none';\n\n      const ov = overlayEls[i];\n      if (ov) {\n        ov.style.opacity = clamp(back * props.falloff * 1.25, 0, 0.86).toFixed(\n          3,\n        );\n      }\n    }\n  }\n\n  function killTween(): void {\n    if (tweenRaf) cancelAnimationFrame(tweenRaf);\n    tweenRaf = 0;\n  }\n\n  function finishTween(): void {\n    const n = count.value;\n    if (n > 0) pos = wrapIndex(pos, n);\n    layout(pos);\n  }\n\n  function tweenTo(target: number, animate: boolean): void {\n    killTween();\n    const from = pos;\n    const dur = animate && !reduce.value ? props.duration : 0;\n    if (dur <= 0) {\n      pos = target;\n      layout(pos);\n      finishTween();\n      return;\n    }\n    const ease = easeFn.value;\n    const start = performance.now();\n    const step = (now: number) => {\n      const t = clamp((now - start) / dur, 0, 1);\n      pos = from + (target - from) * ease(t);\n      layout(pos);\n      if (t < 1) {\n        tweenRaf = requestAnimationFrame(step);\n      } else {\n        tweenRaf = 0;\n        finishTween();\n      }\n    };\n    tweenRaf = requestAnimationFrame(step);\n  }\n\n  function notify(idx: number): void {\n    active.value = idx;\n    const item = data.value[idx];\n    if (item) emit('change', idx, item);\n  }\n\n  function setFocus(rawIndex: number, animate = true): void {\n    const n = count.value;\n    if (!n) return;\n    const idx = props.loop ? wrapIndex(rawIndex, n) : clamp(rawIndex, 0, n - 1);\n    let delta = idx - pos;\n    if (props.loop && n > 1) {\n      delta = wrapIndex(delta, n);\n      if (delta > n / 2) delta -= n;\n    }\n    tweenTo(pos + delta, animate);\n    if (idx !== focusIndex) {\n      focusIndex = idx;\n      notify(idx);\n    }\n  }\n\n  function navigateBy(step: number): void {\n    setFocus(focusIndex + step, true);\n  }\n\n  const stepPx = () => Math.max(props.cardWidth * 0.55 * scale, 40);\n\n  function onPointerDown(e: PointerEvent): void {\n    if (count.value < 2) return;\n    killTween();\n    drag = {\n      x: e.clientX,\n      startPos: pos,\n      lastX: e.clientX,\n      lastT: performance.now(),\n      v: 0,\n      moved: false,\n      id: e.pointerId,\n    };\n  }\n\n  function onPointerMove(e: PointerEvent): void {\n    if (!drag) return;\n    const dx = e.clientX - drag.x;\n    if (!drag.moved && Math.abs(dx) > 4) {\n      drag.moved = true;\n      rootRef.value?.setPointerCapture(drag.id);\n    }\n    if (!drag.moved) return;\n    const now = performance.now();\n    const dt = Math.max(now - drag.lastT, 1);\n    drag.v = (e.clientX - drag.lastX) / dt;\n    drag.lastX = e.clientX;\n    drag.lastT = now;\n    pos = drag.startPos - dx / stepPx();\n    layout(pos);\n  }\n\n  function onPointerEnd(): void {\n    const d = drag;\n    if (!d) return;\n    drag = null;\n    if (!d.moved) return;\n    const projected = pos - (d.v * 180) / stepPx();\n    setFocus(Math.round(projected), true);\n  }\n\n  function onKeydown(e: KeyboardEvent): void {\n    if (e.key === 'ArrowLeft') {\n      e.preventDefault();\n      navigateBy(-1);\n    } else if (e.key === 'ArrowRight') {\n      e.preventDefault();\n      navigateBy(1);\n    }\n  }\n\n  function onCardClick(index: number): void {\n    if (drag?.moved) return;\n    setFocus(index, true);\n  }\n\n  function onPrev(): void {\n    navigateBy(-1);\n  }\n\n  function onNext(): void {\n    navigateBy(1);\n  }\n\n  function onWheel(e: WheelEvent): void {\n    if (count.value < 2) return;\n    e.preventDefault();\n    killTween();\n    const raw = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;\n    const delta = e.deltaMode === 1 ? raw * 24 : raw;\n    pos += clamp(delta / (props.cardWidth * 0.9), -0.6, 0.6);\n    layout(pos);\n    if (wheelTimer) clearTimeout(wheelTimer);\n    wheelTimer = setTimeout(() => setFocus(Math.round(pos), true), 130);\n  }\n\n  function stopAutoplay(): void {\n    if (autoTimer) clearInterval(autoTimer);\n    autoTimer = null;\n  }\n\n  function startAutoplay(): void {\n    stopAutoplay();\n    if (!props.autoplay || reduce.value || count.value < 2) return;\n    autoTimer = setInterval(\n      () => {\n        if (!hovered && !focused) navigateBy(1);\n      },\n      Math.max(props.autoplayDelay, 600),\n    );\n  }\n\n  function onEnter(): void {\n    hovered = true;\n  }\n  function onLeave(): void {\n    hovered = false;\n  }\n  function onFocusIn(): void {\n    focused = true;\n  }\n  function onFocusOut(): void {\n    focused = false;\n  }\n\n  useEventListener(rootRef, 'wheel', onWheel, { passive: false });\n\n  useResizeObserver(rootRef, (entries) => {\n    const w = entries[0]?.contentRect.width ?? 0;\n    const needed = props.cardWidth + Math.abs(props.spread) * 2 + 120;\n    scale = clamp(w / needed, 0.4, 1);\n    layout(pos);\n  });\n\n  watch(\n    [\n      () => props.depth,\n      () => props.spread,\n      () => props.tilt,\n      () => props.tiltDirection,\n      () => props.visibleCards,\n      () => props.falloff,\n      () => props.blur,\n      () => props.cardWidth,\n      () => props.cardHeight,\n      () => props.radius,\n      () => props.loop,\n      count,\n    ],\n    () => {\n      cardEls.length = count.value;\n      overlayEls.length = count.value;\n      layout(pos);\n    },\n    { flush: 'post' },\n  );\n\n  watch(\n    [() => props.autoplay, () => props.autoplayDelay, count, reduce],\n    startAutoplay,\n  );\n\n  onMounted(() => {\n    layout(pos);\n    startAutoplay();\n  });\n\n  onBeforeUnmount(() => {\n    killTween();\n    if (wheelTimer) clearTimeout(wheelTimer);\n    stopAutoplay();\n  });\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"[\n      'depth-carousel relative flex size-full min-h-80 cursor-grab touch-pan-y items-center justify-center rounded-xl outline-none select-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring active:cursor-grabbing',\n      props.class,\n    ]\"\n    :style=\"{ '--dc-perspective': `${perspective}px` }\"\n    role=\"group\"\n    aria-roledescription=\"carousel\"\n    aria-label=\"Depth carousel\"\n    tabindex=\"0\"\n    @pointerdown=\"onPointerDown\"\n    @pointermove=\"onPointerMove\"\n    @pointerup=\"onPointerEnd\"\n    @pointercancel=\"onPointerEnd\"\n    @keydown=\"onKeydown\"\n    @mouseenter=\"onEnter\"\n    @mouseleave=\"onLeave\"\n    @focusin=\"onFocusIn\"\n    @focusout=\"onFocusOut\"\n  >\n    <div class=\"depth-carousel__stage\">\n      <div\n        v-for=\"(item, i) in data\"\n        :key=\"i\"\n        :ref=\"(el) => setCard(el, i)\"\n        class=\"depth-carousel__card\"\n        :style=\"{\n          width: `${cardWidth}px`,\n          height: `${cardHeight}px`,\n          borderRadius: `${radius}px`,\n        }\"\n        aria-roledescription=\"slide\"\n        :aria-label=\"`${i + 1} of ${count}`\"\n        :aria-hidden=\"active !== i\"\n        @click=\"onCardClick(i)\"\n      >\n        <img\n          class=\"depth-carousel__img\"\n          :src=\"item.image\"\n          :alt=\"item.alt || ''\"\n          draggable=\"false\"\n        />\n        <span\n          :ref=\"(el) => setOverlay(el, i)\"\n          class=\"depth-carousel__tint\"\n          :style=\"{ background: tint }\"\n        />\n      </div>\n    </div>\n\n    <template v-if=\"showControls && count > 1\">\n      <button\n        type=\"button\"\n        class=\"absolute top-1/2 left-4 z-3000 grid size-10.5 -translate-y-1/2 cursor-pointer place-items-center rounded-full border border-border bg-background/55 text-foreground backdrop-blur-sm transition-[background-color,border-color,scale] duration-200 hover:border-foreground/40 hover:bg-background/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:scale-94 motion-reduce:transition-none\"\n        aria-label=\"Previous slide\"\n        @click=\"onPrev\"\n      >\n        <Icon name=\"lucide:chevron-left\" class=\"size-5\" />\n      </button>\n      <button\n        type=\"button\"\n        class=\"absolute top-1/2 right-4 z-3000 grid size-10.5 -translate-y-1/2 cursor-pointer place-items-center rounded-full border border-border bg-background/55 text-foreground backdrop-blur-sm transition-[background-color,border-color,scale] duration-200 hover:border-foreground/40 hover:bg-background/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:scale-94 motion-reduce:transition-none\"\n        aria-label=\"Next slide\"\n        @click=\"onNext\"\n      >\n        <Icon name=\"lucide:chevron-right\" class=\"size-5\" />\n      </button>\n    </template>\n\n    <div\n      v-if=\"showIndicators && count > 1\"\n      class=\"absolute bottom-4 left-1/2 z-3000 flex -translate-x-1/2 gap-2 rounded-full bg-background/40 px-3 py-2 backdrop-blur-sm\"\n      role=\"tablist\"\n      aria-label=\"Slides\"\n    >\n      <button\n        v-for=\"(_, i) in data\"\n        :key=\"i\"\n        type=\"button\"\n        role=\"tab\"\n        :aria-selected=\"active === i\"\n        :aria-label=\"`Go to slide ${i + 1}`\"\n        :class=\"[\n          'h-1.75 cursor-pointer rounded-full p-0 transition-[width,background-color] duration-250 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring motion-reduce:transition-none',\n          active === i ? 'w-5 bg-foreground' : 'w-1.75 bg-foreground/32',\n        ]\"\n        @click=\"setFocus(i, true)\"\n      />\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .depth-carousel {\n    perspective: var(--dc-perspective, 1400px);\n    perspective-origin: 50% 50%;\n    -webkit-user-select: none;\n  }\n\n  .depth-carousel__stage {\n    position: absolute;\n    inset: 0;\n    transform-style: preserve-3d;\n  }\n\n  .depth-carousel__card {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform-origin: center center;\n    overflow: hidden;\n    background: #0b0d12;\n    box-shadow:\n      0 30px 60px -20px rgba(0, 0, 0, 0.65),\n      0 8px 20px -10px rgba(0, 0, 0, 0.5);\n    will-change: transform, opacity, filter;\n    cursor: pointer;\n    transform: translate(-50%, -50%);\n  }\n\n  .depth-carousel__img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    pointer-events: none;\n    -webkit-user-drag: none;\n  }\n\n  .depth-carousel__tint {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    pointer-events: none;\n    mix-blend-mode: multiply;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .depth-carousel__card {\n      will-change: auto;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/depth-carousel/DepthCarousel.vue"
    },
    {
      "path": "registry/new-york/depth-carousel/defaults.ts",
      "content": "import type { DepthCarouselItem } from './types';\n\nexport const DEPTH_CAROUSEL_ITEMS: DepthCarouselItem[] = [\n  { image: 'https://picsum.photos/seed/depth1/800/1000', alt: 'Slide 1' },\n  { image: 'https://picsum.photos/seed/depth2/800/1000', alt: 'Slide 2' },\n  { image: 'https://picsum.photos/seed/depth3/800/1000', alt: 'Slide 3' },\n  { image: 'https://picsum.photos/seed/depth4/800/1000', alt: 'Slide 4' },\n  { image: 'https://picsum.photos/seed/depth5/800/1000', alt: 'Slide 5' },\n  { image: 'https://picsum.photos/seed/depth6/800/1000', alt: 'Slide 6' },\n];\n",
      "type": "registry:ui",
      "target": "components/ui/depth-carousel/defaults.ts"
    },
    {
      "path": "registry/new-york/depth-carousel/depth-ease.ts",
      "content": "import type { DepthCarouselEase } from './types';\n\nconst linear: DepthCarouselEase = (t) => t;\n\nconst POWER: Record<string, number> = {\n  power0: 1,\n  linear: 1,\n  power1: 2,\n  quad: 2,\n  power2: 3,\n  cubic: 3,\n  power3: 4,\n  quart: 4,\n  power4: 5,\n  quint: 5,\n  strong: 5,\n};\n\nfunction baseIn(name: string, arg: number): DepthCarouselEase | null {\n  const power = POWER[name];\n  if (power !== undefined) return (t) => t ** power;\n  switch (name) {\n    case 'sine':\n      return (t) => 1 - Math.cos((t * Math.PI) / 2);\n    case 'expo':\n      return (t) => (t <= 0 ? 0 : 2 ** (10 * (t - 1)));\n    case 'circ':\n      return (t) => 1 - Math.sqrt(1 - t * t);\n    case 'back': {\n      const s = Number.isFinite(arg) ? arg : 1.70158;\n      return (t) => t * t * ((s + 1) * t - s);\n    }\n    default:\n      return null;\n  }\n}\n\n/**\n * Resolves a GSAP ease string (`power3.out`, `expo.inOut`, `back.out(1.4)`,\n * `none`) to an easing function. Unknown names fall back to `power3.out`.\n */\nexport function resolveEase(ease: string): DepthCarouselEase {\n  const match =\n    /^\\s*([a-z0-9]+)(?:\\.(in|out|inout))?(?:\\(([-\\d.]+)\\))?\\s*$/i.exec(ease);\n  if (!match) return resolveEase('power3.out');\n  const name = (match[1] ?? '').toLowerCase();\n  if (name === 'none') return linear;\n  const type = (match[2] ?? 'out').toLowerCase();\n  const easeIn = baseIn(name, Number.parseFloat(match[3] ?? ''));\n  if (!easeIn)\n    return ease === 'power3.out' ? linear : resolveEase('power3.out');\n  if (type === 'in') return easeIn;\n  if (type === 'out') return (t) => 1 - easeIn(1 - t);\n  return (t) => (t < 0.5 ? easeIn(t * 2) / 2 : 1 - easeIn((1 - t) * 2) / 2);\n}\n\nexport const clamp = (v: number, min: number, max: number): number =>\n  Math.min(Math.max(v, min), max);\n\nexport const wrapIndex = (v: number, n: number): number => ((v % n) + n) % n;\n",
      "type": "registry:ui",
      "target": "components/ui/depth-carousel/depth-ease.ts"
    },
    {
      "path": "registry/new-york/depth-carousel/index.ts",
      "content": "export { default as DepthCarousel } from './DepthCarousel.vue';\nexport type {\n  DepthCarouselEmits,\n  DepthCarouselItem,\n  DepthCarouselProps,\n  DepthCarouselSlide,\n  DepthCarouselTiltDirection,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/depth-carousel/index.ts"
    },
    {
      "path": "registry/new-york/depth-carousel/types.ts",
      "content": "export interface DepthCarouselSlide {\n  image: string;\n  alt?: string;\n}\n\nexport type DepthCarouselItem = string | DepthCarouselSlide;\n\nexport type DepthCarouselTiltDirection = 'left' | 'right';\n\nexport interface DepthCarouselProps {\n  /** Slides to display: image URLs or objects with an image URL and alt text. */\n  items?: DepthCarouselItem[];\n  /** Width of each card in px. */\n  cardWidth?: number;\n  /** Height of each card in px. */\n  cardHeight?: number;\n  /** Corner rounding of the cards in px. */\n  radius?: number;\n  /** Colour multiplied over cards as they recede. */\n  tint?: string;\n  /** Z distance in px between cards along the depth rail. */\n  depth?: number;\n  /** Lateral offset in px applied per card. */\n  spread?: number;\n  /** Degrees each receding card rotates around the vertical axis. */\n  tilt?: number;\n  /** Which side the stack fans and tilts toward. */\n  tiltDirection?: DepthCarouselTiltDirection;\n  /** CSS perspective in px. */\n  perspective?: number;\n  /** How many cards deep stay visible before further ones fade out. */\n  visibleCards?: number;\n  /** How quickly brightness, tint and blur ramp up with depth. */\n  falloff?: number;\n  /** Maximum blur in px on the furthest visible card. */\n  blur?: number;\n  /** Length of the advance transition in ms. */\n  duration?: number;\n  /** GSAP-style easing name, e.g. `power3.out`, `expo.out`, `back.out(1.4)`, `none`. */\n  ease?: string;\n  /** Auto-advance, pausing on hover or focus. */\n  autoplay?: boolean;\n  /** Delay between auto-advances in ms. */\n  autoplayDelay?: number;\n  /** Wrap from the last card back to the first. */\n  loop?: boolean;\n  /** Show the previous and next arrow buttons. */\n  showControls?: boolean;\n  /** Show the dot indicators. */\n  showIndicators?: boolean;\n  class?: string;\n}\n\nexport interface DepthCarouselEmits {\n  change: [index: number, item: DepthCarouselSlide];\n}\n\nexport interface DepthCarouselDrag {\n  x: number;\n  startPos: number;\n  lastX: number;\n  lastT: number;\n  v: number;\n  moved: boolean;\n  id: number;\n}\n\nexport type DepthCarouselEase = (t: number) => number;\n",
      "type": "registry:ui",
      "target": "components/ui/depth-carousel/types.ts"
    }
  ]
}
