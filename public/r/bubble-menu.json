{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "bubble-menu",
  "type": "registry:ui",
  "title": "Bubble Menu",
  "description": "A logo bubble and round menu button that pop open large tilted pill links with a staggered scale-in.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/bubble-menu/BubbleMenu.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, nextTick, onBeforeUnmount, ref, watch } from 'vue';\n  import { animate } from 'motion-v';\n  import { usePreferredReducedMotion } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import {\n    BUBBLE_MENU_DEFAULT_ITEMS,\n    BUBBLE_MENU_EASES,\n    power3In,\n    power3Out,\n  } from './bubble-menu-presets';\n  import type {\n    BubbleMenuItem,\n    BubbleMenuProps,\n    BubbleMenuTweenOptions,\n  } from './types';\n\n  const props = withDefaults(defineProps<BubbleMenuProps>(), {\n    logo: '',\n    menuAriaLabel: 'Toggle menu',\n    menuBg: '#fff',\n    menuContentColor: '#111',\n    useFixedPosition: false,\n    items: () => BUBBLE_MENU_DEFAULT_ITEMS,\n    animationEase: 'back.out(1.5)',\n    animationDuration: 0.5,\n    staggerDelay: 0.12,\n    class: '',\n  });\n\n  const emit = defineEmits<{ 'menu-click': [open: boolean] }>();\n\n  const isOpen = ref(false);\n  const showOverlay = ref(false);\n  const overlayRef = ref<HTMLDivElement>();\n  const motionPreference = usePreferredReducedMotion();\n  const running: ReturnType<typeof animate>[] = [];\n\n  const menuItems = computed(() =>\n    props.items.length ? props.items : BUBBLE_MENU_DEFAULT_ITEMS,\n  );\n  const position = computed(() =>\n    props.useFixedPosition ? 'fixed' : 'absolute',\n  );\n\n  function handleToggle() {\n    const next = !isOpen.value;\n    if (next) showOverlay.value = true;\n    isOpen.value = next;\n    emit('menu-click', next);\n  }\n\n  function pillStyle(item: BubbleMenuItem) {\n    return {\n      '--item-rot': `${item.rotation ?? 0}deg`,\n      '--pill-bg': props.menuBg,\n      '--pill-color': props.menuContentColor,\n      '--hover-bg': item.hoverStyles?.bgColor || '#f3f4f6',\n      '--hover-color': item.hoverStyles?.textColor || props.menuContentColor,\n    };\n  }\n\n  function stopAll() {\n    running.splice(0).forEach((controls) => controls.stop());\n  }\n\n  function setBubble(el: HTMLElement, scale: number) {\n    el.style.scale = String(scale);\n  }\n\n  function setLabel(el: HTMLElement, progress: number) {\n    el.style.translate = `0 ${(1 - progress) * 24}px`;\n    el.style.opacity = String(progress);\n    el.style.visibility = progress <= 0 ? 'hidden' : 'inherit';\n  }\n\n  function tween(from: number, to: number, options: BubbleMenuTweenOptions) {\n    running.push(animate(from, to, options));\n  }\n\n  function play() {\n    const overlay = overlayRef.value;\n    if (!overlay) return;\n    const bubbles = Array.from(\n      overlay.querySelectorAll<HTMLElement>('.pill-link'),\n    );\n    const labels = Array.from(\n      overlay.querySelectorAll<HTMLElement>('.pill-label'),\n    );\n    if (!bubbles.length) return;\n    stopAll();\n    const reduce = motionPreference.value === 'reduce';\n\n    if (isOpen.value) {\n      const duration = Math.max(0, props.animationDuration);\n      const ease = BUBBLE_MENU_EASES[props.animationEase];\n      bubbles.forEach((bubble, i) => {\n        const label = labels[i];\n        if (reduce) {\n          setBubble(bubble, 1);\n          if (label) setLabel(label, 1);\n          return;\n        }\n        setBubble(bubble, 0);\n        if (label) setLabel(label, 0);\n        const delay = Math.max(\n          0,\n          i * props.staggerDelay + (Math.random() * 0.1 - 0.05),\n        );\n        tween(0, 1, {\n          duration,\n          delay,\n          ease,\n          onUpdate: (v) => setBubble(bubble, v),\n        });\n        if (label) {\n          tween(0, 1, {\n            duration,\n            delay: delay + duration * 0.1,\n            ease: power3Out,\n            onUpdate: (v) => setLabel(label, v),\n          });\n        }\n      });\n    } else if (showOverlay.value) {\n      if (reduce) {\n        showOverlay.value = false;\n        return;\n      }\n      labels.forEach((label) => {\n        const from = Number(label.style.opacity || 1);\n        tween(from, 0, {\n          duration: 0.2,\n          ease: power3In,\n          onUpdate: (v) => setLabel(label, v),\n        });\n      });\n      bubbles.forEach((bubble, i) => {\n        const from = Number(bubble.style.scale || 1);\n        tween(from, 0, {\n          duration: 0.2,\n          ease: power3In,\n          onUpdate: (v) => setBubble(bubble, v),\n          onComplete:\n            i === bubbles.length - 1\n              ? () => {\n                  showOverlay.value = false;\n                }\n              : undefined,\n        });\n      });\n    }\n  }\n\n  watch(\n    [\n      isOpen,\n      showOverlay,\n      () => props.animationEase,\n      () => props.animationDuration,\n      () => props.staggerDelay,\n    ],\n    () => nextTick(play),\n    { flush: 'post' },\n  );\n\n  onBeforeUnmount(stopAll);\n</script>\n\n<template>\n  <nav\n    :class=\"cn('bubble-menu', position, props.class)\"\n    aria-label=\"Main navigation\"\n  >\n    <div\n      class=\"bubble logo-bubble\"\n      aria-label=\"Logo\"\n      :style=\"{ background: menuBg }\"\n    >\n      <span class=\"logo-content\">\n        <slot name=\"logo\">\n          <img v-if=\"logo\" :src=\"logo\" alt=\"Logo\" class=\"bubble-logo\" />\n        </slot>\n      </span>\n    </div>\n\n    <button\n      type=\"button\"\n      :class=\"['bubble toggle-bubble menu-btn', { open: isOpen }]\"\n      :aria-label=\"menuAriaLabel\"\n      :aria-pressed=\"isOpen\"\n      :style=\"{ background: menuBg }\"\n      @click=\"handleToggle\"\n    >\n      <span class=\"menu-line\" :style=\"{ background: menuContentColor }\" />\n      <span class=\"menu-line short\" :style=\"{ background: menuContentColor }\" />\n    </button>\n  </nav>\n  <div\n    v-if=\"showOverlay\"\n    ref=\"overlayRef\"\n    :class=\"['bubble-menu-items', position]\"\n    :aria-hidden=\"!isOpen\"\n  >\n    <ul class=\"pill-list\" role=\"menu\" aria-label=\"Menu links\">\n      <li\n        v-for=\"(item, idx) in menuItems\"\n        :key=\"idx\"\n        role=\"none\"\n        class=\"pill-col\"\n      >\n        <a\n          role=\"menuitem\"\n          :href=\"item.href\"\n          :aria-label=\"item.ariaLabel || item.label\"\n          class=\"pill-link\"\n          :style=\"pillStyle(item)\"\n        >\n          <span class=\"pill-label\">{{ item.label }}</span>\n        </a>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<style scoped>\n  .bubble-menu {\n    left: 0;\n    right: 0;\n    top: 2em;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 0 2em;\n    pointer-events: none;\n    z-index: 99;\n  }\n\n  .bubble-menu.fixed {\n    position: fixed;\n  }\n\n  .bubble-menu.absolute {\n    position: absolute;\n  }\n\n  .bubble-menu .bubble {\n    --bubble-size: 48px;\n    width: var(--bubble-size);\n    height: var(--bubble-size);\n    border-radius: 50%;\n    background: #fff;\n    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    pointer-events: auto;\n  }\n\n  .bubble-menu .logo-bubble,\n  .bubble-menu .toggle-bubble {\n    will-change: transform;\n  }\n\n  .bubble-menu .logo-bubble {\n    width: auto;\n    min-height: var(--bubble-size);\n    height: var(--bubble-size);\n    padding: 0 16px;\n    border-radius: calc(var(--bubble-size) / 2);\n    gap: 8px;\n  }\n\n  .bubble-menu .toggle-bubble {\n    width: var(--bubble-size);\n    height: var(--bubble-size);\n  }\n\n  .bubble-menu .bubble-logo {\n    max-height: 60%;\n    max-width: 100%;\n    object-fit: contain;\n    display: block;\n  }\n\n  .bubble-menu .logo-content {\n    --logo-max-height: 60%;\n    --logo-max-width: 100%;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 120px;\n    height: 100%;\n  }\n\n  .bubble-menu .logo-content > :deep(.bubble-logo),\n  .bubble-menu .logo-content > :deep(img),\n  .bubble-menu .logo-content > :deep(svg) {\n    max-height: var(--logo-max-height);\n    max-width: var(--logo-max-width);\n  }\n\n  .bubble-menu .menu-btn {\n    border: none;\n    background: #fff;\n    cursor: pointer;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n  }\n\n  .bubble-menu .menu-btn:focus-visible {\n    outline: 2px solid var(--ring);\n    outline-offset: 2px;\n  }\n\n  .bubble-menu .menu-line {\n    width: 26px;\n    height: 2px;\n    background: #111;\n    border-radius: 2px;\n    display: block;\n    margin: 0 auto;\n    transition:\n      transform 0.3s ease,\n      opacity 0.3s ease;\n    transform-origin: center;\n  }\n\n  .bubble-menu .menu-line + .menu-line {\n    margin-top: 6px;\n  }\n\n  .bubble-menu .menu-btn.open .menu-line:first-child {\n    transform: translateY(4px) rotate(45deg);\n  }\n\n  .bubble-menu .menu-btn.open .menu-line:last-child {\n    transform: translateY(-4px) rotate(-45deg);\n  }\n\n  @media (min-width: 768px) {\n    .bubble-menu .bubble {\n      --bubble-size: 56px;\n    }\n\n    .bubble-menu .logo-bubble {\n      padding: 0 16px;\n    }\n  }\n\n  .bubble-menu-items {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    pointer-events: none;\n    z-index: 98;\n  }\n\n  .bubble-menu-items.fixed {\n    position: fixed;\n  }\n\n  .bubble-menu-items.absolute {\n    position: absolute;\n  }\n\n  .bubble-menu-items .pill-list {\n    list-style: none;\n    margin: 0;\n    padding: 0 24px;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0;\n    row-gap: 4px;\n    width: 100%;\n    max-width: 1600px;\n    margin-left: auto;\n    margin-right: auto;\n    pointer-events: auto;\n    justify-content: stretch;\n  }\n\n  .bubble-menu-items .pill-list .pill-col {\n    display: flex;\n    justify-content: center;\n    align-items: stretch;\n    flex: 0 0 calc(100% / 3);\n    box-sizing: border-box;\n  }\n\n  .bubble-menu-items .pill-list .pill-col:nth-child(4):nth-last-child(2) {\n    margin-left: calc(100% / 6);\n  }\n\n  .bubble-menu-items .pill-list .pill-col:nth-child(4):last-child {\n    margin-left: calc(100% / 3);\n  }\n\n  .bubble-menu-items .pill-link {\n    --pill-min-h: 160px;\n    width: 100%;\n    min-height: var(--pill-min-h);\n    padding: clamp(1.5rem, 3vw, 8rem) 0;\n    font-size: clamp(1.5rem, 4vw, 4rem);\n    font-weight: 400;\n    line-height: 0;\n    border-radius: 999px;\n    background: var(--pill-bg);\n    color: var(--pill-color);\n    text-decoration: none;\n    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    scale: 0;\n    transition:\n      background 0.3s ease,\n      color 0.3s ease,\n      transform 0.2s ease;\n    will-change: transform;\n    box-sizing: border-box;\n    white-space: nowrap;\n    overflow: hidden;\n    height: 10px;\n  }\n\n  .bubble-menu-items .pill-link:focus-visible {\n    outline: 2px solid var(--hover-bg);\n    outline-offset: 3px;\n  }\n\n  @media (min-width: 900px) {\n    .bubble-menu-items .pill-link {\n      transform: rotate(var(--item-rot));\n    }\n\n    .bubble-menu-items .pill-link:hover {\n      transform: rotate(var(--item-rot)) scale(1.06);\n      background: var(--hover-bg);\n      color: var(--hover-color);\n    }\n\n    .bubble-menu-items .pill-link:active {\n      transform: rotate(var(--item-rot)) scale(0.94);\n    }\n  }\n\n  .bubble-menu-items .pill-link .pill-label {\n    display: inline-block;\n    will-change: transform, opacity;\n    height: 1.2em;\n    line-height: 1.2;\n    opacity: 0;\n    visibility: hidden;\n  }\n\n  @media (max-width: 899px) {\n    .bubble-menu-items {\n      align-items: flex-start;\n      padding-top: 120px;\n    }\n\n    .bubble-menu-items .pill-list {\n      row-gap: 16px;\n    }\n\n    .bubble-menu-items .pill-list .pill-col {\n      flex: 0 0 100%;\n      margin-left: 0 !important;\n      overflow: visible;\n    }\n\n    .bubble-menu-items .pill-link {\n      font-size: clamp(1.2rem, 3vw, 4rem);\n      padding: clamp(1rem, 2vw, 2rem) 0;\n      min-height: 80px;\n    }\n\n    .bubble-menu-items .pill-link:hover {\n      transform: scale(1.06);\n      background: var(--hover-bg);\n      color: var(--hover-color);\n    }\n\n    .bubble-menu-items .pill-link:active {\n      transform: scale(0.94);\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/bubble-menu/BubbleMenu.vue"
    },
    {
      "path": "registry/new-york/bubble-menu/bubble-menu-presets.ts",
      "content": "import type { BubbleMenuEase, BubbleMenuItem } from './types';\n\nexport const BUBBLE_MENU_DEFAULT_ITEMS: BubbleMenuItem[] = [\n  {\n    label: 'home',\n    href: '#',\n    ariaLabel: 'Home',\n    rotation: -8,\n    hoverStyles: { bgColor: '#3b82f6', textColor: '#ffffff' },\n  },\n  {\n    label: 'about',\n    href: '#',\n    ariaLabel: 'About',\n    rotation: 8,\n    hoverStyles: { bgColor: '#10b981', textColor: '#ffffff' },\n  },\n  {\n    label: 'projects',\n    href: '#',\n    ariaLabel: 'Documentation',\n    rotation: 8,\n    hoverStyles: { bgColor: '#f59e0b', textColor: '#ffffff' },\n  },\n  {\n    label: 'blog',\n    href: '#',\n    ariaLabel: 'Blog',\n    rotation: 8,\n    hoverStyles: { bgColor: '#ef4444', textColor: '#ffffff' },\n  },\n  {\n    label: 'contact',\n    href: '#',\n    ariaLabel: 'Contact',\n    rotation: -8,\n    hoverStyles: { bgColor: '#8b5cf6', textColor: '#ffffff' },\n  },\n];\n\ntype Ease = (t: number) => number;\n\nexport const power3Out: Ease = (t) => 1 - (1 - t) ** 4;\nexport const power3In: Ease = (t) => t ** 4;\n\nfunction bounceOut(t: number): number {\n  const n = 7.5625;\n  const d = 2.75;\n  if (t < 1 / d) return n * t * t;\n  if (t < 2 / d) return n * (t - 1.5 / d) ** 2 + 0.75;\n  if (t < 2.5 / d) return n * (t - 2.25 / d) ** 2 + 0.9375;\n  return n * (t - 2.625 / d) ** 2 + 0.984375;\n}\n\nfunction elasticOut(amplitude: number, period: number): Ease {\n  const a = Math.max(1, amplitude);\n  const s = (period / (2 * Math.PI)) * Math.asin(1 / a);\n  return (t) =>\n    t <= 0 || t >= 1\n      ? t\n      : a * 2 ** (-10 * t) * Math.sin(((t - s) * 2 * Math.PI) / period) + 1;\n}\n\nfunction backOut(overshoot: number): Ease {\n  return (t) => {\n    const p = t - 1;\n    return p * p * ((overshoot + 1) * p + overshoot) + 1;\n  };\n}\n\n/** The GSAP eases upstream exposes, as plain easing functions. */\nexport const BUBBLE_MENU_EASES: Record<BubbleMenuEase, Ease> = {\n  'back.out(1.5)': backOut(1.5),\n  'power3.out': power3Out,\n  'power2.out': (t) => 1 - (1 - t) ** 3,\n  'elastic.out(1,0.5)': elasticOut(1, 0.5),\n  'bounce.out': bounceOut,\n};\n",
      "type": "registry:ui",
      "target": "components/ui/bubble-menu/bubble-menu-presets.ts"
    },
    {
      "path": "registry/new-york/bubble-menu/index.ts",
      "content": "export { default as BubbleMenu } from './BubbleMenu.vue';\nexport * from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/bubble-menu/index.ts"
    },
    {
      "path": "registry/new-york/bubble-menu/types.ts",
      "content": "export type BubbleMenuEase =\n  | 'back.out(1.5)'\n  | 'power3.out'\n  | 'power2.out'\n  | 'elastic.out(1,0.5)'\n  | 'bounce.out';\n\nexport interface BubbleMenuHoverStyles {\n  bgColor?: string;\n  textColor?: string;\n}\n\nexport interface BubbleMenuItem {\n  label: string;\n  href?: string;\n  ariaLabel?: string;\n  /** Tilt in degrees, applied on viewports 900px and wider. */\n  rotation?: number;\n  hoverStyles?: BubbleMenuHoverStyles;\n}\n\nexport interface BubbleMenuProps {\n  /** Image URL for the logo bubble. Use the `logo` slot for markup. */\n  logo?: string;\n  menuAriaLabel?: string;\n  menuBg?: string;\n  menuContentColor?: string;\n  useFixedPosition?: boolean;\n  items?: BubbleMenuItem[];\n  animationEase?: BubbleMenuEase;\n  /** Seconds. */\n  animationDuration?: number;\n  /** Seconds between bubbles. */\n  staggerDelay?: number;\n  class?: string;\n}\n\nexport interface BubbleMenuTweenOptions {\n  duration: number;\n  delay?: number;\n  ease: (t: number) => number;\n  onUpdate: (value: number) => void;\n  onComplete?: () => void;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/bubble-menu/types.ts"
    }
  ]
}
