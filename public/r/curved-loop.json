{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "curved-loop",
  "type": "registry:ui",
  "title": "Curved Loop",
  "description": "Looping marquee text along an arc, wave, ring or line, with drag-to-fling, outlined letters, accent separators and a scroll boost.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/curved-loop/CurvedLoop.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    nextTick,\n    onMounted,\n    onUpdated,\n    ref,\n    shallowRef,\n    useId,\n    watch,\n  } from 'vue';\n  import {\n    useEventListener,\n    useIntersectionObserver,\n    usePreferredReducedMotion,\n    useRafFn,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import {\n    MAX_FLING,\n    VIEW_WIDTH,\n    edgeMask,\n    getGeometry,\n    wrapAngle,\n    wrapOffset,\n  } from './curved-loop-geometry';\n  import type { CSSProperties } from 'vue';\n  import type { CurvedLoopDirection, CurvedLoopProps } from './types';\n\n  const props = withDefaults(defineProps<CurvedLoopProps>(), {\n    marqueeText: '',\n    speed: 2,\n    curveAmount: 400,\n    direction: 'left',\n    interactive: true,\n    pauseOnHover: false,\n    color: 'currentColor',\n    edgeFade: 0,\n    shape: 'arc',\n    fontSize: 96,\n    fontWeight: 700,\n    letterSpacing: 0,\n    outline: false,\n    separator: '',\n    separatorColor: undefined,\n    scrollBoost: 0,\n    class: '',\n  });\n\n  const NBSP = '\\u00A0';\n  const MASK_SIZE = VIEW_WIDTH * 3;\n\n  const pathId = `curve-${useId().replace(/[^\\w-]/g, '')}`;\n  const maskId = `${pathId}-outline`;\n\n  const jacketRef = ref<HTMLDivElement | null>(null);\n  const svgRef = ref<SVGSVGElement | null>(null);\n  const measureRef = ref<SVGTextElement | null>(null);\n  const pathRef = ref<SVGPathElement | null>(null);\n  const textPaths = shallowRef<SVGTextPathElement[]>([]);\n\n  const spacing = ref(0);\n  const pathLength = ref(0);\n  const dragging = ref(false);\n\n  let offset = 0;\n  let velocity = 0;\n  let currentDirection: CurvedLoopDirection = props.direction;\n  let hovering = false;\n  let scrollDistance = 0;\n  let scrollLevel = 0;\n  let last = 0;\n  const scrollPositions = new Map<EventTarget, number>();\n  const drag = {\n    active: false,\n    x: 0,\n    time: 0,\n    scale: 1,\n    velocity: 0,\n    ring: false,\n    radius: 0,\n    angle: 0,\n    cx: 0,\n    cy: 0,\n  };\n\n  const reducedMotion = usePreferredReducedMotion();\n\n  const body = computed(() => props.marqueeText.replace(/\\s+$/, ''));\n  const mark = computed(() => String(props.separator ?? '').trim());\n  const text = computed(() =>\n    mark.value\n      ? `${body.value}${NBSP}${mark.value}${NBSP}`\n      : `${body.value}${NBSP}`,\n  );\n  const bodyText = computed(() => `${body.value}${NBSP}`);\n\n  const ring = computed(() => props.shape === 'circle');\n  const geometry = computed(() =>\n    getGeometry(props.shape, props.curveAmount, props.fontSize, spacing.value),\n  );\n  const ready = computed(() => spacing.value > 0);\n  const copies = computed(() => {\n    if (!ready.value) return 1;\n    if (ring.value) return geometry.value.repeats + 1;\n    return Math.ceil((pathLength.value || 1800) / spacing.value) + 2;\n  });\n  const mask = computed(() => edgeMask(props.edgeFade, geometry.value.span));\n  const accent = computed(() => Boolean(mark.value && props.separatorColor));\n  const plain = computed(() => text.value.repeat(copies.value));\n\n  const jacketStyle = computed<CSSProperties>(() => {\n    let cursor = 'auto';\n    if (props.interactive) cursor = dragging.value ? 'grabbing' : 'grab';\n    return {\n      visibility: ready.value ? 'visible' : 'hidden',\n      cursor,\n      touchAction: props.interactive ? 'pan-y' : 'auto',\n      maskImage: mask.value,\n      WebkitMaskImage: mask.value,\n    };\n  });\n\n  const svgStyle = computed(() => ({\n    fontSize: `${props.fontSize}px`,\n    fontWeight: props.fontWeight,\n    letterSpacing: `${props.letterSpacing}px`,\n    ...(ring.value\n      ? {\n          width: `${(geometry.value.span * 100).toFixed(3)}%`,\n          aspectRatio: '1',\n        }\n      : {}),\n  }));\n\n  function applyOffset(): void {\n    const value = `${offset}px`;\n    for (const node of textPaths.value) node.setAttribute('startOffset', value);\n  }\n\n  function collectTextPaths(): void {\n    textPaths.value = svgRef.value\n      ? Array.from(svgRef.value.querySelectorAll('textPath'))\n      : [];\n    applyOffset();\n  }\n\n  function measure(): void {\n    if (measureRef.value) {\n      spacing.value = measureRef.value.getComputedTextLength();\n    }\n  }\n\n  function measurePath(): void {\n    if (pathRef.value) pathLength.value = pathRef.value.getTotalLength();\n  }\n\n  watch(\n    [\n      text,\n      () => props.class,\n      () => props.fontSize,\n      () => props.fontWeight,\n      () => props.letterSpacing,\n    ],\n    () => nextTick(measure),\n  );\n\n  watch(\n    () => geometry.value.d,\n    () => nextTick(measurePath),\n  );\n\n  watch(\n    () => props.direction,\n    (value) => {\n      currentDirection = value;\n    },\n  );\n\n  watch(spacing, (value) => {\n    if (value > 0) offset = wrapOffset(offset, value);\n  });\n\n  useResizeObserver(svgRef, measure);\n\n  onMounted(() => {\n    measure();\n    measurePath();\n    collectTextPaths();\n    const fonts = document.fonts;\n    fonts?.ready.then(measure);\n    useEventListener(fonts, 'loadingdone', measure);\n  });\n\n  onUpdated(collectTextPaths);\n\n  function onScroll(event: Event): void {\n    if (!props.scrollBoost) return;\n    const target = event.target instanceof Element ? event.target : window;\n    if (\n      target instanceof Element &&\n      jacketRef.value &&\n      !target.contains(jacketRef.value)\n    ) {\n      return;\n    }\n    const position =\n      target instanceof Element ? target.scrollTop : window.scrollY;\n    const previous = scrollPositions.get(target);\n    scrollPositions.set(target, position);\n    if (previous !== undefined) scrollDistance += Math.abs(position - previous);\n  }\n\n  useEventListener('scroll', onScroll, { passive: true, capture: true });\n\n  const { pause, resume } = useRafFn(\n    ({ timestamp }) => {\n      const dt = last ? Math.min((timestamp - last) / 1000, 0.05) : 0;\n      last = timestamp;\n      const rate = dt > 0 ? scrollDistance / dt : 0;\n      scrollDistance = 0;\n      scrollLevel +=\n        (rate - scrollLevel) *\n        (1 - Math.exp(-dt * (rate > scrollLevel ? 10 : 2.4)));\n      if (drag.active) return;\n      const sign = currentDirection === 'right' ? 1 : -1;\n      const halted =\n        reducedMotion.value === 'reduce' || (props.pauseOnHover && hovering);\n      const target = halted ? 0 : sign * props.speed * 60;\n      const extra = halted ? 0 : sign * scrollLevel * props.scrollBoost * 0.3;\n      velocity += (target - velocity) * (1 - Math.exp(-dt * 3));\n      const step = (velocity + extra) * dt;\n      if (Math.abs(step) > 0.0001) {\n        offset = wrapOffset(offset + step, spacing.value);\n        applyOffset();\n      }\n    },\n    { immediate: false },\n  );\n\n  const visible = ref(true);\n\n  useIntersectionObserver(jacketRef, (entries) => {\n    const entry = entries[entries.length - 1];\n    if (entry) visible.value = entry.isIntersecting;\n  });\n\n  watch(\n    [ready, visible],\n    ([isReady, isVisible]) => {\n      if (isReady && isVisible) {\n        last = 0;\n        scrollLevel = 0;\n        resume();\n      } else {\n        pause();\n      }\n    },\n    { immediate: true },\n  );\n\n  function onPointerDown(event: PointerEvent): void {\n    if (!props.interactive || !ready.value) return;\n    const rect = svgRef.value?.getBoundingClientRect();\n    const width = rect?.width || VIEW_WIDTH;\n    const cx = rect ? rect.left + rect.width / 2 : event.clientX;\n    const cy = rect ? rect.top + rect.height / 2 : event.clientY;\n    Object.assign(drag, {\n      active: true,\n      x: event.clientX,\n      time: performance.now(),\n      scale: VIEW_WIDTH / width,\n      velocity: 0,\n      ring: ring.value,\n      radius: geometry.value.radius,\n      angle: Math.atan2(event.clientY - cy, event.clientX - cx),\n      cx,\n      cy,\n    });\n    velocity = 0;\n    dragging.value = true;\n    jacketRef.value?.setPointerCapture?.(event.pointerId);\n  }\n\n  function onPointerMove(event: PointerEvent): void {\n    if (!drag.active) return;\n    const now = performance.now();\n    let delta = (event.clientX - drag.x) * drag.scale;\n    if (drag.ring) {\n      const angle = Math.atan2(\n        event.clientY - drag.cy,\n        event.clientX - drag.cx,\n      );\n      delta = wrapAngle(angle - drag.angle) * drag.radius;\n      drag.angle = angle;\n    }\n    const dt = Math.max(now - drag.time, 1) / 1000;\n    drag.x = event.clientX;\n    drag.time = now;\n    drag.velocity = drag.velocity * 0.5 + (delta / dt) * 0.5;\n    offset = wrapOffset(offset + delta, spacing.value);\n    applyOffset();\n  }\n\n  function endDrag(): void {\n    if (!drag.active) return;\n    drag.active = false;\n    dragging.value = false;\n    const fling =\n      performance.now() - drag.time > 100\n        ? 0\n        : Math.max(-MAX_FLING, Math.min(MAX_FLING, drag.velocity));\n    velocity = fling;\n    if (Math.abs(fling) > 60) currentDirection = fling > 0 ? 'right' : 'left';\n  }\n\n  function onPointerEnter(): void {\n    hovering = true;\n  }\n\n  function onPointerLeave(): void {\n    hovering = false;\n    endDrag();\n  }\n</script>\n\n<template>\n  <div\n    ref=\"jacketRef\"\n    :class=\"cn('flex size-full items-center justify-center', props.class)\"\n    :style=\"jacketStyle\"\n    @pointerdown=\"onPointerDown\"\n    @pointermove=\"onPointerMove\"\n    @pointerup=\"endDrag\"\n    @pointercancel=\"endDrag\"\n    @lostpointercapture=\"endDrag\"\n    @pointerenter=\"onPointerEnter\"\n    @pointerleave=\"onPointerLeave\"\n  >\n    <svg\n      ref=\"svgRef\"\n      class=\"block aspect-100/12 w-full overflow-visible fill-current leading-none uppercase select-none\"\n      :viewBox=\"geometry.viewBox\"\n      :style=\"svgStyle\"\n      role=\"img\"\n      :aria-label=\"marqueeText\"\n    >\n      <text\n        ref=\"measureRef\"\n        xml:space=\"preserve\"\n        style=\"visibility: hidden; opacity: 0; pointer-events: none\"\n        v-text=\"text\"\n      />\n      <defs>\n        <path\n          :id=\"pathId\"\n          ref=\"pathRef\"\n          :d=\"geometry.d\"\n          fill=\"none\"\n          stroke=\"transparent\"\n        />\n        <mask\n          v-if=\"ready && outline\"\n          :id=\"maskId\"\n          mask-units=\"userSpaceOnUse\"\n          :x=\"-VIEW_WIDTH\"\n          :y=\"-VIEW_WIDTH\"\n          :width=\"MASK_SIZE\"\n          :height=\"MASK_SIZE\"\n        >\n          <rect\n            :x=\"-VIEW_WIDTH\"\n            :y=\"-VIEW_WIDTH\"\n            :width=\"MASK_SIZE\"\n            :height=\"MASK_SIZE\"\n            fill=\"#fff\"\n          />\n          <text xml:space=\"preserve\" fill=\"#000\">\n            <textPath\n              :href=\"`#${pathId}`\"\n              xml:space=\"preserve\"\n              v-text=\"plain\"\n            />\n          </text>\n        </mask>\n      </defs>\n      <template v-if=\"ready\">\n        <text\n          v-if=\"outline\"\n          xml:space=\"preserve\"\n          fill=\"none\"\n          :stroke=\"color\"\n          :stroke-width=\"fontSize * 0.05\"\n          stroke-linejoin=\"round\"\n          :mask=\"`url(#${maskId})`\"\n        >\n          <textPath v-if=\"accent\" :href=\"`#${pathId}`\" xml:space=\"preserve\">\n            <template v-for=\"i in copies\" :key=\"i\">\n              <tspan v-text=\"bodyText\" />\n              <tspan stroke=\"none\" v-text=\"mark\" />\n              <tspan v-text=\"NBSP\" />\n            </template>\n          </textPath>\n          <textPath\n            v-else\n            :href=\"`#${pathId}`\"\n            xml:space=\"preserve\"\n            v-text=\"plain\"\n          />\n        </text>\n        <text v-else xml:space=\"preserve\" :fill=\"color\">\n          <textPath v-if=\"accent\" :href=\"`#${pathId}`\" xml:space=\"preserve\">\n            <template v-for=\"i in copies\" :key=\"i\">\n              <tspan v-text=\"bodyText\" />\n              <tspan :fill=\"separatorColor\" v-text=\"mark\" />\n              <tspan v-text=\"NBSP\" />\n            </template>\n          </textPath>\n          <textPath\n            v-else\n            :href=\"`#${pathId}`\"\n            xml:space=\"preserve\"\n            v-text=\"plain\"\n          />\n        </text>\n        <text\n          v-if=\"outline && accent\"\n          xml:space=\"preserve\"\n          fill=\"none\"\n          aria-hidden=\"true\"\n        >\n          <textPath :href=\"`#${pathId}`\" xml:space=\"preserve\">\n            <template v-for=\"i in copies\" :key=\"i\">\n              <tspan v-text=\"bodyText\" />\n              <tspan :fill=\"separatorColor\" v-text=\"mark\" />\n              <tspan v-text=\"NBSP\" />\n            </template>\n          </textPath>\n        </text>\n      </template>\n    </svg>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/curved-loop/CurvedLoop.vue"
    },
    {
      "path": "registry/new-york/curved-loop/curved-loop-geometry.ts",
      "content": "import type { CurvedLoopGeometry, CurvedLoopShape } from './types';\n\nexport const VIEW_WIDTH = 1440;\nconst VIEW_HEIGHT = 120;\nexport const MAX_FLING = 4000;\nconst WAVE_LENGTH = 960;\nconst RING_RADIUS = 2.2;\nconst TAU = Math.PI * 2;\n\nexport function wrapOffset(value: number, length: number): number {\n  return length > 0 ? (((value % length) + length) % length) - length : value;\n}\n\nexport function wrapAngle(angle: number): number {\n  return Math.atan2(Math.sin(angle), Math.cos(angle));\n}\n\nexport function edgeMask(amount: number, span: number): string | undefined {\n  const size = Math.min(Math.max(amount, 0), 1) * 50 * span;\n  if (size <= 0) return undefined;\n  const start = 50 - span * 50;\n  const steps = 10;\n  const left: string[] = [];\n  const right: string[] = [];\n  for (let i = 0; i <= steps; i++) {\n    const t = i / steps;\n    const alpha = (t * t * t * (t * (t * 6 - 15) + 10)).toFixed(3);\n    left.push(`rgba(0, 0, 0, ${alpha}) ${(start + t * size).toFixed(2)}%`);\n    right.unshift(\n      `rgba(0, 0, 0, ${alpha}) ${(100 - start - t * size).toFixed(2)}%`,\n    );\n  }\n  return `linear-gradient(to right, ${[...left, ...right].join(', ')})`;\n}\n\nfunction wavePath(amplitude: number, baseline: number): string {\n  const from = -100;\n  const to = VIEW_WIDTH + 100;\n  const k = TAU / WAVE_LENGTH;\n  const y = (x: number) =>\n    baseline + amplitude * Math.cos(k * (x - VIEW_WIDTH / 2));\n  const slope = (x: number) =>\n    -amplitude * k * Math.sin(k * (x - VIEW_WIDTH / 2));\n  const count = Math.ceil((to - from) / (WAVE_LENGTH / 8));\n  const step = (to - from) / count;\n  const f = (n: number) => n.toFixed(2);\n  let d = `M${f(from)},${f(y(from))}`;\n  for (let i = 0; i < count; i++) {\n    const x0 = from + i * step;\n    const x1 = x0 + step;\n    d += ` C${f(x0 + step / 3)},${f(y(x0) + (slope(x0) * step) / 3)} ${f(x1 - step / 3)},${f(y(x1) - (slope(x1) * step) / 3)} ${f(x1)},${f(y(x1))}`;\n  }\n  return d;\n}\n\nexport function getGeometry(\n  shape: CurvedLoopShape,\n  curveAmount: number,\n  fontSize: number,\n  spacing: number,\n): CurvedLoopGeometry {\n  if (shape === 'circle') {\n    const repeats =\n      spacing > 0\n        ? Math.max(1, Math.round((TAU * fontSize * RING_RADIUS) / spacing))\n        : 1;\n    const radius =\n      spacing > 0 ? (repeats * spacing) / TAU : fontSize * RING_RADIUS;\n    const half = radius + fontSize;\n    return {\n      d: `M${-radius},0 A${radius},${radius} 0 1,1 ${radius},0 A${radius},${radius} 0 1,1 ${-radius},0`,\n      viewBox: `${-half} ${-half} ${half * 2} ${half * 2}`,\n      radius,\n      repeats,\n      span: Math.min(1, (fontSize * (RING_RADIUS + 1) * 2) / VIEW_WIDTH),\n    };\n  }\n  const viewBox = `0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`;\n  const baseline = VIEW_HEIGHT / 2 + fontSize * 0.36;\n  let d = `M-100,40 Q500,${40 + curveAmount} 1540,40`;\n  if (shape === 'line')\n    d = `M-100,${baseline} L${VIEW_WIDTH + 100},${baseline}`;\n  else if (shape === 'wave') d = wavePath(curveAmount * 0.25, baseline);\n  return { d, viewBox, radius: 0, repeats: 0, span: 1 };\n}\n",
      "type": "registry:ui",
      "target": "components/ui/curved-loop/curved-loop-geometry.ts"
    },
    {
      "path": "registry/new-york/curved-loop/index.ts",
      "content": "export { default as CurvedLoop } from './CurvedLoop.vue';\nexport type {\n  CurvedLoopDirection,\n  CurvedLoopGeometry,\n  CurvedLoopProps,\n  CurvedLoopShape,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/curved-loop/index.ts"
    },
    {
      "path": "registry/new-york/curved-loop/types.ts",
      "content": "export type CurvedLoopShape = 'arc' | 'wave' | 'circle' | 'line';\n\nexport type CurvedLoopDirection = 'left' | 'right';\n\nexport interface CurvedLoopProps {\n  /** The text that loops along the path. Repeats are joined with a space. */\n  marqueeText?: string;\n  /** How fast the text travels along the path. 0 keeps it still until dragged or scrolled. */\n  speed?: number;\n  /** How far the path bends. On the arc it is the dip at the middle (negative arches up), on the wave it sets the wave height. */\n  curveAmount?: number;\n  /** Which way the text travels. On a circle, right turns clockwise. */\n  direction?: CurvedLoopDirection;\n  /** Lets people drag the text and fling it. */\n  interactive?: boolean;\n  /** Eases the text to a stop while the pointer is over it. */\n  pauseOnHover?: boolean;\n  /** Color of the text, or of its outline when outline is on. */\n  color?: string;\n  /** How much of each side fades out, from 0 to 1. */\n  edgeFade?: number;\n  /** The path the text travels on. */\n  shape?: CurvedLoopShape;\n  /** Letter size in px for a 1440px wide loop. */\n  fontSize?: number;\n  /** Weight of the letters. */\n  fontWeight?: number | string;\n  /** Extra space between letters in px, measured like fontSize. */\n  letterSpacing?: number;\n  /** Draws the letters as outlines instead of solid text. */\n  outline?: boolean;\n  /** A mark placed between repeats, such as ✦ or /. */\n  separator?: string;\n  /** Paints the separator in its own solid color. */\n  separatorColor?: string;\n  /** How much page scrolling speeds the loop up for a moment. 0 turns it off. */\n  scrollBoost?: number;\n  /** Classes merged onto the wrapper, for example to change the font. */\n  class?: string;\n}\n\nexport interface CurvedLoopGeometry {\n  d: string;\n  viewBox: string;\n  radius: number;\n  repeats: number;\n  span: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/curved-loop/types.ts"
    }
  ]
}
