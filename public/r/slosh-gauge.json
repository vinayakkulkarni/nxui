{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "slosh-gauge",
  "type": "registry:ui",
  "title": "Slosh Gauge",
  "description": "Tank gauge whose liquid chases the value on a spring, tilts as it moves and splashes when it fills.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/slosh-gauge/SloshGauge.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    nextTick,\n    onBeforeUnmount,\n    onMounted,\n    ref,\n    watch,\n  } from 'vue';\n  import type { CSSProperties } from 'vue';\n  import { usePreferredReducedMotion } from '@vueuse/core';\n  import type { SloshGaugeGrip, SloshGaugeProps, SloshGaugeSim } from './types';\n\n  const props = withDefaults(defineProps<SloshGaugeProps>(), {\n    modelValue: undefined,\n    defaultValue: 60,\n    interactive: false,\n    showValue: true,\n    disabled: false,\n    liquidColor: '#f5f5f5',\n    glassColor: '#27272a',\n    width: 88,\n    height: 180,\n    radius: 20,\n    ticks: 4,\n    viscosity: 0.15,\n    tilt: 0.45,\n    splash: 0.42,\n    unit: '%',\n    ariaLabel: 'Level',\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    'update:modelValue': [value: number];\n    change: [value: number];\n  }>();\n\n  const clamp = (v: number, a: number, b: number) =>\n    Math.min(b, Math.max(a, v));\n  const H = 1 / 120;\n  const DT_MAX = 0.05;\n  const TILT_GAIN = 0.07;\n  const TILT_MAX = 30;\n  const REST_POS = 0.05;\n  const REST_VEL = 2;\n  const STEP = 2;\n  const BIG = 10;\n  const BAND = 10;\n\n  function onColor(hex: string) {\n    const raw = hex.replace('#', '');\n    const full = raw.length === 3 ? [...raw].map((c) => c + c).join('') : raw;\n    const n = Number.parseInt(full, 16);\n    if (Number.isNaN(n)) return '#ffffff';\n    return (((n >> 16) & 255) * 299 +\n      ((n >> 8) & 255) * 587 +\n      (n & 255) * 114) /\n      1000 >=\n      150\n      ? '#111111'\n      : '#ffffff';\n  }\n\n  const rootRef = ref<HTMLDivElement | null>(null);\n  const liquidRef = ref<HTMLDivElement | null>(null);\n  const markerRef = ref<HTMLDivElement | null>(null);\n  const textA = ref<HTMLSpanElement | null>(null);\n  const textB = ref<HTMLSpanElement | null>(null);\n  const start = clamp(props.modelValue ?? props.defaultValue, 0, 100);\n  const startLabel = `${Math.round(start)}${props.unit}`;\n  const sim: SloshGaugeSim = { x: start, v: 0, L: start, raf: 0, last: 0 };\n  let grip: SloshGaugeGrip | null = null;\n  const reducedPref = usePreferredReducedMotion();\n  const reduce = computed(() => reducedPref.value === 'reduce');\n  const held = ref(false);\n\n  function paint() {\n    const { x, v, L } = sim;\n    const th = reduce.value\n      ? 0\n      : clamp(props.tilt * v * TILT_GAIN, -TILT_MAX, TILT_MAX);\n    const lean = (Math.tan((th * Math.PI) / 180) * props.width) / 2;\n    const top = 100 - x;\n    if (liquidRef.value) {\n      liquidRef.value.style.clipPath = `polygon(0 calc(${top}% + ${lean}px), 100% calc(${top}% - ${lean}px), 100% 100%, 0 100%)`;\n    }\n    if (markerRef.value)\n      markerRef.value.style.transform = `translateY(${((100 - L) * props.height) / 100}px)`;\n  }\n\n  function say() {\n    const n = Math.round(sim.L);\n    const s = `${n}${props.unit}`;\n    rootRef.value?.setAttribute('aria-valuenow', String(n));\n    if (textA.value) textA.value.textContent = s;\n    if (textB.value) textB.value.textContent = s;\n  }\n\n  function tick(now: number) {\n    const s = sim;\n    const dt = s.last ? Math.min((now - s.last) / 1000, DT_MAX) : H;\n    s.last = now;\n    if (props.viscosity <= 0) {\n      s.x = s.L;\n      s.v = 0;\n    } else {\n      const vis = props.viscosity;\n      const k = 1224 - 1044 * vis;\n      const zeta = reduce.value ? 1 : 0.26 - 0.17 * vis;\n      const c = 2 * zeta * Math.sqrt(k);\n      const rest = reduce.value ? 0 : props.splash;\n      for (let n = Math.ceil(dt / H), h = dt / n; n > 0; n -= 1) {\n        s.v = s.v * Math.exp(-c * h) + k * (s.L - s.x) * h;\n        s.x += s.v * h;\n        if (s.x > 100) {\n          s.x = 100;\n          s.v = -s.v * rest;\n        } else if (s.x < 0) {\n          s.x = 0;\n          s.v = -s.v * rest;\n        }\n      }\n      if (!grip && Math.abs(s.L - s.x) < REST_POS && Math.abs(s.v) < REST_VEL) {\n        s.x = s.L;\n        s.v = 0;\n      }\n    }\n    paint();\n    const parked = !grip && s.x === s.L && s.v === 0;\n    if (parked) {\n      s.raf = 0;\n      s.last = 0;\n    } else {\n      s.raf = requestAnimationFrame(tick);\n    }\n  }\n\n  function wake() {\n    if (!sim.raf) sim.raf = requestAnimationFrame(tick);\n  }\n\n  function setLevel(L: number, instant = false) {\n    sim.L = clamp(L, 0, 100);\n    if (instant) {\n      sim.x = sim.L;\n      sim.v = 0;\n    }\n    say();\n    wake();\n  }\n\n  function emitValue(n: number) {\n    emit('update:modelValue', n);\n    emit('change', n);\n  }\n\n  watch(\n    () => props.modelValue,\n    (value) => {\n      if (value === undefined) return;\n      if (grip && Math.round(sim.L) === value) return;\n      setLevel(value, false);\n    },\n  );\n\n  watch(\n    [\n      () => props.width,\n      () => props.height,\n      () => props.tilt,\n      () => props.showValue,\n      () => props.interactive,\n      () => props.disabled,\n      () => props.unit,\n    ],\n    () => {\n      nextTick(() => {\n        say();\n        paint();\n      });\n    },\n  );\n\n  onMounted(() => {\n    say();\n    paint();\n  });\n\n  onBeforeUnmount(() => {\n    cancelAnimationFrame(sim.raf);\n    sim.raf = 0;\n  });\n\n  function levelAt(clientY: number, g: SloshGaugeGrip) {\n    return clamp(\n      ((g.rect.bottom - clientY) /\n        g.scale /\n        (rootRef.value?.offsetHeight || g.rect.height)) *\n        100,\n      0,\n      100,\n    );\n  }\n\n  function report() {\n    const g = grip;\n    const n = Math.round(sim.L);\n    if (g && n !== g.sent) {\n      g.sent = n;\n      emitValue(n);\n    }\n  }\n\n  function onPointerDown(e: PointerEvent) {\n    const el = rootRef.value;\n    if (!props.interactive || props.disabled || grip || e.button !== 0 || !el)\n      return;\n    const rect = el.getBoundingClientRect();\n    const scale = rect.height / (el.offsetHeight || rect.height) || 1;\n    const markerY = rect.top + ((100 - sim.L) / 100) * rect.height;\n    const g: SloshGaugeGrip = {\n      id: e.pointerId,\n      rect,\n      scale,\n      band: Math.abs(e.clientY - markerY) <= BAND * scale,\n      grab: null,\n      at: sim.L,\n      sent: Number.NaN,\n    };\n    grip = g;\n    try {\n      el.setPointerCapture(e.pointerId);\n    } catch {\n      // capture is best-effort\n    }\n    held.value = true;\n    if (g.band) {\n      wake();\n    } else {\n      setLevel(levelAt(e.clientY, g));\n      report();\n    }\n  }\n\n  function onPointerMove(e: PointerEvent) {\n    const g = grip;\n    if (!g || g.id !== e.pointerId) return;\n    const at = levelAt(e.clientY, g);\n    if (g.band && g.grab === null) {\n      g.grab = sim.L - at;\n      return;\n    }\n    setLevel(at + (g.grab ?? 0));\n    report();\n  }\n\n  function release(pointerId: number, reason?: 'escape' | 'cancel') {\n    const g = grip;\n    if (!g || g.id !== pointerId) return;\n    grip = null;\n    try {\n      rootRef.value?.releasePointerCapture(pointerId);\n    } catch {\n      // release is best-effort\n    }\n    held.value = false;\n    if (reason === 'escape') {\n      setLevel(g.at);\n      emitValue(Math.round(g.at));\n    } else if (\n      props.modelValue !== undefined &&\n      Math.round(sim.L) !== props.modelValue\n    ) {\n      setLevel(props.modelValue);\n    }\n    wake();\n  }\n\n  function onPointerUp(e: PointerEvent) {\n    release(e.pointerId);\n  }\n  function onPointerCancel(e: PointerEvent) {\n    release(e.pointerId, 'cancel');\n  }\n\n  const KEY_DELTAS: Record<\n    string,\n    'up' | 'down' | 'pgup' | 'pgdn' | 'home' | 'end'\n  > = {\n    ArrowUp: 'up',\n    ArrowRight: 'up',\n    ArrowDown: 'down',\n    ArrowLeft: 'down',\n    PageUp: 'pgup',\n    PageDown: 'pgdn',\n    Home: 'home',\n    End: 'end',\n  };\n\n  function onKeyDown(e: KeyboardEvent) {\n    if (!props.interactive || props.disabled) return;\n    if (e.key === 'Escape') {\n      if (grip) release(grip.id, 'escape');\n      return;\n    }\n    const kind = KEY_DELTAS[e.key];\n    if (!kind) return;\n    const L = sim.L;\n    const d = e.shiftKey ? BIG : STEP;\n    const next =\n      kind === 'up'\n        ? L + d\n        : kind === 'down'\n          ? L - d\n          : kind === 'pgup'\n            ? L + BIG\n            : kind === 'pgdn'\n              ? L - BIG\n              : kind === 'home'\n                ? 0\n                : 100;\n    e.preventDefault();\n    setLevel(next, true);\n    emitValue(Math.round(sim.L));\n  }\n\n  const rootStyle = computed<CSSProperties>(() => ({\n    '--sg-w': `${props.width}px`,\n    '--sg-h': `${props.height}px`,\n    '--sg-r': `${Math.min(props.radius, props.width / 2, props.height / 2)}px`,\n    '--sg-glass': props.glassColor,\n    '--sg-liquid': props.liquidColor,\n    '--sg-on-liquid': onColor(props.liquidColor),\n    '--sg-ticks': props.ticks,\n    '--sg-font': `${clamp(Math.round(props.width * 0.16), 12, 20)}px`,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"['slosh-gauge', props.class]\"\n    :role=\"interactive ? 'slider' : 'meter'\"\n    :tabindex=\"interactive && !disabled ? 0 : undefined\"\n    :aria-label=\"ariaLabel\"\n    :aria-valuemin=\"0\"\n    :aria-valuemax=\"100\"\n    :aria-valuenow=\"Math.round(start)\"\n    :aria-orientation=\"interactive ? 'vertical' : undefined\"\n    :aria-disabled=\"disabled || undefined\"\n    :data-interactive=\"interactive ? 'true' : 'false'\"\n    :data-held=\"held ? 'true' : 'false'\"\n    :data-disabled=\"disabled ? 'true' : 'false'\"\n    :style=\"rootStyle\"\n    @pointerdown=\"onPointerDown\"\n    @pointermove=\"onPointerMove\"\n    @pointerup=\"onPointerUp\"\n    @pointercancel=\"onPointerCancel\"\n    @lostpointercapture=\"onPointerCancel\"\n    @keydown=\"onKeyDown\"\n  >\n    <span\n      v-if=\"showValue\"\n      ref=\"textA\"\n      class=\"slosh-gauge__value\"\n      aria-hidden=\"true\"\n      >{{ startLabel }}</span\n    >\n    <div ref=\"liquidRef\" class=\"slosh-gauge__liquid\" aria-hidden=\"true\">\n      <span v-if=\"showValue\" ref=\"textB\" class=\"slosh-gauge__value\">{{\n        startLabel\n      }}</span>\n    </div>\n    <div v-if=\"ticks > 0\" class=\"slosh-gauge__ticks\" aria-hidden=\"true\"></div>\n    <div\n      v-if=\"interactive && !disabled\"\n      ref=\"markerRef\"\n      class=\"slosh-gauge__marker\"\n      aria-hidden=\"true\"\n    ></div>\n  </div>\n</template>\n\n<style scoped>\n  .slosh-gauge {\n    --sg-w: 88px;\n    --sg-h: 180px;\n    --sg-r: 20px;\n    --sg-glass: #27272a;\n    --sg-liquid: #f5f5f5;\n    --sg-on-liquid: #111111;\n    --sg-ticks: 4;\n    --sg-font: 14px;\n\n    position: relative;\n    display: inline-block;\n    box-sizing: border-box;\n    width: var(--sg-w);\n    height: var(--sg-h);\n    border-radius: var(--sg-r);\n    overflow: clip;\n    isolation: isolate;\n    background: var(--sg-glass);\n    font-size: var(--sg-font);\n    font-weight: 600;\n    font-variant-numeric: tabular-nums;\n    line-height: 1;\n    outline: none;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .slosh-gauge:focus-visible {\n    box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 55%, transparent);\n  }\n\n  .slosh-gauge[data-interactive='true'] {\n    cursor: ns-resize;\n    touch-action: none;\n    -webkit-touch-callout: none;\n  }\n\n  .slosh-gauge[data-disabled='true'] {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n\n  .slosh-gauge__value {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-items: center;\n    color: color-mix(in srgb, currentColor 65%, transparent);\n    pointer-events: none;\n  }\n\n  .slosh-gauge__liquid {\n    position: absolute;\n    inset: 0;\n    background: var(--sg-liquid);\n    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);\n  }\n\n  .slosh-gauge__liquid .slosh-gauge__value {\n    color: var(--sg-on-liquid);\n  }\n\n  .slosh-gauge__ticks {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    width: 22%;\n    height: 100%;\n    background-image: linear-gradient(\n      to top,\n      color-mix(in srgb, currentColor 22%, transparent) 0 1px,\n      transparent 1px\n    );\n    background-size: 100% calc(100% / var(--sg-ticks));\n    background-repeat: repeat-y;\n    background-position: bottom;\n    pointer-events: none;\n  }\n\n  .slosh-gauge__marker {\n    position: absolute;\n    top: 0;\n    right: 10%;\n    left: 10%;\n    height: 2px;\n    margin-top: -1px;\n    border-radius: 1px;\n    background: currentColor;\n    opacity: 0;\n    transition: opacity 150ms ease;\n    pointer-events: none;\n  }\n\n  .slosh-gauge[data-held='true'] .slosh-gauge__marker {\n    opacity: 1;\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/slosh-gauge/SloshGauge.vue"
    },
    {
      "path": "registry/new-york/slosh-gauge/index.ts",
      "content": "export { default as SloshGauge } from './SloshGauge.vue';\nexport type { SloshGaugeProps } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/slosh-gauge/index.ts"
    },
    {
      "path": "registry/new-york/slosh-gauge/types.ts",
      "content": "export interface SloshGaugeProps {\n  /** The level, 0 to 100, controlled (v-model). Every change launches the liquid toward it. */\n  modelValue?: number;\n  /** The starting level when uncontrolled. */\n  defaultValue?: number;\n  /** Press or drag the tank to set the level, arrows to step. */\n  interactive?: boolean;\n  /** A readout whose colour flips at the surface. */\n  showValue?: boolean;\n  /** Dimmed and inert. Value changes still animate. */\n  disabled?: boolean;\n  /** The liquid. The readout over it picks dark or light by itself. */\n  liquidColor?: string;\n  /** The tank. */\n  glassColor?: string;\n  /** Tank width in px. The readout scales with it. */\n  width?: number;\n  /** Tank height in px. */\n  height?: number;\n  /** Corner radius in px, capped at half the smaller side. */\n  radius?: number;\n  /** Lines etched on the right of the glass. 0 hides them. */\n  ticks?: number;\n  /** 0 is a rigid gauge. Higher is slower, longer to settle, and overshoots more. */\n  viscosity?: number;\n  /** How far the surface leans per unit of speed. 0 keeps it flat. */\n  tilt?: number;\n  /** How much of a slam the top and bottom give back. */\n  splash?: number;\n  /** Readout suffix. */\n  unit?: string;\n  /** Accessible name of the meter or slider. */\n  ariaLabel?: string;\n  class?: string;\n}\n\nexport interface SloshGaugeSim {\n  x: number;\n  v: number;\n  L: number;\n  raf: number;\n  last: number;\n}\n\nexport interface SloshGaugeGrip {\n  id: number;\n  rect: DOMRect;\n  scale: number;\n  band: boolean;\n  grab: number | null;\n  at: number;\n  sent: number;\n}\n\nexport interface SloshGaugePreset {\n  label: string;\n  value: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/slosh-gauge/types.ts"
    }
  ]
}
