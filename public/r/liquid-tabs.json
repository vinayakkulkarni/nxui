      "content": "import type { LiquidTabsGlyphName, LiquidTabsTab } from './types';\n\nconst GLYPHS: readonly LiquidTabsGlyphName[] = [\n  'dome',\n  'shield-outline',\n  'shield-notch',\n];\n\nconst GLYPH_SET: ReadonlySet<string> = new Set(GLYPHS);\n\nexport function isGlyph(icon: string): icon is LiquidTabsGlyphName {\n  return GLYPH_SET.has(icon);\n}\n\nexport const DEFAULT_TABS: LiquidTabsTab[] = [\n  {\n    key: 'all',\n    label: 'All',\n    selected: 'a2',\n    rows: [\n      {\n        id: 'a1',\n        title: 'All',\n        subtitle: 'Notification',\n        time: '12:10',\n        icon: 'dome',\n      },\n      {\n        id: 'a2',\n        title: 'Mentions',\n        subtitle: 'Notification',\n        time: '13:00',\n        icon: 'shield-outline',\n      },\n      {\n        id: 'a3',\n        title: 'Badge',\n        subtitle: 'Notification',\n        time: '13:10',\n        icon: 'shield-notch',\n      },\n      {\n        id: 'a4',\n        title: 'Security',\n        subtitle: 'Notification',\n        time: '14:25',\n        icon: 'lucide:shield-check',\n      },\n    ],\n  },\n  {\n    key: 'mentions',\n    label: 'Mentions',\n    selected: 'm1',\n    rows: [\n      {\n        id: 'm1',\n        title: 'Design review',\n        subtitle: 'Mentioned you',\n        time: '09:42',\n        icon: 'lucide:at-sign',\n      },\n      {\n        id: 'm2',\n        title: 'Release notes',\n        subtitle: 'Replied to you',\n        time: '10:15',\n        icon: 'lucide:reply',\n      },\n      {\n        id: 'm3',\n        title: 'Roadmap',\n        subtitle: 'Commented',\n        time: '11:30',\n        icon: 'lucide:message-circle',\n      },\n      {\n        id: 'm4',\n        title: 'Changelog',\n        subtitle: 'Quoted you',\n        time: '12:05',\n        icon: 'lucide:quote',\n      },\n    ],\n  },\n];\n\nexport const DEFAULT_OVERFLOW: LiquidTabsTab[] = [\n  {\n    key: 'system',\n    label: 'System',\n    selected: 's2',\n    rows: [\n      {\n        id: 's1',\n        title: 'Update',\n        subtitle: 'Version 2.4 ready',\n        time: '08:00',\n        icon: 'lucide:refresh-cw',\n      },\n      {\n        id: 's2',\n        title: 'Security',\n        subtitle: 'New sign-in',\n        time: '08:45',\n        icon: 'lucide:shield-check',\n      },\n      {\n        id: 's3',\n        title: 'Storage',\n        subtitle: '80% used',\n        time: '10:20',\n        icon: 'lucide:hard-drive',\n      },\n      {\n        id: 's4',\n        title: 'Settings',\n        subtitle: 'Preferences saved',\n        time: '11:55',\n        icon: 'lucide:settings',\n      },\n    ],\n  },\n  {\n    key: 'archived',\n    label: 'Archived',\n    selected: 'r1',\n    rows: [\n      {\n        id: 'r1',\n        title: 'Inbox',\n        subtitle: 'Cleared',\n        time: 'Mon',\n        icon: 'lucide:inbox',\n      },\n      {\n        id: 'r2',\n        title: 'Delivery',\n        subtitle: 'Package arrived',\n        time: 'Sun',\n        icon: 'lucide:package',\n      },\n      {\n        id: 'r3',\n        title: 'Reminder',\n        subtitle: 'Snoozed',\n        time: 'Sat',\n        icon: 'lucide:clock',\n      },\n      {\n        id: 'r4',\n        title: 'Archive',\n        subtitle: '12 items',\n        time: 'Fri',\n        icon: 'lucide:archive',\n      },\n    ],\n  },\n  {\n    key: 'requests',\n    label: 'Requests',\n    selected: 'q1',\n    rows: [\n      {\n        id: 'q1',\n        title: 'New member',\n        subtitle: 'Wants to connect',\n        time: '07:30',\n        icon: 'lucide:user-plus',\n      },\n      {\n        id: 'q2',\n        title: 'Design Team',\n        subtitle: 'Invite to join',\n        time: '09:10',\n        icon: 'lucide:users',\n      },\n      {\n        id: 'q3',\n        title: 'Shared link',\n        subtitle: 'Access requested',\n        time: '10:40',\n        icon: 'lucide:link-2',\n      },\n      {\n        id: 'q4',\n        title: 'Newsletter',\n        subtitle: 'Confirm email',\n        time: '13:20',\n        icon: 'lucide:mail',\n      },\n    ],\n  },\n];\n",
