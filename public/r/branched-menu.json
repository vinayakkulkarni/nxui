{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "branched-menu",
  "type": "registry:ui",
  "title": "Branched Menu",
  "description": "Collapsible menu that branches each section from a trunk and traces a line to your pick.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/branched-menu/BranchedMenu.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, ref, watch } from 'vue';\n  import { useResizeObserver } from '@vueuse/core';\n  import { DEFAULT_BRANCHED_MENU_ITEMS } from './default-items';\n  import type {\n    BranchedMenuChild,\n    BranchedMenuItem,\n    BranchedMenuProps,\n  } from './types';\n\n  const PAD = 6;\n  const MARK = 16;\n\n  const props = withDefaults(defineProps<BranchedMenuProps>(), {\n    items: () => DEFAULT_BRANCHED_MENU_ITEMS,\n    defaultOpen: 0,\n    defaultActive: '',\n    color: 'var(--foreground)',\n    accentColor: 'var(--foreground)',\n    lineColor: 'color-mix(in oklab, var(--foreground) 24%, var(--background))',\n    width: 240,\n    rowHeight: 36,\n    indent: 40,\n    trunk: 14,\n    radius: 10,\n    lineWidth: 1.5,\n    fontSize: 14,\n    drawDuration: 400,\n    foldDuration: 300,\n    class: undefined,\n  });\n\n  const emit = defineEmits<{\n    select: [value: string, item: BranchedMenuItem | BranchedMenuChild];\n    toggle: [index: number, open: boolean];\n  }>();\n\n  function toSet(open: number | number[]) {\n    return new Set(Array.isArray(open) ? open : open >= 0 ? [open] : []);\n  }\n\n  const open = ref(toSet(props.defaultOpen));\n  function initialActive() {\n    if (props.defaultActive) return props.defaultActive;\n    const first = props.items.find((it, i) => it.children && open.value.has(i));\n    return first?.children?.[0]?.value ?? '';\n  }\n  const active = ref(initialActive());\n\n  const navRef = ref<HTMLElement | null>(null);\n  const markerRef = ref<HTMLSpanElement | null>(null);\n\n  const activeSection = computed(() =>\n    props.items.findIndex((it) =>\n      it.children?.some((kid) => kid.value === active.value),\n    ),\n  );\n  const markerShown = computed(\n    () => activeSection.value >= 0 && open.value.has(activeSection.value),\n  );\n\n  function headAt(i: number) {\n    const el = navRef.value?.querySelectorAll('.branched-menu__head')[i];\n    return el instanceof HTMLElement ? el : null;\n  }\n\n  function place(glide: boolean) {\n    const m = markerRef.value;\n    if (!m) return;\n    const el = headAt(activeSection.value);\n    const on = markerShown.value && el;\n    if (!glide) m.style.transition = 'none';\n    if (on) m.style.top = `${on.offsetTop + (on.offsetHeight - MARK) / 2}px`;\n    m.toggleAttribute('data-on', Boolean(on));\n    if (!glide) {\n      void m.offsetHeight;\n      m.style.transition = '';\n    }\n  }\n\n  let firstResize = true;\n  useResizeObserver(navRef, () => {\n    if (firstResize) {\n      firstResize = false;\n      return;\n    }\n    place(false);\n  });\n  onMounted(() => place(true));\n  watch(\n    [\n      activeSection,\n      markerShown,\n      () => props.items,\n      () => props.fontSize,\n      () => props.rowHeight,\n    ],\n    () => place(true),\n    { flush: 'post' },\n  );\n\n  function select(value: string, item: BranchedMenuItem | BranchedMenuChild) {\n    active.value = value;\n    emit('select', value, item);\n  }\n\n  function toggle(i: number) {\n    const next = new Set(open.value);\n    const isOpen = !next.has(i);\n    if (isOpen) next.add(i);\n    else next.delete(i);\n    open.value = next;\n    emit('toggle', i, isOpen);\n  }\n\n  function leafValueOf(item: BranchedMenuItem) {\n    return item.value ?? item.label;\n  }\n\n  function onHeadClick(item: BranchedMenuItem, i: number) {\n    if (item.children) toggle(i);\n    else select(leafValueOf(item), item);\n  }\n\n  function onChildClick(kid: BranchedMenuChild) {\n    select(kid.value, kid);\n  }\n\n  const r = computed(() => Math.min(props.radius, props.rowHeight / 2 - 2));\n  const endX = computed(() => props.indent - 8);\n  function rowY(k: number) {\n    return PAD + k * props.rowHeight + props.rowHeight / 2;\n  }\n  function branchPath(k: number) {\n    const t = props.trunk;\n    return `M ${t} ${rowY(k) - r.value} A ${r.value} ${r.value} 0 0 0 ${t + r.value} ${rowY(k)} H ${endX.value}`;\n  }\n  function reachPath(k: number) {\n    const t = props.trunk;\n    return `M ${t} 0 V ${rowY(k) - r.value} A ${r.value} ${r.value} 0 0 0 ${t + r.value} ${rowY(k)} H ${endX.value}`;\n  }\n  function trunkPath(count: number) {\n    return `M ${props.trunk} 0 V ${rowY(count - 1) - r.value}`;\n  }\n  function lengthOf(k: number) {\n    return (\n      rowY(k) -\n      r.value +\n      (Math.PI * r.value) / 2 +\n      (endX.value - props.trunk - r.value)\n    );\n  }\n  function bodyHeight(kids: BranchedMenuChild[]) {\n    return PAD * 2 + kids.length * props.rowHeight;\n  }\n  function reachStyle(kid: BranchedMenuChild, k: number) {\n    const len = lengthOf(k);\n    return {\n      strokeDasharray: `${len}`,\n      strokeDashoffset: `${kid.value === active.value ? 0 : len}`,\n    };\n  }\n\n  const navStyle = computed(() => ({\n    '--bm-w': `${props.width}px`,\n    '--bm-ink': props.color,\n    '--bm-accent': props.accentColor,\n    '--bm-line': props.lineColor,\n    '--bm-font': `${props.fontSize}px`,\n    '--bm-row': `${props.rowHeight}px`,\n    '--bm-indent': `${props.indent}px`,\n    '--bm-line-w': String(props.lineWidth),\n    '--bm-draw': `${props.drawDuration}ms`,\n    '--bm-fold': `${props.foldDuration}ms`,\n  }));\n</script>\n\n<template>\n  <nav ref=\"navRef\" :class=\"['branched-menu', props.class]\" :style=\"navStyle\">\n    <span ref=\"markerRef\" class=\"branched-menu__marker\" aria-hidden=\"true\" />\n    <div\n      v-for=\"(item, i) in items\"\n      :key=\"item.value ?? item.label\"\n      class=\"branched-menu__section\"\n      :data-open=\"item.children && open.has(i) ? '' : undefined\"\n    >\n      <button\n        type=\"button\"\n        class=\"branched-menu__head\"\n        :aria-expanded=\"item.children ? open.has(i) : undefined\"\n        :aria-current=\"\n          !item.children && leafValueOf(item) === active ? 'true' : undefined\n        \"\n        :data-active=\"\n          !item.children && leafValueOf(item) === active ? '' : undefined\n        \"\n        @click=\"onHeadClick(item, i)\"\n      >\n        {{ item.label }}\n      </button>\n      <div\n        v-if=\"item.children\"\n        class=\"branched-menu__body\"\n        :inert=\"!open.has(i)\"\n      >\n        <div class=\"branched-menu__fold\">\n          <div\n            class=\"branched-menu__tree\"\n            :style=\"{ height: `${bodyHeight(item.children)}px` }\"\n          >\n            <svg\n              class=\"branched-menu__lines\"\n              :width=\"indent\"\n              :height=\"bodyHeight(item.children)\"\n              aria-hidden=\"true\"\n            >\n              <path\n                class=\"branched-menu__base\"\n                :d=\"trunkPath(item.children.length)\"\n              />\n              <path\n                v-for=\"(kid, k) in item.children\"\n                :key=\"`base-${kid.value}`\"\n                class=\"branched-menu__base\"\n                :d=\"branchPath(k)\"\n              />\n              <path\n                v-for=\"(kid, k) in item.children\"\n                :key=\"`reach-${kid.value}`\"\n                class=\"branched-menu__reach\"\n                :d=\"reachPath(k)\"\n                :style=\"reachStyle(kid, k)\"\n              />\n            </svg>\n            <button\n              v-for=\"kid in item.children\"\n              :key=\"kid.value\"\n              type=\"button\"\n              class=\"branched-menu__item\"\n              :aria-current=\"kid.value === active ? 'true' : undefined\"\n              :data-active=\"kid.value === active ? '' : undefined\"\n              :tabindex=\"open.has(i) ? 0 : -1\"\n              @click=\"onChildClick(kid)\"\n            >\n              <span\n                v-if=\"kid.icon\"\n                class=\"branched-menu__icon\"\n                aria-hidden=\"true\"\n              >\n                <Icon :name=\"kid.icon\" class=\"size-4\" />\n              </span>\n              <span class=\"branched-menu__label\">{{ kid.label }}</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </nav>\n</template>\n\n<style scoped>\n  .branched-menu {\n    --bm-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n    --bm-muted: color-mix(in srgb, var(--bm-ink) 55%, transparent);\n\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    width: fit-content;\n    max-width: min(var(--bm-w), 100%);\n    padding-left: 14px;\n    color: var(--bm-ink);\n    font-family: inherit;\n    font-size: var(--bm-font);\n    line-height: 1.2;\n  }\n\n  .branched-menu::before {\n    content: '';\n    position: absolute;\n    top: 8px;\n    bottom: 0;\n    left: 0;\n    width: 2px;\n    border-radius: 1px;\n    background: linear-gradient(\n      to bottom,\n      var(--bm-line) 0%,\n      var(--bm-line) 55%,\n      transparent 100%\n    );\n  }\n\n  .branched-menu__marker {\n    position: absolute;\n    top: -1px;\n    left: 0;\n    z-index: 1;\n    width: 2px;\n    height: 16px;\n    border-radius: 1px;\n    background: var(--bm-accent);\n    opacity: 0;\n    transition:\n      top 220ms var(--bm-ease-out),\n      opacity 150ms ease;\n  }\n\n  .branched-menu__marker[data-on] {\n    opacity: 1;\n  }\n\n  .branched-menu__section {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .branched-menu__head {\n    display: block;\n    margin: 0;\n    padding: 9px 0;\n    border: 0;\n    background: none;\n    color: var(--bm-muted);\n    font: inherit;\n    font-size: calc(var(--bm-font) + 1px);\n    font-weight: 500;\n    text-align: left;\n    cursor: pointer;\n    outline: none;\n    -webkit-tap-highlight-color: transparent;\n    transition: color 200ms ease;\n  }\n\n  .branched-menu__section[data-open] .branched-menu__head,\n  .branched-menu__head[data-active] {\n    color: var(--bm-ink);\n  }\n\n  .branched-menu__head:focus-visible,\n  .branched-menu__item:focus-visible {\n    color: var(--bm-ink);\n    outline: 2px solid color-mix(in srgb, var(--bm-accent) 60%, transparent);\n    outline-offset: 2px;\n    border-radius: 4px;\n  }\n\n  .branched-menu__item:focus-visible {\n    outline-offset: -2px;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .branched-menu__head:hover {\n      color: var(--bm-ink);\n    }\n  }\n\n  .branched-menu__body {\n    display: grid;\n    grid-template-rows: 0fr;\n    transition: grid-template-rows var(--bm-fold) var(--bm-ease-out);\n  }\n\n  .branched-menu__section[data-open] .branched-menu__body {\n    grid-template-rows: 1fr;\n  }\n\n  .branched-menu__fold {\n    min-height: 0;\n    overflow: hidden;\n  }\n\n  .branched-menu__tree {\n    position: relative;\n    padding: 6px 0;\n    box-sizing: border-box;\n  }\n\n  .branched-menu__lines {\n    position: absolute;\n    top: 0;\n    left: 0;\n    overflow: visible;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 200ms ease;\n  }\n\n  .branched-menu__section[data-open] .branched-menu__lines {\n    opacity: 1;\n    transition: opacity 250ms ease 100ms;\n  }\n\n  .branched-menu__base,\n  .branched-menu__reach {\n    fill: none;\n    stroke-width: var(--bm-line-w);\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .branched-menu__base {\n    stroke: var(--bm-line);\n  }\n\n  .branched-menu__reach {\n    stroke: var(--bm-accent);\n    transition: stroke-dashoffset var(--bm-draw) var(--bm-ease-out);\n  }\n\n  .branched-menu__item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    width: 100%;\n    height: var(--bm-row);\n    margin: 0;\n    padding: 0 0 0 var(--bm-indent);\n    border: 0;\n    background: none;\n    color: var(--bm-muted);\n    font: inherit;\n    text-align: left;\n    cursor: pointer;\n    outline: none;\n    box-sizing: border-box;\n    -webkit-tap-highlight-color: transparent;\n    transition: color 200ms ease;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .branched-menu__item:hover {\n      color: var(--bm-ink);\n    }\n  }\n\n  .branched-menu__item[data-active] {\n    color: var(--bm-accent);\n    font-weight: 500;\n  }\n\n  .branched-menu__icon {\n    display: inline-flex;\n    flex: none;\n  }\n\n  .branched-menu__label {\n    white-space: nowrap;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .branched-menu__marker {\n      transition: opacity 150ms ease;\n    }\n\n    .branched-menu__body {\n      transition: none;\n    }\n\n    .branched-menu__reach {\n      transition: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/branched-menu/BranchedMenu.vue"
    },
    {
      "path": "registry/new-york/branched-menu/default-items.ts",
      "content": "import type { BranchedMenuItem } from './types';\n\nexport const DEFAULT_BRANCHED_MENU_ITEMS: BranchedMenuItem[] = [\n  {\n    label: 'Getting started',\n    children: [\n      { value: 'install', label: 'Installation', icon: 'lucide:download' },\n      { value: 'quick', label: 'Quick start', icon: 'lucide:rocket' },\n      { value: 'config', label: 'Configuration', icon: 'lucide:settings' },\n      { value: 'theming', label: 'Theming', icon: 'lucide:palette' },\n    ],\n  },\n  {\n    label: 'Components',\n    children: [\n      { value: 'buttons', label: 'Buttons', icon: 'lucide:mouse-pointer-2' },\n      { value: 'typography', label: 'Typography', icon: 'lucide:type' },\n      { value: 'overlays', label: 'Overlays', icon: 'lucide:layers' },\n      { value: 'toasts', label: 'Toasts', icon: 'lucide:bell' },\n    ],\n  },\n];\n",
      "type": "registry:ui",
      "target": "components/ui/branched-menu/default-items.ts"
    },
    {
      "path": "registry/new-york/branched-menu/index.ts",
      "content": "export { default as BranchedMenu } from './BranchedMenu.vue';\nexport type {\n  BranchedMenuChild,\n  BranchedMenuItem,\n  BranchedMenuProps,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/branched-menu/index.ts"
    },
    {
      "path": "registry/new-york/branched-menu/types.ts",
      "content": "import type { HTMLAttributes } from 'vue';\n\nexport interface BranchedMenuChild {\n  value: string;\n  label: string;\n  /** Iconify name, e.g. `lucide:rocket`. */\n  icon?: string;\n}\n\nexport interface BranchedMenuItem {\n  label: string;\n  /** Value of a leaf section. Defaults to its label. */\n  value?: string;\n  /** A section with children folds; one without is a leaf that selects. */\n  children?: BranchedMenuChild[];\n}\n\nexport interface BranchedMenuProps {\n  /** Sections: a label plus children, or a leaf with a value. */\n  items?: BranchedMenuItem[];\n  /** The section, or sections, open at first. -1 for none. */\n  defaultOpen?: number | number[];\n  /** Value selected at first. Empty picks the open section's first child. */\n  defaultActive?: string;\n  /** The ink. Idle text is a mix of it. */\n  color?: string;\n  /** The active line, the active label and the marker. */\n  accentColor?: string;\n  /** The rail, trunk and branches. */\n  lineColor?: string;\n  /** The widest the menu may be, in px. It shrinks to its content. */\n  width?: number;\n  /** Height of a child row in px. */\n  rowHeight?: number;\n  /** Where child rows start, in px. Branches end just before it. */\n  indent?: number;\n  /** The trunk line's x position, in px. */\n  trunk?: number;\n  /** The curve of each branch, in px. */\n  radius?: number;\n  /** Stroke width of the lines. */\n  lineWidth?: number;\n  /** Child text size in px. Headers are 1px larger. */\n  fontSize?: number;\n  /** The accent line's travel, in ms. */\n  drawDuration?: number;\n  /** A section's fold and unfold, in ms. */\n  foldDuration?: number;\n  class?: HTMLAttributes['class'];\n}\n",
      "type": "registry:ui",
      "target": "components/ui/branched-menu/types.ts"
    }
  ]
}
