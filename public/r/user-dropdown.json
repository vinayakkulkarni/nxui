{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "user-dropdown",
  "type": "registry:ui",
  "title": "User Dropdown",
  "description": "An account card that grows into a user menu with key-cap shortcuts, side submenus for status, accounts and spaces, and a recessed footer.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/user-dropdown/UserDropdown.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, nextTick, ref, useId, watch } from 'vue';\n  import {\n    onClickOutside,\n    usePreferredReducedMotion,\n    useTimeoutFn,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import UserDropdownAvatar from './UserDropdownAvatar.vue';\n  import UserDropdownRow from './UserDropdownRow.vue';\n  import UserDropdownSubmenu from './UserDropdownSubmenu.vue';\n  import {\n    badgeClass,\n    initialsOf,\n    SUBMENU_GAP,\n    SUBMENU_WIDTH,\n  } from './user-dropdown-styles';\n  import type {\n    UserDropdownEmits,\n    UserDropdownEntry,\n    UserDropdownItem,\n    UserDropdownNavMode,\n    UserDropdownProps,\n    UserDropdownSection,\n    UserDropdownSubmenuPosition,\n  } from './types';\n\n  const props = withDefaults(defineProps<UserDropdownProps>(), {\n    open: false,\n    closeOnSelect: true,\n    accent: '#3d63dd',\n    label: '',\n    class: '',\n  });\n  const emit = defineEmits<UserDropdownEmits>();\n\n  const uid = useId();\n  const menuId = `ud-menu-${uid}`;\n  const submenuDomId = `ud-sub-${uid}`;\n\n  const root = ref<HTMLElement | null>(null);\n  const trigger = ref<HTMLButtonElement | null>(null);\n  const menu = ref<HTMLElement | null>(null);\n\n  const reducedMotion = usePreferredReducedMotion();\n  const animate = computed(() => reducedMotion.value !== 'reduce');\n\n  const isOpen = ref(props.open);\n  const activeIndex = ref(-1);\n  const navMode = ref<UserDropdownNavMode>('pointer');\n  const submenuId = ref<string | null>(null);\n  const subIndex = ref(-1);\n  const EDGE: UserDropdownSubmenuPosition = { side: 'right', top: 0 };\n  const subPosition = ref<UserDropdownSubmenuPosition>(EDGE);\n\n  const cardSections = computed(() =>\n    props.sections.filter((section) => !section.footer),\n  );\n  const footerSections = computed(() =>\n    props.sections.filter((section) => section.footer),\n  );\n  const entries = computed<UserDropdownEntry[]>(() => {\n    const ordered: UserDropdownSection[] = [\n      ...cardSections.value,\n      ...footerSections.value,\n    ];\n    return ordered\n      .flatMap((section) => section.items)\n      .map((item, index) => ({ item, index }));\n  });\n  const indexById = computed(() => {\n    const map = new Map<string, number>();\n    for (const entry of entries.value) map.set(entry.item.id, entry.index);\n    return map;\n  });\n  const submenuItem = computed<UserDropdownItem | null>(() => {\n    if (!submenuId.value) return null;\n    const index = indexById.value.get(submenuId.value);\n    return index === undefined ? null : (entries.value[index]?.item ?? null);\n  });\n  const subCount = computed(() => {\n    const item = submenuItem.value;\n    if (!item) return 0;\n    return (item.children?.length ?? 0) + (item.submenuInput ? 1 : 0);\n  });\n\n  const activeId = computed(\n    () => entries.value[activeIndex.value]?.item.id ?? null,\n  );\n\n  const triggerLabel = computed(\n    () => props.label || `Account menu for ${props.user.name}`,\n  );\n  const initials = computed(\n    () => props.user.initials ?? initialsOf(props.user.name),\n  );\n  const rootStyle = computed(() => ({ '--ud-accent': props.accent }));\n\n  watch(\n    () => props.open,\n    (value) => {\n      if (value !== isOpen.value) setOpen(value);\n    },\n  );\n\n  function setOpen(value: boolean): void {\n    if (isOpen.value === value) return;\n    isOpen.value = value;\n    if (!value) {\n      submenuId.value = null;\n      subIndex.value = -1;\n      activeIndex.value = -1;\n    }\n    emit('update:open', value);\n  }\n\n  function isEnabled(index: number): boolean {\n    const entry = entries.value[index];\n    return Boolean(entry && !entry.item.disabled);\n  }\n\n  function step(from: number, delta: number): number {\n    const total = entries.value.length;\n    if (!total) return -1;\n    let next = from;\n    for (let tries = 0; tries < total; tries += 1) {\n      next = (next + delta + total) % total;\n      if (isEnabled(next)) return next;\n    }\n    return -1;\n  }\n\n  function rowElement(index: number): HTMLElement | null {\n    const entry = entries.value[index];\n    if (!entry || !root.value) return null;\n    return root.value.querySelector<HTMLElement>(\n      `[data-ud-id=\"${CSS.escape(entry.item.id)}\"]`,\n    );\n  }\n\n  function subElement(index: number): HTMLElement | null {\n    if (!root.value) return null;\n    return root.value.querySelector<HTMLElement>(\n      `#${CSS.escape(submenuDomId)} [data-ud-sub-index=\"${index}\"]`,\n    );\n  }\n\n  function focusRow(\n    index: number,\n    mode: UserDropdownNavMode,\n    move = true,\n  ): void {\n    activeIndex.value = index;\n    navMode.value = mode;\n    if (move) rowElement(index)?.focus({ preventScroll: true });\n  }\n\n  function focusSub(\n    index: number,\n    mode: UserDropdownNavMode,\n    move = true,\n  ): void {\n    subIndex.value = index;\n    navMode.value = mode;\n    if (move) subElement(index)?.focus({ preventScroll: true });\n  }\n\n  async function openMenu(focus: 'first' | 'last' | 'none'): Promise<void> {\n    setOpen(true);\n    await nextTick();\n    if (focus === 'none') {\n      menu.value?.focus({ preventScroll: true });\n      return;\n    }\n    const start = focus === 'first' ? step(-1, 1) : step(0, -1);\n    focusRow(start, 'keyboard');\n  }\n\n  function closeMenu(returnFocus: boolean): void {\n    setOpen(false);\n    if (returnFocus) trigger.value?.focus({ preventScroll: true });\n  }\n\n  function measureSubmenu(index: number): UserDropdownSubmenuPosition {\n    const row = rowElement(index);\n    const host = root.value;\n    const entry = entries.value[index];\n    if (!row || !host || !entry) return EDGE;\n    const hostRect = host.getBoundingClientRect();\n    const rowRect = row.getBoundingClientRect();\n    const rowTop = rowRect.top - hostRect.top;\n    const rowBottom = hostRect.bottom - rowRect.bottom;\n    const lower = rowTop > hostRect.height / 2;\n    const beside = lower ? { bottom: rowBottom - 6 } : { top: rowTop - 8 };\n    const need = SUBMENU_WIDTH + SUBMENU_GAP;\n    const roomRight = window.innerWidth - hostRect.right >= need;\n    const roomLeft = hostRect.left >= need;\n    const preferred = entry.item.submenuSide ?? 'right';\n    if (preferred === 'left' && roomLeft) return { side: 'left', ...beside };\n    if (preferred === 'right' && roomRight) return { side: 'right', ...beside };\n    if (roomRight) return { side: 'right', ...beside };\n    if (roomLeft) return { side: 'left', ...beside };\n    if (lower)\n      return { side: 'inside', bottom: rowBottom + rowRect.height + 4 };\n    return { side: 'inside', top: rowTop + rowRect.height + 4 };\n  }\n\n  async function openSubmenu(\n    index: number,\n    focusFirst: boolean,\n  ): Promise<void> {\n    const entry = entries.value[index];\n    if (!entry || entry.item.kind !== 'submenu') return;\n    cancelClose();\n    subPosition.value = measureSubmenu(index);\n    submenuId.value = entry.item.id;\n    subIndex.value = -1;\n    if (!focusFirst) return;\n    await nextTick();\n    focusSub(0, 'keyboard');\n  }\n\n  function closeSubmenu(returnFocus: boolean): void {\n    const index = submenuId.value\n      ? indexById.value.get(submenuId.value)\n      : undefined;\n    submenuId.value = null;\n    subIndex.value = -1;\n    if (returnFocus && index !== undefined) focusRow(index, 'keyboard');\n  }\n\n  const { start: scheduleClose, stop: cancelClose } = useTimeoutFn(\n    () => closeSubmenu(false),\n    220,\n    { immediate: false },\n  );\n  const { start: scheduleOpen, stop: cancelOpen } = useTimeoutFn(\n    () => {\n      if (activeIndex.value >= 0) openSubmenu(activeIndex.value, false);\n    },\n    120,\n    { immediate: false },\n  );\n\n  function activate(index: number, viaKeyboard: boolean): void {\n    const entry = entries.value[index];\n    if (!entry || entry.item.disabled) return;\n    const { item } = entry;\n    const kind = item.kind ?? 'item';\n    if (kind === 'submenu') {\n      if (submenuId.value === item.id && !viaKeyboard) closeSubmenu(false);\n      else openSubmenu(index, viaKeyboard);\n      return;\n    }\n    if (kind === 'switch') {\n      emit('toggle', item, !item.checked);\n      emit('select', item);\n      return;\n    }\n    emit('select', item);\n    if (props.closeOnSelect) closeMenu(viaKeyboard);\n  }\n\n  function activateSub(index: number, viaKeyboard: boolean): void {\n    const item = submenuItem.value;\n    const child = item?.children?.[index];\n    if (!item || !child || child.disabled) return;\n    emit('select', item, child);\n    closeSubmenu(viaKeyboard);\n  }\n\n  function onTriggerClick(): void {\n    if (isOpen.value) closeMenu(false);\n    else openMenu('none');\n  }\n\n  function onTriggerKeydown(event: KeyboardEvent): void {\n    if (\n      event.key === 'ArrowDown' ||\n      event.key === 'Enter' ||\n      event.key === ' '\n    ) {\n      event.preventDefault();\n      openMenu('first');\n    } else if (event.key === 'ArrowUp') {\n      event.preventDefault();\n      openMenu('last');\n    } else if (event.key === 'Escape' && isOpen.value) {\n      event.preventDefault();\n      closeMenu(true);\n    }\n  }\n\n  let typeBuffer = '';\n  const { start: resetTypeahead } = useTimeoutFn(\n    () => {\n      typeBuffer = '';\n    },\n    500,\n    { immediate: false },\n  );\n\n  function matchShortcut(key: string): number {\n    const lower = key.toLowerCase();\n    const found = entries.value.find(\n      (entry) =>\n        !entry.item.disabled && entry.item.shortcut?.toLowerCase() === lower,\n    );\n    return found ? found.index : -1;\n  }\n\n  function typeahead(key: string): void {\n    typeBuffer += key.toLowerCase();\n    resetTypeahead();\n    const total = entries.value.length;\n    for (let offset = 1; offset <= total; offset += 1) {\n      const index = (activeIndex.value + offset + total) % total;\n      const entry = entries.value[index];\n      if (\n        entry &&\n        isEnabled(index) &&\n        entry.item.label.toLowerCase().startsWith(typeBuffer)\n      ) {\n        focusRow(index, 'keyboard');\n        return;\n      }\n    }\n  }\n\n  function onMenuKeydown(event: KeyboardEvent): void {\n    if (submenuId.value && subIndex.value >= 0) {\n      onSubKeydown(event);\n      return;\n    }\n    const { key } = event;\n    const current = activeIndex.value;\n    const entry = entries.value[current];\n    if (key === 'ArrowDown' || key === 'ArrowUp') {\n      event.preventDefault();\n      closeSubmenu(false);\n      focusRow(\n        step(\n          current < 0 && key === 'ArrowUp' ? 0 : current,\n          key === 'ArrowDown' ? 1 : -1,\n        ),\n        'keyboard',\n      );\n    } else if (key === 'Home' || key === 'End') {\n      event.preventDefault();\n      closeSubmenu(false);\n      focusRow(key === 'Home' ? step(-1, 1) : step(0, -1), 'keyboard');\n    } else if (key === 'Enter' || key === ' ') {\n      event.preventDefault();\n      if (current >= 0) {\n        if (entry?.item.href && !entry.item.disabled)\n          rowElement(current)?.click();\n        else activate(current, true);\n      }\n    } else if (key === 'ArrowRight' || key === 'ArrowLeft') {\n      if (entry?.item.kind === 'submenu') {\n        event.preventDefault();\n        openSubmenu(current, true);\n      }\n    } else if (key === 'Escape') {\n      event.preventDefault();\n      closeMenu(true);\n    } else if (key === 'Tab') {\n      closeMenu(false);\n    } else if (\n      key.length === 1 &&\n      !event.metaKey &&\n      !event.ctrlKey &&\n      !event.altKey\n    ) {\n      const hit = matchShortcut(key);\n      if (hit >= 0) {\n        event.preventDefault();\n        focusRow(hit, 'keyboard');\n        activate(hit, true);\n      } else if (key !== ' ') {\n        typeahead(key);\n      }\n    }\n  }\n\n  function onSubKeydown(event: KeyboardEvent): void {\n    event.stopPropagation();\n    const total = subCount.value;\n    const { key } = event;\n    const back = subPosition.value.side === 'left' ? 'ArrowRight' : 'ArrowLeft';\n    if (key === 'ArrowDown' || key === 'ArrowUp') {\n      event.preventDefault();\n      const delta = key === 'ArrowDown' ? 1 : -1;\n      const from = subIndex.value < 0 && delta < 0 ? 0 : subIndex.value;\n      focusSub((from + delta + total) % total, 'keyboard');\n    } else if (key === 'Home' || key === 'End') {\n      event.preventDefault();\n      focusSub(key === 'Home' ? 0 : total - 1, 'keyboard');\n    } else if (key === 'Enter' || key === ' ') {\n      event.preventDefault();\n      if (subIndex.value >= 0) activateSub(subIndex.value, true);\n    } else if (key === 'Escape' || key === back) {\n      event.preventDefault();\n      closeSubmenu(true);\n    } else if (key === 'Tab') {\n      closeMenu(false);\n    }\n  }\n\n  function isRowActive(id: string): boolean {\n    if (activeId.value !== id) return false;\n    return submenuId.value !== id || subIndex.value < 0;\n  }\n\n  function onRowActivate(id: string): void {\n    const index = indexById.value.get(id);\n    if (index !== undefined) activate(index, false);\n  }\n\n  function onSubActivate(index: number): void {\n    activateSub(index, false);\n  }\n\n  function onRowHover(id: string): void {\n    const index = indexById.value.get(id);\n    if (index === undefined) return;\n    if (activeIndex.value === index && navMode.value === 'pointer') return;\n    focusRow(index, 'pointer', false);\n    menu.value?.focus({ preventScroll: true });\n    const entry = entries.value[index];\n    cancelOpen();\n    if (entry?.item.kind === 'submenu') {\n      cancelClose();\n      if (submenuId.value !== entry.item.id) scheduleOpen();\n    } else if (submenuId.value) {\n      scheduleClose();\n    }\n  }\n\n  function onSubHover(index: number): void {\n    cancelClose();\n    if (subIndex.value === index && navMode.value === 'pointer') return;\n    focusSub(index, 'pointer', false);\n  }\n\n  function onSubSubmit(value: string): void {\n    const item = submenuItem.value;\n    if (!item) return;\n    emit('submit', item, value);\n    closeSubmenu(true);\n  }\n\n  function onMenuPointerLeave(): void {\n    if (navMode.value === 'pointer' && !submenuId.value) activeIndex.value = -1;\n  }\n\n  onClickOutside(root, () => {\n    if (isOpen.value) closeMenu(false);\n  });\n\n  function highlight(id: string | null): void {\n    if (id === null) {\n      activeIndex.value = -1;\n      return;\n    }\n    const index = indexById.value.get(id);\n    if (index !== undefined) focusRow(index, 'keyboard', false);\n  }\n\n  function highlightSub(index: number): void {\n    focusSub(index, 'keyboard', false);\n  }\n\n  function showSubmenu(id: string): void {\n    const index = indexById.value.get(id);\n    if (index !== undefined) openSubmenu(index, false);\n  }\n\n  defineExpose({\n    open: () => setOpen(true),\n    close: () => setOpen(false),\n    highlight,\n    highlightSub,\n    showSubmenu,\n    hideSubmenu: () => closeSubmenu(false),\n  });\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    :class=\"cn('relative w-68 max-w-full text-left', props.class)\"\n    :style=\"rootStyle\"\n  >\n    <div\n      :class=\"\n        cn(\n          'overflow-hidden rounded-[18px] bg-muted ring-1 ring-black/6 dark:bg-background dark:ring-white/8',\n          'shadow-[0_18px_40px_-14px_rgb(0_0_0/0.22),0_3px_8px_-3px_rgb(0_0_0/0.08)] dark:shadow-[0_24px_48px_-12px_rgb(0_0_0/0.75)]',\n        )\n      \"\n    >\n      <div class=\"relative z-1 bg-card p-1.5\">\n        <button\n          ref=\"trigger\"\n          type=\"button\"\n          aria-haspopup=\"menu\"\n          :aria-expanded=\"isOpen\"\n          :aria-controls=\"menuId\"\n          :aria-label=\"triggerLabel\"\n          class=\"flex w-full cursor-pointer items-center gap-3 rounded-xl p-1.5 pr-2 text-left outline-none focus-visible:ring-[1.5px] focus-visible:ring-(--ud-accent)\"\n          @click=\"onTriggerClick\"\n          @keydown=\"onTriggerKeydown\"\n        >\n          <Transition\n            mode=\"out-in\"\n            :css=\"animate\"\n            enter-active-class=\"transition duration-300 ease-out\"\n            enter-from-class=\"scale-75 opacity-0 blur-xs\"\n            leave-active-class=\"transition duration-150 ease-in\"\n            leave-to-class=\"scale-75 opacity-0 blur-xs\"\n          >\n            <UserDropdownAvatar\n              :key=\"user.name\"\n              :src=\"user.avatar\"\n              :background=\"user.avatarBackground\"\n              :initials=\"initials\"\n            />\n          </Transition>\n          <Transition\n            mode=\"out-in\"\n            :css=\"animate\"\n            enter-active-class=\"transition duration-300 ease-out\"\n            enter-from-class=\"translate-y-1 opacity-0 blur-xs\"\n            leave-active-class=\"transition duration-150 ease-in\"\n            leave-to-class=\"-translate-y-1 opacity-0 blur-xs\"\n          >\n            <span :key=\"user.name\" class=\"flex min-w-0 flex-1 flex-col\">\n              <span\n                class=\"truncate text-[15px]/5 font-semibold text-foreground\"\n              >\n                {{ user.name }}\n              </span>\n              <span\n                v-if=\"user.email\"\n                class=\"truncate text-xs/4 text-muted-foreground\"\n              >\n                {{ user.email }}\n              </span>\n            </span>\n          </Transition>\n          <span\n            v-if=\"user.badge\"\n            :class=\"\n              cn(\n                'shrink-0 self-start rounded-md px-1.5 py-px text-[10px]/4 font-medium',\n                badgeClass(user.badgeTone ?? 'success'),\n              )\n            \"\n          >\n            {{ user.badge }}\n          </span>\n        </button>\n      </div>\n\n      <div\n        :class=\"\n          cn(\n            'grid',\n            animate &&\n              'transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]',\n            isOpen ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]',\n          )\n        \"\n      >\n        <div class=\"min-h-0 overflow-hidden\">\n          <div\n            :id=\"menuId\"\n            ref=\"menu\"\n            role=\"menu\"\n            tabindex=\"-1\"\n            :aria-label=\"triggerLabel\"\n            :inert=\"!isOpen\"\n            :class=\"\n              cn(\n                'outline-none',\n                animate && 'transition-opacity duration-200',\n                isOpen ? 'opacity-100' : 'opacity-0',\n              )\n            \"\n            @keydown=\"onMenuKeydown\"\n            @pointerleave=\"onMenuPointerLeave\"\n          >\n            <div\n              class=\"rounded-b-[18px] bg-card shadow-[0_8px_14px_-10px_rgb(0_0_0/0.18)] dark:shadow-[0_10px_18px_-8px_rgb(0_0_0/0.9)]\"\n            >\n              <div\n                v-for=\"(section, sIndex) in cardSections\"\n                :key=\"section.id\"\n                role=\"group\"\n                :class=\"\n                  cn(\n                    'py-1.5',\n                    sIndex === 0 ? 'pt-0' : 'border-t border-border/70',\n                  )\n                \"\n              >\n                <UserDropdownRow\n                  v-for=\"item in section.items\"\n                  :key=\"item.id\"\n                  :item=\"item\"\n                  :active=\"isRowActive(item.id)\"\n                  :keyboard=\"navMode === 'keyboard'\"\n                  :expanded=\"submenuId === item.id\"\n                  :submenu-id=\"submenuDomId\"\n                  @activate=\"onRowActivate(item.id)\"\n                  @hover=\"onRowHover(item.id)\"\n                />\n              </div>\n            </div>\n            <div\n              v-for=\"section in footerSections\"\n              :key=\"section.id\"\n              role=\"group\"\n              class=\"py-1.5 first-of-type:pt-2.5\"\n            >\n              <UserDropdownRow\n                v-for=\"item in section.items\"\n                :key=\"item.id\"\n                :item=\"item\"\n                :active=\"isRowActive(item.id)\"\n                :keyboard=\"navMode === 'keyboard'\"\n                :expanded=\"submenuId === item.id\"\n                :submenu-id=\"submenuDomId\"\n                @activate=\"onRowActivate(item.id)\"\n                @hover=\"onRowHover(item.id)\"\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <Transition\n      :css=\"animate\"\n      enter-active-class=\"transition duration-200 ease-out\"\n      enter-from-class=\"scale-96 opacity-0 blur-xs\"\n      leave-active-class=\"transition duration-150 ease-in\"\n      leave-to-class=\"scale-96 opacity-0 blur-xs\"\n    >\n      <UserDropdownSubmenu\n        v-if=\"isOpen && submenuItem\"\n        :key=\"submenuItem.id\"\n        :item=\"submenuItem\"\n        :active-index=\"subIndex\"\n        :keyboard=\"navMode === 'keyboard'\"\n        :position=\"subPosition\"\n        :menu-id=\"submenuDomId\"\n        @activate=\"onSubActivate\"\n        @hover=\"onSubHover\"\n        @keydown=\"onSubKeydown\"\n        @submit=\"onSubSubmit\"\n        @pointerenter=\"cancelClose\"\n      />\n    </Transition>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/user-dropdown/UserDropdown.vue"
    },
    {
      "path": "registry/new-york/user-dropdown/UserDropdownAvatar.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import { cn } from '~/lib/utils';\n  import type { UserDropdownAvatarProps } from './types';\n\n  const props = withDefaults(defineProps<UserDropdownAvatarProps>(), {\n    src: undefined,\n    background: undefined,\n    initials: '',\n    square: false,\n    class: '',\n  });\n\n  const fill = computed(() =>\n    props.background ? { background: props.background } : undefined,\n  );\n</script>\n\n<template>\n  <span\n    aria-hidden=\"true\"\n    :class=\"\n      cn(\n        'relative inline-flex size-9 shrink-0 items-center justify-center overflow-hidden bg-muted text-xs font-semibold text-muted-foreground ring-1 ring-black/5 dark:ring-white/10',\n        square ? 'rounded-[28%]' : 'rounded-full',\n        props.class,\n      )\n    \"\n    :style=\"fill\"\n  >\n    <img\n      v-if=\"src\"\n      :src=\"src\"\n      alt=\"\"\n      class=\"size-full object-cover\"\n      draggable=\"false\"\n    />\n    <span v-else-if=\"!background\">{{ initials }}</span>\n  </span>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/user-dropdown/UserDropdownAvatar.vue"
    },
    {
      "path": "registry/new-york/user-dropdown/UserDropdownRow.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import { cn } from '~/lib/utils';\n  import { badgeClass } from './user-dropdown-styles';\n  import type { UserDropdownRowEmits, UserDropdownRowProps } from './types';\n\n  const props = withDefaults(defineProps<UserDropdownRowProps>(), {\n    active: false,\n    keyboard: false,\n    expanded: false,\n    submenuId: undefined,\n  });\n  const emit = defineEmits<UserDropdownRowEmits>();\n\n  const kind = computed(() => props.item.kind ?? 'item');\n  const isLink = computed(\n    () => Boolean(props.item.href) && !props.item.disabled,\n  );\n  const role = computed(() =>\n    kind.value === 'switch' ? 'menuitemcheckbox' : 'menuitem',\n  );\n  const chevron = computed(() =>\n    props.item.submenuSide === 'left'\n      ? 'lucide:chevron-left'\n      : 'lucide:chevron-right',\n  );\n\n  function onClick(event: MouseEvent): void {\n    if (props.item.disabled) {\n      event.preventDefault();\n      return;\n    }\n    emit('activate');\n  }\n\n  function onHover(): void {\n    emit('hover');\n  }\n</script>\n\n<template>\n  <component\n    :is=\"isLink ? 'a' : 'div'\"\n    :role=\"role\"\n    tabindex=\"-1\"\n    :data-ud-id=\"item.id\"\n    :href=\"isLink ? item.href : undefined\"\n    :target=\"isLink && item.external ? '_blank' : undefined\"\n    :rel=\"isLink && item.external ? 'noopener noreferrer' : undefined\"\n    :aria-checked=\"kind === 'switch' ? Boolean(item.checked) : undefined\"\n    :aria-haspopup=\"kind === 'submenu' ? 'menu' : undefined\"\n    :aria-expanded=\"kind === 'submenu' ? expanded : undefined\"\n    :aria-controls=\"kind === 'submenu' && expanded ? submenuId : undefined\"\n    :aria-disabled=\"item.disabled ? true : undefined\"\n    :class=\"\n      cn(\n        'relative mx-1.5 flex h-9 cursor-pointer items-center gap-2.5 rounded-[10px] px-2.5 text-sm font-medium text-foreground no-underline outline-none select-none',\n        'transition-[background-color,box-shadow,color] duration-150',\n        item.muted && 'text-muted-foreground',\n        item.danger && 'text-red-600 dark:text-red-400',\n        item.disabled && 'cursor-not-allowed opacity-50',\n        active && !keyboard && 'bg-foreground/5',\n        expanded && 'bg-card shadow-sm ring-1 ring-border',\n        active &&\n          keyboard &&\n          'bg-card shadow-sm ring-[1.5px] ring-(--ud-accent) dark:bg-foreground/5',\n      )\n    \"\n    @click=\"onClick\"\n    @pointermove=\"onHover\"\n  >\n    <Icon\n      v-if=\"item.icon\"\n      :name=\"item.icon\"\n      :class=\"\n        cn(\n          'size-4.5 shrink-0',\n          item.danger ? 'text-current' : 'text-foreground/65',\n          item.iconClass,\n        )\n      \"\n    />\n    <span class=\"min-w-0 flex-1 truncate\">{{ item.label }}</span>\n\n    <span\n      v-if=\"kind === 'switch'\"\n      aria-hidden=\"true\"\n      :class=\"\n        cn(\n          'relative inline-flex h-4.5 w-8 shrink-0 items-center rounded-full p-0.5 transition-colors duration-200',\n          item.checked ? 'bg-(--ud-accent)' : 'bg-foreground/15',\n        )\n      \"\n    >\n      <span\n        :class=\"\n          cn(\n            'size-3.5 rounded-full bg-white shadow-sm transition-transform duration-200 ease-out',\n            item.checked ? 'translate-x-3.5' : 'translate-x-0',\n          )\n        \"\n      />\n    </span>\n    <span\n      v-else-if=\"item.badge\"\n      :class=\"\n        cn(\n          'shrink-0 rounded-[5px] px-1.5 py-px text-[10px]/4 font-semibold',\n          badgeClass(item.badgeTone ?? 'accent'),\n        )\n      \"\n    >\n      {{ item.badge }}\n    </span>\n    <span\n      v-else-if=\"item.swatch\"\n      aria-hidden=\"true\"\n      class=\"size-4.5 shrink-0 rounded-[5px] ring-1 ring-black/5 dark:ring-white/10\"\n      :style=\"{ background: item.swatch }\"\n    />\n    <kbd\n      v-else-if=\"item.shortcut\"\n      class=\"inline-flex h-5 min-w-5 shrink-0 items-center justify-center rounded-[5px] border border-border bg-card px-1 font-sans text-[10px] font-medium text-muted-foreground shadow-xs\"\n    >\n      {{ item.shortcut.toUpperCase() }}\n    </kbd>\n    <Icon\n      v-else-if=\"item.external\"\n      name=\"lucide:external-link\"\n      class=\"size-4 shrink-0 text-muted-foreground\"\n    />\n    <Icon\n      v-else-if=\"kind === 'submenu'\"\n      :name=\"chevron\"\n      class=\"size-4 shrink-0 text-muted-foreground\"\n    />\n  </component>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/user-dropdown/UserDropdownRow.vue"
    },
    {
      "path": "registry/new-york/user-dropdown/UserDropdownSubmenu.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref } from 'vue';\n  import { cn } from '~/lib/utils';\n  import UserDropdownAvatar from './UserDropdownAvatar.vue';\n  import type {\n    UserDropdownSubItem,\n    UserDropdownSubmenuEmits,\n    UserDropdownSubmenuProps,\n  } from './types';\n\n  const props = defineProps<UserDropdownSubmenuProps>();\n  const emit = defineEmits<UserDropdownSubmenuEmits>();\n\n  const EMPTY: UserDropdownSubItem[] = [];\n  const children = computed(() => props.item.children ?? EMPTY);\n  const draft = ref('');\n\n  const placement = computed(() => {\n    const { side, top, bottom } = props.position;\n    const vertical =\n      bottom === undefined\n        ? { top: `${top ?? 0}px` }\n        : { bottom: `${bottom}px` };\n    if (side === 'inside') return { ...vertical, left: '12px', right: '12px' };\n    if (side === 'left') return { ...vertical, right: 'calc(100% + 8px)' };\n    return { ...vertical, left: 'calc(100% + 8px)' };\n  });\n  const origin = computed(() => {\n    const fromTop = props.position.bottom === undefined;\n    if (props.position.side === 'left') {\n      return fromTop ? 'origin-top-right' : 'origin-bottom-right';\n    }\n    if (props.position.side === 'right') {\n      return fromTop ? 'origin-top-left' : 'origin-bottom-left';\n    }\n    return fromTop ? 'origin-top' : 'origin-bottom';\n  });\n\n  function roleOf(child: UserDropdownSubItem): string {\n    return child.checked === undefined ? 'menuitem' : 'menuitemradio';\n  }\n\n  function onActivate(event: MouseEvent): void {\n    const target = event.currentTarget;\n    if (!(target instanceof HTMLElement)) return;\n    emit('activate', Number(target.dataset.udSubIndex));\n  }\n\n  function onHover(event: PointerEvent): void {\n    const target = event.currentTarget;\n    if (!(target instanceof HTMLElement)) return;\n    emit('hover', Number(target.dataset.udSubIndex));\n  }\n\n  function onKeydown(event: KeyboardEvent): void {\n    emit('keydown', event);\n  }\n\n  function onPointerEnter(): void {\n    emit('pointerenter');\n  }\n\n  function onInputKeydown(event: KeyboardEvent): void {\n    if (event.key === 'Enter') {\n      event.preventDefault();\n      event.stopPropagation();\n      const value = draft.value.trim();\n      if (value) emit('submit', value);\n      draft.value = '';\n      return;\n    }\n    if (event.key === 'ArrowUp' || event.key === 'Escape') {\n      emit('keydown', event);\n      return;\n    }\n    event.stopPropagation();\n  }\n\n  function onInputFocus(): void {\n    emit('hover', children.value.length);\n  }\n</script>\n\n<template>\n  <div\n    :id=\"menuId\"\n    role=\"menu\"\n    :aria-label=\"item.submenuTitle ?? item.label\"\n    :class=\"\n      cn(\n        'absolute z-20 w-58 rounded-2xl bg-card pb-1.5 shadow-[0_12px_32px_-8px_rgb(0_0_0/0.18),0_2px_6px_-2px_rgb(0_0_0/0.08)] ring-1 ring-black/6 dark:shadow-[0_16px_40px_-8px_rgb(0_0_0/0.7)] dark:ring-white/10',\n        origin,\n      )\n    \"\n    :style=\"placement\"\n    @keydown=\"onKeydown\"\n    @pointerenter=\"onPointerEnter\"\n  >\n    <p\n      v-if=\"item.submenuTitle\"\n      class=\"px-4 pt-3 pb-1.5 text-xs font-medium text-muted-foreground\"\n    >\n      {{ item.submenuTitle }}\n    </p>\n    <div v-else class=\"h-1.5\" />\n    <div\n      v-for=\"(child, index) in children\"\n      :key=\"child.id\"\n      :role=\"roleOf(child)\"\n      tabindex=\"-1\"\n      :data-ud-sub-index=\"index\"\n      :aria-checked=\"child.checked === undefined ? undefined : child.checked\"\n      :aria-disabled=\"child.disabled ? true : undefined\"\n      :class=\"\n        cn(\n          'mx-1.5 flex h-9 cursor-pointer items-center gap-2.5 rounded-[10px] px-2.5 text-sm font-medium text-foreground outline-none select-none',\n          'transition-[background-color,box-shadow] duration-150',\n          child.action && 'mt-1 border border-border shadow-xs',\n          child.disabled && 'cursor-not-allowed opacity-50',\n          activeIndex === index && !keyboard && 'bg-foreground/5',\n          activeIndex === index &&\n            keyboard &&\n            'border-transparent bg-card shadow-sm ring-[1.5px] ring-(--ud-accent) dark:bg-foreground/5',\n        )\n      \"\n      @click=\"onActivate\"\n      @pointermove=\"onHover\"\n    >\n      <UserDropdownAvatar\n        v-if=\"child.avatar || child.avatarBackground\"\n        :src=\"child.avatar\"\n        :background=\"child.avatarBackground\"\n        :square=\"child.square\"\n        class=\"size-4.5\"\n      />\n      <Icon\n        v-else-if=\"child.icon\"\n        :name=\"child.icon\"\n        class=\"size-4.5 shrink-0 text-foreground/70\"\n      />\n      <span class=\"min-w-0 flex-1 truncate\">{{ child.label }}</span>\n      <Icon\n        v-if=\"child.checked\"\n        name=\"lucide:check\"\n        class=\"size-3.5 shrink-0 text-foreground/70\"\n      />\n      <kbd\n        v-if=\"child.shortcut\"\n        class=\"inline-flex h-5 min-w-5 shrink-0 items-center justify-center rounded-[5px] border border-border bg-card px-1 font-sans text-[10px] font-medium text-muted-foreground shadow-xs\"\n      >\n        {{ child.shortcut }}\n      </kbd>\n    </div>\n    <label\n      v-if=\"item.submenuInput\"\n      :class=\"\n        cn(\n          'mx-1.5 mt-1 flex h-9 items-center gap-2.5 rounded-[10px] border border-border px-2.5 transition-shadow duration-150',\n          activeIndex === children.length &&\n            keyboard &&\n            'border-transparent ring-[1.5px] ring-(--ud-accent)',\n        )\n      \"\n    >\n      <Icon name=\"lucide:smile\" class=\"size-4.5 shrink-0 text-foreground/50\" />\n      <input\n        v-model=\"draft\"\n        type=\"text\"\n        :data-ud-sub-index=\"children.length\"\n        :placeholder=\"item.submenuInput\"\n        :aria-label=\"item.submenuInput\"\n        class=\"min-w-0 flex-1 bg-transparent text-sm text-foreground outline-none placeholder:text-muted-foreground/70\"\n        @keydown=\"onInputKeydown\"\n        @focus=\"onInputFocus\"\n      />\n      <kbd\n        class=\"inline-flex h-5 min-w-5 shrink-0 items-center justify-center rounded-[5px] border border-border bg-card px-1 text-muted-foreground shadow-xs\"\n        aria-hidden=\"true\"\n      >\n        <Icon name=\"lucide:corner-down-left\" class=\"size-3\" />\n      </kbd>\n    </label>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/user-dropdown/UserDropdownSubmenu.vue"
    },
    {
      "path": "registry/new-york/user-dropdown/index.ts",
      "content": "export { default as UserDropdown } from './UserDropdown.vue';\nexport { default as UserDropdownAvatar } from './UserDropdownAvatar.vue';\nexport type {\n  UserDropdownBadgeTone,\n  UserDropdownItem,\n  UserDropdownItemKind,\n  UserDropdownProps,\n  UserDropdownSection,\n  UserDropdownSide,\n  UserDropdownSubItem,\n  UserDropdownUser,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/user-dropdown/index.ts"
    },
    {
      "path": "registry/new-york/user-dropdown/types.ts",
      "content": "export type UserDropdownBadgeTone = 'success' | 'accent' | 'neutral';\n\nexport type UserDropdownItemKind = 'item' | 'switch' | 'submenu';\n\nexport type UserDropdownSide = 'left' | 'right';\n\nexport interface UserDropdownUser {\n  /** Display name shown in the trigger. */\n  name: string;\n  /** Secondary line under the name, usually the email. */\n  email?: string;\n  /** Avatar image URL. */\n  avatar?: string;\n  /** Initials shown when there is no image. Defaults to the name's initials. */\n  initials?: string;\n  /** CSS background for the avatar when there is no image, e.g. a gradient. */\n  avatarBackground?: string;\n  /** Small pill next to the name, e.g. `Online` or `Pro`. */\n  badge?: string;\n  /** Colour of the pill. */\n  badgeTone?: UserDropdownBadgeTone;\n}\n\nexport interface UserDropdownSubItem {\n  id: string;\n  label: string;\n  /** Iconify name, e.g. `lucide:plus`. */\n  icon?: string;\n  /** Avatar image URL drawn instead of the icon. */\n  avatar?: string;\n  /** CSS background drawn as a round (or square) swatch instead of the icon. */\n  avatarBackground?: string;\n  /** Draw the swatch as a rounded square (spaces) instead of a circle. */\n  square?: boolean;\n  /** Shortcut hint, e.g. `⌘1`. Display only. */\n  shortcut?: string;\n  /** Set to make the row a radio item (`true` = selected). */\n  checked?: boolean;\n  /** Draws the row as a bordered action, e.g. “Add new account”. */\n  action?: boolean;\n  disabled?: boolean;\n}\n\nexport interface UserDropdownItem {\n  id: string;\n  label: string;\n  /** Iconify name, e.g. `lucide:settings`. */\n  icon?: string;\n  /** Extra classes for the icon, e.g. a colour. */\n  iconClass?: string;\n  /** `item` (default), `switch` (checkbox with a toggle) or `submenu`. */\n  kind?: UserDropdownItemKind;\n  /** Single-key shortcut. Shown as a key cap and pressing it while open activates the row. */\n  shortcut?: string;\n  /** Pill on the right, e.g. `20% off`. */\n  badge?: string;\n  badgeTone?: UserDropdownBadgeTone;\n  /** CSS background drawn as a small square swatch on the right. */\n  swatch?: string;\n  /** Renders the row as a link. */\n  href?: string;\n  /** Opens the link in a new tab and shows an external-link icon. */\n  external?: boolean;\n  /** Red text for destructive actions. */\n  danger?: boolean;\n  /** Muted text, e.g. a status line. */\n  muted?: boolean;\n  disabled?: boolean;\n  /** Switch state for `kind: 'switch'`. */\n  checked?: boolean;\n  /** Rows of the submenu for `kind: 'submenu'`. */\n  children?: UserDropdownSubItem[];\n  /** Small heading at the top of the submenu. */\n  submenuTitle?: string;\n  /** Which side the submenu opens on. Flips when there is no room. */\n  submenuSide?: UserDropdownSide;\n  /** Adds a text field to the submenu with this placeholder. Enter emits `submit`. */\n  submenuInput?: string;\n}\n\nexport interface UserDropdownSection {\n  id: string;\n  items: UserDropdownItem[];\n  /** Draws the section on the recessed base under the card. */\n  footer?: boolean;\n}\n\nexport interface UserDropdownProps {\n  user: UserDropdownUser;\n  sections: UserDropdownSection[];\n  /** `v-model:open`. */\n  open?: boolean;\n  /** Close the menu after a plain item is chosen. */\n  closeOnSelect?: boolean;\n  /** Colour of the focus ring. */\n  accent?: string;\n  /** Accessible label for the trigger. Defaults to “Account menu for <name>”. */\n  label?: string;\n  class?: string;\n}\n\nexport interface UserDropdownEmits {\n  (e: 'update:open', value: boolean): void;\n  (e: 'select', item: UserDropdownItem, child?: UserDropdownSubItem): void;\n  (e: 'toggle', item: UserDropdownItem, value: boolean): void;\n  (e: 'submit', item: UserDropdownItem, value: string): void;\n}\n\n/** Flat entry used for roving focus inside the main menu. */\nexport interface UserDropdownEntry {\n  item: UserDropdownItem;\n  index: number;\n}\n\nexport interface UserDropdownSubmenuPosition {\n  side: UserDropdownSide | 'inside';\n  /** Offset from the top of the menu; used when the row sits in the upper half. */\n  top?: number;\n  /** Offset from the bottom of the menu; used when the row sits in the lower half. */\n  bottom?: number;\n}\n\nexport type UserDropdownNavMode = 'keyboard' | 'pointer';\n\nexport interface UserDropdownAvatarProps {\n  src?: string;\n  background?: string;\n  initials?: string;\n  square?: boolean;\n  class?: string;\n}\n\nexport interface UserDropdownRowProps {\n  item: UserDropdownItem;\n  active?: boolean;\n  keyboard?: boolean;\n  expanded?: boolean;\n  submenuId?: string;\n}\n\nexport interface UserDropdownSubmenuProps {\n  item: UserDropdownItem;\n  activeIndex: number;\n  keyboard: boolean;\n  position: UserDropdownSubmenuPosition;\n  menuId: string;\n}\n\nexport interface UserDropdownSubmenuEmits {\n  activate: [index: number];\n  hover: [index: number];\n  keydown: [event: KeyboardEvent];\n  submit: [value: string];\n  pointerenter: [];\n}\n\nexport interface UserDropdownRowEmits {\n  activate: [];\n  hover: [];\n}\n",
      "type": "registry:ui",
      "target": "components/ui/user-dropdown/types.ts"
    },
    {
      "path": "registry/new-york/user-dropdown/user-dropdown-styles.ts",
      "content": "import type { UserDropdownBadgeTone } from './types';\n\nconst BADGE_TONES: Record<UserDropdownBadgeTone, string> = {\n  success:\n    'border border-emerald-500/35 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',\n  accent: 'bg-orange-600 text-white dark:bg-orange-500',\n  neutral: 'border border-border bg-muted text-muted-foreground',\n};\n\nexport function badgeClass(tone: UserDropdownBadgeTone = 'neutral'): string {\n  return BADGE_TONES[tone];\n}\n\nexport function initialsOf(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  const first = parts[0]?.[0] ?? '';\n  const last = parts.length > 1 ? (parts[parts.length - 1]?.[0] ?? '') : '';\n  return `${first}${last}`.toUpperCase();\n}\n\nexport const SUBMENU_WIDTH = 232;\nexport const SUBMENU_GAP = 8;\n",
      "type": "registry:ui",
      "target": "components/ui/user-dropdown/user-dropdown-styles.ts"
    }
  ]
}
