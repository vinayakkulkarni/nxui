{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "model-picker",
  "type": "registry:ui",
  "title": "Model Picker",
  "description": "A chat composer with a model menu that compares speed, quality and cost, with thinking effort, web search and a rolling price tray.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/model-picker/ModelPicker.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, nextTick, ref, useId } from 'vue';\n  import {\n    onClickOutside,\n    onKeyStroke,\n    usePreferredReducedMotion,\n  } from '@vueuse/core';\n  import { AnimatePresence, motion } from 'motion-v';\n  import { cn } from '~/lib/utils';\n  import ModelPickerEffortControl from './ModelPickerEffort.vue';\n  import ModelPickerRow from './ModelPickerRow.vue';\n  import ModelPickerToggle from './ModelPickerToggle.vue';\n  import ModelPickerTray from './ModelPickerTray.vue';\n  import {\n    AUTO_KEY,\n    COLUMNS,\n    DEFAULT_EFFORT_SCALE,\n    DEFAULT_HINTS,\n    EFFORTS,\n  } from './model-picker-constants';\n  import { useModelPickerAutoplay } from './use-model-picker-autoplay';\n  import type {\n    ModelPickerEffortLevel,\n    ModelPickerModel,\n    ModelPickerProps,\n    ModelPickerSubmit,\n  } from './types';\n\n  const props = withDefaults(defineProps<ModelPickerProps>(), {\n    showAuto: true,\n    autoLabel: 'Auto',\n    autoTagline: 'Picks per message',\n    placeholder: 'Ask anything…',\n    accent: '#3b76e1',\n    effortScale: () => DEFAULT_EFFORT_SCALE,\n    hints: () => DEFAULT_HINTS,\n    autoplay: false,\n    class: '',\n  });\n\n  const emit = defineEmits<{ submit: [payload: ModelPickerSubmit] }>();\n\n  const selected = defineModel<string>({ default: '' });\n  const thinking = defineModel<boolean>('thinking', { default: false });\n  const effort = defineModel<ModelPickerEffortLevel>('effort', {\n    default: 'medium',\n  });\n  const webSearch = defineModel<boolean>('webSearch', { default: false });\n  const prompt = defineModel<string>('prompt', { default: '' });\n  const open = defineModel<boolean>('open', { default: false });\n\n  const rootRef = ref<HTMLElement | null>(null);\n  const chipRef = ref<HTMLButtonElement | null>(null);\n  const menuRef = ref<HTMLElement | null>(null);\n  const activeKey = ref<string | null>(null);\n  const menuId = `mp-${useId()}`;\n\n  const reducedMotion = usePreferredReducedMotion();\n  const animate = computed(() => reducedMotion.value !== 'reduce');\n\n  const current = computed<ModelPickerModel | undefined>(\n    () =>\n      props.models.find((model) => model.id === selected.value) ??\n      props.models[0],\n  );\n  const isAuto = computed(() => props.showAuto && selected.value === AUTO_KEY);\n  const currentKey = computed(() =>\n    isAuto.value ? AUTO_KEY : (current.value?.id ?? ''),\n  );\n  const chipName = computed(() =>\n    isAuto.value ? props.autoLabel : (current.value?.name ?? ''),\n  );\n  const chipGlyph = computed(() => current.value?.glyph ?? chipName.value[0]);\n  const rowKeys = computed(() => {\n    const keys = props.models.map((model) => model.id);\n    return props.showAuto ? [...keys, AUTO_KEY] : keys;\n  });\n  const hoveringRow = computed(\n    () => activeKey.value !== null && rowKeys.value.includes(activeKey.value),\n  );\n\n  const scale = computed(() =>\n    thinking.value ? (props.effortScale[effort.value] ?? 1) : 1,\n  );\n  const trayModel = computed(() => {\n    const key = activeKey.value ?? currentKey.value;\n    return props.models.find((model) => model.id === key);\n  });\n  const trayHint = computed(() => {\n    const key = activeKey.value ?? currentKey.value;\n    if (key === 'thinking' || key === 'effort')\n      return thinking.value ? props.hints.thinkingOn : props.hints.thinkingOff;\n    if (key === 'web')\n      return webSearch.value ? props.hints.webOn : props.hints.webOff;\n    if (key === AUTO_KEY || !trayModel.value) return props.hints.auto;\n    return '';\n  });\n  const trayLatency = computed(\n    () => (trayModel.value?.latency ?? 0) * scale.value,\n  );\n  const trayPrice = computed(() => trayModel.value?.price ?? 0);\n\n  const menuMotion = computed(() =>\n    animate.value\n      ? {\n          initial: { opacity: 0, y: -6, scale: 0.98, filter: 'blur(4px)' },\n          animate: { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)' },\n          exit: { opacity: 0, y: -4, scale: 0.98, filter: 'blur(4px)' },\n        }\n      : {\n          initial: { opacity: 0 },\n          animate: { opacity: 1 },\n          exit: { opacity: 0 },\n        },\n  );\n\n  function items(): HTMLElement[] {\n    const menu = menuRef.value;\n    if (!menu) return [];\n    return [...menu.querySelectorAll<HTMLElement>('[data-mp-item]')];\n  }\n\n  function focusKey(key: string): void {\n    const item = items().find((element) => element.dataset.key === key);\n    if (!item) return;\n    item.focus({ preventScroll: true });\n    activeKey.value = key;\n  }\n\n  function focusIndex(index: number): void {\n    const list = items();\n    if (list.length === 0) return;\n    const item = list[(index + list.length) % list.length];\n    if (!item) return;\n    item.focus({ preventScroll: true });\n    activeKey.value = item.dataset.key ?? null;\n  }\n\n  async function openMenu(focus: 'selected' | 'last' | 'menu'): Promise<void> {\n    open.value = true;\n    await nextTick();\n    if (focus === 'menu') menuRef.value?.focus({ preventScroll: true });\n    else if (focus === 'last') focusIndex(-1);\n    else focusKey(currentKey.value);\n  }\n\n  function closeMenu(returnFocus: boolean): void {\n    open.value = false;\n    activeKey.value = null;\n    if (returnFocus) chipRef.value?.focus({ preventScroll: true });\n  }\n\n  function onChipClick(event: MouseEvent): void {\n    if (open.value) closeMenu(false);\n    else void openMenu(event.detail === 0 ? 'selected' : 'menu');\n  }\n\n  function onChipKeydown(event: KeyboardEvent): void {\n    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {\n      event.preventDefault();\n      void openMenu(event.key === 'ArrowUp' ? 'last' : 'selected');\n    }\n  }\n\n  function stepEffort(delta: number): void {\n    const index = EFFORTS.indexOf(effort.value) + delta;\n    const next = EFFORTS[Math.max(0, Math.min(EFFORTS.length - 1, index))];\n    if (next) effort.value = next;\n    void nextTick(() => focusKey('effort'));\n  }\n\n  function onMenuKeydown(event: KeyboardEvent): void {\n    const list = items();\n    const at = list.findIndex((item) => item.dataset.key === activeKey.value);\n    const keyMap: Record<string, () => void> = {\n      ArrowDown: () => focusIndex(at + 1),\n      ArrowUp: () => focusIndex(at < 0 ? -1 : at - 1),\n      Home: () => focusIndex(0),\n      End: () => focusIndex(-1),\n      ArrowRight: () => {\n        if (activeKey.value === 'effort') stepEffort(1);\n      },\n      ArrowLeft: () => {\n        if (activeKey.value === 'effort') stepEffort(-1);\n      },\n    };\n    if (event.key === 'Tab') {\n      closeMenu(false);\n      return;\n    }\n    const action = keyMap[event.key];\n    if (!action) return;\n    event.preventDefault();\n    action();\n  }\n\n  function onFocusIn(event: FocusEvent): void {\n    if (event.target instanceof HTMLElement && event.target.dataset.key)\n      activeKey.value = event.target.dataset.key;\n  }\n\n  function onHover(key: string): void {\n    activeKey.value = key;\n    if (menuRef.value?.contains(document.activeElement)) focusKey(key);\n  }\n\n  function onMenuLeave(): void {\n    activeKey.value = null;\n  }\n\n  function onSelect(key: string): void {\n    selected.value = key;\n    closeMenu(true);\n  }\n\n  function onToggle(key: string): void {\n    if (key === 'thinking') thinking.value = !thinking.value;\n    else webSearch.value = !webSearch.value;\n  }\n\n  function onEffort(value: ModelPickerEffortLevel): void {\n    effort.value = value;\n    focusKey('effort');\n  }\n\n  function onSubmit(): void {\n    emit('submit', {\n      prompt: prompt.value,\n      model: currentKey.value,\n      thinking: thinking.value,\n      effort: effort.value,\n      webSearch: webSearch.value,\n    });\n  }\n\n  onClickOutside(rootRef, () => {\n    if (open.value) closeMenu(false);\n  });\n\n  onKeyStroke('Escape', (event) => {\n    if (!open.value || event.defaultPrevented) return;\n    const inside = rootRef.value?.contains(document.activeElement) ?? false;\n    closeMenu(inside);\n  });\n\n  function hoverStep(key: string): () => void {\n    return () => {\n      open.value = true;\n      activeKey.value = key;\n    };\n  }\n\n  useModelPickerAutoplay({\n    enabled: () => props.autoplay,\n    target: () => rootRef.value,\n    interval: 1100,\n    onStop: () => {\n      activeKey.value = null;\n    },\n    steps: () => {\n      const next =\n        rowKeys.value[\n          (rowKeys.value.indexOf(currentKey.value) + 1) % rowKeys.value.length\n        ] ?? currentKey.value;\n      return [\n        () => {\n          open.value = true;\n          activeKey.value = null;\n        },\n        ...rowKeys.value.map((key) => hoverStep(key)),\n        hoverStep('thinking'),\n        () => {\n          thinking.value = true;\n        },\n        hoverStep('effort'),\n        () => {\n          effort.value = 'high';\n        },\n        hoverStep('web'),\n        () => {\n          webSearch.value = !webSearch.value;\n        },\n        hoverStep(next),\n        () => {\n          selected.value = next;\n          thinking.value = false;\n          closeMenu(false);\n        },\n        () => undefined,\n      ];\n    },\n  });\n</script>\n\n<template>\n  <div ref=\"rootRef\" :class=\"cn('relative w-full max-w-lg', props.class)\">\n    <form\n      class=\"rounded-2xl border border-border bg-card p-3.5 shadow-xs\"\n      @submit.prevent=\"onSubmit\"\n    >\n      <input\n        v-model=\"prompt\"\n        type=\"text\"\n        :placeholder=\"placeholder\"\n        aria-label=\"Prompt\"\n        class=\"w-full bg-transparent px-1.5 pt-1 pb-4 text-lg text-foreground outline-none placeholder:text-muted-foreground/70\"\n      />\n      <div class=\"flex items-center justify-between gap-3\">\n        <div class=\"relative\">\n          <button\n            ref=\"chipRef\"\n            type=\"button\"\n            aria-haspopup=\"menu\"\n            :aria-expanded=\"open\"\n            :aria-controls=\"menuId\"\n            :aria-label=\"`Model: ${chipName}`\"\n            class=\"flex h-10 items-center gap-2 rounded-lg bg-foreground/5 pr-2.5 pl-2 text-lg font-medium text-foreground outline-none transition-colors hover:bg-foreground/8 focus-visible:ring-2 focus-visible:ring-ring/60\"\n            @click=\"onChipClick\"\n            @keydown=\"onChipKeydown\"\n          >\n            <span\n              class=\"flex size-6 items-center justify-center rounded-md border border-border bg-background text-xs\"\n              aria-hidden=\"true\"\n            >\n              <Icon v-if=\"isAuto\" name=\"lucide:sparkle\" class=\"size-3\" />\n              <template v-else>{{ chipGlyph }}</template>\n            </span>\n            <span class=\"grid\">\n              <Transition name=\"mp-chip\">\n                <span :key=\"chipName\" class=\"col-start-1 row-start-1\">\n                  {{ chipName }}\n                </span>\n              </Transition>\n            </span>\n            <Icon\n              v-if=\"thinking\"\n              name=\"lucide:lightbulb\"\n              class=\"size-4\"\n              :style=\"{ color: accent }\"\n            />\n            <Icon\n              v-if=\"webSearch\"\n              name=\"lucide:globe\"\n              class=\"size-4\"\n              :style=\"{ color: accent }\"\n            />\n            <Icon\n              name=\"lucide:chevron-down\"\n              :class=\"[\n                'size-4 text-muted-foreground transition-transform duration-200',\n                open ? 'rotate-180' : '',\n              ]\"\n            />\n          </button>\n\n          <AnimatePresence>\n            <component\n              :is=\"motion.div\"\n              v-if=\"open\"\n              :initial=\"menuMotion.initial\"\n              :animate=\"menuMotion.animate\"\n              :exit=\"menuMotion.exit\"\n              :transition=\"{ duration: 0.18, ease: [0.2, 0.8, 0.2, 1] }\"\n              class=\"absolute top-full left-0 z-50 mt-2.5 w-120 max-w-[calc(100vw-3rem)] origin-top-left\"\n            >\n              <div\n                :id=\"menuId\"\n                ref=\"menuRef\"\n                role=\"menu\"\n                tabindex=\"-1\"\n                aria-label=\"Model\"\n                class=\"overflow-hidden rounded-xl border border-border bg-card shadow-xl shadow-black/5 outline-none dark:shadow-black/40\"\n                @keydown=\"onMenuKeydown\"\n                @focusin=\"onFocusIn\"\n                @pointerleave=\"onMenuLeave\"\n              >\n                <div class=\"p-1.5\">\n                  <div\n                    class=\"flex items-center gap-3 px-2.5 pt-1.5 pb-1 text-[13px] font-medium tracking-wide text-muted-foreground uppercase\"\n                    aria-hidden=\"true\"\n                  >\n                    <span class=\"flex-1\">Model</span>\n                    <span\n                      class=\"grid grid-cols-3 gap-2.5 text-center max-sm:gap-1 *:w-15.5 max-sm:*:w-9.5\"\n                    >\n                      <span v-for=\"column in COLUMNS\" :key=\"column.label\">\n                        <span class=\"max-sm:hidden\">{{ column.label }}</span>\n                        <span class=\"sm:hidden\">\n                          <Icon :name=\"column.icon\" class=\"size-3.5\" />\n                        </span>\n                      </span>\n                    </span>\n                  </div>\n                  <ModelPickerRow\n                    v-for=\"model in models\"\n                    :key=\"model.id\"\n                    :item-key=\"model.id\"\n                    :name=\"model.name\"\n                    :tagline=\"model.tagline\"\n                    :glyph=\"model.glyph\"\n                    :icon=\"model.icon\"\n                    :speed=\"model.speed\"\n                    :quality=\"model.quality\"\n                    :cost=\"model.cost\"\n                    :checked=\"currentKey === model.id\"\n                    :active=\"activeKey === model.id\"\n                    :lit=\"(activeKey ?? currentKey) === model.id\"\n                    :dimmed=\"hoveringRow && activeKey !== model.id\"\n                    :accent=\"accent\"\n                    :animate=\"animate\"\n                    @select=\"onSelect\"\n                    @hover=\"onHover\"\n                  />\n                  <ModelPickerRow\n                    v-if=\"showAuto\"\n                    item-key=\"auto\"\n                    :name=\"autoLabel\"\n                    :tagline=\"autoTagline\"\n                    icon=\"lucide:sparkle\"\n                    varies\n                    :checked=\"isAuto\"\n                    :active=\"activeKey === 'auto'\"\n                    :lit=\"false\"\n                    :dimmed=\"hoveringRow && activeKey !== 'auto'\"\n                    :accent=\"accent\"\n                    :animate=\"animate\"\n                    @select=\"onSelect\"\n                    @hover=\"onHover\"\n                  />\n                </div>\n                <div class=\"border-t border-border p-1.5\">\n                  <ModelPickerToggle\n                    item-key=\"thinking\"\n                    label=\"Extended thinking\"\n                    icon=\"lucide:lightbulb\"\n                    :checked=\"thinking\"\n                    :active=\"activeKey === 'thinking'\"\n                    :accent=\"accent\"\n                    @toggle=\"onToggle\"\n                    @hover=\"onHover\"\n                  />\n                  <div\n                    :class=\"[\n                      'grid transition-[grid-template-rows,opacity] duration-250 ease-out motion-reduce:transition-none',\n                      thinking\n                        ? 'grid-rows-[1fr] opacity-100'\n                        : 'grid-rows-[0fr] opacity-0',\n                    ]\"\n                    :inert=\"!thinking\"\n                  >\n                    <div class=\"min-h-0 overflow-hidden\">\n                      <ModelPickerEffortControl\n                        :effort=\"effort\"\n                        :active=\"activeKey === 'effort'\"\n                        label=\"Effort\"\n                        @change=\"onEffort\"\n                        @hover=\"onHover\"\n                      />\n                    </div>\n                  </div>\n                  <ModelPickerToggle\n                    item-key=\"web\"\n                    label=\"Web search\"\n                    icon=\"lucide:globe\"\n                    :checked=\"webSearch\"\n                    :active=\"activeKey === 'web'\"\n                    :accent=\"accent\"\n                    @toggle=\"onToggle\"\n                    @hover=\"onHover\"\n                  />\n                </div>\n                <ModelPickerTray\n                  :latency=\"trayLatency\"\n                  :price=\"trayPrice\"\n                  :hint=\"trayHint\"\n                  :animate=\"animate\"\n                />\n              </div>\n            </component>\n          </AnimatePresence>\n        </div>\n        <button\n          type=\"submit\"\n          aria-label=\"Send\"\n          class=\"flex size-10 items-center justify-center rounded-lg bg-foreground text-background outline-none transition-opacity hover:opacity-85 focus-visible:ring-2 focus-visible:ring-ring/60 focus-visible:ring-offset-2 focus-visible:ring-offset-card\"\n        >\n          <Icon name=\"lucide:arrow-up\" class=\"size-5\" />\n        </button>\n      </div>\n    </form>\n  </div>\n</template>\n\n<style scoped>\n  .mp-chip-enter-active,\n  .mp-chip-leave-active {\n    transition:\n      opacity 220ms ease,\n      filter 220ms ease;\n  }\n  .mp-chip-enter-from,\n  .mp-chip-leave-to {\n    opacity: 0;\n    filter: blur(4px);\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/ModelPicker.vue"
    },
    {
      "path": "registry/new-york/model-picker/ModelPickerBars.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import type { ModelPickerBarsProps } from './types';\n\n  const props = defineProps<ModelPickerBarsProps>();\n\n  const SEGMENTS = [0, 1, 2, 3, 4];\n\n  const filled = computed(() =>\n    Math.max(0, Math.min(5, Math.round(props.value))),\n  );\n\n  function segmentStyle(index: number): Record<string, string> {\n    const on = index < filled.value;\n    const lit = on && props.active;\n    const wait = `${props.delay + index * 45}ms`;\n    return {\n      backgroundColor: lit ? props.accent : '',\n      transitionDelay: lit ? wait : '0ms',\n      animationDelay: wait,\n    };\n  }\n</script>\n\n<template>\n  <span class=\"flex items-center gap-0.75 max-sm:gap-0.5\" aria-hidden=\"true\">\n    <span\n      v-for=\"index in SEGMENTS\"\n      :key=\"index\"\n      :class=\"[\n        'h-1.5 w-2.5 rounded-[2px] max-sm:w-1.5 transition-colors duration-200',\n        index < filled\n          ? 'bg-foreground/16 dark:bg-foreground/18'\n          : 'bg-foreground/6 dark:bg-foreground/8',\n        active && index < filled && animate ? 'mp-pop' : '',\n      ]\"\n      :style=\"segmentStyle(index)\"\n    />\n  </span>\n</template>\n\n<style scoped>\n  .mp-pop {\n    animation: mp-pop 320ms cubic-bezier(0.3, 0.7, 0.4, 1) both;\n  }\n\n  @keyframes mp-pop {\n    0% {\n      transform: scale(1);\n    }\n    45% {\n      transform: scale(1.35);\n    }\n    100% {\n      transform: scale(1);\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/ModelPickerBars.vue"
    },
    {
      "path": "registry/new-york/model-picker/ModelPickerEffort.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import { EFFORTS } from './model-picker-constants';\n  import type { ModelPickerEffortLevel, ModelPickerEffortProps } from './types';\n\n  const props = defineProps<ModelPickerEffortProps>();\n  const emit = defineEmits<{\n    change: [effort: ModelPickerEffortLevel];\n    hover: [key: string];\n  }>();\n\n  const index = computed(() => Math.max(0, EFFORTS.indexOf(props.effort)));\n  const pillStyle = computed(() => ({\n    transform: `translateX(${index.value * 100}%)`,\n  }));\n\n  function title(value: ModelPickerEffortLevel): string {\n    return value.charAt(0).toUpperCase() + value.slice(1);\n  }\n\n  function onPick(event: MouseEvent): void {\n    const target = event.currentTarget;\n    if (!(target instanceof HTMLElement)) return;\n    const value = EFFORTS.find((item) => item === target.dataset.effort);\n    if (value) emit('change', value);\n  }\n\n  function onEnter(): void {\n    emit('hover', 'effort');\n  }\n</script>\n\n<template>\n  <div\n    role=\"group\"\n    :aria-label=\"label\"\n    :class=\"[\n      'flex items-center gap-3 rounded-lg py-1.5 pr-1.5 pl-13.5 transition-colors duration-150',\n      active ? 'bg-foreground/4' : '',\n    ]\"\n    @pointerenter=\"onEnter\"\n  >\n    <span class=\"flex-1 text-[15px] text-muted-foreground\">{{ label }}</span>\n    <span class=\"relative grid grid-cols-3 rounded-md\">\n      <span\n        class=\"absolute inset-y-0 left-0 w-1/3 rounded-md bg-foreground/8 shadow-xs transition-transform duration-250 ease-out motion-reduce:transition-none dark:bg-foreground/12\"\n        :style=\"pillStyle\"\n        aria-hidden=\"true\"\n      />\n      <button\n        v-for=\"value in EFFORTS\"\n        :key=\"value\"\n        type=\"button\"\n        role=\"menuitemradio\"\n        tabindex=\"-1\"\n        :data-effort=\"value\"\n        :data-mp-item=\"value === effort ? '' : undefined\"\n        :data-key=\"value === effort ? 'effort' : undefined\"\n        :aria-checked=\"value === effort\"\n        :class=\"[\n          'relative z-10 rounded-md px-3 py-1 text-sm outline-none transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-ring/60',\n          value === effort\n            ? 'text-foreground'\n            : 'text-muted-foreground hover:text-foreground',\n        ]\"\n        @click=\"onPick\"\n      >\n        {{ title(value) }}\n      </button>\n    </span>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/ModelPickerEffort.vue"
    },
    {
      "path": "registry/new-york/model-picker/ModelPickerRow.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import ModelPickerBars from './ModelPickerBars.vue';\n  import type { ModelPickerRowProps } from './types';\n\n  const props = defineProps<ModelPickerRowProps>();\n  const emit = defineEmits<{\n    select: [key: string];\n    hover: [key: string];\n  }>();\n\n  const letter = computed(\n    () => props.glyph ?? props.name.charAt(0).toUpperCase(),\n  );\n\n  function onClick(): void {\n    emit('select', props.itemKey);\n  }\n\n  function onEnter(): void {\n    emit('hover', props.itemKey);\n  }\n</script>\n\n<template>\n  <button\n    type=\"button\"\n    role=\"menuitemradio\"\n    tabindex=\"-1\"\n    data-mp-item\n    :data-key=\"itemKey\"\n    :aria-checked=\"checked\"\n    :class=\"[\n      'flex w-full items-center gap-3 rounded-lg px-2.5 py-2 text-left outline-none',\n      'transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-ring/60',\n      active ? 'bg-foreground/7 dark:bg-foreground/8' : '',\n    ]\"\n    @click=\"onClick\"\n    @pointerenter=\"onEnter\"\n  >\n    <span\n      :class=\"[\n        'flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-background text-xs font-medium transition-colors duration-150',\n        dimmed ? 'text-muted-foreground' : 'text-foreground',\n      ]\"\n      aria-hidden=\"true\"\n    >\n      <Icon v-if=\"icon\" :name=\"icon\" class=\"size-3.5\" />\n      <template v-else>{{ letter }}</template>\n    </span>\n    <span class=\"min-w-0 flex-1\">\n      <span\n        :class=\"[\n          'flex items-center gap-1.5 text-[17px]/6 font-medium transition-colors duration-150',\n          dimmed ? 'text-muted-foreground' : 'text-foreground',\n        ]\"\n      >\n        <span class=\"truncate\">{{ name }}</span>\n        <Icon\n          v-if=\"checked\"\n          name=\"lucide:check\"\n          class=\"size-3.5 shrink-0\"\n          :style=\"{ color: accent }\"\n        />\n      </span>\n      <span\n        :class=\"[\n          'block truncate text-[15px]/5 transition-colors duration-150',\n          dimmed ? 'text-muted-foreground/70' : 'text-muted-foreground',\n        ]\"\n      >\n        {{ tagline }}\n      </span>\n    </span>\n    <span\n      v-if=\"varies\"\n      class=\"w-52 shrink-0 text-center text-[15px] text-muted-foreground/80 max-sm:w-auto max-sm:pr-2\"\n    >\n      Varies\n    </span>\n    <span v-else class=\"grid shrink-0 grid-cols-3 gap-2.5 max-sm:gap-1\">\n      <ModelPickerBars\n        :value=\"speed ?? 0\"\n        :active=\"lit\"\n        :accent=\"accent\"\n        :delay=\"0\"\n        :animate=\"animate\"\n      />\n      <ModelPickerBars\n        :value=\"quality ?? 0\"\n        :active=\"lit\"\n        :accent=\"accent\"\n        :delay=\"60\"\n        :animate=\"animate\"\n      />\n      <ModelPickerBars\n        :value=\"cost ?? 0\"\n        :active=\"lit\"\n        :accent=\"accent\"\n        :delay=\"120\"\n        :animate=\"animate\"\n      />\n    </span>\n  </button>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/ModelPickerRow.vue"
    },
    {
      "path": "registry/new-york/model-picker/ModelPickerToggle.vue",
      "content": "<script setup lang=\"ts\">\n  import type { ModelPickerToggleProps } from './types';\n\n  const props = defineProps<ModelPickerToggleProps>();\n  const emit = defineEmits<{\n    toggle: [key: string];\n    hover: [key: string];\n  }>();\n\n  function onClick(): void {\n    emit('toggle', props.itemKey);\n  }\n\n  function onEnter(): void {\n    emit('hover', props.itemKey);\n  }\n</script>\n\n<template>\n  <button\n    type=\"button\"\n    role=\"menuitemcheckbox\"\n    tabindex=\"-1\"\n    data-mp-item\n    :data-key=\"itemKey\"\n    :aria-checked=\"checked\"\n    :class=\"[\n      'flex w-full items-center gap-3 rounded-lg px-2.5 py-2 text-left outline-none',\n      'transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-ring/60',\n      active ? 'bg-foreground/7 dark:bg-foreground/8' : '',\n    ]\"\n    @click=\"onClick\"\n    @pointerenter=\"onEnter\"\n  >\n    <span class=\"flex size-8 shrink-0 items-center justify-center\">\n      <Icon :name=\"icon\" class=\"size-4.5 text-muted-foreground\" />\n    </span>\n    <span class=\"flex-1 text-[17px]/6 text-foreground\">{{ label }}</span>\n    <span\n      :class=\"[\n        'relative h-5 w-8.5 shrink-0 rounded-full transition-colors duration-200',\n        checked ? '' : 'bg-foreground/12 dark:bg-foreground/16',\n      ]\"\n      :style=\"{ backgroundColor: checked ? accent : '' }\"\n      aria-hidden=\"true\"\n    >\n      <span\n        :class=\"[\n          'absolute top-0.5 left-0.5 size-4 rounded-full bg-white shadow-sm transition-transform duration-200 ease-out',\n          checked ? 'translate-x-3.5' : 'translate-x-0',\n        ]\"\n      />\n    </span>\n  </button>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/ModelPickerToggle.vue"
    },
    {
      "path": "registry/new-york/model-picker/ModelPickerTray.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import { TransitionPresets, useTransition } from '@vueuse/core';\n  import type { ModelPickerTrayProps } from './types';\n\n  const props = defineProps<ModelPickerTrayProps>();\n\n  const duration = computed(() => (props.animate ? 450 : 0));\n\n  const latencySource = computed(() => props.latency);\n  const priceSource = computed(() => props.price);\n\n  const latencyShown = useTransition(latencySource, {\n    duration,\n    transition: TransitionPresets.easeOutCubic,\n  });\n  const priceShown = useTransition(priceSource, {\n    duration,\n    transition: TransitionPresets.easeOutCubic,\n  });\n\n  const latencyText = computed(() => latencyShown.value.toFixed(1));\n  const priceText = computed(() => Math.round(priceShown.value).toString());\n</script>\n\n<template>\n  <div\n    class=\"flex items-center gap-3 border-t border-border px-4 py-2.5 text-[15px] text-muted-foreground\"\n  >\n    <div class=\"relative min-w-0 flex-1\" aria-live=\"polite\">\n      <Transition name=\"mp-tray\" mode=\"out-in\">\n        <span v-if=\"hint\" :key=\"hint\" class=\"block truncate\">{{ hint }}</span>\n        <span v-else key=\"stats\" class=\"block truncate tabular-nums\">\n          ~<span class=\"font-semibold text-foreground\">{{ latencyText }}s</span>\n          first token ·\n          <span class=\"font-semibold text-foreground\">${{ priceText }}</span>\n          / M tokens\n        </span>\n      </Transition>\n    </div>\n    <span class=\"flex shrink-0 items-center gap-1\" aria-hidden=\"true\">\n      <kbd\n        class=\"flex h-6 items-center rounded-md border border-border px-1.5 text-muted-foreground\"\n      >\n        <Icon name=\"lucide:arrow-up-down\" class=\"size-3\" />\n      </kbd>\n      <kbd\n        class=\"flex h-6 items-center rounded-md border border-border px-1.5 text-muted-foreground\"\n      >\n        <Icon name=\"lucide:corner-down-left\" class=\"size-3\" />\n      </kbd>\n    </span>\n  </div>\n</template>\n\n<style scoped>\n  .mp-tray-enter-active,\n  .mp-tray-leave-active {\n    transition:\n      opacity 160ms ease,\n      filter 160ms ease,\n      transform 160ms ease;\n  }\n  .mp-tray-enter-from,\n  .mp-tray-leave-to {\n    opacity: 0;\n    filter: blur(3px);\n    transform: translateY(2px);\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .mp-tray-enter-active,\n    .mp-tray-leave-active {\n      transition: opacity 120ms ease;\n    }\n    .mp-tray-enter-from,\n    .mp-tray-leave-to {\n      filter: none;\n      transform: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/ModelPickerTray.vue"
    },
