    {
      "path": "registry/new-york/model-picker/types.ts",
      "content": "export type ModelPickerEffortLevel = 'low' | 'medium' | 'high';\n\nexport interface ModelPickerModel {\n  /** Unique id, used as the v-model value. */\n  id: string;\n  /** Name shown in the chip and the menu. */\n  name: string;\n  /** One-line description under the name. */\n  tagline: string;\n  /** Letter shown in the icon tile. Defaults to the first letter of the name. */\n  glyph?: string;\n  /** Iconify name (e.g. `lucide:zap`). Replaces the glyph when set. */\n  icon?: string;\n  /** Speed rating, 0–5. */\n  speed: number;\n  /** Quality rating, 0–5. */\n  quality: number;\n  /** Cost rating, 0–5. */\n  cost: number;\n  /** Time to first token, in seconds, without extended thinking. */\n  latency: number;\n  /** Price in dollars per million tokens. */\n  price: number;\n}\n\nexport interface ModelPickerHints {\n  auto: string;\n  thinkingOn: string;\n  thinkingOff: string;\n  webOn: string;\n  webOff: string;\n}\n\nexport type ModelPickerEffortScale = Record<ModelPickerEffortLevel, number>;\n\nexport interface ModelPickerSubmit {\n  prompt: string;\n  model: string;\n  thinking: boolean;\n  effort: ModelPickerEffortLevel;\n  webSearch: boolean;\n}\n\nexport interface ModelPickerProps {\n  /** Models listed in the menu. */\n  models: ModelPickerModel[];\n  /** Adds an \"Auto\" row that picks a model per message. Its id is `auto`. */\n  showAuto?: boolean;\n  /** Name of the auto row. */\n  autoLabel?: string;\n  /** Tagline of the auto row. */\n  autoTagline?: string;\n  /** Placeholder of the prompt field. */\n  placeholder?: string;\n  /** Colour of filled bars, checks and switches. */\n  accent?: string;\n  /** Latency multiplier per effort level when extended thinking is on. */\n  effortScale?: ModelPickerEffortScale;\n  /** Texts shown in the footer tray. */\n  hints?: ModelPickerHints;\n  /** Opens the menu and walks through rows on its own until the user interacts. */\n  autoplay?: boolean;\n  class?: string;\n}\n\nexport interface ModelPickerRowProps {\n  itemKey: string;\n  name: string;\n  tagline: string;\n  glyph?: string;\n  icon?: string;\n  speed?: number;\n  quality?: number;\n  cost?: number;\n  varies?: boolean;\n  checked: boolean;\n  active: boolean;\n  lit: boolean;\n  dimmed: boolean;\n  accent: string;\n  animate: boolean;\n}\n\nexport interface ModelPickerBarsProps {\n  value: number;\n  active: boolean;\n  accent: string;\n  delay: number;\n  animate: boolean;\n}\n\nexport interface ModelPickerToggleProps {\n  itemKey: string;\n  label: string;\n  icon: string;\n  checked: boolean;\n  active: boolean;\n  accent: string;\n}\n\nexport interface ModelPickerEffortProps {\n  effort: ModelPickerEffortLevel;\n  active: boolean;\n  label: string;\n}\n\nexport interface ModelPickerAutoplayOptions {\n  /** Turns the walk-through on. */\n  enabled: () => boolean;\n  /** Element that ends the walk-through when the user touches it. */\n  target: () => HTMLElement | null | undefined;\n  /** Actions run one per tick, in a loop. */\n  steps: () => Array<() => void>;\n  /** Milliseconds between steps. */\n  interval: number;\n  /** Called once when the user takes over. */\n  onStop: () => void;\n}\n\nexport interface ModelPickerTrayProps {\n  latency: number;\n  price: number;\n  hint: string;\n  animate: boolean;\n}\n\nexport interface ModelPickerColumn {\n  label: string;\n  icon: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/types.ts"
    },
    {
      "path": "registry/new-york/model-picker/use-model-picker-autoplay.ts",
      "content": "import { computed, ref, watch } from 'vue';\nimport {\n  useElementVisibility,\n  useEventListener,\n  useIntervalFn,\n} from '@vueuse/core';\nimport type { ModelPickerAutoplayOptions } from './types';\n\nconst STOP_EVENTS = ['pointerdown', 'pointerenter', 'keydown', 'focusin'];\n\n/**\n * Runs a looping list of steps while the target is on screen, and stops for\n * good the first time the user points at, clicks, focuses or types in it.\n */\nexport function useModelPickerAutoplay(options: ModelPickerAutoplayOptions) {\n  const target = computed(() => options.target() ?? null);\n  const visible = useElementVisibility(target);\n  const stopped = ref(false);\n  let index = 0;\n\n  const { pause, resume } = useIntervalFn(\n    () => {\n      const steps = options.steps();\n      if (steps.length === 0) return;\n      const step = steps[index % steps.length];\n      index += 1;\n      if (step) step();\n    },\n    options.interval,\n    { immediate: false },\n  );\n\n  function stop(): void {\n    if (stopped.value || !options.enabled()) return;\n    stopped.value = true;\n    pause();\n    options.onStop();\n  }\n\n  useEventListener(target, STOP_EVENTS, stop, { passive: true });\n\n  const running = computed(\n    () => options.enabled() && !stopped.value && visible.value,\n  );\n\n  watch(\n    running,\n    (on) => {\n      if (on) resume();\n      else pause();\n    },\n    { immediate: true },\n  );\n\n  return { stopped, stop };\n}\n",
      "type": "registry:ui",
      "target": "components/ui/model-picker/use-model-picker-autoplay.ts"
    }
  ]
