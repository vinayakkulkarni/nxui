{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "circular-text",
  "type": "registry:ui",
  "title": "Circular Text",
  "description": "Text around a spinning ring that reacts to hover, can be flung with inertia, tilts toward the cursor in 3D and holds an icon in the middle.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/circular-text/CircularText.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    nextTick,\n    onMounted,\n    ref,\n    useTemplateRef,\n    watch,\n    watchEffect,\n  } from 'vue';\n  import type { CSSProperties } from 'vue';\n  import {\n    useIntersectionObserver,\n    usePreferredReducedMotion,\n    useRafFn,\n  } from '@vueuse/core';\n  import { motion, useMotionValue, useSpring } from 'motion-v';\n  import { cn } from '~/lib/utils';\n  import {\n    HOVER_SPEED,\n    MAX_FLING,\n    clamp,\n    letterAngles,\n  } from './circular-text-layout';\n  import type { CircularTextMotionState } from './circular-text-layout';\n  import type { CircularTextProps } from './types';\n\n  const props = withDefaults(defineProps<CircularTextProps>(), {\n    spinDuration: 20,\n    onHover: 'speedUp',\n    direction: 'clockwise',\n    size: 200,\n    fontSize: 24,\n    fontWeight: 900,\n    letterSpacing: 0,\n    color: '',\n    startAngle: 0,\n    fill: true,\n    repeat: 1,\n    ring: false,\n    ringColor: '',\n    tilt: 0,\n    hoverTilt: 0,\n    draggable: false,\n    class: '',\n  });\n\n  const rootEl = useTemplateRef<HTMLElement>('rootEl');\n  const reducedMotion = usePreferredReducedMotion();\n  const reduce = computed(() => reducedMotion.value === 'reduce');\n\n  const rotation = useMotionValue(0);\n  const speed = useSpring(1, { stiffness: 60, damping: 18 });\n  const scale = useSpring(1, { stiffness: 300, damping: 20 });\n  const tiltX = useSpring(0, { stiffness: 150, damping: 18 });\n  const tiltY = useSpring(0, { stiffness: 150, damping: 18 });\n\n  const advances = ref<number[] | null>(null);\n  const settled = ref(false);\n  const dragging = ref(false);\n\n  const glyphs = computed(() => Array.from(props.text ?? ''));\n  const copies = computed(() => Math.max(1, Math.round(props.repeat) || 1));\n  const letters = computed(() =>\n    Array.from({ length: copies.value }, () => glyphs.value).flat(),\n  );\n\n  const angles = computed(() =>\n    letterAngles({\n      glyphs: glyphs.value,\n      copies: copies.value,\n      fill: props.fill,\n      startAngle: props.startAngle,\n      size: props.size,\n      fontSize: props.fontSize,\n      letterSpacing: props.letterSpacing,\n      advances: advances.value,\n    }),\n  );\n\n  const state: CircularTextMotionState = {\n    hovering: false,\n    dragging: false,\n    fling: 0,\n    cruise: 0,\n    angle: null,\n    travel: 0,\n    samples: [],\n  };\n\n  function measure() {\n    if (props.fill) return;\n    const root = rootEl.value;\n    if (!root) return;\n    const nodes = Array.from(\n      root.querySelectorAll<HTMLElement>('[data-glyph]'),\n    ).slice(0, glyphs.value.length);\n    const widths = nodes.map((node) => node.offsetWidth);\n    const prev = advances.value;\n    if (\n      prev &&\n      prev.length === widths.length &&\n      prev.every((width, i) => width === widths[i])\n    ) {\n      return;\n    }\n    advances.value = widths;\n  }\n\n  watch(\n    [\n      () => props.fill,\n      glyphs,\n      () => props.fontSize,\n      () => props.fontWeight,\n      () => props.class,\n    ],\n    () => nextTick(measure),\n  );\n\n  onMounted(() => {\n    measure();\n    document.fonts?.ready.then(measure).catch(() => {});\n    requestAnimationFrame(() => {\n      settled.value = true;\n    });\n  });\n\n  watchEffect(() => {\n    const turn = props.direction === 'counterclockwise' ? -1 : 1;\n    state.cruise =\n      props.spinDuration > 0 && !reduce.value\n        ? (360 / props.spinDuration) * turn\n        : 0;\n  });\n\n  const { pause, resume } = useRafFn(\n    ({ delta }) => {\n      if (state.dragging || reduce.value) return;\n      const dt = Math.min(delta, 100) / 1000;\n      state.fling *= Math.exp(-dt / 0.7);\n      if (Math.abs(state.fling) < 1) state.fling = 0;\n      const velocity = state.cruise * speed.get() + state.fling;\n      if (velocity) rotation.set((rotation.get() + velocity * dt) % 360);\n    },\n    { immediate: false },\n  );\n\n  useIntersectionObserver(rootEl, (entries) => {\n    if (entries[0]?.isIntersecting) resume();\n    else pause();\n  });\n\n  watch([() => props.hoverTilt, reduce], () => {\n    if (props.hoverTilt && !reduce.value) return;\n    tiltX.set(0);\n    tiltY.set(0);\n  });\n\n  function applyScale() {\n    const bonkers =\n      state.hovering && props.onHover === 'goBonkers' && !reduce.value;\n    scale.set((bonkers ? 0.8 : 1) * (state.dragging ? 0.96 : 1));\n  }\n\n  function pointerAngle(event: PointerEvent): number | null {\n    const root = rootEl.value;\n    if (!root) return null;\n    const rect = root.getBoundingClientRect();\n    const dx = event.clientX - (rect.left + rect.width / 2);\n    const dy = event.clientY - (rect.top + rect.height / 2);\n    if (Math.hypot(dx, dy) < rect.width * 0.06) return null;\n    return (Math.atan2(dy, dx) * 180) / Math.PI;\n  }\n\n  function onEnter() {\n    state.hovering = true;\n    if (props.onHover && !reduce.value) speed.set(HOVER_SPEED[props.onHover]);\n    applyScale();\n  }\n\n  function onLeave() {\n    state.hovering = false;\n    speed.set(1);\n    tiltX.set(0);\n    tiltY.set(0);\n    applyScale();\n  }\n\n  function onMove(event: PointerEvent) {\n    const root = rootEl.value;\n    if (!root) return;\n\n    if (state.dragging) {\n      const angle = pointerAngle(event);\n      if (angle !== null) {\n        if (state.angle !== null) {\n          let delta = angle - state.angle;\n          if (delta > 180) delta -= 360;\n          if (delta < -180) delta += 360;\n          state.travel += delta;\n          rotation.set((rotation.get() + delta) % 360);\n          state.samples.push([event.timeStamp, state.travel]);\n          while (\n            state.samples.length > 2 &&\n            event.timeStamp - (state.samples[0]?.[0] ?? 0) > 100\n          ) {\n            state.samples.shift();\n          }\n        }\n        state.angle = angle;\n      }\n    }\n\n    if (!props.hoverTilt || reduce.value || event.pointerType === 'touch') {\n      return;\n    }\n    const rect = root.getBoundingClientRect();\n    const nx = clamp(((event.clientX - rect.left) / rect.width) * 2 - 1, -1, 1);\n    const ny = clamp(((event.clientY - rect.top) / rect.height) * 2 - 1, -1, 1);\n    tiltX.set(-ny * props.hoverTilt);\n    tiltY.set(nx * props.hoverTilt);\n  }\n\n  function onDown(event: PointerEvent) {\n    if (!props.draggable) return;\n    if (event.pointerType === 'mouse' && event.button !== 0) return;\n    state.dragging = true;\n    state.fling = 0;\n    state.angle = pointerAngle(event);\n    state.travel = 0;\n    state.samples = [[event.timeStamp, 0]];\n    rootEl.value?.setPointerCapture(event.pointerId);\n    dragging.value = true;\n    applyScale();\n  }\n\n  function onUp(event: PointerEvent) {\n    if (!state.dragging) return;\n    state.dragging = false;\n    dragging.value = false;\n    applyScale();\n    const [startTime, startTravel] = state.samples[0] ?? [event.timeStamp, 0];\n    const lastTime = state.samples.at(-1)?.[0] ?? event.timeStamp;\n    const elapsed = event.timeStamp - startTime;\n    const velocity =\n      elapsed > 0 && event.timeStamp - lastTime < 80\n        ? ((state.travel - startTravel) / elapsed) * 1000\n        : 0;\n    state.fling = reduce.value\n      ? 0\n      : clamp(velocity, -MAX_FLING, MAX_FLING) - state.cruise * speed.get();\n  }\n\n  const rootStyle = computed<CSSProperties>(() => ({\n    width: `${props.size}px`,\n    height: `${props.size}px`,\n    fontSize: `${props.fontSize}px`,\n    fontWeight: props.fontWeight,\n    color: props.color || undefined,\n    perspective: `${props.size * 2.5}px`,\n    cursor: props.draggable\n      ? dragging.value\n        ? 'grabbing'\n        : 'grab'\n      : undefined,\n    touchAction: props.draggable ? 'none' : undefined,\n    userSelect: props.draggable ? 'none' : undefined,\n    WebkitUserSelect: props.draggable ? 'none' : undefined,\n  }));\n\n  const planeStyle = computed<CSSProperties | undefined>(() =>\n    props.tilt ? { transform: `rotateX(${props.tilt}deg)` } : undefined,\n  );\n\n  const lineStyle = computed<CSSProperties>(() => ({\n    borderWidth: `${Math.max(1, props.fontSize / 16)}px`,\n    borderColor: props.ringColor || undefined,\n    opacity: props.ring ? 1 : 0,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"rootEl\"\n    :class=\"\n      cn(\n        'group relative mx-auto cursor-pointer rounded-full text-center',\n        props.class,\n      )\n    \"\n    :data-settled=\"settled ? '' : undefined\"\n    :style=\"rootStyle\"\n    @pointerenter=\"onEnter\"\n    @pointerleave=\"onLeave\"\n    @pointermove=\"onMove\"\n    @pointerdown=\"onDown\"\n    @pointerup=\"onUp\"\n    @pointercancel=\"onUp\"\n  >\n    <motion.div\n      class=\"absolute inset-0 transform-3d\"\n      :style=\"{ rotateX: tiltX, rotateY: tiltY, scale }\"\n    >\n      <div\n        class=\"absolute inset-0 transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]\"\n        :style=\"planeStyle\"\n      >\n        <span\n          aria-hidden=\"true\"\n          class=\"pointer-events-none absolute inset-[1.3em] rounded-full border-solid border-current transition-opacity duration-400 ease-[ease]\"\n          :style=\"lineStyle\"\n        ></span>\n        <motion.div\n          class=\"absolute inset-0\"\n          role=\"img\"\n          :aria-label=\"text\"\n          :style=\"{ rotate: rotation }\"\n        >\n          <span\n            v-for=\"(letter, i) in letters\"\n            :key=\"i\"\n            class=\"absolute inset-0 inline-block whitespace-pre group-data-settled:transition-transform group-data-settled:duration-500 group-data-settled:ease-[cubic-bezier(0,0,0,1)]\"\n            :style=\"{ transform: `rotate(${angles[i] ?? 0}deg)` }\"\n            ><span :data-glyph=\"i < glyphs.length ? '' : undefined\">{{\n              letter\n            }}</span></span\n          >\n        </motion.div>\n      </div>\n      <div\n        v-if=\"$slots.default\"\n        class=\"absolute inset-0 flex items-center justify-center\"\n      >\n        <slot></slot>\n      </div>\n    </motion.div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/circular-text/CircularText.vue"
    },
    {
      "path": "registry/new-york/circular-text/circular-text-layout.ts",
      "content": "import type { CircularTextHover } from './types';\n\nexport const HOVER_SPEED: Record<CircularTextHover, number> = {\n  slowDown: 0.5,\n  speedUp: 4,\n  pause: 0,\n  goBonkers: 20,\n};\n\nexport const MAX_FLING = 1440;\n\nexport const clamp = (v: number, a: number, b: number): number =>\n  v < a ? a : v > b ? b : v;\n\nexport interface LetterLayoutInput {\n  glyphs: string[];\n  copies: number;\n  fill: boolean;\n  startAngle: number;\n  size: number;\n  fontSize: number;\n  letterSpacing: number;\n  advances: number[] | null;\n}\n\n/** Angle (deg) of every letter around the ring, all copies included. */\nexport function letterAngles(input: LetterLayoutInput): number[] {\n  const { glyphs, copies, fill, startAngle, size, fontSize, letterSpacing } =\n    input;\n  const count = glyphs.length;\n  if (!count) return [];\n  const total = count * copies;\n  if (fill) {\n    return Array.from(\n      { length: total },\n      (_, i) => startAngle + (360 / total) * i,\n    );\n  }\n  const known =\n    input.advances && input.advances.length === count ? input.advances : null;\n  const toDegrees = 180 / (Math.PI * Math.max(size / 2 - fontSize * 0.6, 1));\n  const arcs = glyphs.map((glyph, i) => {\n    const width = known\n      ? (known[i] ?? 0)\n      : fontSize * (glyph === ' ' ? 0.3 : 0.6);\n    return Math.max(0, width + letterSpacing * fontSize) * toDegrees;\n  });\n  const span = arcs.reduce((sum, arc) => sum + arc, 0);\n  const fit = span > 0 ? Math.min(1, 360 / (span * copies)) : 1;\n  const result: number[] = [];\n  for (let copy = 0; copy < copies; copy += 1) {\n    let cursor =\n      startAngle + (360 / copies) * copy - ((arcs[0] ?? 0) * fit) / 2;\n    for (let i = 0; i < count; i += 1) {\n      const arc = (arcs[i] ?? 0) * fit;\n      result.push(cursor + arc / 2);\n      cursor += arc;\n    }\n  }\n  return result;\n}\n\nexport interface CircularTextMotionState {\n  hovering: boolean;\n  dragging: boolean;\n  fling: number;\n  cruise: number;\n  angle: number | null;\n  travel: number;\n  samples: [number, number][];\n}\n",
      "type": "registry:ui",
      "target": "components/ui/circular-text/circular-text-layout.ts"
    },
    {
      "path": "registry/new-york/circular-text/index.ts",
      "content": "export { default as CircularText } from './CircularText.vue';\nexport type {\n  CircularTextDirection,\n  CircularTextHover,\n  CircularTextProps,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/circular-text/index.ts"
    },
    {
      "path": "registry/new-york/circular-text/types.ts",
      "content": "export type CircularTextHover = 'slowDown' | 'speedUp' | 'pause' | 'goBonkers';\nexport type CircularTextDirection = 'clockwise' | 'counterclockwise';\n\nexport interface CircularTextProps {\n  /** Text laid out around the ring. End it with a separator for a seamless loop. */\n  text: string;\n  /** Seconds for one full turn. 0 keeps the ring still until it is dragged. */\n  spinDuration?: number;\n  /** What happens while the pointer is over the ring. `null` does nothing. */\n  onHover?: CircularTextHover | null;\n  /** Which way the ring turns. */\n  direction?: CircularTextDirection;\n  /** Diameter in px. */\n  size?: number;\n  /** Letter size in px. */\n  fontSize?: number;\n  /** Letter weight. */\n  fontWeight?: number;\n  /** Extra space between letters in em. Applies when `fill` is off. */\n  letterSpacing?: number;\n  /** Letter and center color. Empty follows the surrounding text color. */\n  color?: string;\n  /** Where the first letter sits, in degrees clockwise from the top. */\n  startAngle?: number;\n  /** Spread the letters evenly around the whole ring. */\n  fill?: boolean;\n  /** How many times the text repeats around the ring. */\n  repeat?: number;\n  /** Draw a thin circle just inside the letters. */\n  ring?: boolean;\n  /** Inner circle color. Empty matches the letters. */\n  ringColor?: string;\n  /** Lean the ring back in perspective, in degrees. */\n  tilt?: number;\n  /** How far the ring tilts toward the pointer, in degrees. */\n  hoverTilt?: number;\n  /** Grab the ring and fling it. */\n  draggable?: boolean;\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/circular-text/types.ts"
    }
  ]
}
