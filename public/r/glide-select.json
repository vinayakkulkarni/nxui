    {
      "path": "registry/new-york/glide-select/glide-select-utils.ts",
      "content": "import type {\n  GlideSelectItem,\n  GlideSelectOption,\n  GlideSelectSize,\n  GlideSelectSizePreset,\n} from './types';\n\nexport const SIZES: Record<GlideSelectSize, GlideSelectSizePreset> = {\n  sm: { chip: 28, row: 26, font: 12 },\n  md: { chip: 32, row: 30, font: 13 },\n  lg: { chip: 44, row: 40, font: 14 },\n};\nexport const PAD = 4;\nexport const GAP = 1;\nexport const MENU_GAP = 6;\nexport const DEFAULT_OPTIONS: GlideSelectItem[] = ['One', 'Two', 'Three'];\n\nexport function norm(o: GlideSelectItem): GlideSelectOption {\n  return typeof o === 'string' ? { value: o, label: o } : o;\n}\n\n/** Next option after `from` whose label starts with `ch`, wrapping around. */\nexport function typeaheadIndex(\n  items: GlideSelectOption[],\n  from: number,\n  ch: string,\n): number {\n  const c = ch.toLowerCase();\n  const n = items.length;\n  for (let k = 1; k <= n; k++) {\n    const i = (from + k) % n;\n    if (items[i]?.label.toLowerCase().startsWith(c)) return i;\n  }\n  return from;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/glide-select/glide-select-utils.ts"
    },
    {
      "path": "registry/new-york/glide-select/index.ts",
      "content": "export { default as GlideSelect } from './GlideSelect.vue';\nexport type {\n  GlideSelectAlign,\n  GlideSelectItem,\n  GlideSelectOption,\n  GlideSelectPlacement,\n  GlideSelectProps,\n  GlideSelectSize,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/glide-select/index.ts"
    },
    {
      "path": "registry/new-york/glide-select/types.ts",
      "content": "export interface GlideSelectOption {\n  value: string;\n  label: string;\n  tag?: string;\n}\n\nexport type GlideSelectItem = string | GlideSelectOption;\n\nexport type GlideSelectSize = 'sm' | 'md' | 'lg';\n\nexport type GlideSelectPlacement = 'top' | 'bottom';\n\nexport type GlideSelectAlign = 'left' | 'right';\n\nexport type GlideSelectPhase = 'closed' | 'open' | 'closing';\n\nexport interface GlideSelectProps {\n  options?: GlideSelectItem[];\n  /** Controlled value (v-model). */\n  modelValue?: string;\n  defaultValue?: string;\n  placeholder?: string;\n  showTags?: boolean;\n  accentColor?: string;\n  surfaceColor?: string;\n  highlightColor?: string;\n  textColor?: string;\n  size?: GlideSelectSize;\n  radius?: number;\n  menuWidth?: number;\n  placement?: GlideSelectPlacement;\n  align?: GlideSelectAlign;\n  popDuration?: number;\n  glideDuration?: number;\n  rememberPosition?: boolean;\n  disabled?: boolean;\n  ariaLabel?: string;\n  class?: string;\n}\n\nexport interface GlideSelectSizePreset {\n  chip: number;\n  row: number;\n  font: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/glide-select/types.ts"
    }
