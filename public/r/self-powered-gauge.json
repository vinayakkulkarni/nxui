{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "self-powered-gauge",
  "type": "registry:ui",
  "title": "Self-Powered Gauge",
  "description": "Analog needle meter for the self-powered share, with a stacked source bar and a seven-day segment chart.",
  "dependencies": ["@vueuse/core"],
  "registryDependencies": ["https://nxui.geoql.in/r/segment-display.json"],
  "files": [
    {
      "path": "registry/new-york/self-powered-gauge/SelfPoweredGauge.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref } from 'vue';\n  import { cn } from '~/lib/utils';\n  import SelfPoweredGaugeMeter from './SelfPoweredGaugeMeter.vue';\n  import { splitPercent } from './self-powered-gauge';\n  import type {\n    SelfPoweredDay,\n    SelfPoweredGaugeProps,\n    SelfPoweredSource,\n  } from './types';\n\n  const props = withDefaults(defineProps<SelfPoweredGaugeProps>(), {\n    value: 86,\n    title: 'Self-powered',\n    subtitle: 'Today, so far',\n    badge: '+9 pts',\n    label: 'Self-powered',\n    zoneFrom: 80,\n    sources: () => [\n      { label: 'Solar, direct', value: 7.2, color: '#ff9a2e' },\n      { label: 'Battery', value: 2.9, color: '#4ade80' },\n      { label: 'Grid', value: 1.7, color: '#7ea6ff' },\n    ],\n    unit: 'kWh',\n    sourcesLabel: 'Where it came from',\n    history: () => [\n      { label: 'F', name: 'Friday', value: 72 },\n      { label: 'S', name: 'Saturday', value: 88 },\n      { label: 'S', name: 'Sunday', value: 87 },\n      { label: 'M', name: 'Monday', value: 68 },\n      { label: 'T', name: 'Tuesday', value: 79 },\n      { label: 'W', name: 'Wednesday', value: 80 },\n      { label: 'T', name: 'Thursday', value: 86 },\n    ],\n    historyLabel: 'Last 7 days',\n    segments: 10,\n    jitter: 0.5,\n    color: '#ff9a2e',\n    class: '',\n  });\n\n  const emit = defineEmits<{ 'day-hover': [day: SelfPoweredDay | null] }>();\n\n  const total = computed(() =>\n    props.sources.reduce((sum, s) => sum + s.value, 0),\n  );\n  const percents = computed(() =>\n    splitPercent(props.sources.map((s) => s.value)),\n  );\n  const activeSource = ref<number | null>(null);\n\n  function sourceOpacity(i: number): number {\n    return activeSource.value === null || activeSource.value === i ? 1 : 0.3;\n  }\n  function highlight(i: number): void {\n    activeSource.value = i;\n  }\n  function clearHighlight(): void {\n    activeSource.value = null;\n  }\n\n  function formatSource(s: SelfPoweredSource, i: number): string {\n    return `${s.value.toFixed(1)} ${props.unit} · ${percents.value[i] ?? 0} %`;\n  }\n\n  // Today follows the live value.\n  const days = computed(() =>\n    props.history.map((d, i) =>\n      i === props.history.length - 1 ? { ...d, value: props.value } : d,\n    ),\n  );\n  const average = computed(() => {\n    if (days.value.length === 0) return 0;\n    const sum = days.value.reduce((acc, d) => acc + d.value, 0);\n    return Math.round(sum / days.value.length);\n  });\n  const segmentRows = computed(() =>\n    Array.from({ length: props.segments }, (_, i) => props.segments - 1 - i),\n  );\n\n  const hoveredDay = ref<number | null>(null);\n  const historyText = computed(() => {\n    const day =\n      hoveredDay.value === null ? undefined : days.value[hoveredDay.value];\n    if (!day) return `avg ${average.value} %`;\n    return `${day.name ?? day.label} · ${Math.round(day.value)} %`;\n  });\n\n  function lit(day: SelfPoweredDay): number {\n    return Math.round(\n      (Math.min(100, Math.max(0, day.value)) / 100) * props.segments,\n    );\n  }\n\n  function enterDay(i: number): void {\n    hoveredDay.value = i;\n    emit('day-hover', days.value[i] ?? null);\n  }\n  function leaveDay(): void {\n    hoveredDay.value = null;\n    emit('day-hover', null);\n  }\n\n  function segmentColor(dayIndex: number, row: number, count: number): string {\n    if (row >= count) return '';\n    const today = dayIndex === days.value.length - 1;\n    const hovered = hoveredDay.value === dayIndex;\n    if (today || hovered) return props.color;\n    return 'color-mix(in oklab, var(--spg-accent) 60%, var(--spg-mix))';\n  }\n</script>\n\n<template>\n  <article\n    :class=\"\n      cn(\n        'flex w-full max-w-88 flex-col gap-4 rounded-[1.75rem] [--spg-mix:#ffffff] dark:[--spg-mix:#1c1c1e] border border-border bg-card p-3 text-card-foreground shadow-[0_24px_48px_-20px_rgb(0_0_0/0.25)] dark:border-white/8 dark:bg-[#1c1c1e] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.06),0_24px_48px_-16px_rgb(0_0_0/0.7)]',\n        props.class,\n      )\n    \"\n    :style=\"{ '--spg-accent': props.color }\"\n  >\n    <header class=\"flex items-center gap-3 px-1.5 pt-1.5\">\n      <span\n        class=\"flex size-9 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-foreground shadow-[inset_0_1px_0_rgb(255_255_255/0.6)] dark:border-white/8 dark:bg-linear-to-b dark:from-[#2e2e30] dark:to-[#1f1f21] dark:shadow-[inset_0_1px_0_rgb(255_255_255/0.08),0_2px_6px_rgb(0_0_0/0.5)]\"\n      >\n        <Icon name=\"lucide:gauge\" class=\"size-4.5\" />\n      </span>\n      <div class=\"min-w-0 flex-1\">\n        <p class=\"truncate text-[15px]/tight font-medium\">{{ props.title }}</p>\n        <p class=\"truncate text-sm/tight text-muted-foreground\">\n          {{ props.subtitle }}\n        </p>\n      </div>\n      <span\n        v-if=\"props.badge\"\n        class=\"rounded-full border border-border bg-muted px-2.5 py-1 text-sm/none text-muted-foreground tabular-nums dark:border-white/6 dark:bg-black/30\"\n      >\n        {{ props.badge }}\n      </span>\n    </header>\n\n    <SelfPoweredGaugeMeter\n      :value=\"props.value\"\n      :zone-from=\"props.zoneFrom\"\n      :label=\"props.label\"\n      :jitter=\"props.jitter\"\n      :color=\"props.color\"\n    />\n\n    <section class=\"flex flex-col gap-3 px-2\" :aria-label=\"props.sourcesLabel\">\n      <div class=\"flex items-baseline justify-between text-sm\">\n        <span class=\"text-muted-foreground\">{{ props.sourcesLabel }}</span>\n        <span class=\"font-medium tabular-nums\">\n          {{ total.toFixed(1) }} {{ props.unit }}\n        </span>\n      </div>\n      <div\n        class=\"flex gap-1 rounded-full border border-border bg-muted p-1 dark:border-white/6 dark:bg-black/45 dark:shadow-[inset_0_1px_3px_rgb(0_0_0/0.7)]\"\n        aria-hidden=\"true\"\n      >\n        <span\n          v-for=\"(s, i) in props.sources\"\n          :key=\"s.label\"\n          class=\"h-3.5 min-w-2 rounded-full shadow-[inset_0_1px_0_rgb(255_255_255/0.35)] transition-[flex-grow,opacity] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none\"\n          :style=\"{\n            flexGrow: s.value,\n            flexBasis: 0,\n            backgroundColor: s.color,\n            opacity: sourceOpacity(i),\n          }\"\n          @mouseenter=\"highlight(i)\"\n          @mouseleave=\"clearHighlight\"\n        />\n      </div>\n      <ul class=\"flex flex-col gap-1.5\">\n        <li\n          v-for=\"(s, i) in props.sources\"\n          :key=\"s.label\"\n          class=\"flex items-center gap-2.5 text-sm transition-opacity duration-200\"\n          :style=\"{\n            opacity: activeSource === null || activeSource === i ? 1 : 0.45,\n          }\"\n          @mouseenter=\"highlight(i)\"\n          @mouseleave=\"clearHighlight\"\n        >\n          <span\n            class=\"size-2 shrink-0 rounded-[2px] ring-1 ring-black/25 dark:ring-2 dark:ring-black/60\"\n            :style=\"{\n              backgroundColor: s.color,\n              boxShadow: `0 0 6px ${s.color}`,\n            }\"\n          />\n          <span class=\"flex-1 truncate text-muted-foreground\">{{\n            s.label\n          }}</span>\n          <span class=\"tabular-nums\">{{ formatSource(s, i) }}</span>\n        </li>\n      </ul>\n    </section>\n\n    <section\n      class=\"flex flex-col gap-3 px-2 pb-2\"\n      :aria-label=\"props.historyLabel\"\n    >\n      <div class=\"flex items-baseline justify-between text-sm\">\n        <span class=\"text-muted-foreground\">{{ props.historyLabel }}</span>\n        <span class=\"font-medium tabular-nums\" aria-live=\"polite\">\n          {{ historyText }}\n        </span>\n      </div>\n      <div\n        class=\"grid gap-3\"\n        :style=\"{\n          gridTemplateColumns: `repeat(${days.length}, minmax(0, 1fr))`,\n        }\"\n        @mouseleave=\"leaveDay\"\n      >\n        <button\n          v-for=\"(day, i) in days\"\n          :key=\"i\"\n          type=\"button\"\n          class=\"group flex flex-col items-stretch gap-2 rounded-md outline-none focus-visible:ring-2 focus-visible:ring-(--spg-accent)/70 focus-visible:ring-offset-2 focus-visible:ring-offset-card\"\n          :aria-label=\"`${day.name ?? day.label}: ${Math.round(day.value)} %`\"\n          @mouseenter=\"enterDay(i)\"\n          @focus=\"enterDay(i)\"\n          @blur=\"leaveDay\"\n        >\n          <span class=\"flex flex-col gap-0.5\">\n            <span\n              v-for=\"row in segmentRows\"\n              :key=\"row\"\n              class=\"h-1.25 rounded-[1px] bg-black/8 transition-[background-color,box-shadow] duration-300 dark:bg-white/7\"\n              :style=\"\n                row < lit(day)\n                  ? {\n                      backgroundColor: segmentColor(i, row, lit(day)),\n                      boxShadow:\n                        i === days.length - 1 || hoveredDay === i\n                          ? `0 0 6px color-mix(in oklab, ${props.color} 60%, transparent)`\n                          : undefined,\n                    }\n                  : undefined\n              \"\n            />\n          </span>\n          <span\n            class=\"text-center text-sm/none\"\n            :class=\"\n              i === days.length - 1 || hoveredDay === i\n                ? 'font-semibold text-foreground'\n                : 'text-muted-foreground'\n            \"\n          >\n            {{ day.label }}\n          </span>\n        </button>\n      </div>\n    </section>\n  </article>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/self-powered-gauge/SelfPoweredGauge.vue"
    },
    {
      "path": "registry/new-york/self-powered-gauge/SelfPoweredGaugeMeter.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, onMounted, ref, useId, watch } from 'vue';\n  import {\n    useElementVisibility,\n    usePreferredReducedMotion,\n    useRafFn,\n  } from '@vueuse/core';\n  import SegmentDisplay from '../segment-display/SegmentDisplay.vue';\n  import type { SelfPoweredGaugeMeterProps } from './types';\n\n  const props = defineProps<SelfPoweredGaugeMeterProps>();\n\n  // Scale geometry in a 320×178 box. The pivot sits just below the face.\n  const CX = 160;\n  const CY = 186;\n  const R = 128;\n  const SWEEP = 56;\n\n  const clamp = (v: number): number => Math.min(100, Math.max(0, v));\n  const angle = (v: number): number => -SWEEP + (2 * SWEEP * clamp(v)) / 100;\n  const at = (r: number, deg: number): [number, number] => {\n    const rad = (deg * Math.PI) / 180;\n    return [CX + r * Math.sin(rad), CY - r * Math.cos(rad)];\n  };\n  const fmt = (n: number): string => n.toFixed(2);\n\n  function arc(r: number, from: number, to: number): string {\n    const [x1, y1] = at(r, angle(from));\n    const [x2, y2] = at(r, angle(to));\n    return `M${fmt(x1)} ${fmt(y1)}A${r} ${r} 0 0 1 ${fmt(x2)} ${fmt(y2)}`;\n  }\n\n  const ticks = Array.from({ length: 41 }, (_, i) => {\n    const v = i * 2.5;\n    const major = v % 25 === 0;\n    const a = angle(v);\n    const [x1, y1] = at(R - 2, a);\n    const [x2, y2] = at(R + (major ? 11 : v % 5 === 0 ? 6 : 4.5), a);\n    return { v, major, x1, y1, x2, y2 };\n  });\n  const labels = [0, 25, 50, 75, 100].map((v) => {\n    const [x, y] = at(R + 24, angle(v));\n    return { v, x, y };\n  });\n\n  const zonePath = computed(() => arc(R + 3.5, props.zoneFrom, 100));\n  const innerArc = arc(R - 9, 0, 100);\n\n  // Damped spring: a small overshoot, then it settles.\n  const reduced = usePreferredReducedMotion();\n  const position = ref(0);\n  const velocity = ref(0);\n  const tremble = ref(0);\n  let time = 0;\n\n  const root = ref<HTMLElement | null>(null);\n  const visible = useElementVisibility(root);\n\n  const raf = useRafFn(\n    ({ delta }) => {\n      const dt = Math.min(delta, 50) / 1000;\n      time += dt;\n      const force = 78 * (props.value - position.value) - 11.5 * velocity.value;\n      velocity.value += force * dt;\n      position.value += velocity.value * dt;\n      tremble.value =\n        props.jitter *\n        (Math.sin(time * 9.1) * 0.5 +\n          Math.sin(time * 3.7 + 1.3) * 0.35 +\n          Math.sin(time * 17.3) * 0.15);\n      const settled =\n        Math.abs(props.value - position.value) < 0.01 &&\n        Math.abs(velocity.value) < 0.01;\n      if (settled && props.jitter === 0) {\n        position.value = props.value;\n        raf.pause();\n      }\n    },\n    { immediate: false },\n  );\n\n  function sync(): void {\n    if (reduced.value === 'reduce') {\n      raf.pause();\n      position.value = props.value;\n      velocity.value = 0;\n      tremble.value = 0;\n      return;\n    }\n    if (visible.value) raf.resume();\n    else raf.pause();\n  }\n  watch([() => props.value, () => props.jitter, visible, reduced], sync);\n  onMounted(sync);\n\n  const needle = computed(() => {\n    const [x, y] = at(R + 14, angle(position.value + tremble.value));\n    return { x, y };\n  });\n  const readout = computed(() => String(Math.round(clamp(position.value))));\n  const faceId = `spg-face-${useId()}`;\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    class=\"@container relative aspect-320/178 overflow-hidden rounded-[1.25rem] border border-black/50 bg-[#0e0c0a] shadow-[inset_0_2px_14px_rgb(0_0_0/0.85),0_1px_0_rgb(255_255_255/0.05)] dark:border-white/6\"\n    :style=\"{ '--spg-accent': props.color }\"\n    role=\"meter\"\n    :aria-valuenow=\"Math.round(props.value)\"\n    aria-valuemin=\"0\"\n    aria-valuemax=\"100\"\n    :aria-label=\"props.label\"\n    :aria-valuetext=\"`${Math.round(props.value)} %`\"\n  >\n    <svg\n      viewBox=\"0 0 320 178\"\n      class=\"absolute inset-0 size-full\"\n      aria-hidden=\"true\"\n    >\n      <defs>\n        <radialGradient :id=\"faceId\" cx=\"50%\" cy=\"30%\" r=\"80%\">\n          <stop offset=\"0\" stop-color=\"#3a2f22\" />\n          <stop offset=\"0.55\" stop-color=\"#1b1712\" />\n          <stop offset=\"1\" stop-color=\"#0c0b09\" />\n        </radialGradient>\n      </defs>\n      <rect width=\"320\" height=\"178\" :fill=\"`url(#${faceId})`\" />\n      <path\n        :d=\"innerArc\"\n        fill=\"none\"\n        stroke=\"#e8e0cf\"\n        stroke-opacity=\"0.22\"\n        stroke-width=\"0.9\"\n      />\n      <path\n        :d=\"zonePath\"\n        fill=\"none\"\n        :stroke=\"props.color\"\n        stroke-width=\"7\"\n        style=\"filter: drop-shadow(0 0 4px var(--spg-accent))\"\n      />\n      <line\n        v-for=\"t in ticks\"\n        :key=\"t.v\"\n        :x1=\"t.x1\"\n        :y1=\"t.y1\"\n        :x2=\"t.x2\"\n        :y2=\"t.y2\"\n        :stroke=\"t.v >= props.zoneFrom ? '#2a1a08' : '#ddd5c4'\"\n        :stroke-opacity=\"t.v >= props.zoneFrom ? 0.55 : 0.85\"\n        :stroke-width=\"t.major ? 1.8 : 1.1\"\n      />\n      <text\n        v-for=\"l in labels\"\n        :key=\"l.v\"\n        :x=\"l.x\"\n        :y=\"l.y + 4\"\n        text-anchor=\"middle\"\n        font-size=\"12.5\"\n        :fill=\"l.v >= props.zoneFrom ? props.color : '#d8d0bf'\"\n        :fill-opacity=\"l.v >= props.zoneFrom ? 1 : 0.85\"\n      >\n        {{ l.v }}\n      </text>\n      <line\n        :x1=\"CX + 2\"\n        :y1=\"CY + 3\"\n        :x2=\"needle.x + 2\"\n        :y2=\"needle.y + 3\"\n        stroke=\"#000000\"\n        stroke-opacity=\"0.45\"\n        stroke-width=\"2.4\"\n        stroke-linecap=\"round\"\n      />\n      <line\n        :x1=\"CX\"\n        :y1=\"CY\"\n        :x2=\"needle.x\"\n        :y2=\"needle.y\"\n        stroke=\"#f6eedf\"\n        stroke-width=\"1.5\"\n        stroke-linecap=\"round\"\n      />\n      <circle\n        :cx=\"CX\"\n        :cy=\"CY + 4\"\n        r=\"38\"\n        fill=\"#090807\"\n        stroke=\"#ffffff\"\n        stroke-opacity=\"0.07\"\n      />\n    </svg>\n    <div\n      class=\"pointer-events-none absolute top-[56%] left-1/2 flex -translate-1/2 items-end gap-[1.2cqw]\"\n    >\n      <SegmentDisplay\n        :value=\"readout\"\n        :digits=\"2\"\n        :color=\"props.color\"\n        :label=\"`${readout} %`\"\n        class=\"text-[8.4cqw]\"\n      />\n      <span class=\"pb-[0.3cqw] text-[4.4cqw] text-(--spg-accent)\">%</span>\n    </div>\n    <span\n      class=\"pointer-events-none absolute bottom-[6%] left-[6%] text-[4.6cqw] tracking-wider text-[#d8d0bf]/45 uppercase\"\n    >\n      {{ props.label }}\n    </span>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/self-powered-gauge/SelfPoweredGaugeMeter.vue"
    },
    {
      "path": "registry/new-york/self-powered-gauge/index.ts",
      "content": "export { default as SelfPoweredGauge } from './SelfPoweredGauge.vue';\nexport { default as SelfPoweredGaugeMeter } from './SelfPoweredGaugeMeter.vue';\nexport { splitPercent } from './self-powered-gauge';\nexport type {\n  SelfPoweredDay,\n  SelfPoweredGaugeMeterProps,\n  SelfPoweredGaugeProps,\n  SelfPoweredSource,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/self-powered-gauge/index.ts"
    },
    {
      "path": "registry/new-york/self-powered-gauge/self-powered-gauge.ts",
      "content": "/**\n * Whole-number percentages that always add up to 100, using the\n * largest-remainder method.\n */\nexport function splitPercent(values: readonly number[]): number[] {\n  const total = values.reduce((sum, v) => sum + Math.max(0, v), 0);\n  if (total <= 0) return values.map(() => 0);\n  const exact = values.map((v) => (Math.max(0, v) / total) * 100);\n  const result = exact.map((v) => Math.floor(v));\n  let left = 100 - result.reduce((sum, v) => sum + v, 0);\n  const order = exact\n    .map((v, i) => ({ i, rest: v - Math.floor(v) }))\n    .sort((a, b) => b.rest - a.rest);\n  for (const { i } of order) {\n    if (left <= 0) break;\n    result[i] = (result[i] ?? 0) + 1;\n    left -= 1;\n  }\n  return result;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/self-powered-gauge/self-powered-gauge.ts"
    },
    {
      "path": "registry/new-york/self-powered-gauge/types.ts",
      "content": "export interface SelfPoweredSource {\n  label: string;\n  /** Energy from this source, in the gauge `unit`. */\n  value: number;\n  color: string;\n}\n\nexport interface SelfPoweredDay {\n  /** Short label under the column, e.g. `M`. */\n  label: string;\n  /** Full name for screen readers and the hover readout, e.g. `Monday`. */\n  name?: string;\n  /** Self-powered share for the day, 0–100. */\n  value: number;\n}\n\nexport interface SelfPoweredGaugeMeterProps {\n  value: number;\n  zoneFrom: number;\n  label: string;\n  jitter: number;\n  color: string;\n}\n\nexport interface SelfPoweredGaugeProps {\n  /** Self-powered share, 0–100. The needle springs to it. */\n  value?: number;\n  title?: string;\n  subtitle?: string;\n  /** Text in the pill on the right of the header. Hidden when empty. */\n  badge?: string;\n  /** Small caps label inside the meter. */\n  label?: string;\n  /** The orange zone on the scale starts here. */\n  zoneFrom?: number;\n  /** Where the energy came from. */\n  sources?: SelfPoweredSource[];\n  /** Unit for source values. */\n  unit?: string;\n  sourcesLabel?: string;\n  /** One entry per day. The last one is today and is highlighted. */\n  history?: SelfPoweredDay[];\n  historyLabel?: string;\n  /** Lit segments per day column. */\n  segments?: number;\n  /** Needle tremble in points, like a live VU meter. `0` turns it off. */\n  jitter?: number;\n  /** Accent colour for the zone, readout and today's column. */\n  color?: string;\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/self-powered-gauge/types.ts"
    }
  ]
}
