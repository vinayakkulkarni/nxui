{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "jelly-radio",
  "type": "registry:ui",
  "title": "Jelly Radio",
  "description": "Radio group of chips where the chosen one swells and barges its neighbours outward.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/jelly-radio/JellyRadio.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    nextTick,\n    onBeforeUnmount,\n    onMounted,\n    ref,\n    watch,\n  } from 'vue';\n  import { usePreferredReducedMotion, useResizeObserver } from '@vueuse/core';\n  import { animate, useMotionValue } from 'motion-v';\n  import type {\n    JellyRadioChipValues,\n    JellyRadioOption,\n    JellyRadioProps,\n  } from './types';\n\n  const SIZES = {\n    sm: { h: 28, font: 12, px: 12 },\n    md: { h: 36, font: 13, px: 16 },\n    lg: { h: 44, font: 14, px: 20 },\n  };\n\n  const props = withDefaults(defineProps<JellyRadioProps>(), {\n    items: () => ['Off', 'Low', 'Medium', 'High', 'Max'],\n    modelValue: undefined,\n    defaultValue: undefined,\n    chipColor: 'var(--muted)',\n    activeColor: 'var(--foreground)',\n    textColor: 'var(--foreground)',\n    activeTextColor: 'var(--background)',\n    size: 'md',\n    gap: 8,\n    radius: 18,\n    swell: 0.2,\n    barge: 6,\n    shrink: 0.05,\n    jelly: 1,\n    bounce: 0.25,\n    stagger: 22,\n    stiffness: 580,\n    disabled: false,\n    ariaLabel: 'Options',\n    class: undefined,\n  });\n\n  const emit = defineEmits<{\n    'update:modelValue': [value: string];\n    change: [value: string, index: number];\n  }>();\n\n  const list = computed<JellyRadioOption[]>(() =>\n    props.items.map((it) =>\n      typeof it === 'string' ? { value: it, label: it } : it,\n    ),\n  );\n  const inner = ref(props.defaultValue ?? list.value[0]?.value);\n  const current = computed(() => props.modelValue ?? inner.value);\n  const at = computed(() =>\n    Math.max(\n      0,\n      list.value.findIndex((it) => it.value === current.value),\n    ),\n  );\n  const reduceMotion = usePreferredReducedMotion();\n  const reduce = computed(() => reduceMotion.value === 'reduce');\n  const dims = computed(() => SIZES[props.size] ?? SIZES.md);\n  const itemsKey = computed(() => list.value.map((it) => it.value).join('|'));\n\n  const groupRef = ref<HTMLDivElement | null>(null);\n  let widths: number[] = [];\n  let applied = at.value;\n\n  const mvs: JellyRadioChipValues[] = [];\n\n  function chipAt(i: number) {\n    const el = groupRef.value?.children[i];\n    return el instanceof HTMLElement ? el : null;\n  }\n\n  function mvFor(i: number) {\n    const existing = mvs[i];\n    if (existing) return existing;\n    const x = useMotionValue(0);\n    const sx = useMotionValue(1);\n    const sy = useMotionValue(1);\n    const paint = () => {\n      const el = chipAt(i);\n      if (el)\n        el.style.transform = `translateX(${x.get()}px) scale(${sx.get()}, ${sy.get()})`;\n    };\n    const offs = [\n      x.on('change', paint),\n      sx.on('change', paint),\n      sy.on('change', paint),\n    ];\n    const created: JellyRadioChipValues = {\n      x,\n      sx,\n      sy,\n      off: () => offs.forEach((off) => off()),\n    };\n    mvs[i] = created;\n    return created;\n  }\n\n  function spring(k: number, m: number, bounce: number) {\n    return {\n      type: 'spring' as const,\n      stiffness: k,\n      damping: 2 * Math.sqrt(k * m) * (1 - bounce),\n      mass: m,\n    };\n  }\n\n  function apply(sel: number, instant: boolean) {\n    const group = groupRef.value;\n    const rtl = group ? getComputedStyle(group).direction === 'rtl' : false;\n    const push = ((widths[sel] ?? 0) * props.swell) / 2 + props.barge;\n    const count = list.value.length;\n    for (let i = 0; i < count; i++) {\n      const mv = mvFor(i);\n      const on = i === sel;\n      const far = Math.abs(i - sel);\n      const dir = Math.sign(i - sel) * (rtl ? -1 : 1);\n      const x = dir * push;\n      const s = on ? 1 + props.swell : 1 - props.shrink;\n      if (instant || reduce.value) {\n        mv.x.jump(x);\n        mv.sx.jump(s);\n        mv.sy.jump(s);\n        const el = chipAt(i);\n        if (el) el.style.transform = `translateX(${x}px) scale(${s}, ${s})`;\n        continue;\n      }\n      const k = props.stiffness * (1 - 0.12 * Math.min(far, 3));\n      const inFlight =\n        mv.x.isAnimating() || mv.sx.isAnimating() || mv.sy.isAnimating();\n      const delay = inFlight ? 0 : (far * props.stagger) / 1000;\n      const j = props.jelly;\n      animate(mv.x, x, { ...spring(k, 0.9, props.bounce), delay });\n      animate(mv.sx, s, {\n        ...spring(\n          k * (1 + 0.24 * j),\n          0.9 - 0.1 * j,\n          Math.min(0.85, props.bounce + 0.3 * j),\n        ),\n        delay,\n      });\n      animate(mv.sy, s, {\n        ...spring(k * (1 - 0.14 * j), 0.9 + 0.05 * j, props.bounce),\n        delay: delay + 0.05 * j,\n      });\n    }\n  }\n\n  function measure() {\n    const group = groupRef.value;\n    if (!group) return;\n    const chips = list.value.map((_, i) => chipAt(i));\n    widths = chips.map((el) => el?.offsetWidth ?? 0);\n    const chipH = chips[0]?.offsetHeight ?? 0;\n    const maxW = Math.max(0, ...widths);\n    group.style.setProperty(\n      '--jr-pad-x',\n      `${Math.ceil((maxW * props.swell * 1.3) / 2 + props.barge) + 2}px`,\n    );\n    group.style.setProperty(\n      '--jr-pad-y',\n      `${Math.ceil((chipH * props.swell) / 2) + 2}px`,\n    );\n  }\n\n  function settle() {\n    measure();\n    apply(applied, true);\n  }\n\n  useResizeObserver(groupRef, settle);\n  onMounted(() => {\n    settle();\n    void document.fonts?.ready.then(settle);\n  });\n  watch(\n    [\n      itemsKey,\n      () => props.size,\n      () => props.gap,\n      () => props.swell,\n      () => props.barge,\n      () => props.shrink,\n    ],\n    () => {\n      void nextTick(settle);\n    },\n  );\n  watch(at, (next) => {\n    if (applied === next) return;\n    applied = next;\n    apply(next, true);\n  });\n\n  onBeforeUnmount(() => {\n    mvs.forEach((mv) => {\n      mv.off();\n      mv.x.destroy();\n      mv.sx.destroy();\n      mv.sy.destroy();\n    });\n  });\n\n  function commit(i: number, instant: boolean) {\n    const item = list.value[i];\n    if (props.disabled || i === at.value || !item || item.disabled) return;\n    applied = i;\n    apply(i, instant);\n    if (props.modelValue === undefined) inner.value = item.value;\n    emit('update:modelValue', item.value);\n    emit('change', item.value, i);\n  }\n\n  function stepFrom(i: number, dir: number) {\n    const n = list.value.length;\n    let j = i;\n    for (let tries = 0; tries < n; tries++) {\n      j = (j + dir + n) % n;\n      if (!list.value[j]?.disabled) return j;\n    }\n    return i;\n  }\n\n  function onChipClick(event: MouseEvent, i: number) {\n    commit(i, event.detail === 0);\n  }\n\n  function onKeyDown(event: KeyboardEvent, i: number) {\n    let next: number | null = null;\n    if (event.key === 'ArrowRight' || event.key === 'ArrowDown')\n      next = stepFrom(i, 1);\n    else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')\n      next = stepFrom(i, -1);\n    else if (event.key === 'Home') next = stepFrom(-1, 1);\n    else if (event.key === 'End') next = stepFrom(list.value.length, -1);\n    else if (event.key === ' ' || event.key === 'Enter') next = i;\n    if (next === null) return;\n    event.preventDefault();\n    commit(next, true);\n    chipAt(next)?.focus();\n  }\n\n  const groupStyle = computed(() => ({\n    '--jr-chip': props.chipColor,\n    '--jr-active': props.activeColor,\n    '--jr-text': props.textColor,\n    '--jr-active-text': props.activeTextColor,\n    '--jr-gap': `${props.gap}px`,\n    '--jr-radius': `${props.radius}px`,\n    '--jr-h': `${dims.value.h}px`,\n    '--jr-font': `${dims.value.font}px`,\n    '--jr-px': `${dims.value.px}px`,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"groupRef\"\n    role=\"radiogroup\"\n    :aria-label=\"ariaLabel\"\n    :data-disabled=\"disabled ? '' : undefined\"\n    :class=\"['jelly-radio', props.class]\"\n    :style=\"groupStyle\"\n  >\n    <button\n      v-for=\"(it, i) in list\"\n      :key=\"it.value\"\n      type=\"button\"\n      role=\"radio\"\n      :aria-checked=\"i === at\"\n      :tabindex=\"i === at ? 0 : -1\"\n      :disabled=\"disabled || !!it.disabled\"\n      class=\"jelly-radio__chip\"\n      :data-on=\"i === at ? 'true' : 'false'\"\n      @click=\"onChipClick($event, i)\"\n      @keydown=\"onKeyDown($event, i)\"\n    >\n      <span class=\"jelly-radio__skin\">\n        <span v-if=\"it.icon\" class=\"jelly-radio__icon\">\n          <Icon :name=\"it.icon\" class=\"size-[1.1em]\" />\n        </span>\n        <span class=\"jelly-radio__label\">{{ it.label }}</span>\n      </span>\n    </button>\n  </div>\n</template>\n\n<style scoped>\n  .jelly-radio {\n    --jr-pad-x: 16px;\n    --jr-pad-y: 6px;\n    --jr-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n\n    display: inline-flex;\n    align-items: center;\n    gap: var(--jr-gap);\n    padding: var(--jr-pad-y) var(--jr-pad-x);\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n  }\n\n  .jelly-radio[data-disabled] {\n    opacity: 0.5;\n    pointer-events: none;\n  }\n\n  .jelly-radio__chip {\n    position: relative;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    background: none;\n    color: inherit;\n    font: inherit;\n    cursor: pointer;\n    outline: none;\n    transform-origin: 50% 50%;\n    touch-action: manipulation;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .jelly-radio__chip[data-on='true'] {\n    cursor: default;\n  }\n\n  .jelly-radio:not([data-disabled]) .jelly-radio__chip:disabled {\n    cursor: default;\n    opacity: 0.4;\n  }\n\n  .jelly-radio__skin {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.4em;\n    height: var(--jr-h);\n    padding: 0 var(--jr-px);\n    border-radius: var(--jr-radius);\n    overflow: hidden;\n    background: var(--jr-chip);\n    color: var(--jr-text);\n    font-size: var(--jr-font);\n    font-weight: 500;\n    line-height: 1;\n    white-space: nowrap;\n    transition:\n      transform 160ms var(--jr-ease-out),\n      background-color 200ms ease,\n      color 200ms ease;\n  }\n\n  .jelly-radio__chip:focus-visible .jelly-radio__skin {\n    outline: 2px solid color-mix(in srgb, var(--jr-text) 60%, transparent);\n    outline-offset: 2px;\n    overflow: visible;\n  }\n\n  .jelly-radio__skin::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    background: var(--jr-text);\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 160ms ease;\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .jelly-radio__chip[data-on='false']:not(:disabled):hover\n      .jelly-radio__skin::before {\n      opacity: 0.11;\n    }\n  }\n\n  .jelly-radio__chip:active .jelly-radio__skin {\n    transform: scale(0.97);\n  }\n\n  .jelly-radio__chip[data-on='true'] .jelly-radio__skin {\n    background: var(--jr-active);\n    color: var(--jr-active-text);\n  }\n\n  .jelly-radio__icon {\n    display: inline-flex;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .jelly-radio__chip:active .jelly-radio__skin {\n      transform: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/jelly-radio/JellyRadio.vue"
    },
    {
      "path": "registry/new-york/jelly-radio/index.ts",
      "content": "export { default as JellyRadio } from './JellyRadio.vue';\nexport type {\n  JellyRadioItem,\n  JellyRadioOption,\n  JellyRadioProps,\n  JellyRadioSize,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/jelly-radio/index.ts"
    },
    {
      "path": "registry/new-york/jelly-radio/types.ts",
      "content": "import type { HTMLAttributes } from 'vue';\nimport type { MotionValue } from 'motion-v';\n\nexport type JellyRadioSize = 'sm' | 'md' | 'lg';\n\nexport interface JellyRadioOption {\n  value: string;\n  label: string;\n  /** Iconify name rendered before the label, e.g. `lucide:sun`. */\n  icon?: string;\n  disabled?: boolean;\n}\n\n/** A string is both value and label. */\nexport type JellyRadioItem = string | JellyRadioOption;\n\nexport interface JellyRadioProps {\n  /** The chips. */\n  items?: JellyRadioItem[];\n  /** Controlled value (`v-model`). Outside changes jump. */\n  modelValue?: string;\n  /** Initial value when uncontrolled. Defaults to the first item. */\n  defaultValue?: string;\n  /** Surface of an unchosen chip. */\n  chipColor?: string;\n  /** Surface of the chosen chip. */\n  activeColor?: string;\n  /** Label of an unchosen chip, and the hover tone. */\n  textColor?: string;\n  /** Label of the chosen chip. */\n  activeTextColor?: string;\n  /** Chip height 28, 36 or 44 pixels. */\n  size?: JellyRadioSize;\n  /** Rest spacing between chips in pixels. */\n  gap?: number;\n  /** Corner radius in pixels. */\n  radius?: number;\n  /** How much the chosen chip grows. */\n  swell?: number;\n  /** Extra pixels every neighbour is shoved beyond the room it makes. */\n  barge?: number;\n  /** How much every unchosen chip gives up. */\n  shrink?: number;\n  /** The wide-before-tall split. 0 swells uniformly. */\n  jelly?: number;\n  /** One minus the damping ratio. */\n  bounce?: number;\n  /** Milliseconds per row step before a neighbour moves. */\n  stagger?: number;\n  /** Spring stiffness of the chosen chip. */\n  stiffness?: number;\n  /** Fades the group and ignores input. */\n  disabled?: boolean;\n  /** Accessible name of the group. */\n  ariaLabel?: string;\n  class?: HTMLAttributes['class'];\n}\n\n/** Internal: the motion values that drive one chip. */\nexport interface JellyRadioChipValues {\n  x: MotionValue<number>;\n  sx: MotionValue<number>;\n  sy: MotionValue<number>;\n  off: () => void;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/jelly-radio/types.ts"
    }
  ]
}
