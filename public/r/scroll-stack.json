  "name": "scroll-stack",
  "type": "registry:ui",
  "title": "Scroll Stack",
  "description": "Cards pin and stack as you scroll, settling back into a dimmed deck with smooth, jitter-free motion.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/scroll-stack/ScrollStack.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    onBeforeUnmount,\n    onMounted,\n    onUpdated,\n    ref,\n    useSlots,\n    watch,\n  } from 'vue';\n  import {\n    useEventListener,\n    usePreferredReducedMotion,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import { cn } from '~/lib/utils';\n  import {\n    flattenSlot,\n    resolveOffset,\n    scrollsInside,\n    toLength,\n  } from './scroll-stack-utils';\n  import type { ScrollStackProps } from './types';\n\n  const props = withDefaults(defineProps<ScrollStackProps>(), {\n    itemDistance: 100,\n    itemStackDistance: 24,\n    stackPosition: '15%',\n    itemScale: 0.05,\n    baseScale: 0.8,\n    dimAmount: 0.2,\n    blurAmount: 0,\n    tiltAmount: 0,\n    rotationAmount: 0,\n    holdDistance: 200,\n    smoothScroll: true,\n    snap: false,\n    useWindowScroll: false,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    stackComplete: [];\n  }>();\n\n  const slots = useSlots();\n  const rootRef = ref<HTMLElement | null>(null);\n  const innerRef = ref<HTMLElement | null>(null);\n  const endRef = ref<HTMLElement | null>(null);\n  const mounted = ref(false);\n  const reducedMotion = usePreferredReducedMotion();\n\n  function entries() {\n    const nodes = flattenSlot(slots.default?.() ?? []);\n    return nodes.map((node, index) => ({\n      node,\n      index,\n      key: node.key ?? index,\n      spacer: index > 0 ? spacerStyle(index, nodes.length) : null,\n      style: slotStyle(index, nodes.length),\n    }));\n  }\n\n  function spacerStyle(index: number, count: number) {\n    const gap = props.itemDistance - (count - index) * props.itemStackDistance;\n    return {\n      height: `${Math.max(0, gap)}px`,\n      marginTop: `${Math.min(0, gap)}px`,\n    };\n  }\n\n  function slotStyle(index: number, count: number) {\n    return {\n      top: `calc(${toLength(props.stackPosition)} + ${index * props.itemStackDistance}px)`,\n      marginBottom: `${(count - 1 - index) * props.itemStackDistance}px`,\n      zIndex: index + 1,\n    };\n  }\n\n  const cache = new Map<string, string | number>();\n  let frame = 0;\n  let glide = 0;\n  let rest = 0;\n  let complete = false;\n  let gliding = false;\n  let pressed = false;\n  let current = 0;\n  let goal = 0;\n  let written = 0;\n  let last = 0;\n  let points: number[] = [];\n  let reach = 0;\n\n  const windowed = () => props.useWindowScroll;\n  const reduced = () => reducedMotion.value === 'reduce';\n\n  function readScroll() {\n    return windowed() ? window.scrollY : (rootRef.value?.scrollTop ?? 0);\n  }\n\n  function maxScroll() {\n    const root = rootRef.value;\n    if (windowed())\n      return document.documentElement.scrollHeight - window.innerHeight;\n    return root ? root.scrollHeight - root.clientHeight : 0;\n  }\n\n  function writeScroll(value: number) {\n    written = value;\n    const target = windowed() ? window : rootRef.value;\n    target?.scrollTo({ top: value, behavior: 'instant' });\n  }\n\n  function write(\n    key: string,\n    value: string | number,\n    apply: (value: string | number) => void,\n  ) {\n    if (cache.get(key) === value) return false;\n    cache.set(key, value);\n    apply(value);\n    return true;\n  }\n\n  function update() {\n    frame = 0;\n    const root = rootRef.value;\n    const inner = innerRef.value;\n    const end = endRef.value;\n    if (!root || !inner || !end) return;\n    const slotEls = Array.from(inner.children).filter(\n      (child): child is HTMLElement =>\n        child instanceof HTMLElement && child.hasAttribute('data-stack-slot'),\n    );\n    if (!slotEls.length) return;\n\n    const isWindow = windowed();\n    const viewHeight = isWindow ? window.innerHeight : root.clientHeight;\n    const viewTop = isWindow\n      ? 0\n      : root.getBoundingClientRect().top + root.clientTop;\n    const stackTop = resolveOffset(props.stackPosition, viewHeight);\n    const offset = props.itemStackDistance;\n    const heights = slotEls.map((slot) => slot.offsetHeight);\n    const tops = slotEls.map((slot) => slot.getBoundingClientRect().top);\n    const lastPin = stackTop + (slotEls.length - 1) * offset;\n    const padTop = isWindow ? 0 : stackTop;\n    const lastHeight = heights[heights.length - 1] ?? 0;\n    const endHeight =\n      props.holdDistance +\n      (isWindow ? 0 : Math.max(0, viewHeight - lastPin - lastHeight));\n\n    let moved = write('padTop', padTop, (value) => {\n      inner.style.paddingTop = `${value}px`;\n    });\n    moved =\n      write('endHeight', endHeight, (value) => {\n        end.style.height = `${value}px`;\n      }) || moved;\n\n    let flow =\n      inner.getBoundingClientRect().top - viewTop + readScroll() + padTop;\n    points = heights.map((height, i) => {\n      const point = flow - stackTop - i * offset;\n      flow += height + props.itemDistance;\n      return point;\n    });\n    reach = Math.max(40, ((heights[0] ?? 0) + props.itemDistance - offset) / 2);\n\n    const depths = slotEls.map(() => 0);\n    let lastCover = 0;\n    for (let j = 1; j < slotEls.length; j++) {\n      const pinBefore = viewTop + stackTop + (j - 1) * offset;\n      const start = pinBefore + (heights[j - 1] ?? 0);\n      const span = Math.max(1, start - pinBefore - offset);\n      const cover = Math.min(1, Math.max(0, (start - (tops[j] ?? 0)) / span));\n      for (let i = 0; i < j; i++) depths[i] = (depths[i] ?? 0) + cover;\n      lastCover = cover;\n    }\n\n    const dimStep = Math.min(Math.max(props.dimAmount, 0), 1);\n    slotEls.forEach((slot, i) => {\n      const card = slot.firstElementChild;\n      if (!(card instanceof HTMLElement)) return;\n      const depth = depths[i] ?? 0;\n      const lean = Math.min(depth, 1);\n      const scale = Math.max(\n        Math.min(props.baseScale, 1),\n        1 - depth * props.itemScale,\n      );\n      const tilt = -lean * props.tiltAmount;\n      const turn = lean * props.rotationAmount * (i % 2 ? -1 : 1);\n      const blur = depth * props.blurAmount;\n      const dim = 1 - Math.pow(1 - dimStep, depth);\n      const transform =\n        depth < 0.0005\n          ? ''\n          : `perspective(1200px) rotateX(${tilt.toFixed(2)}deg) rotate(${turn.toFixed(2)}deg) scale(${scale.toFixed(4)})`;\n      write(`transform${i}`, transform, (value) => {\n        card.style.transform = String(value);\n      });\n      write(\n        `filter${i}`,\n        blur > 0.01 ? `blur(${blur.toFixed(2)}px)` : '',\n        (value) => {\n          card.style.filter = String(value);\n        },\n      );\n      write(`dim${i}`, dim.toFixed(3), (value) => {\n        card.style.setProperty('--scroll-stack-dim', String(value));\n      });\n    });\n\n    const done = slotEls.length > 1 && lastCover >= 0.999;\n    if (done !== complete) {\n      complete = done;\n      if (done) emit('stackComplete');\n    }\n\n    if (moved) schedule();\n  }\n\n  function schedule() {\n    if (!mounted.value) return;\n    if (!frame) frame = requestAnimationFrame(update);\n  }\n\n  function stopGlide() {\n    gliding = false;\n    cancelAnimationFrame(glide);\n    glide = 0;\n  }\n\n  function step(now: number) {\n    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));\n    last = now;\n    if (Math.abs(readScroll() - written) > 2) {\n      stopGlide();\n      settleSoon();\n      return;\n    }\n    current += (goal - current) * (1 - Math.pow(0.9, dt * 60));\n    if (Math.abs(goal - current) < 0.5) current = goal;\n    writeScroll(current);\n    if (current === goal) {\n      stopGlide();\n      settleSoon();\n      return;\n    }\n    glide = requestAnimationFrame(step);\n  }\n\n  function glideTo(value: number) {\n    goal = Math.min(Math.max(value, 0), maxScroll());\n    if (reduced()) {\n      writeScroll(goal);\n      return;\n    }\n    if (gliding) return;\n    gliding = true;\n    current = readScroll();\n    written = current;\n    last = performance.now();\n    glide = requestAnimationFrame(step);\n  }\n\n  function settle() {\n    rest = 0;\n    if (!props.snap || gliding || pressed || !points.length) return;\n    const now = readScroll();\n    const nearest = points.reduce((best, point) =>\n      Math.abs(point - now) < Math.abs(best - now) ? point : best,\n    );\n    const gap = Math.abs(nearest - now);\n    if (gap > 1 && gap < reach) glideTo(nearest);\n  }\n\n  function settleSoon() {\n    window.clearTimeout(rest);\n    rest = window.setTimeout(settle, 140);\n  }\n\n  function onScroll() {\n    schedule();\n    if (!gliding) settleSoon();\n  }\n\n  function onWheel(event: WheelEvent) {\n    const root = rootRef.value;\n    if (\n      !root ||\n      !props.smoothScroll ||\n      reduced() ||\n      event.defaultPrevented ||\n      event.ctrlKey\n    )\n      return;\n    if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;\n    const isWindow = windowed();\n    const page = isWindow ? window.innerHeight : root.clientHeight;\n    const delta =\n      event.deltaY *\n      (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? page : 1);\n    if (\n      !delta ||\n      scrollsInside(event.target, isWindow ? document.body : root, delta)\n    )\n      return;\n    const base = gliding ? goal : readScroll();\n    if ((delta < 0 && base <= 0) || (delta > 0 && base >= maxScroll() - 0.5))\n      return;\n    event.preventDefault();\n    window.clearTimeout(rest);\n    glideTo(base + delta);\n  }\n\n  function onPress() {\n    pressed = true;\n    window.clearTimeout(rest);\n  }\n\n  function onRelease() {\n    if (!pressed) return;\n    pressed = false;\n    settleSoon();\n  }\n\n  const scrollTarget = computed(() => {\n    if (!mounted.value) return null;\n    return props.useWindowScroll ? window : rootRef.value;\n  });\n  const releaseTarget = computed(() => (mounted.value ? window : null));\n\n  useEventListener(scrollTarget, 'scroll', onScroll, { passive: true });\n  useEventListener(scrollTarget, 'wheel', onWheel, { passive: false });\n  useEventListener(scrollTarget, 'pointerdown', onPress, { passive: true });\n  useEventListener(releaseTarget, 'pointerup', onRelease, { passive: true });\n  useEventListener(releaseTarget, 'pointercancel', onRelease, {\n    passive: true,\n  });\n  useEventListener(releaseTarget, 'resize', schedule);\n  useResizeObserver([rootRef, innerRef], schedule);\n\n  watch(props, schedule);\n  onUpdated(schedule);\n\n  watch(\n    () => props.useWindowScroll,\n    () => {\n      stopGlide();\n      window.clearTimeout(rest);\n      cache.clear();\n      complete = false;\n      schedule();\n    },\n  );\n\n  onMounted(() => {\n    mounted.value = true;\n    update();\n  });\n\n  onBeforeUnmount(() => {\n    cancelAnimationFrame(frame);\n    stopGlide();\n    window.clearTimeout(rest);\n  });\n</script>\n\n<template>\n  <div\n    ref=\"rootRef\"\n    :class=\"\n      cn(\n        'scroll-stack relative w-full',\n        useWindowScroll\n          ? 'scroll-stack--window'\n          : 'scroll-stack--contained h-full overflow-x-hidden overflow-y-auto',\n        props.class,\n      )\n    \"\n  >\n    <div\n      ref=\"innerRef\"\n      class=\"scroll-stack__inner relative px-[clamp(1rem,6%,5rem)]\"\n    >\n      <template v-for=\"entry in entries()\" :key=\"entry.key\">\n        <div v-if=\"entry.spacer\" aria-hidden=\"true\" :style=\"entry.spacer\" />\n        <div\n          data-stack-slot=\"\"\n          class=\"scroll-stack__slot sticky\"\n          :style=\"entry.style\"\n        >\n          <component :is=\"entry.node\" />\n        </div>\n      </template>\n      <div ref=\"endRef\" class=\"scroll-stack__end\" aria-hidden=\"true\" />\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/scroll-stack/ScrollStack.vue"
    },
    {
      "path": "registry/new-york/scroll-stack/ScrollStackItem.vue",
      "content": "<script setup lang=\"ts\">\n  import { cn } from '~/lib/utils';\n  import type { ScrollStackItemProps } from './types';\n\n  const props = withDefaults(defineProps<ScrollStackItemProps>(), {\n    class: '',\n  });\n</script>\n\n<template>\n  <div\n    :class=\"\n      cn(\n        'scroll-stack-card relative box-border [--scroll-stack-dim:0] h-80 w-full origin-top rounded-[28px] bg-card p-10 text-card-foreground shadow-[0_0_0_1px_rgb(0_0_0/0.06),0_-12px_40px_-16px_rgb(0_0_0/0.35),0_24px_48px_-24px_rgb(0_0_0/0.4)] will-change-transform dark:shadow-[0_0_0_1px_rgb(255_255_255/0.08),0_-12px_40px_-16px_rgb(0_0_0/0.35),0_24px_48px_-24px_rgb(0_0_0/0.4)]',\n        props.class,\n      )\n    \"\n  >\n    <slot />\n    <span\n      class=\"pointer-events-none absolute inset-0 rounded-[inherit] bg-black opacity-(--scroll-stack-dim)\"\n      aria-hidden=\"true\"\n    />\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/scroll-stack/ScrollStackItem.vue"
    },
    {
      "path": "registry/new-york/scroll-stack/index.ts",
      "content": "export { default as ScrollStack } from './ScrollStack.vue';\nexport { default as ScrollStackItem } from './ScrollStackItem.vue';\nexport type { ScrollStackItemProps, ScrollStackProps } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/scroll-stack/index.ts"
    },
    {
      "path": "registry/new-york/scroll-stack/scroll-stack-utils.ts",
      "content": "import { Comment, Fragment, Text, isVNode } from 'vue';\nimport type { VNode } from 'vue';\n\nexport function resolveOffset(value: number | string, size: number): number {\n  if (typeof value === 'number') return value;\n  const text = value.trim();\n  if (text.endsWith('%')) return (Number.parseFloat(text) / 100) * size;\n  return Number.parseFloat(text) || 0;\n}\n\nexport function toLength(value: number | string): string {\n  return typeof value === 'number' ? `${value}px` : value;\n}\n\n/** True when a nested scroller under `node` can still scroll in the wheel direction. */\nexport function scrollsInside(\n  node: EventTarget | null,\n  stop: Element,\n  delta: number,\n): boolean {\n  let element = node instanceof Element ? node : null;\n  for (; element && element !== stop; element = element.parentElement) {\n    if (element.scrollHeight <= element.clientHeight + 1) continue;\n    const overflow = getComputedStyle(element).overflowY;\n    if (overflow !== 'auto' && overflow !== 'scroll') continue;\n    if (\n      delta > 0\n        ? element.scrollTop + element.clientHeight < element.scrollHeight - 1\n        : element.scrollTop > 0\n    ) {\n      return true;\n    }\n  }\n  return false;\n}\n\n/** Flattens slot fragments (v-for) and drops comments / whitespace text. */\nexport function flattenSlot(nodes: VNode[]): VNode[] {\n  const out: VNode[] = [];\n  for (const node of nodes) {\n    if (node.type === Comment) continue;\n    if (node.type === Text && String(node.children ?? '').trim() === '')\n      continue;\n    if (node.type === Fragment && Array.isArray(node.children)) {\n      out.push(\n        ...flattenSlot(\n          node.children.filter((child): child is VNode => isVNode(child)),\n        ),\n      );\n      continue;\n    }\n    out.push(node);\n  }\n  return out;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/scroll-stack/scroll-stack-utils.ts"
    },
    {
      "path": "registry/new-york/scroll-stack/types.ts",
      "content": "export interface ScrollStackProps {\n  /** Gap between cards before they stack, in px. */\n  itemDistance?: number;\n  /** How far each card rests below the one before it in the stack, in px. */\n  itemStackDistance?: number;\n  /** Where the stack pins. A number is px, or use a % string. */\n  stackPosition?: number | string;\n  /** How much a card shrinks for each card stacked on top of it. */\n  itemScale?: number;\n  /** The smallest a buried card can shrink to. */\n  baseScale?: number;\n  /** How much a card darkens for each card stacked on top, 0–1. */\n  dimAmount?: number;\n  /** Blur added for each card stacked on top, in px. */\n  blurAmount?: number;\n  /** How far buried cards lean back in 3D, in degrees. */\n  tiltAmount?: number;\n  /** How far buried cards turn, alternating left and right, in degrees. */\n  rotationAmount?: number;\n  /** How long the finished stack stays pinned, in px of scrolling. */\n  holdDistance?: number;\n  /** Glides mouse wheel scrolling smoothly. */\n  smoothScroll?: boolean;\n  /** Glides the nearest card onto the stack when scrolling stops near it. */\n  snap?: boolean;\n  /** Stacks the cards as the page scrolls instead of inside the container. */\n  useWindowScroll?: boolean;\n  class?: string;\n}\n\nexport interface ScrollStackItemProps {\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/scroll-stack/types.ts"
    }
  ]
}
