{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "bell-toggle",
  "type": "registry:ui",
  "title": "Bell Toggle",
  "description": "Pill toggle where a press rings the bell, crossfades the label and unfurls the pill.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/bell-toggle/BellToggle.vue",
      "content": "<script setup lang=\"ts\">\n  import {\n    computed,\n    onBeforeUnmount,\n    onMounted,\n    ref,\n    useTemplateRef,\n    watch,\n  } from 'vue';\n  import { animate, motionValue } from 'motion-v';\n  import type { AnimationPlaybackControls } from 'motion-v';\n  import { usePreferredReducedMotion, useResizeObserver } from '@vueuse/core';\n  import type { BellToggleInput, BellToggleProps } from './types';\n  import {\n    BELL_BODY,\n    SIZES,\n    SPRING_UI,\n    WOBBLE,\n    liveAngle,\n    passOffset,\n    ringKeyframes,\n  } from './bell-ring';\n\n  const props = withDefaults(defineProps<BellToggleProps>(), {\n    offLabel: 'Notify me',\n    onLabel: \"You'll be notified\",\n    icon: 'lucide:bell',\n    label: undefined,\n    color: '#f5f5f5',\n    background: '#27272a',\n    onColor: '#18181b',\n    onBackground: '#f5f5f5',\n    size: 'md',\n    radius: 22,\n    ringAmplitude: 17,\n    ringPasses: 5,\n    ringDecay: 1,\n    ringDuration: 820,\n    ringPivot: 16,\n    crossfadeMs: 200,\n    revealBounce: 0,\n    count: 0,\n    badge: true,\n    badgeColor: '#ef4444',\n    badgeTextColor: '#ffffff',\n    waves: true,\n    clapper: false,\n    pressed: undefined,\n    defaultPressed: false,\n    disabled: false,\n    class: '',\n  });\n\n  const emit = defineEmits<{\n    'update:pressed': [pressed: boolean];\n    change: [pressed: boolean];\n  }>();\n\n  const inner = ref(props.defaultPressed);\n  const on = computed(() => props.pressed ?? inner.value);\n  const reducedMotion = usePreferredReducedMotion();\n  const reduce = computed(() => reducedMotion.value === 'reduce');\n\n  const rootRef = useTemplateRef<HTMLSpanElement>('root');\n  const glyphRef = useTemplateRef<HTMLSpanElement>('glyph');\n  const clapperRef = useTemplateRef<HTMLSpanElement>('clapperEl');\n  const waveLeft = useTemplateRef<SVGSVGElement>('waveLeft');\n  const waveRight = useTemplateRef<SVGSVGElement>('waveRight');\n  const offRef = useTemplateRef<HTMLSpanElement>('offFace');\n  const onRef = useTemplateRef<HTMLSpanElement>('onFace');\n\n  let lastInput: BellToggleInput = 'pointer';\n  let pending: BellToggleInput | null = null;\n  let spring: AnimationPlaybackControls | null = null;\n\n  const preset = computed(() => SIZES[props.size] ?? SIZES.md);\n\n  const t = motionValue(on.value ? 1 : 0);\n  const wOff = motionValue(0);\n  const wOn = motionValue(0);\n\n  function paintClip() {\n    const root = rootRef.value;\n    if (!root) return;\n    const a = wOff.get();\n    const b = wOn.get();\n    const clip = Math.max(a, b) - (a + (b - a) * t.get());\n    root.style.setProperty('--bt-clip', `${clip}px`);\n  }\n\n  const unsubscribers = [\n    t.on('change', paintClip),\n    wOff.on('change', paintClip),\n    wOn.on('change', paintClip),\n  ];\n\n  function measure() {\n    if (offRef.value) wOff.set(offRef.value.offsetWidth);\n    if (onRef.value) wOn.set(onRef.value.offsetWidth);\n    paintClip();\n  }\n\n  useResizeObserver(offRef, measure);\n  useResizeObserver(onRef, measure);\n\n  onMounted(() => {\n    measure();\n    document.fonts?.ready.then(measure);\n  });\n\n  watch(\n    [() => props.offLabel, () => props.onLabel, () => props.size],\n    measure,\n    {\n      flush: 'post',\n    },\n  );\n\n  function swing(amplitude: number, passes: number, duration: number) {\n    const el = glyphRef.value;\n    if (!el) return;\n    el.getAnimations().forEach((a) => a.cancel());\n    el.animate(\n      ringKeyframes(liveAngle(el), amplitude, passes, props.ringDecay),\n      {\n        duration,\n        easing: 'linear',\n      },\n    );\n    const c = clapperRef.value;\n    if (c) {\n      c.getAnimations().forEach((a) => a.cancel());\n      c.animate(\n        ringKeyframes(liveAngle(c), amplitude * 1.6, passes, props.ringDecay),\n        { duration, delay: 70, easing: 'linear' },\n      );\n    }\n    if (!props.waves) return;\n    for (let k = 0; k < passes; k++) {\n      const side = k % 2 ? waveRight.value : waveLeft.value;\n      if (!side) continue;\n      const strength = Math.pow(1 - k / passes, props.ringDecay);\n      side.animate(\n        [\n          { opacity: 0, transform: 'scale(0.55)' },\n          { opacity: 0.9 * strength, offset: 0.3 },\n          { opacity: 0, transform: 'scale(1.25)' },\n        ],\n        {\n          duration: 380,\n          delay: passOffset(k, passes) * duration,\n          easing: 'ease-out',\n        },\n      );\n    }\n  }\n\n  watch(\n    on,\n    (value) => {\n      const pointer = pending === 'pointer' && !reduce.value;\n      pending = null;\n      spring?.stop();\n      if (pointer) {\n        spring = animate(t, value ? 1 : 0, {\n          ...SPRING_UI,\n          bounce: props.revealBounce,\n        });\n      } else {\n        t.jump(value ? 1 : 0);\n      }\n      if (value && pointer) {\n        swing(props.ringAmplitude, props.ringPasses, props.ringDuration);\n      }\n    },\n    { flush: 'post' },\n  );\n\n  watch(\n    () => props.count,\n    (count, was) => {\n      if (count > was && on.value && !reduce.value) {\n        swing(\n          props.ringAmplitude * WOBBLE.amplitude,\n          WOBBLE.passes,\n          WOBBLE.duration,\n        );\n      }\n    },\n  );\n\n  onBeforeUnmount(() => {\n    spring?.stop();\n    unsubscribers.forEach((off) => off());\n  });\n\n  function toggle() {\n    pending = lastInput;\n    const next = !on.value;\n    if (props.pressed === undefined) inner.value = next;\n    emit('update:pressed', next);\n    emit('change', next);\n  }\n\n  function press(e: PointerEvent) {\n    lastInput = 'pointer';\n    if (e.button === 0 && !props.disabled && rootRef.value) {\n      rootRef.value.dataset.pressed = '';\n    }\n  }\n\n  function release() {\n    if (rootRef.value) delete rootRef.value.dataset.pressed;\n  }\n\n  function handleKey(e: KeyboardEvent) {\n    if (e.key === 'Enter' || e.key === ' ') lastInput = 'keyboard';\n  }\n\n  const showBadge = computed(() => props.badge && on.value && props.count > 0);\n  const badgeText = computed(() =>\n    props.count > 9 ? '9+' : String(props.count),\n  );\n\n  const rootStyle = computed(() => ({\n    '--bt-color': props.color,\n    '--bt-bg': props.background,\n    '--bt-on-color': props.onColor,\n    '--bt-on-bg': props.onBackground,\n    '--bt-badge': props.badgeColor,\n    '--bt-badge-ink': props.badgeTextColor,\n    '--bt-radius': `${props.radius}px`,\n    '--bt-fade': `${props.crossfadeMs}ms`,\n    '--bt-pivot': `${props.ringPivot}%`,\n    '--bt-h': `${preset.value[0]}px`,\n    '--bt-fs': `${preset.value[1]}px`,\n    '--bt-icon': `${preset.value[2]}px`,\n    '--bt-px': `${preset.value[3]}px`,\n    '--bt-gap': `${preset.value[4]}px`,\n  }));\n</script>\n\n<template>\n  <span\n    ref=\"root\"\n    :class=\"['bell-toggle', props.class]\"\n    :data-on=\"on ? 'true' : 'false'\"\n    :data-disabled=\"disabled ? '' : undefined\"\n    :style=\"rootStyle\"\n  >\n    <button\n      type=\"button\"\n      class=\"bell-toggle__button\"\n      :aria-pressed=\"on\"\n      :aria-label=\"label ?? offLabel\"\n      :disabled=\"disabled\"\n      @pointerdown=\"press\"\n      @pointerup=\"release\"\n      @pointercancel=\"release\"\n      @pointerleave=\"release\"\n      @keydown=\"handleKey\"\n      @click=\"toggle\"\n    >\n      <span class=\"bell-toggle__bell\" aria-hidden=\"true\">\n        <span ref=\"glyph\" class=\"bell-toggle__glyph\">\n          <svg\n            v-if=\"clapper\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          >\n            <path :d=\"BELL_BODY\" />\n            <path d=\"M12 2.5V4\" />\n          </svg>\n          <slot v-else name=\"icon\">\n            <Icon :name=\"icon\" class=\"size-full\" />\n          </slot>\n        </span>\n        <span v-if=\"clapper\" ref=\"clapperEl\" class=\"bell-toggle__clapper\">\n          <svg viewBox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"20.4\" r=\"1.7\" fill=\"currentColor\" />\n          </svg>\n        </span>\n        <template v-if=\"waves\">\n          <svg\n            ref=\"waveLeft\"\n            class=\"bell-toggle__wave bell-toggle__wave--left\"\n            viewBox=\"0 0 14 14\"\n          >\n            <path d=\"M14 8a6 6 0 0 0-6 6\" />\n            <path d=\"M14 4A10 10 0 0 0 4 14\" />\n          </svg>\n          <svg\n            ref=\"waveRight\"\n            class=\"bell-toggle__wave bell-toggle__wave--right\"\n            viewBox=\"0 0 14 14\"\n          >\n            <path d=\"M0 8a6 6 0 0 1 6 6\" />\n            <path d=\"M0 4a10 10 0 0 1 10 10\" />\n          </svg>\n        </template>\n        <span\n          v-if=\"badge\"\n          class=\"bell-toggle__badge\"\n          :data-show=\"showBadge ? '' : undefined\"\n        >\n          <span :key=\"count\" class=\"bell-toggle__digit\">{{ badgeText }}</span>\n        </span>\n      </span>\n      <span class=\"bell-toggle__say\" aria-hidden=\"true\">\n        <span ref=\"offFace\" class=\"bell-toggle__face bell-toggle__face--off\">\n          {{ offLabel }}\n        </span>\n        <span ref=\"onFace\" class=\"bell-toggle__face bell-toggle__face--on\">\n          {{ onLabel }}\n        </span>\n      </span>\n    </button>\n  </span>\n</template>\n\n<style scoped>\n  .bell-toggle {\n    --bt-clip: 0px;\n    --bt-press: 0.97;\n    --bt-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n\n    position: relative;\n    display: inline-grid;\n    grid-template-columns: max-content;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n    transition: transform 160ms var(--bt-ease-out);\n  }\n\n  .bell-toggle[data-pressed] {\n    transform: scale(var(--bt-press));\n  }\n\n  .bell-toggle[data-disabled] {\n    opacity: 0.55;\n  }\n\n  .bell-toggle[data-disabled][data-pressed] {\n    transform: none;\n  }\n\n  .bell-toggle__button {\n    grid-area: 1 / 1;\n    display: inline-flex;\n    align-items: center;\n    gap: var(--bt-gap);\n    height: var(--bt-h);\n    margin: 0;\n    padding: 0 var(--bt-px);\n    border: 0;\n    border-radius: var(--bt-radius);\n    background: var(--bt-bg);\n    color: var(--bt-color);\n    font: inherit;\n    font-size: var(--bt-fs);\n    font-weight: 500;\n    line-height: 1;\n    letter-spacing: 0.01em;\n    white-space: nowrap;\n    cursor: pointer;\n    outline: none;\n    touch-action: manipulation;\n    -webkit-tap-highlight-color: transparent;\n    clip-path: inset(0 var(--bt-clip) 0 0 round var(--bt-radius));\n    transition:\n      background-color var(--bt-fade) ease,\n      color var(--bt-fade) ease;\n  }\n\n  .bell-toggle__button:focus-visible {\n    box-shadow: inset 0 0 0 2px\n      color-mix(in srgb, currentColor 70%, transparent);\n  }\n\n  .bell-toggle__button:disabled {\n    cursor: default;\n  }\n\n  .bell-toggle[data-on='true'] .bell-toggle__button {\n    background: var(--bt-on-bg);\n    color: var(--bt-on-color);\n  }\n\n  @media (hover: hover) and (pointer: fine) {\n    .bell-toggle__button:enabled:hover {\n      background: color-mix(in srgb, var(--bt-color) 6%, var(--bt-bg));\n    }\n\n    .bell-toggle[data-on='true'] .bell-toggle__button:enabled:hover {\n      background: color-mix(in srgb, var(--bt-on-color) 6%, var(--bt-on-bg));\n    }\n  }\n\n  .bell-toggle__bell {\n    position: relative;\n    display: inline-grid;\n    flex: none;\n    width: var(--bt-icon);\n    height: var(--bt-icon);\n  }\n\n  .bell-toggle__glyph {\n    display: inline-grid;\n    place-items: center;\n    grid-area: 1 / 1;\n    width: var(--bt-icon);\n    height: var(--bt-icon);\n    transform-origin: 50% var(--bt-pivot);\n  }\n\n  .bell-toggle__glyph svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .bell-toggle__clapper {\n    position: absolute;\n    inset: 0;\n    transform-origin: 50% var(--bt-pivot);\n    pointer-events: none;\n  }\n\n  .bell-toggle__clapper svg {\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n\n  .bell-toggle__wave {\n    position: absolute;\n    top: -3px;\n    width: 14px;\n    height: 14px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.6;\n    stroke-linecap: round;\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  .bell-toggle__wave--left {\n    right: calc(100% - 2px);\n    transform-origin: 100% 100%;\n  }\n\n  .bell-toggle__wave--right {\n    left: calc(100% - 2px);\n    transform-origin: 0% 100%;\n  }\n\n  .bell-toggle__badge {\n    position: absolute;\n    top: -6px;\n    right: -7px;\n    display: grid;\n    place-items: center;\n    min-width: 14px;\n    height: 14px;\n    padding: 0 3px;\n    box-sizing: border-box;\n    border-radius: 7px;\n    background: var(--bt-badge);\n    color: var(--bt-badge-ink);\n    font-size: 9.5px;\n    font-weight: 600;\n    line-height: 1;\n    opacity: 0;\n    transform: translateY(5px) scale(0.6);\n    pointer-events: none;\n    transition:\n      transform 180ms var(--bt-ease-out),\n      opacity 140ms ease;\n  }\n\n  .bell-toggle__badge[data-show] {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n    transition:\n      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),\n      opacity 120ms ease;\n  }\n\n  .bell-toggle__digit {\n    display: block;\n    opacity: 1;\n    transform: translateY(0);\n    transition:\n      opacity 200ms ease,\n      transform 200ms var(--bt-ease-out);\n  }\n\n  @starting-style {\n    .bell-toggle__digit {\n      opacity: 0;\n      transform: translateY(5px);\n    }\n  }\n\n  .bell-toggle__say {\n    display: inline-grid;\n    grid-template-columns: max-content;\n    height: 18px;\n    line-height: 18px;\n  }\n\n  .bell-toggle__face {\n    grid-area: 1 / 1;\n    justify-self: start;\n    opacity: 0;\n    filter: blur(2px);\n    transition:\n      opacity var(--bt-fade) ease,\n      filter var(--bt-fade) ease;\n  }\n\n  .bell-toggle[data-on='false'] .bell-toggle__face--off,\n  .bell-toggle[data-on='true'] .bell-toggle__face--on {\n    opacity: 1;\n    filter: blur(0);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .bell-toggle[data-pressed] {\n      transform: none;\n    }\n\n    .bell-toggle__face {\n      filter: none !important;\n      transition: opacity var(--bt-fade) ease;\n    }\n\n    .bell-toggle__badge,\n    .bell-toggle__badge[data-show] {\n      transition: opacity 140ms ease;\n      transform: none;\n    }\n\n    .bell-toggle__digit {\n      transition: opacity 200ms ease;\n      transform: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/bell-toggle/BellToggle.vue"
    },
    {
      "path": "registry/new-york/bell-toggle/bell-ring.ts",
      "content": "import type { BellToggleSize, BellToggleSizePreset } from './types';\n\nexport const SPRING_UI = { type: 'spring' as const, duration: 0.3, bounce: 0 };\nconst SEG_EASE = 'cubic-bezier(0.77, 0, 0.175, 1)';\nconst WARP = 0.6;\n\nexport const SIZES: Record<BellToggleSize, BellToggleSizePreset> = {\n  sm: [36, 12.5, 14, 15, 8],\n  md: [44, 13.5, 16, 19, 9],\n  lg: [52, 15, 18, 23, 10],\n};\nexport const WOBBLE = { amplitude: 0.4, passes: 3, duration: 420 };\nexport const BELL_BODY = 'M6 16.5V10a6 6 0 0 1 12 0v6.5l1.6 2.3H4.4L6 16.5z';\n\n/** Time offset (0–1) of swing pass `k`; passes bunch up toward the end. */\nexport function passOffset(k: number, passes: number): number {\n  return 1 - Math.pow(1 - (k + 2 / 3) / (passes + 1), WARP);\n}\n\n/** Decaying alternating rotation keyframes starting from the live angle. */\nexport function ringKeyframes(\n  from: number,\n  amplitude: number,\n  passes: number,\n  decay: number,\n): Keyframe[] {\n  const frames: Keyframe[] = [\n    { transform: `rotate(${from}deg)`, offset: 0, easing: SEG_EASE },\n  ];\n  for (let k = 0; k < passes; k++) {\n    const angle =\n      amplitude * Math.pow(1 - k / passes, decay) * (k % 2 ? 1 : -1);\n    frames.push({\n      transform: `rotate(${angle.toFixed(2)}deg)`,\n      offset: passOffset(k, passes),\n      easing: SEG_EASE,\n    });\n  }\n  frames.push({ transform: 'rotate(0deg)', offset: 1 });\n  return frames;\n}\n\n/** Current rotation of an element in degrees, read from its computed transform. */\nexport function liveAngle(el: Element): number {\n  const tf = getComputedStyle(el).transform;\n  if (!tf || tf === 'none') return 0;\n  const m = new DOMMatrix(tf);\n  return (Math.atan2(m.b, m.a) * 180) / Math.PI;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/bell-toggle/bell-ring.ts"
    },
    {
      "path": "registry/new-york/bell-toggle/index.ts",
      "content": "export { default as BellToggle } from './BellToggle.vue';\nexport type { BellToggleProps, BellToggleSize } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/bell-toggle/index.ts"
    },
    {
      "path": "registry/new-york/bell-toggle/types.ts",
      "content": "export type BellToggleSize = 'sm' | 'md' | 'lg';\n\nexport interface BellToggleProps {\n  offLabel?: string;\n  onLabel?: string;\n  /** Iconify name for the bell glyph. Ignored when `clapper` is on. */\n  icon?: string;\n  /** Accessible name; defaults to `offLabel`. */\n  label?: string;\n  color?: string;\n  background?: string;\n  onColor?: string;\n  onBackground?: string;\n  size?: BellToggleSize;\n  radius?: number;\n  ringAmplitude?: number;\n  ringPasses?: number;\n  ringDecay?: number;\n  ringDuration?: number;\n  ringPivot?: number;\n  crossfadeMs?: number;\n  revealBounce?: number;\n  count?: number;\n  badge?: boolean;\n  badgeColor?: string;\n  badgeTextColor?: string;\n  waves?: boolean;\n  clapper?: boolean;\n  /** Controlled state (`v-model:pressed`). */\n  pressed?: boolean;\n  defaultPressed?: boolean;\n  disabled?: boolean;\n  class?: string;\n}\n\n/** [height, font size, icon size, horizontal padding, gap] in px. */\nexport type BellToggleSizePreset = [number, number, number, number, number];\n\nexport type BellToggleInput = 'pointer' | 'keyboard';\n",
      "type": "registry:ui",
      "target": "components/ui/bell-toggle/types.ts"
    }
  ]
}
