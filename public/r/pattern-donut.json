{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pattern-donut",
  "type": "registry:ui",
  "title": "Pattern Donut",
  "description": "A two-ring donut: solid category slices inside, patterned cause segments outside, a hover-driven center label, a pinnable legend and a computed insight.",
  "dependencies": [],
  "files": [
    {
      "path": "registry/new-york/pattern-donut/PatternDonut.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref, useId, useTemplateRef } from 'vue';\n  import PatternDonutPattern from './PatternDonutPattern.vue';\n  import { CENTER, sectorPath } from './pattern-donut-geometry';\n  import type {\n    PatternDonutHover,\n    PatternDonutInsight,\n    PatternDonutKeyItem,\n    PatternDonutPatternKind,\n    PatternDonutProps,\n    PatternDonutSegment,\n    PatternDonutSlice,\n  } from './types';\n\n  const props = withDefaults(defineProps<PatternDonutProps>(), {\n    title: '',\n    description: '',\n    unit: '',\n    delta: undefined,\n    deltaLabel: '',\n    lowerIsBetter: true,\n    patternLabels: () => ['top cause', '2nd', '3rd'],\n    patterns: () => [\n      'lines',\n      'dots',\n      'checker',\n      'crosshatch',\n      'grid',\n      'stripes',\n    ],\n    insightThreshold: 0.75,\n    insightSuffix: 'of lost minutes',\n    hideInsight: false,\n    locale: 'en-US',\n    class: '',\n  });\n\n  /** Label of the pinned category, or `null` when nothing is pinned. */\n  const selected = defineModel<string | null>('selected', { default: null });\n\n  const uid = useId();\n\n  // Ring radii in view-box units (240 × 240).\n  const INNER_START = 43;\n  const INNER_END = 71;\n  const BAND = 75.5;\n  const BAND_WIDTH = 9;\n  const OUTER_START = 80;\n  const OUTER_END = 112;\n  const INNER_GAP = 2.4;\n  const CORNER = 2.5;\n  const OUTER_GAP = 2.2;\n  const OUTLINE = 0.9;\n  const TAU = Math.PI * 2;\n\n  const total = computed(() =>\n    props.data.reduce((sum, item) => sum + Math.max(0, item.value), 0),\n  );\n\n  function kindFor(rank: number): PatternDonutPatternKind {\n    return props.patterns[rank % props.patterns.length] ?? 'lines';\n  }\n\n  const geometry = computed(() => {\n    const slices: PatternDonutSlice[] = [];\n    const segments: PatternDonutSegment[] = [];\n    const sum = total.value;\n    if (sum <= 0) return { slices, segments };\n    let angle = 0;\n    props.data.forEach((item, index) => {\n      const value = Math.max(0, item.value);\n      const span = (value / sum) * TAU;\n      const start = angle;\n      const end = angle + span;\n      angle = end;\n      slices.push({\n        index,\n        label: item.label,\n        value,\n        color: item.color,\n        share: value / sum,\n        path: sectorPath(\n          INNER_START + CORNER,\n          INNER_END - CORNER,\n          start,\n          end,\n          INNER_GAP / 2 + CORNER,\n        ),\n      });\n\n      const causes = (item.causes ?? [])\n        .filter((cause) => cause.value > 0)\n        .sort((a, b) => b.value - a.value);\n      const parts = causes.length\n        ? causes\n        : [{ label: item.label, value: value || 1 }];\n      const causeSum = parts.reduce((acc, cause) => acc + cause.value, 0);\n      let cursor = start;\n      parts.forEach((cause, rank) => {\n        const width = (cause.value / causeSum) * span;\n        const kind = kindFor(rank);\n        segments.push({\n          key: `${index}-${rank}`,\n          index,\n          cause: cause.label,\n          value: cause.value,\n          color: item.color,\n          rank,\n          kind,\n          patternId: `${uid}-p-${index}-${rank}`,\n          path: sectorPath(\n            OUTER_START + OUTLINE / 2,\n            OUTER_END - OUTLINE / 2,\n            cursor,\n            cursor + width,\n            OUTER_GAP / 2 + OUTLINE / 2,\n          ),\n        });\n        cursor += width;\n      });\n    });\n    return { slices, segments };\n  });\n\n  const slices = computed(() => geometry.value.slices);\n  const segments = computed(() => geometry.value.segments);\n\n  // Interaction state: hover/focus wins, then the pinned slice.\n  const hovered = ref<PatternDonutHover | null>(null);\n  const cursor = ref(0);\n\n  const pinnedIndex = computed(() => {\n    if (selected.value === null) return null;\n    const index = props.data.findIndex((item) => item.label === selected.value);\n    return index === -1 ? null : index;\n  });\n\n  const emphasis = computed(\n    () => hovered.value?.index ?? pinnedIndex.value ?? null,\n  );\n\n  const largestIndex = computed(() => {\n    let best = 0;\n    props.data.forEach((item, index) => {\n      if (item.value > (props.data[best]?.value ?? 0)) best = index;\n    });\n    return best;\n  });\n\n  const shown = computed(\n    () => slices.value[emphasis.value ?? largestIndex.value] ?? null,\n  );\n\n  const shownCause = computed(() => {\n    const hover = hovered.value;\n    if (!hover?.cause) return null;\n    return (\n      segments.value.find(\n        (segment) =>\n          segment.index === hover.index && segment.cause === hover.cause,\n      ) ?? null\n    );\n  });\n\n  function dimmed(index: number): boolean {\n    return emphasis.value !== null && emphasis.value !== index;\n  }\n\n  function causeDimmed(segment: PatternDonutSegment): boolean {\n    const hover = hovered.value;\n    if (hover?.cause) {\n      return !(segment.index === hover.index && segment.cause === hover.cause);\n    }\n    return dimmed(segment.index);\n  }\n\n  const number = computed(() => new Intl.NumberFormat(props.locale));\n\n  function format(value: number): string {\n    return number.value.format(value);\n  }\n\n  function percent(share: number): string {\n    return String(Math.round(share * 100));\n  }\n\n  const totalText = computed(() =>\n    props.unit ? `${format(total.value)} ${props.unit}` : format(total.value),\n  );\n\n  const deltaGood = computed(() => {\n    if (props.delta === undefined) return false;\n    return props.lowerIsBetter ? props.delta <= 0 : props.delta >= 0;\n  });\n\n  const deltaText = computed(() => {\n    if (props.delta === undefined) return '';\n    const magnitude = format(Math.abs(props.delta));\n    const sign = props.delta < 0 ? '−' : props.delta > 0 ? '+' : '';\n    return `${sign}${magnitude} %`;\n  });\n\n  const insight = computed<PatternDonutInsight>(() => {\n    const sum = total.value;\n    if (sum <= 0) return { count: 0, share: 0 };\n    const values = props.data\n      .map((item) => Math.max(0, item.value))\n      .sort((a, b) => b - a);\n    let acc = 0;\n    let count = 0;\n    for (const value of values) {\n      acc += value;\n      count += 1;\n      if (acc / sum >= props.insightThreshold) break;\n    }\n    return { count, share: acc / sum };\n  });\n\n  const keyItems = computed<PatternDonutKeyItem[]>(() => {\n    const deepest = props.data.reduce(\n      (max, item) => Math.max(max, item.causes?.length ?? 1),\n      1,\n    );\n    return props.patternLabels.slice(0, deepest).map((label, rank) => ({\n      label,\n      kind: kindFor(rank),\n      id: `${uid}-k-${rank}`,\n    }));\n  });\n\n  // Keyboard: arrows move between slices (or legend items) with a roving\n  // tab stop; Enter/Space pins, Escape clears the pin.\n  const chart = useTemplateRef<SVGSVGElement>('chart');\n  const legend = useTemplateRef<HTMLElement>('legend');\n\n  function focusIn(container: Element | null, index: number): void {\n    const target = container?.querySelector(`[data-index=\"${index}\"]`);\n    if (target instanceof HTMLElement || target instanceof SVGElement) {\n      target.focus();\n    }\n  }\n\n  function moveFrom(index: number, event: KeyboardEvent): number | null {\n    const count = props.data.length;\n    if (count === 0) return null;\n    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {\n      return (index + 1) % count;\n    }\n    if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {\n      return (index - 1 + count) % count;\n    }\n    if (event.key === 'Home') return 0;\n    if (event.key === 'End') return count - 1;\n    return null;\n  }\n\n  function toggle(index: number): void {\n    const label = props.data[index]?.label ?? null;\n    selected.value = selected.value === label ? null : label;\n  }\n\n  function onSliceKey(event: KeyboardEvent): void {\n    if (event.key === 'Enter' || event.key === ' ') {\n      event.preventDefault();\n      toggle(cursor.value);\n      return;\n    }\n    onKey(event, chart.value);\n  }\n\n  function onLegendKey(event: KeyboardEvent): void {\n    onKey(event, legend.value);\n  }\n\n  function onKey(event: KeyboardEvent, container: Element | null): void {\n    if (event.key === 'Escape') {\n      selected.value = null;\n      return;\n    }\n    const next = moveFrom(cursor.value, event);\n    if (next === null) return;\n    event.preventDefault();\n    cursor.value = next;\n    focusIn(container, next);\n  }\n\n  function hoverSlice(index: number): void {\n    cursor.value = index;\n    hovered.value = { index, cause: null };\n  }\n\n  function hoverCause(segment: PatternDonutSegment): void {\n    hovered.value = { index: segment.index, cause: segment.cause };\n  }\n\n  function clearHover(): void {\n    hovered.value = null;\n  }\n\n  function sliceLabel(slice: PatternDonutSlice): string {\n    const unit = props.unit ? ` ${props.unit}` : '';\n    return `${slice.label}: ${format(slice.value)}${unit}, ${percent(slice.share)}%`;\n  }\n\n  function causeLabel(segment: PatternDonutSegment): string {\n    const unit = props.unit ? ` ${props.unit}` : '';\n    const parent = props.data[segment.index]?.label ?? '';\n    return `${parent} · ${segment.cause}: ${format(segment.value)}${unit}`;\n  }\n\n  const textColor = (color: string): Record<string, string> => ({\n    '--pd-color': color,\n  });\n</script>\n\n<template>\n  <section\n    :class=\"[\n      'w-full max-w-sm rounded-3xl border bg-card p-2 text-card-foreground shadow-sm dark:border-white/5',\n      props.class,\n    ]\"\n    :aria-label=\"props.title || undefined\"\n  >\n    <header v-if=\"props.title || props.description\" class=\"px-4 pt-3 pb-4\">\n      <h3 v-if=\"props.title\" class=\"text-base/tight font-medium\">\n        {{ props.title }}\n      </h3>\n      <p v-if=\"props.description\" class=\"mt-1 text-sm text-muted-foreground\">\n        {{ props.description }}\n      </p>\n    </header>\n\n    <div\n      class=\"rounded-[1.25rem] border border-border/60 bg-muted/40 px-4 pt-5 pb-4 dark:border-white/4 dark:bg-white/3\"\n    >\n      <p class=\"flex flex-wrap items-baseline gap-x-2.5 gap-y-1\">\n        <span\n          class=\"font-mono text-[1.75rem]/none font-medium tracking-tight tabular-nums\"\n        >\n          {{ totalText }}\n        </span>\n        <span\n          v-if=\"props.delta !== undefined\"\n          :class=\"[\n            'text-sm font-medium tabular-nums',\n            deltaGood\n              ? 'text-emerald-600 dark:text-emerald-400'\n              : 'text-rose-600 dark:text-rose-400',\n          ]\"\n        >\n          {{ deltaText }}\n          <template v-if=\"props.deltaLabel\">{{ props.deltaLabel }}</template>\n        </span>\n      </p>\n\n      <div class=\"relative mx-auto mt-5 aspect-square w-full max-w-72\">\n        <svg\n          ref=\"chart\"\n          viewBox=\"0 0 240 240\"\n          class=\"size-full overflow-visible\"\n          role=\"group\"\n          :aria-label=\"`${props.title || 'Breakdown'} chart`\"\n        >\n          <defs>\n            <PatternDonutPattern\n              v-for=\"segment in segments\"\n              :id=\"segment.patternId\"\n              :key=\"segment.patternId\"\n              :kind=\"segment.kind\"\n              :color=\"segment.color\"\n            />\n            <radialGradient\n              :id=\"`${uid}-shade`\"\n              gradientUnits=\"userSpaceOnUse\"\n              :cx=\"CENTER\"\n              :cy=\"CENTER\"\n              :r=\"INNER_END\"\n            >\n              <stop offset=\"0.62\" stop-color=\"#000\" stop-opacity=\"0.16\" />\n              <stop offset=\"0.78\" stop-color=\"#000\" stop-opacity=\"0\" />\n              <stop offset=\"0.93\" stop-color=\"#fff\" stop-opacity=\"0\" />\n              <stop offset=\"1\" stop-color=\"#fff\" stop-opacity=\"0.22\" />\n            </radialGradient>\n            <mask :id=\"`${uid}-inner`\" maskUnits=\"userSpaceOnUse\">\n              <circle\n                class=\"pd-sweep\"\n                :cx=\"CENTER\"\n                :cy=\"CENTER\"\n                r=\"60\"\n                fill=\"none\"\n                stroke=\"#fff\"\n                stroke-width=\"120\"\n                pathLength=\"100\"\n                stroke-dasharray=\"100 100\"\n                :transform=\"`rotate(-90 ${CENTER} ${CENTER})`\"\n              />\n            </mask>\n            <mask :id=\"`${uid}-outer`\" maskUnits=\"userSpaceOnUse\">\n              <circle\n                class=\"pd-sweep pd-sweep-late\"\n                :cx=\"CENTER\"\n                :cy=\"CENTER\"\n                r=\"60\"\n                fill=\"none\"\n                stroke=\"#fff\"\n                stroke-width=\"120\"\n                pathLength=\"100\"\n                stroke-dasharray=\"100 100\"\n                :transform=\"`rotate(-90 ${CENTER} ${CENTER})`\"\n              />\n            </mask>\n          </defs>\n\n          <circle\n            :cx=\"CENTER\"\n            :cy=\"CENTER\"\n            :r=\"BAND\"\n            fill=\"none\"\n            :stroke-width=\"BAND_WIDTH\"\n            class=\"stroke-foreground/8 dark:stroke-black/40\"\n          />\n\n          <g :mask=\"`url(#${uid}-outer)`\">\n            <path\n              v-for=\"segment in segments\"\n              :key=\"segment.key\"\n              :d=\"segment.path\"\n              :fill=\"`url(#${segment.patternId})`\"\n              :stroke=\"segment.color\"\n              :stroke-width=\"OUTLINE\"\n              stroke-linejoin=\"round\"\n              :class=\"[\n                'pd-fade cursor-pointer',\n                causeDimmed(segment) ? 'opacity-30' : 'opacity-100',\n              ]\"\n              @mouseenter=\"hoverCause(segment)\"\n              @mouseleave=\"clearHover\"\n              @click=\"toggle(segment.index)\"\n            >\n              <title>{{ causeLabel(segment) }}</title>\n            </path>\n          </g>\n\n          <g :mask=\"`url(#${uid}-inner)`\">\n            <g\n              v-for=\"slice in slices\"\n              :key=\"slice.index\"\n              role=\"button\"\n              :data-index=\"slice.index\"\n              :tabindex=\"slice.index === cursor ? 0 : -1\"\n              :aria-label=\"sliceLabel(slice)\"\n              :aria-pressed=\"pinnedIndex === slice.index\"\n              :class=\"[\n                'pd-fade cursor-pointer outline-none',\n                dimmed(slice.index) ? 'opacity-30' : 'opacity-100',\n              ]\"\n              @mouseenter=\"hoverSlice(slice.index)\"\n              @focus=\"hoverSlice(slice.index)\"\n              @blur=\"clearHover\"\n              @mouseleave=\"clearHover\"\n              @click=\"toggle(slice.index)\"\n              @keydown=\"onSliceKey\"\n            >\n              <path\n                :d=\"slice.path\"\n                fill=\"none\"\n                :stroke-width=\"CORNER * 2 + 3.5\"\n                stroke-linejoin=\"round\"\n                class=\"pd-ring pointer-events-none stroke-ring opacity-0\"\n              />\n              <path\n                :d=\"slice.path\"\n                :fill=\"slice.color\"\n                :stroke=\"slice.color\"\n                :stroke-width=\"CORNER * 2\"\n                stroke-linejoin=\"round\"\n              />\n              <path\n                :d=\"slice.path\"\n                :fill=\"`url(#${uid}-shade)`\"\n                :stroke=\"`url(#${uid}-shade)`\"\n                :stroke-width=\"CORNER * 2\"\n                stroke-linejoin=\"round\"\n                class=\"pointer-events-none\"\n              />\n            </g>\n          </g>\n        </svg>\n\n        <div\n          class=\"pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center\"\n          aria-live=\"polite\"\n        >\n          <template v-if=\"shown\">\n            <span\n              class=\"max-w-24 truncate text-base/tight font-medium text-[color-mix(in_oklab,var(--pd-color)_68%,black)] dark:text-(--pd-color)\"\n              :style=\"textColor(shown.color)\"\n            >\n              {{ shown.label }}\n            </span>\n            <span class=\"mt-1 text-4xl/none font-semibold tabular-nums\">\n              {{ percent(shown.share)\n              }}<span class=\"text-xl font-medium\">%</span>\n            </span>\n            <span\n              v-if=\"shownCause\"\n              class=\"mt-1 max-w-24 truncate text-[0.6875rem]/tight text-muted-foreground\"\n            >\n              {{ shownCause.cause }} · {{ format(shownCause.value) }}\n            </span>\n          </template>\n        </div>\n      </div>\n\n      <ul\n        ref=\"legend\"\n        class=\"mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1\"\n        :aria-label=\"`${props.title || 'Breakdown'} legend`\"\n      >\n        <li v-for=\"slice in slices\" :key=\"slice.index\">\n          <button\n            type=\"button\"\n            :data-index=\"slice.index\"\n            :tabindex=\"slice.index === cursor ? 0 : -1\"\n            :aria-pressed=\"pinnedIndex === slice.index\"\n            :aria-label=\"sliceLabel(slice)\"\n            :class=\"[\n              'pd-fade inline-flex items-center gap-2 rounded-md py-0.5 pr-1.5 text-sm transition-opacity focus-visible:outline-2 focus-visible:outline-ring',\n              dimmed(slice.index) ? 'opacity-40' : 'opacity-100',\n            ]\"\n            @mouseenter=\"hoverSlice(slice.index)\"\n            @mouseleave=\"clearHover\"\n            @focus=\"hoverSlice(slice.index)\"\n            @blur=\"clearHover\"\n            @click=\"toggle(slice.index)\"\n            @keydown=\"onLegendKey\"\n          >\n            <span\n              class=\"size-2.5 shrink-0 rounded-[3px]\"\n              :style=\"{ backgroundColor: slice.color }\"\n              aria-hidden=\"true\"\n            />\n            <span class=\"text-muted-foreground\">{{ slice.label }}</span>\n            <span class=\"font-mono font-medium text-foreground tabular-nums\">\n              {{ format(slice.value) }}\n            </span>\n          </button>\n        </li>\n      </ul>\n\n      <ul\n        v-if=\"keyItems.length\"\n        class=\"mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground\"\n        aria-label=\"Pattern key\"\n      >\n        <li\n          v-for=\"item in keyItems\"\n          :key=\"item.id\"\n          class=\"inline-flex items-center gap-2\"\n        >\n          <svg\n            viewBox=\"0 0 12 12\"\n            class=\"size-3.5 rounded-[3px] text-foreground/85\"\n            aria-hidden=\"true\"\n          >\n            <defs>\n              <PatternDonutPattern\n                :id=\"item.id\"\n                :kind=\"item.kind\"\n                color=\"currentColor\"\n                :size=\"3.4\"\n                :tint=\"0\"\n              />\n            </defs>\n            <rect width=\"12\" height=\"12\" :fill=\"`url(#${item.id})`\" />\n          </svg>\n          {{ item.label }}\n        </li>\n      </ul>\n\n      <p\n        v-if=\"!props.hideInsight && insight.count > 0\"\n        class=\"mt-4 flex items-center gap-3 rounded-full bg-blue-50 px-4 py-2.5 text-sm text-blue-950 ring-1 ring-blue-200/70 dark:bg-[#17305a] dark:text-white dark:ring-0\"\n      >\n        <Icon\n          name=\"lucide:sparkle\"\n          class=\"size-4 shrink-0 text-blue-500 dark:text-blue-300\"\n        />\n        <slot name=\"insight\" :count=\"insight.count\" :share=\"insight.share\">\n          <span>\n            {{ insight.count }}\n            {{ insight.count === 1 ? 'reason causes' : 'reasons cause' }}\n            {{ percent(insight.share) }} % {{ props.insightSuffix }}\n          </span>\n        </slot>\n      </p>\n    </div>\n  </section>\n</template>\n\n<style scoped>\n  .pd-sweep {\n    animation: pd-sweep 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;\n  }\n\n  .pd-sweep-late {\n    animation-duration: 1150ms;\n    animation-delay: 120ms;\n  }\n\n  .pd-fade {\n    transition: opacity 200ms ease;\n  }\n\n  g:focus-visible > .pd-ring {\n    opacity: 1;\n  }\n\n  @keyframes pd-sweep {\n    from {\n      stroke-dashoffset: 100;\n    }\n    to {\n      stroke-dashoffset: 0;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .pd-sweep {\n      animation: none;\n    }\n\n    .pd-fade {\n      transition: none;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/pattern-donut/PatternDonut.vue"
    },
    {
      "path": "registry/new-york/pattern-donut/PatternDonutPattern.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed } from 'vue';\n  import type {\n    PatternDonutPatternKind,\n    PatternDonutPatternProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<PatternDonutPatternProps>(), {\n    size: 5.5,\n    tint: 0.14,\n  });\n\n  // Dots and checker read better on a slightly larger tile than lines.\n  const SCALE: Record<PatternDonutPatternKind, number> = {\n    lines: 1,\n    dots: 1.15,\n    checker: 1.35,\n    crosshatch: 1.2,\n    grid: 1.2,\n    stripes: 1,\n  };\n  const tile = computed(() => props.size * SCALE[props.kind]);\n  const half = computed(() => tile.value / 2);\n  const line = computed(() => tile.value * 0.36);\n  const rotated = computed(\n    () =>\n      props.kind === 'lines' ||\n      props.kind === 'checker' ||\n      props.kind === 'crosshatch',\n  );\n</script>\n\n<template>\n  <pattern\n    :id=\"props.id\"\n    patternUnits=\"userSpaceOnUse\"\n    :width=\"tile\"\n    :height=\"tile\"\n    :patternTransform=\"rotated ? 'rotate(-45)' : undefined\"\n  >\n    <rect\n      :width=\"tile\"\n      :height=\"tile\"\n      :fill=\"props.color\"\n      :fill-opacity=\"props.tint\"\n    />\n    <template v-if=\"props.kind === 'lines'\">\n      <rect :width=\"line\" :height=\"tile\" :fill=\"props.color\" />\n    </template>\n    <template v-else-if=\"props.kind === 'dots'\">\n      <circle :cx=\"half\" :cy=\"half\" :r=\"tile * 0.2\" :fill=\"props.color\" />\n    </template>\n    <template v-else-if=\"props.kind === 'checker'\">\n      <rect :width=\"half\" :height=\"half\" :fill=\"props.color\" />\n      <rect\n        :x=\"half\"\n        :y=\"half\"\n        :width=\"half\"\n        :height=\"half\"\n        :fill=\"props.color\"\n      />\n    </template>\n    <template v-else-if=\"props.kind === 'crosshatch'\">\n      <rect :width=\"line\" :height=\"tile\" :fill=\"props.color\" />\n      <rect :width=\"tile\" :height=\"line\" :fill=\"props.color\" />\n    </template>\n    <template v-else-if=\"props.kind === 'grid'\">\n      <rect :width=\"line * 0.7\" :height=\"tile\" :fill=\"props.color\" />\n      <rect :width=\"tile\" :height=\"line * 0.7\" :fill=\"props.color\" />\n    </template>\n    <template v-else>\n      <rect :width=\"tile\" :height=\"line\" :fill=\"props.color\" />\n    </template>\n  </pattern>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/pattern-donut/PatternDonutPattern.vue"
    },
    {
      "path": "registry/new-york/pattern-donut/index.ts",
      "content": "export { default as PatternDonut } from './PatternDonut.vue';\nexport { default as PatternDonutPattern } from './PatternDonutPattern.vue';\nexport type {\n  PatternDonutCategory,\n  PatternDonutCause,\n  PatternDonutPatternKind,\n  PatternDonutProps,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/pattern-donut/index.ts"
    },
    {
      "path": "registry/new-york/pattern-donut/pattern-donut-geometry.ts",
      "content": "/** Centre of the 240 × 240 view box. */\nexport const CENTER = 120;\n\nfunction point(radius: number, angle: number): string {\n  const x = CENTER + radius * Math.sin(angle);\n  const y = CENTER - radius * Math.cos(angle);\n  return `${x.toFixed(3)} ${y.toFixed(3)}`;\n}\n\n/**\n * Annular sector between `start` and `end` (radians, clockwise from 12\n * o'clock). Each side is pulled in by `inset` user units, measured along the\n * arc, so the gap between neighbours stays the same width at every radius.\n */\nexport function sectorPath(\n  inner: number,\n  outer: number,\n  start: number,\n  end: number,\n  inset: number,\n): string {\n  const angles = (radius: number): [number, number] => {\n    const pull = inset / radius;\n    const a = start + pull;\n    const b = end - pull;\n    if (b > a) return [a, b];\n    const mid = (start + end) / 2;\n    return [mid - 0.0005, mid + 0.0005];\n  };\n  const [o0, o1] = angles(outer);\n  const [i0, i1] = angles(inner);\n  const largeOuter = o1 - o0 > Math.PI ? 1 : 0;\n  const largeInner = i1 - i0 > Math.PI ? 1 : 0;\n  return [\n    `M ${point(outer, o0)}`,\n    `A ${outer} ${outer} 0 ${largeOuter} 1 ${point(outer, o1)}`,\n    `L ${point(inner, i1)}`,\n    `A ${inner} ${inner} 0 ${largeInner} 0 ${point(inner, i0)}`,\n    'Z',\n  ].join(' ');\n}\n",
      "type": "registry:ui",
      "target": "components/ui/pattern-donut/pattern-donut-geometry.ts"
    },
    {
      "path": "registry/new-york/pattern-donut/types.ts",
      "content": "/** Texture used for a cause in the outer ring, in rank order by default. */\nexport type PatternDonutPatternKind =\n  | 'lines'\n  | 'dots'\n  | 'checker'\n  | 'crosshatch'\n  | 'grid'\n  | 'stripes';\n\nexport interface PatternDonutCause {\n  label: string;\n  value: number;\n}\n\nexport interface PatternDonutCategory {\n  label: string;\n  value: number;\n  /** Any CSS color. Used for the solid slice, its textures and the legend. */\n  color: string;\n  /**\n   * Breakdown shown in the outer ring. Causes are sorted by value; the\n   * largest gets the first pattern (lines), the next dots, then checker.\n   * Without causes the whole outer segment uses the first pattern.\n   */\n  causes?: PatternDonutCause[];\n}\n\nexport interface PatternDonutProps {\n  data: PatternDonutCategory[];\n  title?: string;\n  description?: string;\n  /** Unit after the total, e.g. `min`. */\n  unit?: string;\n  /** Change against the previous period, in percent. Hidden when undefined. */\n  delta?: number;\n  /** Text after the delta, e.g. `vs Aug`. */\n  deltaLabel?: string;\n  /** A falling value is good news (green). Set `false` for metrics where up is good. */\n  lowerIsBetter?: boolean;\n  /** Labels for the pattern key, in rank order. */\n  patternLabels?: string[];\n  /** Order of textures by cause rank. */\n  patterns?: PatternDonutPatternKind[];\n  /** Share (0–1) the insight pill counts top categories up to. */\n  insightThreshold?: number;\n  /** Words after the share in the insight pill. */\n  insightSuffix?: string;\n  /** Hides the insight pill. */\n  hideInsight?: boolean;\n  /** Locale for number formatting. */\n  locale?: string;\n  class?: string;\n}\n\nexport interface PatternDonutPatternProps {\n  id: string;\n  kind: PatternDonutPatternKind;\n  color: string;\n  /** Tile size in user units. */\n  size?: number;\n  /** Opacity of the color tint behind the texture. */\n  tint?: number;\n}\n\n/** A solid slice in the inner ring. */\nexport interface PatternDonutSlice {\n  index: number;\n  label: string;\n  value: number;\n  color: string;\n  share: number;\n  path: string;\n}\n\n/** A textured cause segment in the outer ring. */\nexport interface PatternDonutSegment {\n  key: string;\n  index: number;\n  cause: string;\n  value: number;\n  color: string;\n  rank: number;\n  kind: PatternDonutPatternKind;\n  patternId: string;\n  path: string;\n}\n\nexport interface PatternDonutHover {\n  index: number;\n  cause: string | null;\n}\n\nexport interface PatternDonutInsight {\n  count: number;\n  share: number;\n}\n\nexport interface PatternDonutKeyItem {\n  kind: PatternDonutPatternKind;\n  label: string;\n  id: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/pattern-donut/types.ts"
    }
