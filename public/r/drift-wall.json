{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "drift-wall",
  "type": "registry:ui",
  "title": "Drift Wall",
  "description": "An endless 3D wall of image tiles drifting in alternating columns, lifting a tile toward you on hover or focus.",
  "dependencies": ["@vueuse/core"],
  "files": [
    {
      "path": "registry/new-york/drift-wall/DriftWall.vue",
      "content": "<script setup lang=\"ts\">\n  import { computed, ref, watch } from 'vue';\n  import {\n    useIntersectionObserver,\n    usePreferredReducedMotion,\n    useRafFn,\n    useResizeObserver,\n  } from '@vueuse/core';\n  import { DRIFT_WALL_DEFAULT_ITEMS, columnFactor } from './drift-wall';\n  import type {\n    DriftWallColumnMeta,\n    DriftWallItem,\n    DriftWallProps,\n  } from './types';\n\n  const props = withDefaults(defineProps<DriftWallProps>(), {\n    items: () => DRIFT_WALL_DEFAULT_ITEMS,\n    columns: 5,\n    tileWidth: 200,\n    tileHeight: 132,\n    gap: 18,\n    radius: 14,\n    tilt: 16,\n    turn: -14,\n    roll: 0,\n    perspective: 1200,\n    depth: 120,\n    speed: 42,\n    direction: 'up',\n    variance: 0.45,\n    parallax: 0.6,\n    pauseOnHover: false,\n    lift: 64,\n    fade: 0.6,\n    dim: 0.55,\n    grayscale: false,\n    overlayColor: '#060010',\n    class: '',\n  });\n\n  const containerRef = ref<HTMLDivElement | null>(null);\n  const planeRef = ref<HTMLDivElement | null>(null);\n  const trackEls = ref<HTMLDivElement[]>([]);\n\n  const containerHeight = ref(600);\n  const activeId = ref<string | null>(null);\n  const visible = ref(true);\n\n  const motionPref = usePreferredReducedMotion();\n  const reduced = computed(() => motionPref.value === 'reduce');\n\n  let offsets: number[] = [];\n  let velocities: number[] = [];\n  let hoveredCol = -1;\n  let wallHovered = false;\n  const pointer = { x: 0, y: 0 };\n  const damped = { x: 0, y: 0 };\n\n  const columnItems = computed<DriftWallItem[][]>(() => {\n    const count = Math.max(1, Math.round(props.columns));\n    const cols: DriftWallItem[][] = Array.from({ length: count }, () => []);\n    props.items.forEach((item, i) => cols[i % count]!.push(item));\n    return cols.map((col) => (col.length ? col : props.items.slice(0, 1)));\n  });\n\n  const columnMeta = computed<DriftWallColumnMeta[]>(() => {\n    const unit = props.tileHeight + props.gap;\n    return columnItems.value.map((col) => {\n      const copyHeight = Math.max(unit, col.length * unit);\n      const copies = Math.max(\n        2,\n        Math.ceil((containerHeight.value * 1.6) / copyHeight) + 1,\n      );\n      return { copyHeight, copies };\n    });\n  });\n\n  const baseVelocities = computed<number[]>(() => {\n    const dirSign = props.direction === 'up' ? 1 : -1;\n    return columnItems.value.map((_, c) => {\n      const altSign = c % 2 === 0 ? 1 : -1;\n      return props.speed * columnFactor(c, props.variance) * dirSign * altSign;\n    });\n  });\n\n  watch(\n    [columnMeta, columnItems],\n    () => {\n      offsets = columnMeta.value.map(\n        (meta, c) => meta.copyHeight * ((c * 0.37) % 1),\n      );\n      velocities = columnItems.value.map(() => 0);\n    },\n    { immediate: true },\n  );\n\n  useResizeObserver(containerRef, (entries) => {\n    const entry = entries[0];\n    if (entry) containerHeight.value = entry.contentRect.height || 600;\n  });\n\n  useIntersectionObserver(containerRef, (entries) => {\n    visible.value = entries[0]?.isIntersecting ?? true;\n  });\n\n  function applyPlaneTransform(px: number, py: number) {\n    const plane = planeRef.value;\n    if (!plane) return;\n    plane.style.transform =\n      `translate(-50%, -50%) scale(1.18) ` +\n      `rotateX(${props.tilt + py}deg) rotateY(${props.turn + px}deg) rotateZ(${props.roll}deg) ` +\n      `translateZ(${-props.depth}px)`;\n  }\n\n  function trackIndex(el: HTMLDivElement) {\n    return Number(el.dataset.col);\n  }\n\n  const { pause, resume } = useRafFn(({ delta }) => {\n    const dt = Math.min(0.05, Math.max(0, delta) / 1000);\n\n    const maxTilt = props.parallax * 8;\n    const targetX = pointer.x * maxTilt;\n    const targetY = -pointer.y * maxTilt;\n    const damp = 1 - Math.exp(-dt / 0.12);\n    damped.x += (targetX - damped.x) * damp;\n    damped.y += (targetY - damped.y) * damp;\n    applyPlaneTransform(damped.x, damped.y);\n\n    const metas = columnMeta.value;\n    const bases = baseVelocities.value;\n    for (const el of trackEls.value) {\n      const c = trackIndex(el);\n      const meta = metas[c];\n      if (!meta) continue;\n      if (!reduced.value) {\n        const paused = wallHovered && props.pauseOnHover;\n        const factor = paused || hoveredCol === c ? 0 : 1;\n        const target = (bases[c] ?? 0) * factor;\n        const ease = 1 - Math.exp(-dt / (target === 0 ? 0.16 : 0.28));\n        const v = velocities[c] ?? 0;\n        velocities[c] = v + (target - v) * ease;\n        let next = (offsets[c] ?? 0) + (velocities[c] ?? 0) * dt;\n        next = ((next % meta.copyHeight) + meta.copyHeight) % meta.copyHeight;\n        offsets[c] = next;\n      }\n      el.style.transform = `translate3d(0, ${-(offsets[c] ?? 0)}px, 0)`;\n    }\n  });\n\n  watch(visible, (isVisible) => {\n    if (isVisible) resume();\n    else pause();\n  });\n\n  function activate(id: string, col: number) {\n    activeId.value = id;\n    hoveredCol = col;\n  }\n\n  function release() {\n    activeId.value = null;\n    hoveredCol = -1;\n  }\n\n  function onPointerMove(e: PointerEvent) {\n    const rect = containerRef.value?.getBoundingClientRect();\n    if (!rect) return;\n    if (props.parallax > 0 && !reduced.value) {\n      pointer.x = (e.clientX - rect.left) / rect.width - 0.5;\n      pointer.y = (e.clientY - rect.top) / rect.height - 0.5;\n    }\n    const hit = document.elementFromPoint(e.clientX, e.clientY);\n    const tile = hit?.closest<HTMLElement>('[data-tile-id]');\n    if (!tile) return;\n    const id = tile.dataset.tileId ?? null;\n    if (!id || id === activeId.value) return;\n    activate(id, Number(tile.dataset.col));\n  }\n\n  function onPointerEnter() {\n    wallHovered = true;\n  }\n\n  function onPointerLeave() {\n    wallHovered = false;\n    pointer.x = 0;\n    pointer.y = 0;\n    release();\n  }\n\n  function tileId(c: number, copyIndex: number, itemIndex: number) {\n    return `${c}-${copyIndex}-${itemIndex}`;\n  }\n\n  function onTileFocus(e: FocusEvent) {\n    const el = e.currentTarget;\n    if (!(el instanceof HTMLElement)) return;\n    const id = el.dataset.tileId;\n    if (id) activate(id, Number(el.dataset.col));\n  }\n\n  const cssVars = computed(() => ({\n    '--dw-tile-w': `${props.tileWidth}px`,\n    '--dw-tile-h': `${props.tileHeight}px`,\n    '--dw-gap': `${props.gap}px`,\n    '--dw-radius': `${props.radius}px`,\n    '--dw-perspective': `${props.perspective}px`,\n    '--dw-lift': `${props.lift}px`,\n    '--dw-dim': String(props.dim),\n    '--dw-gray': props.grayscale ? '1' : '0',\n    '--dw-overlay': props.overlayColor,\n    '--dw-edge': `${Math.max(0, (1 - props.fade) * 100)}%`,\n  }));\n</script>\n\n<template>\n  <div\n    ref=\"containerRef\"\n    :class=\"['drift-wall', reduced && 'drift-wall--reduced', props.class]\"\n    :style=\"cssVars\"\n    role=\"group\"\n    aria-label=\"Drifting wall of tiles\"\n    @pointermove=\"onPointerMove\"\n    @pointerenter=\"onPointerEnter\"\n    @pointerleave=\"onPointerLeave\"\n  >\n    <div ref=\"planeRef\" class=\"drift-wall__plane\">\n      <div\n        v-for=\"(col, c) in columnItems\"\n        :key=\"`col-${c}`\"\n        class=\"drift-wall__col\"\n      >\n        <div ref=\"trackEls\" class=\"drift-wall__track\" :data-col=\"c\">\n          <template\n            v-for=\"copyIndex in columnMeta[c]?.copies ?? 2\"\n            :key=\"copyIndex\"\n          >\n            <template\n              v-for=\"(item, itemIndex) in col\"\n              :key=\"tileId(c, copyIndex, itemIndex)\"\n            >\n              <a\n                v-if=\"item.href\"\n                :href=\"item.href\"\n                target=\"_blank\"\n                rel=\"noreferrer noopener\"\n                :class=\"[\n                  'drift-wall__tile',\n                  activeId === tileId(c, copyIndex, itemIndex) && 'is-active',\n                ]\"\n                :data-tile-id=\"tileId(c, copyIndex, itemIndex)\"\n                :data-col=\"c\"\n                :aria-label=\"item.title ?? 'tile'\"\n                @focus=\"onTileFocus\"\n                @blur=\"release\"\n              >\n                <span class=\"drift-wall__inner\">\n                  <img\n                    :src=\"item.image\"\n                    :alt=\"item.title ?? ''\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                    draggable=\"false\"\n                  />\n                  <span class=\"drift-wall__overlay\" aria-hidden=\"true\" />\n                </span>\n              </a>\n              <div\n                v-else\n                tabindex=\"0\"\n                role=\"button\"\n                :aria-label=\"item.title ?? 'tile'\"\n                :class=\"[\n                  'drift-wall__tile',\n                  activeId === tileId(c, copyIndex, itemIndex) && 'is-active',\n                ]\"\n                :data-tile-id=\"tileId(c, copyIndex, itemIndex)\"\n                :data-col=\"c\"\n                @focus=\"onTileFocus\"\n                @blur=\"release\"\n              >\n                <span class=\"drift-wall__inner\">\n                  <img\n                    :src=\"item.image\"\n                    :alt=\"item.title ?? ''\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                    draggable=\"false\"\n                  />\n                  <span class=\"drift-wall__overlay\" aria-hidden=\"true\" />\n                </span>\n              </div>\n            </template>\n          </template>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n  .drift-wall {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    perspective: var(--dw-perspective, 1200px);\n    perspective-origin: 50% 50%;\n    -webkit-mask-image:\n      radial-gradient(\n        ellipse 78% 82% at 50% 46%,\n        #000 var(--dw-edge),\n        transparent 100%\n      ),\n      linear-gradient(to top, #000 var(--dw-edge), transparent 100%);\n    -webkit-mask-composite: source-in;\n    mask-image:\n      radial-gradient(\n        ellipse 78% 82% at 50% 46%,\n        #000 var(--dw-edge),\n        transparent 100%\n      ),\n      linear-gradient(to top, #000 var(--dw-edge), transparent 100%);\n    mask-composite: intersect;\n  }\n\n  .drift-wall__plane {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    display: flex;\n    flex-direction: row;\n    transform-style: preserve-3d;\n    cursor: pointer;\n    transform-origin: 50% 50%;\n    will-change: transform;\n  }\n\n  .drift-wall__col {\n    position: relative;\n    width: calc(var(--dw-tile-w) + var(--dw-gap));\n    transform-style: preserve-3d;\n  }\n\n  .drift-wall__track {\n    display: flex;\n    flex-direction: column;\n    will-change: transform;\n    transform-style: preserve-3d;\n  }\n\n  .drift-wall__tile {\n    position: relative;\n    display: block;\n    width: 100%;\n    height: calc(var(--dw-tile-h) + var(--dw-gap));\n    flex: 0 0 auto;\n    outline: none;\n    transform-style: preserve-3d;\n  }\n\n  .drift-wall__inner {\n    position: absolute;\n    inset: calc(var(--dw-gap) / 2);\n    display: block;\n    border-radius: var(--dw-radius);\n    overflow: hidden;\n    background: var(--dw-surface, #0b0b12);\n    opacity: var(--dw-dim);\n    transform: translateZ(0);\n    pointer-events: none;\n    transition:\n      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),\n      opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1),\n      box-shadow 0.42s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .drift-wall__tile img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    filter: grayscale(var(--dw-gray)) saturate(0.92);\n    transition: filter 0.42s cubic-bezier(0.22, 1, 0.36, 1);\n    user-select: none;\n    -webkit-user-drag: none;\n  }\n\n  .drift-wall__overlay {\n    position: absolute;\n    inset: 0;\n    background: var(--dw-overlay);\n    opacity: var(--dw-overlay-opacity, 0.42);\n    pointer-events: none;\n    transition: opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  .drift-wall__tile.is-active .drift-wall__inner,\n  .drift-wall__tile:focus-visible .drift-wall__inner {\n    opacity: 1;\n    transform: translateZ(var(--dw-lift));\n    box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.7);\n  }\n\n  .drift-wall__tile.is-active img,\n  .drift-wall__tile:focus-visible img {\n    filter: grayscale(0) saturate(1.05);\n  }\n\n  .drift-wall__tile.is-active .drift-wall__overlay,\n  .drift-wall__tile:focus-visible .drift-wall__overlay {\n    opacity: 0;\n  }\n\n  .drift-wall__tile:focus-visible .drift-wall__inner {\n    box-shadow:\n      0 24px 60px -18px rgba(0, 0, 0, 0.7),\n      0 0 0 2px var(--dw-ring, rgba(255, 255, 255, 0.9));\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .drift-wall__plane,\n    .drift-wall__track {\n      will-change: auto;\n    }\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "components/ui/drift-wall/DriftWall.vue"
    },
    {
      "path": "registry/new-york/drift-wall/drift-wall.ts",
      "content": "import type { DriftWallItem } from './types';\n\nconst DEFAULT_IDS = [\n  1015, 1025, 1039, 1043, 1044, 1050, 1062, 1069, 1074, 1080, 1084, 106, 110,\n  133, 164,\n];\n\nexport const DRIFT_WALL_DEFAULT_ITEMS: DriftWallItem[] = DEFAULT_IDS.map(\n  (id, i) => ({\n    image: `https://picsum.photos/id/${id}/600/400`,\n    title: `Tile ${i + 1}`,\n  }),\n);\n\n/** Deterministic per-column speed multiplier (golden-ratio scatter). */\nexport function columnFactor(index: number, variance: number): number {\n  const pseudo = ((index * 0.6180339887 + 0.35) % 1) * 2 - 1;\n  return 1 + variance * pseudo;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/drift-wall/drift-wall.ts"
    },
    {
      "path": "registry/new-york/drift-wall/index.ts",
      "content": "export { default as DriftWall } from './DriftWall.vue';\nexport { DRIFT_WALL_DEFAULT_ITEMS } from './drift-wall';\nexport type {\n  DriftWallColumnMeta,\n  DriftWallDirection,\n  DriftWallItem,\n  DriftWallProps,\n} from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/drift-wall/index.ts"
    },
    {
      "path": "registry/new-york/drift-wall/types.ts",
      "content": "import type { HTMLAttributes } from 'vue';\n\nexport interface DriftWallItem {\n  /** Image URL of the tile. */\n  image: string;\n  /** Alt text and accessible name of the tile. */\n  title?: string;\n  /** When set, the tile is a link that opens in a new tab. */\n  href?: string;\n}\n\nexport type DriftWallDirection = 'up' | 'down';\n\nexport interface DriftWallProps {\n  /** Tiles to display. Each item has { image, title?, href? }. */\n  items?: DriftWallItem[];\n  /** Number of drifting columns. */\n  columns?: number;\n  /** Width of each tile in pixels. */\n  tileWidth?: number;\n  /** Height of each tile in pixels. */\n  tileHeight?: number;\n  /** Spacing between tiles and columns in pixels. */\n  gap?: number;\n  /** Corner radius of each tile in pixels. */\n  radius?: number;\n  /** Perspective pitch of the wall (rotateX, degrees). */\n  tilt?: number;\n  /** Perspective yaw of the wall (rotateY, degrees). */\n  turn?: number;\n  /** In-plane rotation of the wall (rotateZ, degrees). */\n  roll?: number;\n  /** Perspective distance in pixels. Smaller is more dramatic. */\n  perspective?: number;\n  /** How far the wall sits back from the viewer in pixels. */\n  depth?: number;\n  /** Base drift speed in pixels per second. */\n  speed?: number;\n  /** Primary drift direction; columns alternate around it. */\n  direction?: DriftWallDirection;\n  /** How much column speeds differ from each other (0–1). */\n  variance?: number;\n  /** Pointer-follow tilt strength (0 disables it). */\n  parallax?: number;\n  /** Pause the whole wall while the pointer is over it. */\n  pauseOnHover?: boolean;\n  /** How far a hovered tile lifts toward the viewer in pixels. */\n  lift?: number;\n  /** Strength of the edge and depth dissolve (0–1). */\n  fade?: number;\n  /** Resting opacity of unhovered tiles (0–1). */\n  dim?: number;\n  /** Desaturate resting tiles; hover restores colour. */\n  grayscale?: boolean;\n  /** Tint laid over resting tiles, cleared on hover. */\n  overlayColor?: string;\n  class?: HTMLAttributes['class'];\n}\n\nexport interface DriftWallColumnMeta {\n  copyHeight: number;\n  copies: number;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/drift-wall/types.ts"
    }
  ]
}
