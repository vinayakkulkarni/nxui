{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "numbered-reveal",
  "type": "registry:ui",
  "title": "Numbered Reveal",
  "description": "A scroll-driven editorial list of numbered sections that rise into view with staggered easing.",
  "dependencies": ["@vueuse/core", "motion-v"],
  "files": [
    {
      "path": "registry/new-york/numbered-reveal/NumberedReveal.vue",
      "content": "<script setup lang=\"ts\">\n  import { ref } from 'vue';\n  import { useIntersectionObserver } from '@vueuse/core';\n  import { motion } from 'motion-v';\n  import type { RevealSection } from './types';\n  import { cn } from '~/lib/utils';\n\n  const props = withDefaults(\n    defineProps<{\n      sections?: RevealSection[];\n      stagger?: boolean;\n      class?: string;\n    }>(),\n    {\n      sections: () => [\n        {\n          number: '01',\n          title: 'Describing pixels with words',\n          body: 'Ask an agent to build something today and you get a wall of text in a terminal. You squint at localhost, alt-tab back, type \"no, the spacing is off, make the hero bigger\", pray, repeat.',\n        },\n        {\n          number: '02',\n          title: 'Direct with your eyes and hands',\n          body: 'Your pages and components live on a visual canvas, running live from your own dev server. Point at the thing that is wrong, annotate it, drag a slider — the edit lands in the agent\\'s context.',\n        },\n        {\n          number: '03',\n          title: 'For people who care too much',\n          body: 'Every component becomes a playable instrument, with sliders, colors and springs derived from your real code. Nothing is trapped in a proprietary file; every change lands on disk, ready to commit.',\n        },\n      ],\n      stagger: true,\n      class: '',\n    },\n  );\n\n  const root = ref<HTMLElement | null>(null);\n  const visible = ref(0);\n\n  useIntersectionObserver(\n    root,\n    ([entry]) => {\n      if (!entry.isIntersecting) return;\n      visible.value = props.sections.length;\n    },\n    { threshold: 0.2 },\n  );\n\n  const sections = computed(() =>\n    props.stagger ? props.sections : props.sections.slice(0, visible.value),\n  );\n</script>\n\n<template>\n  <div ref=\"root\" :class=\"cn('w-full max-w-xl space-y-10', props.class)\">\n    <component\n      :is=\"motion.div\"\n      v-for=\"(section, i) in sections\"\n      :key=\"section.number\"\n      :initial=\"{ opacity: 0, y: 28 }\"\n      :animate=\"{\n        opacity: i < visible ? 1 : 0,\n        y: i < visible ? 0 : 28,\n      }\"\n      :transition=\"{ duration: 0.7, ease: [0.22, 1, 0.36, 1], delay: i * 0.12 }\"\n      class=\"flex gap-6 border-t border-border/60 pt-6\"\n    >\n      <span class=\"font-mono text-sm text-muted-foreground/70\">\n        {{ section.number }}.\n      </span>\n      <div>\n        <h3 class=\"text-xl font-medium tracking-tight\">\n          {{ section.title }}\n        </h3>\n        <p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">\n          {{ section.body }}\n        </p>\n      </div>\n    </component>\n  </div>\n</template>\n",
      "type": "registry:ui",
      "target": "components/ui/numbered-reveal/NumberedReveal.vue"
    },
    {
      "path": "registry/new-york/numbered-reveal/index.ts",
      "content": "export { default as NumberedReveal } from './NumberedReveal.vue';\nexport type { NumberedRevealProps, RevealSection } from './types';\n",
      "type": "registry:ui",
      "target": "components/ui/numbered-reveal/index.ts"
    },
    {
      "path": "registry/new-york/numbered-reveal/types.ts",
      "content": "export interface RevealSection {\n  /** Section number, e.g. '01'. */\n  number: string;\n  /** Section heading. */\n  title: string;\n  /** Body copy. */\n  body: string;\n}\n\nexport interface NumberedRevealProps {\n  sections?: RevealSection[];\n  /** Sections reveal one at a time on scroll (default), or all at once. */\n  stagger?: boolean;\n  class?: string;\n}\n",
      "type": "registry:ui",
      "target": "components/ui/numbered-reveal/types.ts"
    }
  ]
}
